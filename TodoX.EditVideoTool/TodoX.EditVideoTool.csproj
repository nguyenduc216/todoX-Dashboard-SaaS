<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>todox-editvideo</AssemblyName>
    <RootNamespace>TodoX.EditVideoTool</RootNamespace>
    <Version>1.1.0</Version>
    <Product>TodoX EditVideo</Product>
    <Company>TodoX</Company>
    <!-- Required by the LibraryImport source generator (volume serial P/Invoke). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets/favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release distribution: one self-contained exe for Windows x64. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Smaller installer download; the exe unpacks itself in memory at start. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/todox-logo.png" LogicalName="todox-logo.png" />
    <EmbeddedResource Include="Skill\SKILL.md" LogicalName="SKILL.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TodoX.EditVideoTool.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

</Project>
