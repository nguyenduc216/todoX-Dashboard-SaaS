<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuildCommit Condition="'$(BuildCommit)' == ''">unknown</BuildCommit>
    <BuildBranch Condition="'$(BuildBranch)' == ''">local</BuildBranch>
    <BuildCommitMessage Condition="'$(BuildCommitMessage)' == ''">unknown</BuildCommitMessage>
    <BuildTimeUtc Condition="'$(BuildTimeUtc)' == ''">$([System.DateTime]::UtcNow.ToString("o"))</BuildTimeUtc>
    <PublishTimeUtc Condition="'$(PublishTimeUtc)' == ''">$([System.DateTime]::UtcNow.ToString("o"))</PublishTimeUtc>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;bin/**;bin2/**;obj/**;publish/**;Tests/**;.codex_bin/**;.codex_obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="PopulateBuildMetadataFromGit" BeforeTargets="GenerateAssemblyInfo">
    <Exec Command="git rev-parse HEAD" ConsoleToMsBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommit" />
    </Exec>
    <Exec Command="git rev-parse --abbrev-ref HEAD" ConsoleToMsBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitBranch" />
    </Exec>
    <Exec Command="git log -1 --pretty=%25s" ConsoleToMsBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitMessage" />
    </Exec>
    <PropertyGroup>
      <BuildCommit Condition="'$(_GitCommit)' != '' and '$(BuildCommit)' == 'unknown'">$(_GitCommit)</BuildCommit>
      <BuildBranch Condition="'$(_GitBranch)' != '' and '$(BuildBranch)' == 'local'">$(_GitBranch)</BuildBranch>
      <BuildCommitMessage Condition="'$(_GitCommitMessage)' != '' and '$(BuildCommitMessage)' == 'unknown'">$(_GitCommitMessage)</BuildCommitMessage>
    </PropertyGroup>
  </Target>

  <Target Name="GenerateBuildMetadataSource" BeforeTargets="CoreCompile" DependsOnTargets="PopulateBuildMetadataFromGit">
    <ItemGroup>
      <_BuildAssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildCommit</_Parameter1>
        <_Parameter2>$(BuildCommit)</_Parameter2>
      </_BuildAssemblyAttribute>
      <_BuildAssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildBranch</_Parameter1>
        <_Parameter2>$(BuildBranch)</_Parameter2>
      </_BuildAssemblyAttribute>
      <_BuildAssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildCommitMessage</_Parameter1>
        <_Parameter2>$(BuildCommitMessage)</_Parameter2>
      </_BuildAssemblyAttribute>
      <_BuildAssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildTimeUtc</_Parameter1>
        <_Parameter2>$(BuildTimeUtc)</_Parameter2>
      </_BuildAssemblyAttribute>
      <_BuildAssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>PublishTimeUtc</_Parameter1>
        <_Parameter2>$(PublishTimeUtc)</_Parameter2>
      </_BuildAssemblyAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#" OutputFile="$(IntermediateOutputPath)BuildMetadata.g.cs" AssemblyAttributes="@(_BuildAssemblyAttribute)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildMetadata.g.cs" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.6.0" />
    <PackageReference Include="Npgsql" Version="9.0.2" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
  </ItemGroup>

  <!-- Stale published output lives under ./publish and must not be scanned by the build -->
  <ItemGroup>
    <Content Remove="publish/**" />
    <None Remove="publish/**" />
    <Compile Remove="publish/**" />
    <Content Remove="artifacts/**" />
    <None Remove="artifacts/**" />
    <Compile Remove="artifacts/**" />
    <Content Remove="bin/**" />
    <None Remove="bin/**" />
    <Compile Remove="bin/**" />
    <Content Remove="bin2/**" />
    <None Remove="bin2/**" />
    <Compile Remove="bin2/**" />
    <Content Remove="obj/**" />
    <None Remove="obj/**" />
    <Compile Remove="obj/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
    <Compile Remove="Tests/**" />
    <Content Remove=".codex_bin/**" />
    <None Remove=".codex_bin/**" />
    <Compile Remove=".codex_bin/**" />
    <Content Remove=".codex_obj/**" />
    <None Remove=".codex_obj/**" />
    <Compile Remove=".codex_obj/**" />
    <Content Remove="keys/**/*.json" />
    <None Remove="keys/**/*.json" />
  </ItemGroup>

</Project>
