@inject IJSRuntime JS

<MudDialog Class="rdance-tiktok-url-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">TikTok URL</MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField T="string"
                          Label="Current TikTok URL"
                          Value="@CurrentUrl"
                          Variant="Variant.Outlined"
                          ReadOnly="true" />

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ContentCopy"
                       Disabled="@string.IsNullOrWhiteSpace(CurrentUrl)"
                       OnClick="CopyCurrentUrlAsync">
                Copy
            </MudButton>

            <MudTextField T="string"
                          Label="Change TikTok URL"
                          @bind-Value="_url"
                          Variant="Variant.Outlined"
                          Placeholder="https://www.tiktok.com/..."
                          Immediate="true" />
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   Disabled="@string.IsNullOrWhiteSpace(_url)"
                   OnClick="Confirm">
            Confirm / Load video
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? CurrentUrl { get; set; }

    private string _url = string.Empty;

    protected override void OnParametersSet()
    {
        _url = CurrentUrl?.Trim() ?? string.Empty;
    }

    private async Task CopyCurrentUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentUrl))
        {
            return;
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", CurrentUrl);
    }

    private void Confirm() => MudDialog.Close(DialogResult.Ok(_url.Trim()));

    private void Cancel() => MudDialog.Cancel();
}
