<MudDialog>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(VideoUrl))
        {
            <video src="@VideoUrl" controls autoplay playsinline class="rv2-preview-video"></video>
        }
        else if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            <img src="@ImageUrl" alt="@(Title ?? "Xem trước")" class="rv2-preview-image" />
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true">Chưa có media để xem trước.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        @if (!string.IsNullOrWhiteSpace(VideoUrl))
        {
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Download" Href="@VideoUrl" Target="_blank">Mở video</MudButton>
        }
        <MudButton Variant="Variant.Text" OnClick="Cancel">Đóng</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .rv2-preview-video { width: 100%; max-height: 70vh; background: #000; border-radius: 8px; }
    .rv2-preview-image { max-width: 100%; max-height: 70vh; object-fit: contain; border-radius: 8px; }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? VideoUrl { get; set; }
    [Parameter] public string? ImageUrl { get; set; }

    private void Cancel() => MudDialog.Cancel();
}