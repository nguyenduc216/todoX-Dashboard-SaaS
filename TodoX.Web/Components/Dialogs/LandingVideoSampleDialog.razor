@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using System.Diagnostics
@using TodoX.Web.Models.Catalog
@using TodoX.Web.Services
@using TodoX.Web.Services.Landing
@using TodoX.Web.Services.SharedMedia
@inject AuthStateService AuthState
@inject LandingVideoSampleRepository Repository
@inject LandingIntroVideoMediaService Media
@inject SharedMediaPathService Paths
@inject ISnackbar Snackbar
@inject ILogger<LandingVideoSampleDialog> Logger
@inject IOptions<SharedMediaOptions> MediaOptions

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_model.Id == Guid.Empty ? "Thêm video mẫu" : "Chỉnh sửa video mẫu")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
            @if (!Paths.IsConfigured || !Paths.CanWrite()) { <MudAlert Severity="Severity.Warning">SharedMedia chưa sẵn sàng để upload.</MudAlert> }
            <MudTextField T="string" Label="Tiêu đề video" @bind-Value="_model.Title" MaxLength="@LandingVideoSampleRepository.MaxTitleLength" />
            <MudTextField T="string" Label="Thông tin nội dung video" @bind-Value="_model.Description" Lines="4" MaxLength="@LandingVideoSampleRepository.MaxDescriptionLength" />
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" Label="Kích thước" @bind-Value="_model.AspectRatio">
                        <MudSelectItem Value="@LandingVideoSampleRepository.Portrait">9:16 (dọc)</MudSelectItem>
                        <MudSelectItem Value="@LandingVideoSampleRepository.Landscape">16:9 (ngang)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudSelect T="string" Label="Nhóm dịch vụ video" @bind-Value="_serviceChoice">
                        @foreach (var service in _services)
                        {
                            <MudSelectItem Value="@service.Id.ToString()">@service.ServiceName</MudSelectItem>
                        }
                        <MudSelectItem Value="@LandingVideoSampleRepository.OtherServiceChoice">@LandingVideoSampleRepository.OtherServiceName</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="2">
                        <MudText>Video MP4/WebM (tối đa @(LandingIntroVideoMediaService.MaxBytes(MediaOptions.Value, LandingVideoSampleRepository.MediaArea, true) / (1024 * 1024)) MB):</MudText>
                        <InputFile OnChange="UploadVideoAsync" accept=".mp4,.webm,video/mp4,video/webm" disabled="@_busy" />
                        @if (_uploadingVideo)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">Đang tải lên và tối ưu video cho web (720p), có thể mất 1–2 phút...</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(_model.VideoUrl))
                        {
                            <video src="@_model.VideoUrl" poster="@PreviewPoster" controls playsinline preload="metadata" style="max-width:100%;max-height:300px"></video>
                        }
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="2">
                        <MudText>Thumbnail 9:16 (dọc, khuyên dùng 1080×1920):</MudText>
                        <InputFile OnChange="@(args => UploadAsync(args, ImageSlot.Portrait))" accept="@ImageAccept" disabled="@_busy" />
                        @if (!string.IsNullOrWhiteSpace(_model.ThumbnailPortraitUrl)) { <img src="@_model.ThumbnailPortraitUrl" alt="Thumbnail 9:16" style="max-width:100%;max-height:300px;aspect-ratio:9/16;object-fit:cover" /> }
                    </MudStack>
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.subtitle2">Ảnh hiển thị thêm</MudText>
            <MudText Typo="Typo.caption">Hệ thống tự chọn ảnh phù hợp: thẻ video và trình phát dùng thumbnail cùng tỉ lệ với video; khi dán link vào Zalo/Facebook/Messenger dùng ảnh chia sẻ, nếu chưa có thì dùng thumbnail 16:9, cuối cùng là thumbnail còn lại.</MudText>
            @if (!_thumbnailsReady)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">Cần chạy script <code>@LandingVideoSampleRepository.ThumbnailsScript</code> trên database để lưu ảnh chia sẻ và giữ cả hai thumbnail (hiện chỉ lưu thumbnail cùng tỉ lệ với video).</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="2">
                        <MudText>Thumbnail 16:9 (ngang, khuyên dùng 1920×1080):</MudText>
                        <InputFile OnChange="@(args => UploadAsync(args, ImageSlot.Landscape))" accept="@ImageAccept" disabled="@_busy" />
                        @if (!string.IsNullOrWhiteSpace(_model.ThumbnailLandscapeUrl)) { <img src="@_model.ThumbnailLandscapeUrl" alt="Thumbnail 16:9" style="max-width:100%;max-height:200px;aspect-ratio:16/9;object-fit:cover" /> }
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="2">
                        <MudText>Ảnh chia sẻ Zalo/Facebook (1200×630):</MudText>
                        <InputFile OnChange="@(args => UploadAsync(args, ImageSlot.Share))" accept="@ImageAccept" disabled="@(_busy || !_thumbnailsReady)" />
                        @if (!string.IsNullOrWhiteSpace(_model.ShareImageUrl)) { <img src="@_model.ShareImageUrl" alt="Ảnh chia sẻ" style="max-width:100%;max-height:200px;aspect-ratio:1200/630;object-fit:cover" /> }
                    </MudStack>
                </MudItem>
            </MudGrid>
            @if (_busy) { <MudProgressLinear Indeterminate="true" /> }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="@_busy" OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@_busy" OnClick="SaveAsync">Lưu video mẫu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public LandingVideoSample? Source { get; set; }
    [Parameter] public IReadOnlyList<ServiceDto> Services { get; set; } = [];

    private LandingVideoSample _model = new();
    private List<ServiceDto> _services = [];
    private string? _serviceChoice;
    private bool _busy;
    private bool _uploadingVideo;
    private bool _thumbnailsReady;
    private string? _error;

    private const string ImageAccept = ".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp";
    private enum ImageSlot { Video, Portrait, Landscape, Share }

    private string? PreviewPoster => (_model.AspectRatio == LandingVideoSampleRepository.Landscape
        ? _model.ThumbnailLandscapeUrl ?? _model.ThumbnailPortraitUrl
        : _model.ThumbnailPortraitUrl ?? _model.ThumbnailLandscapeUrl) ?? _model.PosterUrl;

    protected override async Task OnInitializedAsync()
    {
        try { _thumbnailsReady = await Repository.SupportsThumbnailsAsync(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Landing video sample thumbnail columns check failed."); }

        if (Source is not null)
        {
            _model = new LandingVideoSample
            {
                Id = Source.Id, Title = Source.Title, Description = Source.Description, AspectRatio = Source.AspectRatio,
                VideoUrl = Source.VideoUrl, PosterUrl = Source.PosterUrl, ServiceId = Source.ServiceId,
                ThumbnailLandscapeUrl = Source.ThumbnailLandscapeUrl, ShareImageUrl = Source.ShareImageUrl,
                ThumbnailPortraitUrl = Source.ThumbnailPortraitUrl
            };
            // Samples saved before the extra slots existed only have the main poster: show it in its ratio's slot.
            if (_model.ThumbnailPortraitUrl is null && _model.ThumbnailLandscapeUrl is null)
            {
                if (_model.AspectRatio == LandingVideoSampleRepository.Landscape) _model.ThumbnailLandscapeUrl = _model.PosterUrl;
                else _model.ThumbnailPortraitUrl = _model.PosterUrl;
            }
            _serviceChoice = Source.ServiceId?.ToString() ?? LandingVideoSampleRepository.OtherServiceChoice;
        }

        // Keep the current service selectable when editing a sample whose service has been paused.
        _services = Services.Where(service => service.Status == TodoXServiceStatuses.Active || service.Id == Source?.ServiceId).ToList();
    }

    private void Cancel() => MudDialog.Cancel();

    private Task UploadVideoAsync(InputFileChangeEventArgs args) => UploadAsync(args, ImageSlot.Video);
    private async Task UploadAsync(InputFileChangeEventArgs args, ImageSlot slot)
    {
        var video = slot == ImageSlot.Video;
        if (_busy) return;
        _busy = true;
        _uploadingVideo = video;
        _error = null;
        try
        {
            var url = await Media.UploadAsync(args.File, video, LandingVideoSampleRepository.MediaArea);
            switch (slot)
            {
                case ImageSlot.Video: _model.VideoUrl = url; break;
                case ImageSlot.Portrait: _model.ThumbnailPortraitUrl = url; break;
                case ImageSlot.Landscape: _model.ThumbnailLandscapeUrl = url; break;
                case ImageSlot.Share: _model.ShareImageUrl = url; break;
            }
            Snackbar.Add("Upload thành công. Nhấn Lưu video mẫu để áp dụng.", Severity.Success);
        }
        catch (Exception ex)
        {
            var maxBytes = LandingIntroVideoMediaService.MaxBytes(MediaOptions.Value, LandingVideoSampleRepository.MediaArea, video);
            var storageAvailable = Paths.IsConfigured && Paths.CanWrite();
            var category = IntroUploadDiagnostics.Classify(ex, storageAvailable);
            Logger.LogError(ex,
                "Landing video sample upload failed. FileName={FileName} FileSize={FileSize} UploadType={UploadType} MaxBytes={MaxBytes} StorageAvailable={StorageAvailable} ExceptionType={ExceptionType} ErrorCategory={ErrorCategory} CorrelationId={CorrelationId}",
                IntroUploadDiagnostics.SafeFileName(args.File.Name), args.File.Size, slot.ToString(),
                maxBytes, storageAvailable, ex.GetType().Name, category, Activity.Current?.Id);
            _error = IntroUploadDiagnostics.Message(category, maxBytes);
        }
        finally { _busy = false; _uploadingVideo = false; }
    }

    private async Task SaveAsync()
    {
        if (_busy || AuthState.CurrentUser is null) return;
        _busy = true;
        _error = null;
        try
        {
            LandingVideoSampleRepository.ApplyServiceChoice(_model, _serviceChoice);
            await Repository.SaveAsync(_model, AuthState.CurrentUser.UserId.ToString());
            Snackbar.Add("Đã lưu video mẫu.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ArgumentException ex) { _error = ex.Message.Split(" (Parameter")[0]; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Landing video sample save failed.");
            _error = "Không thể lưu video mẫu. Kiểm tra database và script landing.video_samples.";
        }
        finally { _busy = false; }
    }
}
