@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using System.Diagnostics
@using TodoX.Web.Models.Catalog
@using TodoX.Web.Models
@using TodoX.Web.Services
@using TodoX.Web.Services.CustomerVideos
@using TodoX.Web.Services.Landing
@using TodoX.Web.Services.SharedMedia
@inject AuthStateService AuthState
@inject LandingVideoSampleRepository Repository
@inject LandingIntroVideoMediaService Media
@inject SharedMediaPathService Paths
@inject ISnackbar Snackbar
@inject ILogger<LandingVideoSampleDialog> Logger
@inject IOptions<SharedMediaOptions> MediaOptions
@inject CustomerVideoRepository CustomerVideos
@inject AccountService Accounts
@inject WalletService Wallets
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_model.Id == Guid.Empty ? "Thêm video mẫu" : "Chỉnh sửa video mẫu")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
            @if (!Paths.IsConfigured || !Paths.CanWrite()) { <MudAlert Severity="Severity.Warning">SharedMedia chưa sẵn sàng để upload.</MudAlert> }
            <MudTextField T="string" Label="Tiêu đề video" @bind-Value="_model.Title" MaxLength="@LandingVideoSampleRepository.MaxTitleLength" />
            <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                <MudSwitch T="bool" @bind-Value="_model.IsVisible" Color="Color.Success" Disabled="@(!_visibilityReady)"
                           Label="@(_model.IsVisible ? "Hiển thị trên landing: Có" : "Hiển thị trên landing: Không (đang ẩn, vẫn xem được qua link)")" />
                @if (_model.Id != Guid.Empty)
                {
                    <MudSwitch T="bool" @bind-Value="_overwrite" Color="Color.Warning" Disabled="@_busy"
                               Label="Ghi đè file cũ khi tải bản mới" />
                }
            </MudStack>
            @if (!_visibilityReady)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">Cần chạy script <code>@LandingVideoSampleRepository.VisibilityScript</code> trên database để ẩn/hiện video mẫu.</MudAlert>
            }
            @if (_overwrite)
            {
                <MudAlert Severity="Severity.Info" Dense="true">Chế độ ghi đè: video/ảnh mới tải lên (hoặc chọn từ thư viện) sẽ thay bản cũ, và file cũ bị xóa khỏi thư viện khi bấm Lưu (nếu không video mẫu nào khác còn dùng). Link chia sẻ của video mẫu giữ nguyên; người xem thấy ngay bản mới.</MudAlert>
                @if (_replaced.Count > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">Sẽ thay @_replaced.Count file cũ khi lưu.</MudText>
                }
            }
            <MudTextField T="string" Label="Thông tin nội dung video" @bind-Value="_model.Description" Lines="4" MaxLength="@LandingVideoSampleRepository.MaxDescriptionLength" />
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" Label="Kích thước" @bind-Value="_model.AspectRatio">
                        <MudSelectItem Value="@LandingVideoSampleRepository.Portrait">9:16 (dọc)</MudSelectItem>
                        <MudSelectItem Value="@LandingVideoSampleRepository.Landscape">16:9 (ngang)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudSelect T="string" Label="Nhóm dịch vụ video" Value="_serviceChoice" ValueChanged="ServiceChoiceChanged">
                        @foreach (var service in _services)
                        {
                            <MudSelectItem Value="@service.Id.ToString()">@service.ServiceName</MudSelectItem>
                        }
                        @foreach (var builtIn in LandingVideoSampleRepository.BuiltInChoices)
                        {
                            <MudSelectItem Value="@builtIn.Choice">@builtIn.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @if (_customerReady && CustomerAllowed)
                {
                    <MudItem xs="12" sm="@(_customer is null ? 12 : 6)">
                        <MudAutocomplete T="CustomerProfile" Label="Khách hàng (không bắt buộc)" Value="_customer" ValueChanged="CustomerChangedAsync"
                                         SearchFunc="SearchCustomersAsync" ToStringFunc="CustomerDisplay" Clearable="true" ResetValueOnEmptyText="true"
                                         MaxItems="30" Disabled="_busy" autocomplete="off" data-testid="sample-customer"
                                         HelperText="Video làm cho khách nào thì chọn khách đó; để trống nếu là video mẫu chung." />
                        @if (_customer is not null && _balance is not null && !Linked && _existing is null && _addToCustomerVideos)
                        {
                            <MudText Typo="Typo.caption" Class="mt-1 d-block" Color="@(_balance < _points ? Color.Error : Color.Secondary)">Số dư hiện tại: @_balance.Value.ToString("#,0.##") điểm</MudText>
                        }
                    </MudItem>
                    @if (_customer is not null)
                    {
                        <MudItem xs="12" sm="6">
                            @if (Linked)
                            {
                                <MudAlert Severity="Severity.Success" Dense="true">Đã có trong <a href="/customer-videos" target="_blank">Video khách hàng</a>: tiêu đề, video và ảnh bìa được cập nhật theo video mẫu khi lưu.</MudAlert>
                            }
                            else if (_existing is not null)
                            {
                                <MudAlert Severity="Severity.Success" Dense="true" data-testid="sample-existing-customer-video">
                                    Khách đã có video này trong <a href="/customer-videos" target="_blank">Video khách hàng</a>
                                    ("@_existing.Title", @CustomerVideoRules.StatusLabel(_existing.ChargeStatus).ToLowerInvariant()@(_existing.ChargedPoints > 0 ? $" {_existing.ChargedPoints:#,0.##} điểm" : "") ngày @_existing.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")).
                                    Lưu chỉ cập nhật thông tin, không trừ điểm thêm.
                                </MudAlert>
                            }
                            else if (_customerVideosEnabled)
                            {
                                <MudCheckBox T="bool" @bind-Value="_addToCustomerVideos" Color="Color.Warning" Disabled="_busy" data-testid="sample-add-customer-video"
                                             Label="Thêm luôn vào mục Video khách hàng" />
                                @if (_addToCustomerVideos)
                                {
                                    <MudNumericField T="decimal" Label="Trừ điểm của khách" @bind-Value="_points" Min="0" Format="#,0.##" Disabled="_busy"
                                                     Margin="Margin.Dense" HelperText="Theo bảng giá Video khách hàng, 0 = miễn phí" />
                                }
                            }
                        </MudItem>
                    }
                }
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="2">
                        <MudText>Video MP4/WebM (tối đa @(LandingIntroVideoMediaService.MaxBytes(MediaOptions.Value, LandingVideoSampleRepository.MediaArea, true) / (1024 * 1024)) MB):</MudText>
                        <InputFile OnChange="UploadVideoAsync" accept=".mp4,.webm,video/mp4,video/webm" disabled="@_busy" />
                        @LibraryButton(ImageSlot.Video)
                        @if (_uploadingVideo)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">Đang tải lên và tối ưu video cho web (720p), có thể mất 1–2 phút...</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(_model.VideoUrl))
                        {
                            <video src="@_model.VideoUrl" poster="@PreviewPoster" controls playsinline preload="metadata" style="max-width:100%;max-height:300px"></video>
                        }
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="2">
                        <MudText>Thumbnail 9:16 (dọc, khuyên dùng 1080×1920):</MudText>
                        <InputFile OnChange="@(args => UploadAsync(args, ImageSlot.Portrait))" accept="@ImageAccept" disabled="@_busy" />
                        @LibraryButton(ImageSlot.Portrait)
                        @if (!string.IsNullOrWhiteSpace(_model.ThumbnailPortraitUrl)) { <img src="@_model.ThumbnailPortraitUrl" alt="Thumbnail 9:16" style="max-width:100%;max-height:300px;aspect-ratio:9/16;object-fit:cover" /> }
                    </MudStack>
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.subtitle2">Ảnh hiển thị thêm</MudText>
            <MudText Typo="Typo.caption">Hệ thống tự chọn ảnh phù hợp: thẻ video và trình phát dùng thumbnail cùng tỉ lệ với video; khi dán link vào Zalo/Facebook/Messenger dùng ảnh chia sẻ, nếu chưa có thì dùng thumbnail 16:9, cuối cùng là thumbnail còn lại.</MudText>
            @if (!_thumbnailsReady)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">Cần chạy script <code>@LandingVideoSampleRepository.ThumbnailsScript</code> trên database để lưu ảnh chia sẻ và giữ cả hai thumbnail (hiện chỉ lưu thumbnail cùng tỉ lệ với video).</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="2">
                        <MudText>Thumbnail 16:9 (ngang, khuyên dùng 1920×1080):</MudText>
                        <InputFile OnChange="@(args => UploadAsync(args, ImageSlot.Landscape))" accept="@ImageAccept" disabled="@_busy" />
                        @LibraryButton(ImageSlot.Landscape)
                        @if (!string.IsNullOrWhiteSpace(_model.ThumbnailLandscapeUrl)) { <img src="@_model.ThumbnailLandscapeUrl" alt="Thumbnail 16:9" style="max-width:100%;max-height:200px;aspect-ratio:16/9;object-fit:cover" /> }
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="2">
                        <MudText>Ảnh chia sẻ Zalo/Facebook (1200×630):</MudText>
                        <InputFile OnChange="@(args => UploadAsync(args, ImageSlot.Share))" accept="@ImageAccept" disabled="@(_busy || !_thumbnailsReady)" />
                        @if (_thumbnailsReady) { @LibraryButton(ImageSlot.Share) }
                        @if (!string.IsNullOrWhiteSpace(_model.ShareImageUrl)) { <img src="@_model.ShareImageUrl" alt="Ảnh chia sẻ" style="max-width:100%;max-height:200px;aspect-ratio:1200/630;object-fit:cover" /> }
                    </MudStack>
                </MudItem>
            </MudGrid>
            @if (_librarySlot is { } openSlot)
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.subtitle2">Thư viện @(openSlot == ImageSlot.Video ? "video" : "ảnh") đã tải lên — chọn cho: @SlotName(openSlot)</MudText>
                        <MudButton Size="Size.Small" OnClick="CloseLibrary">Đóng</MudButton>
                    </MudStack>
                    @if (_library.Count == 0)
                    {
                        <MudText Typo="Typo.caption">Chưa có tệp nào trong thư viện.</MudText>
                    }
                    else
                    {
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;max-height:420px;overflow:auto;margin-top:8px">
                            @foreach (var file in _library)
                            {
                                var picked = file.Url == CurrentUrl(openSlot);
                                <div style="border:2px solid @(picked ? "var(--mud-palette-warning)" : "var(--mud-palette-lines-default)");border-radius:6px;padding:6px;display:flex;flex-direction:column;gap:4px">
                                    @if (openSlot == ImageSlot.Video)
                                    {
                                        <video src="@file.Url" preload="metadata" muted playsinline controls style="width:100%;height:180px;object-fit:contain;background:#000"></video>
                                    }
                                    else
                                    {
                                        <img src="@file.Url" alt="@file.FileName" loading="lazy" style="width:100%;height:180px;object-fit:contain;background:#111;cursor:pointer" @onclick="() => PickFromLibrary(file)" />
                                    }
                                    <MudText Typo="Typo.caption">@file.UploadedAtUtc.AddHours(7).ToString("dd/MM HH:mm") · @FormatSize(file.Size)</MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" Disabled="@picked" OnClick="() => PickFromLibrary(file)">@(picked ? "Đang dùng" : "Chọn")</MudButton>
                                </div>
                            }
                        </div>
                    }
                </MudPaper>
            }
            @if (OlderVersions.Count > 0)
            {
                <MudPaper Outlined="true" Class="pa-3" data-testid="sample-versions">
                    <MudText Typo="Typo.subtitle2">Các phiên bản video trước (@OlderVersions.Count)</MudText>
                    <MudText Typo="Typo.caption">Bản đang dùng không nằm trong danh sách. "Dùng lại" thay video hiện tại khi bấm Lưu; "Xóa" xóa hẳn file của phiên bản đó.</MudText>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px;margin-top:8px">
                        @foreach (var version in OlderVersions)
                        {
                            <div style="border:1px solid var(--mud-palette-lines-default);border-radius:6px;padding:6px;display:flex;flex-direction:column;gap:4px">
                                <video src="@version.VideoUrl" poster="@version.PosterUrl" preload="metadata" muted playsinline controls style="width:100%;height:180px;object-fit:contain;background:#000"></video>
                                <MudText Typo="Typo.caption">@version.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Disabled="_busy" OnClick="() => UseVersion(version)">Dùng lại</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Disabled="_busy" OnClick="() => DeleteVersionAsync(version)">Xóa</MudButton>
                                </MudStack>
                            </div>
                        }
                    </div>
                </MudPaper>
            }
            @if (_busy) { <MudProgressLinear Indeterminate="true" /> }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="@_busy" OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@_busy" OnClick="SaveAsync">Lưu video mẫu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public LandingVideoSample? Source { get; set; }
    [Parameter] public IReadOnlyList<ServiceDto> Services { get; set; } = [];

    private LandingVideoSample _model = new();
    private List<ServiceDto> _services = [];
    private string? _serviceChoice;
    private bool _busy;
    private bool _uploadingVideo;
    private bool _thumbnailsReady;
    private bool _visibilityReady = true;
    private string? _error;
    // Overwrite mode: files of the saved sample that a new version replaced; deleted after a successful save.
    private bool _overwrite = true;
    private readonly HashSet<string> _replaced = new(StringComparer.OrdinalIgnoreCase);

    private const string ImageAccept = ".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp";
    private enum ImageSlot { Video, Portrait, Landscape, Share }

    private string? PreviewPoster => (_model.AspectRatio == LandingVideoSampleRepository.Landscape
        ? _model.ThumbnailLandscapeUrl ?? _model.ThumbnailPortraitUrl
        : _model.ThumbnailPortraitUrl ?? _model.ThumbnailLandscapeUrl) ?? _model.PosterUrl;

    protected override async Task OnInitializedAsync()
    {
        try { _thumbnailsReady = await Repository.SupportsThumbnailsAsync(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Landing video sample thumbnail columns check failed."); }
        try { _visibilityReady = await Repository.SupportsVisibilityAsync(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Landing video sample visibility column check failed."); }

        try
        {
            _customerReady = await Repository.SupportsCustomerVersionsAsync();
            _customerVideosEnabled = _customerReady && AdminEndpointAuthorization.IsAdmin(AuthState.CurrentUser) && await CustomerVideos.IsReadyAsync();
            if (_customerReady)
            {
                _customers = await Accounts.GetCustomersAsync();
                if (_customerVideosEnabled) _products = await CustomerVideos.GetProductsAsync();
                if (Source is not null) _versions = (await Repository.ListVersionsAsync(Source.Id, Source.VideoUrl)).ToList();
            }
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Landing video sample customer/version data load failed."); }

        if (Source is not null)
        {
            _model = new LandingVideoSample
            {
                Id = Source.Id, Title = Source.Title, Description = Source.Description, AspectRatio = Source.AspectRatio,
                VideoUrl = Source.VideoUrl, PosterUrl = Source.PosterUrl, ServiceId = Source.ServiceId, SampleGroup = Source.SampleGroup,
                ThumbnailLandscapeUrl = Source.ThumbnailLandscapeUrl, ShareImageUrl = Source.ShareImageUrl,
                ThumbnailPortraitUrl = Source.ThumbnailPortraitUrl, IsVisible = Source.IsVisible,
                CustomerId = Source.CustomerId, CustomerName = Source.CustomerName, CustomerVideoId = Source.CustomerVideoId
            };
            _customer = _customers.FirstOrDefault(c => c.Id == Source.CustomerId);
            // Samples saved before the extra slots existed only have the main poster: show it in its ratio's slot.
            if (_model.ThumbnailPortraitUrl is null && _model.ThumbnailLandscapeUrl is null)
            {
                if (_model.AspectRatio == LandingVideoSampleRepository.Landscape) _model.ThumbnailLandscapeUrl = _model.PosterUrl;
                else _model.ThumbnailPortraitUrl = _model.PosterUrl;
            }
            _serviceChoice = LandingVideoSampleRepository.ServiceChoiceOf(Source);
        }
        UpdateDefaultPoints();
        if (_customer is not null) await LoadBalanceAsync();

        // Keep the current service selectable when editing a sample whose service has been paused.
        _services = Services.Where(service => service.Status == TodoXServiceStatuses.Active || service.Id == Source?.ServiceId).ToList();
    }

    private void Cancel() => MudDialog.Cancel();

    // Customer (optional, built-in groups only) and "Video khách hàng".
    private bool _customerReady;
    private bool _customerVideosEnabled;
    private IReadOnlyList<CustomerProfile> _customers = [];
    private IReadOnlyList<CustomerVideoProduct> _products = [];
    private CustomerProfile? _customer;
    private bool _addToCustomerVideos = true;
    private decimal _points;
    private decimal? _balance;
    // The customer's video already in "Video khách hàng" (same file or title): saving links it, never charges again.
    private CustomerVideo? _existing;

    private bool CustomerAllowed => _serviceChoice is LandingVideoSampleRepository.OtherServiceChoice or LandingVideoSampleRepository.TvcServiceChoice;
    // Still the customer the saved sample's "Video khách hàng" row belongs to.
    private bool Linked => _model.CustomerVideoId is not null && _customer?.Id == Source?.CustomerId;

    private void ServiceChoiceChanged(string? choice)
    {
        _serviceChoice = choice;
        UpdateDefaultPoints();
    }

    private void UpdateDefaultPoints()
    {
        var product = _serviceChoice == LandingVideoSampleRepository.TvcServiceChoice ? CustomerVideoRules.Tvc : CustomerVideoRules.Communication;
        _points = _products.FirstOrDefault(x => x.ProductCode == product)?.Points ?? 0;
    }

    private static string CustomerDisplay(CustomerProfile? customer)
        => customer is null ? string.Empty : $"{customer.CompanyName} ({customer.CustomerCode}{(string.IsNullOrWhiteSpace(customer.Email) ? "" : " · " + customer.Email)})";

    private Task<IEnumerable<CustomerProfile>> SearchCustomersAsync(string value, CancellationToken cancellationToken)
    {
        IEnumerable<CustomerProfile> result = _customers;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var term = value.Trim();
            result = result.Where(c => c.CompanyName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || c.CustomerCode.Contains(term, StringComparison.OrdinalIgnoreCase)
                || c.Email.Contains(term, StringComparison.OrdinalIgnoreCase)
                || c.Phone.Contains(term, StringComparison.OrdinalIgnoreCase)
                || c.ContactName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(result.Take(30));
    }

    private async Task CustomerChangedAsync(CustomerProfile? customer)
    {
        _customer = customer;
        _addToCustomerVideos = true;
        await LoadBalanceAsync();
    }

    private async Task LoadBalanceAsync()
    {
        _balance = null;
        _existing = null;
        if (_customer is null || !_customerVideosEnabled) return;
        if (!Linked)
        {
            try { _existing = await CustomerVideos.FindExistingAsync(_customer.Id, _model.VideoUrl, _model.Title); }
            catch (Exception ex) { Logger.LogWarning(ex, "Landing video sample existing customer video lookup failed {CustomerId}", _customer.Id); }
        }
        try { _balance = await Wallets.GetBalanceAsync(_customer.Id); }
        catch (Exception ex) { Logger.LogWarning(ex, "Landing video sample balance lookup failed {CustomerId}", _customer.Id); }
    }

    // Older video versions of the saved sample (the one in use is never listed).
    private List<LandingVideoSampleVersion> _versions = [];
    private List<LandingVideoSampleVersion> OlderVersions
        => _versions.Where(v => !string.Equals(v.VideoUrl, _model.VideoUrl, StringComparison.OrdinalIgnoreCase)
                                && !_replaced.Contains(v.VideoUrl)).ToList();

    private void UseVersion(LandingVideoSampleVersion version)
    {
        RememberReplaced(ImageSlot.Video, version.VideoUrl);
        _model.VideoUrl = version.VideoUrl;
        Snackbar.Add("Đã chọn lại phiên bản cũ. Nhấn Lưu video mẫu để áp dụng.", Severity.Success);
    }

    private async Task DeleteVersionAsync(LandingVideoSampleVersion version)
    {
        if (_busy || Source is null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync("Xóa phiên bản video",
            $"Xóa phiên bản tải lên lúc {version.CreatedAt.ToLocalTime():dd/MM/yyyy HH:mm}? File video sẽ bị xóa và không khôi phục được.",
            yesText: "Xóa", cancelText: "Hủy");
        if (confirmed != true) return;
        _busy = true;
        _error = null;
        try
        {
            await Repository.RemoveVersionsAsync(Source.Id, [version.VideoUrl]);
            _versions.Remove(version);
            // The file goes only when nothing else (another sample, version or customer video) still uses it.
            var used = await Repository.ReferencedMediaUrlsAsync();
            if (!used.Contains(version.VideoUrl)) Media.DeleteSampleUpload(version.VideoUrl);
            Snackbar.Add("Đã xóa phiên bản video.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Landing video sample version delete failed. Version={VersionId}", version.Id);
            _error = "Không xóa được phiên bản video. Vui lòng thử lại.";
        }
        finally { _busy = false; }
    }

    // Library: reuse a file uploaded earlier (e.g. the dialog was closed after the video upload) instead of uploading again.
    private ImageSlot? _librarySlot;
    private IReadOnlyList<LandingMediaFile> _library = [];

    private RenderFragment LibraryButton(ImageSlot slot) => @<MudButton Size="Size.Small" Variant="Variant.Outlined"
        StartIcon="@Icons.Material.Filled.PhotoLibrary" Disabled="@_busy" OnClick="() => OpenLibrary(slot)"
        Style="align-self:flex-start">Chọn từ thư viện</MudButton>;

    private void OpenLibrary(ImageSlot slot)
    {
        _error = null;
        try
        {
            _library = Media.ListUploads(LandingVideoSampleRepository.MediaArea, slot == ImageSlot.Video);
            _librarySlot = slot;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Landing video sample library listing failed. Slot={Slot}", slot);
            _error = "Không mở được thư viện tệp. Vui lòng thử lại.";
        }
    }

    private void CloseLibrary() => _librarySlot = null;

    private void PickFromLibrary(LandingMediaFile file)
    {
        if (_librarySlot is { } pickSlot) RememberReplaced(pickSlot, file.Url);
        switch (_librarySlot)
        {
            case ImageSlot.Video: _model.VideoUrl = file.Url; break;
            case ImageSlot.Portrait: _model.ThumbnailPortraitUrl = file.Url; break;
            case ImageSlot.Landscape: _model.ThumbnailLandscapeUrl = file.Url; break;
            case ImageSlot.Share: _model.ShareImageUrl = file.Url; break;
            default: return;
        }
        Snackbar.Add($"Đã chọn {SlotName(_librarySlot.Value)} từ thư viện. Nhấn Lưu video mẫu để áp dụng.", Severity.Success);
        _librarySlot = null;
    }

    /// <summary>In overwrite mode, remembers the saved sample's file in this slot so it is deleted after saving.</summary>
    private void RememberReplaced(ImageSlot slot, string newUrl)
    {
        if (!_overwrite || Source is null) return;
        var old = CurrentUrl(slot);
        var saved = new[] { Source.VideoUrl, Source.PosterUrl, Source.ThumbnailPortraitUrl, Source.ThumbnailLandscapeUrl, Source.ShareImageUrl };
        if (!string.IsNullOrWhiteSpace(old) && !string.Equals(old, newUrl, StringComparison.OrdinalIgnoreCase)
            && saved.Contains(old, StringComparer.OrdinalIgnoreCase))
            _replaced.Add(old);
    }

    private string? CurrentUrl(ImageSlot slot) => slot switch
    {
        ImageSlot.Video => _model.VideoUrl,
        ImageSlot.Portrait => _model.ThumbnailPortraitUrl,
        ImageSlot.Landscape => _model.ThumbnailLandscapeUrl,
        _ => _model.ShareImageUrl
    };

    private static string SlotName(ImageSlot slot) => slot switch
    {
        ImageSlot.Video => "video",
        ImageSlot.Portrait => "thumbnail 9:16",
        ImageSlot.Landscape => "thumbnail 16:9",
        _ => "ảnh chia sẻ"
    };

    private static string FormatSize(long bytes)
        => bytes >= 1024 * 1024 ? $"{bytes / (1024d * 1024):0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    private Task UploadVideoAsync(InputFileChangeEventArgs args) => UploadAsync(args, ImageSlot.Video);
    private async Task UploadAsync(InputFileChangeEventArgs args, ImageSlot slot)
    {
        var video = slot == ImageSlot.Video;
        if (_busy) return;
        _busy = true;
        _uploadingVideo = video;
        _error = null;
        try
        {
            var url = await Media.UploadAsync(args.File, video, LandingVideoSampleRepository.MediaArea);
            RememberReplaced(slot, url);
            switch (slot)
            {
                case ImageSlot.Video: _model.VideoUrl = url; break;
                case ImageSlot.Portrait: _model.ThumbnailPortraitUrl = url; break;
                case ImageSlot.Landscape: _model.ThumbnailLandscapeUrl = url; break;
                case ImageSlot.Share: _model.ShareImageUrl = url; break;
            }
            Snackbar.Add("Upload thành công. Nhấn Lưu video mẫu để áp dụng.", Severity.Success);
        }
        catch (Exception ex)
        {
            var maxBytes = LandingIntroVideoMediaService.MaxBytes(MediaOptions.Value, LandingVideoSampleRepository.MediaArea, video);
            var storageAvailable = Paths.IsConfigured && Paths.CanWrite();
            var category = IntroUploadDiagnostics.Classify(ex, storageAvailable);
            Logger.LogError(ex,
                "Landing video sample upload failed. FileName={FileName} FileSize={FileSize} UploadType={UploadType} MaxBytes={MaxBytes} StorageAvailable={StorageAvailable} ExceptionType={ExceptionType} ErrorCategory={ErrorCategory} CorrelationId={CorrelationId}",
                IntroUploadDiagnostics.SafeFileName(args.File.Name), args.File.Size, slot.ToString(),
                maxBytes, storageAvailable, ex.GetType().Name, category, Activity.Current?.Id);
            _error = IntroUploadDiagnostics.Message(category, maxBytes);
        }
        finally { _busy = false; _uploadingVideo = false; }
    }

    private async Task SaveAsync()
    {
        if (_busy || AuthState.CurrentUser is null) return;
        _busy = true;
        _error = null;
        try
        {
            LandingVideoSampleRepository.ApplyServiceChoice(_model, _serviceChoice);
            _model.CustomerId = _customerReady && LandingVideoSampleRepository.AllowsCustomer(_model) ? _customer?.Id : null;
            // Another customer (or none): the old "Video khách hàng" row stays with its customer, this sample is unlinked.
            if (_model.CustomerId is null || _model.CustomerId != Source?.CustomerId) _model.CustomerVideoId = null;
            LandingVideoSampleRepository.Normalize(_model);
            LandingVideoSampleRepository.Validate(_model);

            var customerVideoNote = await SyncCustomerVideoAsync();
            if (customerVideoNote is null) return;
            try
            {
                await Repository.SaveAsync(_model, AuthState.CurrentUser.UserId.ToString());
            }
            catch when (_createdCustomerVideo is { } created)
            {
                // Nothing half-done: the customer video added (and charged) for this save is removed and refunded.
                try { await CustomerVideos.DeleteAsync(created); }
                catch (Exception undo) { Logger.LogError(undo, "Customer video {Id} could not be undone after a failed sample save.", created); }
                _model.CustomerVideoId = null;
                _createdCustomerVideo = null;
                throw;
            }
            await Repository.RemoveVersionsAsync(_model.Id, _replaced);
            var removed = await RemoveReplacedFilesAsync();
            var message = removed > 0 ? $"Đã lưu video mẫu và thay {removed} file cũ." : "Đã lưu video mẫu.";
            Snackbar.Add(customerVideoNote.Length > 0 ? $"{message} {customerVideoNote}" : message, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ArgumentException ex) { _error = ex.Message.Split(" (Parameter")[0]; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Landing video sample save failed.");
            _error = "Không thể lưu video mẫu. Kiểm tra database và script landing.video_samples.";
        }
        finally { _busy = false; }
    }

    private Guid? _createdCustomerVideo;

    /// <summary>
    /// Adds the sample to the customer's "Video khách hàng" (charging the points set) or keeps the linked one in sync.
    /// Returns a note for the success message, or null when adding failed (the error is shown and nothing is saved).
    /// </summary>
    private async Task<string?> SyncCustomerVideoAsync()
    {
        _createdCustomerVideo = null;
        if (_model.CustomerId is not { } customerId || !_customerVideosEnabled) return string.Empty;
        if (_model.CustomerVideoId is { } linkedId)
        {
            var linked = await CustomerVideos.GetAsync(linkedId, AuthState.CurrentUser);
            if (linked is null) { _model.CustomerVideoId = null; return string.Empty; }
            linked.Title = _model.Title;
            linked.VideoUrl = _model.VideoUrl;
            linked.PosterUrl = _model.PosterUrl;
            var updated = await CustomerVideos.UpdateAsync(linked);
            if (!updated.Ok) Logger.LogWarning("Linked customer video {Id} was not updated: {Error}", linkedId, updated.Error);
            return updated.Ok ? "Đã cập nhật Video khách hàng." : string.Empty;
        }
        // Already made for this customer (already charged or free): link it and update its information, no new charge.
        var existing = await CustomerVideos.FindExistingAsync(customerId, _model.VideoUrl, _model.Title)
                       ?? await CustomerVideos.FindExistingAsync(customerId, Source?.VideoUrl, Source?.Title);
        if (existing is not null)
        {
            _model.CustomerVideoId = existing.Id;
            existing.Title = _model.Title;
            existing.VideoUrl = _model.VideoUrl;
            existing.PosterUrl = _model.PosterUrl;
            var updated = await CustomerVideos.UpdateAsync(existing);
            if (!updated.Ok) Logger.LogWarning("Existing customer video {Id} was not updated: {Error}", existing.Id, updated.Error);
            return "Khách đã có video này: đã cập nhật Video khách hàng, không trừ điểm.";
        }
        if (!_addToCustomerVideos) return string.Empty;
        var result = await CustomerVideos.CreateAsync(new CustomerVideo
        {
            CustomerId = customerId,
            ProductCode = LandingVideoSampleRepository.CustomerVideoProduct(_model),
            Title = _model.Title,
            VideoUrl = _model.VideoUrl,
            PosterUrl = _model.PosterUrl,
            Note = string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description
        }, _points);
        if (!result.Ok || result.Id is null)
        {
            _error = $"Chưa lưu: không thêm được vào Video khách hàng — {result.Error} "
                + "Có thể nạp thêm điểm cho khách, giảm số điểm trừ (0 = miễn phí) hoặc bỏ tích \"Thêm luôn vào mục Video khách hàng\".";
            return null;
        }
        _model.CustomerVideoId = _createdCustomerVideo = result.Id;
        return _points > 0 ? $"Đã thêm vào Video khách hàng và trừ {_points:#,0.##} điểm." : "Đã thêm vào Video khách hàng (miễn phí).";
    }

    /// <summary>Deletes the replaced files that no sample uses any more (a file picked for several samples stays).</summary>
    private async Task<int> RemoveReplacedFilesAsync()
    {
        if (_replaced.Count == 0) return 0;
        var removed = 0;
        try
        {
            var used = await Repository.ReferencedMediaUrlsAsync();
            foreach (var url in _replaced.Where(url => !used.Contains(url)))
                if (Media.DeleteSampleUpload(url)) removed++;
        }
        catch (Exception ex)
        {
            // The sample is saved; a leftover old file only stays in the library.
            Logger.LogWarning(ex, "Landing video sample replaced-file cleanup failed. Files={Count}", _replaced.Count);
        }
        return removed;
    }
}
