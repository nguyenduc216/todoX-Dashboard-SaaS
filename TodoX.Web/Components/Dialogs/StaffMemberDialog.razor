@using TodoX.Web.Models
@using TodoX.Web.Services.Studio

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "Thêm nhân viên TodoX" : "Chỉnh sửa nhân viên")</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-1">Tài khoản đăng nhập dashboard</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Họ tên" @bind-Value="_model.FullName" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Tên đăng nhập" @bind-Value="_model.Username" Variant="Variant.Outlined" Required="true" autocomplete="off" name="staff-new-username" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Email" @bind-Value="_model.Email" Variant="Variant.Outlined" Required="true" autocomplete="off" name="staff-new-email" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Số điện thoại" @bind-Value="_model.Phone" Variant="Variant.Outlined" autocomplete="off" name="staff-new-phone" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="@(_isNew ? "Mật khẩu" : "Mật khẩu mới (để trống nếu không đổi)")" @bind-Value="_model.Password"
                              InputType="InputType.Password" Variant="Variant.Outlined" Required="@_isNew" autocomplete="new-password" name="staff-new-password" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="bool" Label="Trạng thái" @bind-Value="_model.IsActive" Variant="Variant.Outlined">
                    <MudSelectItem Value="true">Hoạt động</MudSelectItem>
                    <MudSelectItem Value="false">Đã khóa</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Hồ sơ nhân viên</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Mã nhân viên" @bind-Value="_model.EmployeeCode" Variant="Variant.Outlined"
                              HelperText="Để trống: tự cấp NV-0001, NV-0002..." />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Ngày vào làm" @bind-Date="_model.JoinedOn" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Chức vụ" @bind-Value="_model.Position" Variant="Variant.Outlined" Placeholder="Ví dụ: Biên tập video" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Bộ phận" @bind-Value="_model.Department" Variant="Variant.Outlined" Placeholder="Ví dụ: Sản xuất" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Ghi chú" @bind-Value="_model.Note" Variant="Variant.Outlined" Lines="2" />
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Class="todox-page-subtitle mt-2 d-block">
            Tài khoản có vai trò "Nhân viên TodoX": xem khách hàng và làm kế hoạch video. Muốn mở thêm quyền, vào Phân quyền → vai trò Nhân viên TodoX.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Class="todox-primary-btn" OnClick="Submit">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public StaffMember? Source { get; set; }

    private StaffEditModel _model = new();
    private bool _isNew;

    protected override void OnInitialized()
    {
        _isNew = Source is null;
        _model = Source is null
            ? new StaffEditModel { IsActive = true, JoinedOn = DateTime.Today }
            : new StaffEditModel
            {
                UserId = Source.UserId,
                FullName = Source.FullName,
                Username = Source.Username,
                Email = Source.Email,
                Phone = Source.Phone,
                IsActive = Source.IsActive,
                EmployeeCode = Source.EmployeeCode,
                Position = Source.Position,
                Department = Source.Department,
                JoinedOn = Source.JoinedOn,
                Note = Source.Note
            };
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(_model));
    private void Cancel() => MudDialog.Cancel();

    public sealed class StaffEditModel
    {
        public Guid UserId { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
        public string? EmployeeCode { get; set; }
        public string? Position { get; set; }
        public string? Department { get; set; }
        public DateTime? JoinedOn { get; set; }
        public string? Note { get; set; }
    }
}
