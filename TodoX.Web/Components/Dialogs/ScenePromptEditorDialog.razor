@using TodoX.Web.Services.VideoRender

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            @if (IsRendering)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">Scene đang render. Thay đổi prompt chỉ áp dụng cho lần render tiếp theo và không sửa snapshot version cũ.</MudAlert>
            }
            <MudExpansionPanels Elevation="0" Dense="true">
                <MudExpansionPanel Text="Prompt ảnh">
                    <MudTextField T="string" @bind-Value="_imagePrompt" Variant="Variant.Outlined" Lines="5" Required="true" />
                </MudExpansionPanel>
                <MudExpansionPanel Text="Prompt video">
                    <MudTextField T="string" @bind-Value="_motionPrompt" Variant="Variant.Outlined" Lines="5" Required="true" />
                </MudExpansionPanel>
                <MudExpansionPanel Text="Voice / dialogue">
                    <MudTextField T="string" @bind-Value="_voice" Variant="Variant.Outlined" Lines="4" />
                </MudExpansionPanel>
            </MudExpansionPanels>
            @if (!string.IsNullOrWhiteSpace(_validationError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_validationError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Hủy</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!CanSubmit)">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ScenePromptMetadata Metadata { get; set; } = new();
    [Parameter] public bool IsRendering { get; set; }

    private string? _imagePrompt;
    private string? _motionPrompt;
    private string? _voice;
    private string? _validationError;

    private bool CanSubmit
        => !string.IsNullOrWhiteSpace(_imagePrompt)
           && !string.IsNullOrWhiteSpace(_motionPrompt);

    protected override void OnInitialized()
    {
        _imagePrompt = Metadata.ImagePrompt;
        _motionPrompt = Metadata.MotionPrompt;
        _voice = Metadata.Voice;
    }

    private void Submit()
    {
        var imagePrompt = TrimOrNull(_imagePrompt);
        var effectiveImagePrompt = ScenePromptMetadata.NormalizeEditedEffectiveImagePrompt(
            imagePrompt,
            Metadata.ImagePrompt,
            Metadata.EffectiveImagePrompt);
        if (string.IsNullOrWhiteSpace(effectiveImagePrompt))
        {
            _validationError = "SCENE_IMAGE_SOURCE_UNRESOLVED: prompt ảnh là placeholder và không có fallback dùng được.";
            return;
        }

        var result = new ScenePromptMetadata
        {
            ImagePrompt = imagePrompt,
            MotionPrompt = TrimOrNull(_motionPrompt),
            Voice = TrimOrNull(_voice),
            RawSceneJson = Metadata.RawSceneJson,
            EffectiveImagePrompt = effectiveImagePrompt
        };
        foreach (var item in Metadata.Extra)
        {
            result.Extra[item.Key] = item.Value;
        }

        MudDialog.Close(DialogResult.Ok(result));
    }

    private void Cancel() => MudDialog.Cancel();

    private static string? TrimOrNull(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
