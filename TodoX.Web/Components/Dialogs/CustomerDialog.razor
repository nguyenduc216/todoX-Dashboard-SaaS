@using TodoX.Web.Models

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "Thêm khách hàng" : "Chỉnh sửa khách hàng")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Tên công ty" Value="_model.CompanyName" ValueChanged="OnBrandChanged" Immediate="true"
                              Variant="Variant.Outlined" Required="true" autocomplete="off" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Người liên hệ" @bind-Value="_model.ContactName" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Email" @bind-Value="_model.Email" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Số điện thoại" @bind-Value="_model.Phone" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Mã số thuế" @bind-Value="_model.TaxCode" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="TodoXAccountStatus" Label="Trạng thái" @bind-Value="_model.Status" Variant="Variant.Outlined">
                    <MudSelectItem Value="TodoXAccountStatus.Active">Hoạt động</MudSelectItem>
                    <MudSelectItem Value="TodoXAccountStatus.Pending">Chờ duyệt</MudSelectItem>
                    <MudSelectItem Value="TodoXAccountStatus.Locked">Đã khóa</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (SegmentEnabled)
            {
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Loại khách" @bind-Value="_model.Segment" Variant="Variant.Outlined">
                        @foreach (var segment in TodoX.Web.Services.Studio.CustomerSegments.All)
                        {
                            <MudSelectItem Value="@segment">@TodoX.Web.Services.Studio.CustomerSegments.Label(segment)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12">
                <MudTextField T="string" Label="Địa chỉ" @bind-Value="_model.Address" Variant="Variant.Outlined" Lines="2" />
            </MudItem>
            @if (_isNew)
            {
                <MudItem xs="12">
                    <MudCheckBox T="bool" @bind-Value="_model.CreateLogin" Label="Tạo tài khoản đăng nhập cho khách" Color="Color.Warning" />
                </MudItem>
                @if (_model.CreateLogin)
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Tên đăng nhập" Value="_model.LoginUsername" ValueChanged="OnUsernameChanged"
                                      Variant="Variant.Outlined" autocomplete="off"
                                      HelperText="Tự đặt theo tên thương hiệu; trùng thì thêm số." />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" Label="Mật khẩu" @bind-Value="_model.LoginPassword" Variant="Variant.Outlined"
                                      autocomplete="new-password" HelperText="Mật khẩu tạo sẵn – gửi cho khách cùng tên đăng nhập."
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Refresh" OnAdornmentClick="NewPassword" />
                    </MudItem>
                }
            }
            @if (AffiliateEnabled)
            {
                <MudItem xs="12" sm="6">
                    <MudCheckBox T="bool" @bind-Value="_model.IsAgent" Label="Là đại lý" Color="Color.Warning" />
                    @if (!string.IsNullOrWhiteSpace(_model.AgentCode))
                    {
                        <MudText Typo="Typo.body2">Mã đại lý: <span class="todox-badge">@_model.AgentCode</span></MudText>
                    }
                    else if (_model.IsAgent)
                    {
                        <MudText Typo="Typo.caption" Class="todox-page-subtitle">Mã đại lý sẽ được tạo tự động khi lưu.</MudText>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="Mã đại lý giới thiệu" @bind-Value="_model.ReferralCode" Variant="Variant.Outlined"
                                  HelperText="@(string.IsNullOrWhiteSpace(_model.ReferredByAgentName) ? "Để trống nếu không có đại lý" : $"Đại lý: {_model.ReferredByAgentName}")" />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Class="todox-primary-btn" OnClick="Submit">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public CustomerProfile? Source { get; set; }

    /// <summary>Hiện phần đại lý khi DB đã có schema affiliate.</summary>
    [Parameter] public bool AffiliateEnabled { get; set; }

    /// <summary>Hiện ô "Loại khách" khi DB đã có studio.customer_profiles.</summary>
    [Parameter] public bool SegmentEnabled { get; set; }

    private CustomerProfile _model = new();
    private bool _isNew;

    protected override void OnInitialized()
    {
        _isNew = Source is null;
        _model = Source is null
            ? new CustomerProfile { Id = Guid.Empty, Status = TodoXAccountStatus.Active, CreateLogin = true, LoginPassword = TodoX.Web.Services.CustomerLoginNames.NewPassword() }
            : new CustomerProfile
            {
                Id = Source.Id,
                CustomerCode = Source.CustomerCode,
                CompanyName = Source.CompanyName,
                ContactName = Source.ContactName,
                Email = Source.Email,
                Phone = Source.Phone,
                TaxCode = Source.TaxCode,
                Address = Source.Address,
                Status = Source.Status,
                CreatedAt = Source.CreatedAt,
                IsAgent = Source.IsAgent,
                AgentCode = Source.AgentCode,
                ReferralCode = Source.ReferralCode,
                ReferredByAgentName = Source.ReferredByAgentName,
                Segment = Source.Segment
            };
    }

    private bool _usernameEdited;

    private void OnBrandChanged(string? value)
    {
        _model.CompanyName = value ?? string.Empty;
        if (_isNew && !_usernameEdited)
        {
            _model.LoginUsername = TodoX.Web.Services.CustomerLoginNames.FromBrand(_model.CompanyName);
        }
    }

    private void OnUsernameChanged(string? value)
    {
        _model.LoginUsername = (value ?? string.Empty).Trim().ToLowerInvariant();
        _usernameEdited = _model.LoginUsername.Length > 0;
    }

    private void NewPassword() => _model.LoginPassword = TodoX.Web.Services.CustomerLoginNames.NewPassword();

    private void Submit() => MudDialog.Close(DialogResult.Ok(_model));
    private void Cancel() => MudDialog.Cancel();
}
