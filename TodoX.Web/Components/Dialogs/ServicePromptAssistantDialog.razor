@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using TodoX.Web.Models
@using TodoX.Web.Services.PromptAssistant
@inject IServicePromptAssistantService AssistantService
@inject AuthStateService AuthState
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IOptions<ServicePromptAssistantOptions> PromptAssistantOptions
@inject PromptAgentAuditService AgentAudit

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Prompt Assistant - @Service.ServiceName</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
        }
        else
        {
            <MudTabs KeepPanelsAlive="true">
                <MudTabPanel Text="Configuration">
                    <MudGrid Class="pa-2">
                        <MudItem xs="12" sm="6">
                            <MudSwitch T="bool" @bind-Value="_enabled" Color="Color.Warning" Label="Enabled" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Value="_provider" Label="Provider" Variant="Variant.Outlined" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="_model" Label="Model" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="int?" @bind-Value="_gommoAgentId" Label="Agent ID" Variant="Variant.Outlined" Min="1" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="_gommoAgentIdBase" Label="Agent ID Base" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal?" @bind-Value="_temperature" Label="Temperature (0-2)" Variant="Variant.Outlined" Min="0" Max="2" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="int?" @bind-Value="_maxTokens" Label="Max tokens" Variant="Variant.Outlined" Min="1" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption">Connection: @_connectionStatus</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.CloudDone" OnClick="TestConnectionAsync" Disabled="_busy">
                                Test Connection
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAssistantAsync">
                                Save configuration
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                @* Legacy training management is retained in backend/data and hidden for Phase 1. *@
                @* <MudTabPanel Text="Training versions">
                    <MudStack Spacing="2" Class="pa-2">
                        <MudText Typo="Typo.subtitle2">Published: @PublishedVersionLabel</MudText>
                        <MudText Typo="Typo.subtitle2">Draft: @DraftVersionLabel</MudText>
                        <MudTextField T="string" @bind-Value="_versionName" Label="Draft version name" Variant="Variant.Outlined" />
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap gap-2">
                            <label class="profile-avatar-upload">
                                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" />
                                <span>Upload JSON template</span>
                                <InputFile OnChange="UploadTemplateAsync" accept=".json,application/json" />
                            </label>
                            <label class="profile-avatar-upload">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                                <span>Upload description</span>
                                <InputFile OnChange="UploadDescriptionAsync" accept=".txt,.md,.json,text/plain,text/markdown,application/json" />
                            </label>
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(_templateFileName))
                        {
                            <MudText Typo="Typo.caption">Template: @_templateFileName</MudText>
                            <MudTextField T="string" Value="_templateJson" Label="Template preview (read-only)" Variant="Variant.Outlined" Lines="8" ReadOnly="true" />
                        }
                        @if (!string.IsNullOrWhiteSpace(_descriptionFileName))
                        {
                            <MudText Typo="Typo.caption">Description: @_descriptionFileName</MudText>
                            <MudTextField T="string" Value="_description" Label="Description preview (read-only)" Variant="Variant.Outlined" Lines="6" ReadOnly="true" />
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveDraftAsync">
                            Save draft
                        </MudButton>
                        <MudTable Items="_versions" Dense="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Version</MudTh><MudTh>Name</MudTh><MudTh>Status</MudTh><MudTh>Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Version">@context.VersionNo</MudTd>
                                <MudTd DataLabel="Name">@context.VersionName</MudTd>
                                <MudTd DataLabel="Status">@context.Status.ToString().ToUpperInvariant()</MudTd>
                                <MudTd DataLabel="Actions">
                                    @if (context.Status == ServicePromptTrainingStatus.Draft)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Publish" title="Publish draft" OnClick="@(() => PublishAsync(context.Id))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Archive" title="Archive draft" OnClick="@(() => ArchiveAsync(context.Id))" />
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudStack>
                </MudTabPanel> *@

                <MudTabPanel Text="Chạy thử & kiểm tra">
                    <MudStack Spacing="2" Class="pa-2">
                        <MudText Typo="Typo.body2">
                            Chạy agent với đúng lời nhắn mà job video thật gửi: xem prompt agent trả về và kết quả đối chiếu với chuẩn kịch bản TodoX
                            (thời lượng scene, prompt ảnh, mô tả chuyển động, lời đọc, tốc độ đọc). Nên chạy mỗi khi đổi agent
                            và trước khi mở dịch vụ cho khách. Một lần chạy có thể mất vài phút và tốn credit của agent.
                        </MudText>
                        @if (_audit is not null && _assistantDto is not null && _audit.IsStaleFor(_assistantDto))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">Cấu hình agent đã đổi sau lần kiểm tra này. Hãy kiểm tra lại.</MudAlert>
                        }
                        <MudTextField T="string" @bind-Value="_auditInput" Label="Nội dung video mẫu (để trống = dùng đoạn mẫu có sẵn)" Variant="Variant.Outlined" Lines="4" Disabled="_auditing" />
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="gap-2 flex-wrap">
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.FactCheck" Disabled="@_auditing" OnClick="RunAuditAsync">
                                @(_auditing ? "Đang chạy..." : "Chạy thử & kiểm tra")
                            </MudButton>
                            @if (_audit is not null)
                            {
                                <MudText Typo="Typo.caption">Lần kiểm tra: @_audit.CheckedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @_audit.CheckedBy · model @_audit.ModelCode · agent @_audit.AgentId</MudText>
                            }
                        </MudStack>
                        @if (_auditing)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                        }
                        @if (_audit is not null)
                        {
                            <MudAlert Severity="@AuditSeverity(_audit.Status)">
                                <b>@PromptAgentAuditStatuses.Label(_audit.Status)</b>
                                @if (_audit.SceneCount > 0)
                                {
                                    <span> · @_audit.SceneCount scene @(_audit.TotalSeconds is int sec ? $"· {sec} giây" : "")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(_audit.Error))
                                {
                                    <div>@_audit.Error</div>
                                }
                                <div>@AuditAdvice(_audit.Status)</div>
                            </MudAlert>
                            @if (_audit.Checks.Count > 0)
                            {
                                <MudSimpleTable Dense="true" Hover="true">
                                    <thead><tr><th>Yêu cầu</th><th>Kết quả</th><th>Chi tiết</th></tr></thead>
                                    <tbody>
                                        @foreach (var check in _audit.Checks)
                                        {
                                            <tr>
                                                <td>@check.Label</td>
                                                <td><MudChip T="string" Size="Size.Small" Color="@CheckColor(check.Status)">@CheckLabel(check.Status)</MudChip></td>
                                                <td>@check.Detail</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        }
                        @if (_lastResult is not null)
                        {
                            <MudText Typo="Typo.caption">
                                Agent ID: @_gommoAgentId | Agent ID Base: @_gommoAgentIdBase |
                                Configured model: @_lastResult.ModelCode | Runtime provider: @_lastResult.RuntimeProvider |
                                Repair attempts: @_lastResult.RepairAttemptCount |
                                Prompt tokens: @_lastResult.PromptTokens |
                                Output tokens: @_lastResult.OutputTokens |
                                Total tokens: @_lastResult.TotalTokens |
                                Credit: @_lastResult.Credit |
                                First event: @_lastResult.FirstEventMs ms |
                                First content: @_lastResult.FirstContentMs ms |
                                Total: @_lastResult.Latency.TotalMilliseconds.ToString("0") ms |
                                Streaming: @_lastResult.StreamingDurationMs ms
                            </MudText>
                            @if (_lastResult.GeneratedJson is not null)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.subtitle2">Prompt agent trả về</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy JSON" OnClick="CopyJsonAsync" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" title="Download JSON" OnClick="DownloadJsonAsync" />
                                </MudStack>
                                <MudTextField T="string" Value="_lastResult.GeneratedJson" Label="Generated JSON" Variant="Variant.Outlined" Lines="12" ReadOnly="true" />
                            }
                            @foreach (var error in _lastResult.ValidationErrors)
                            {
                                <MudText Color="Color.Error" Typo="Typo.caption">@error.Path - @error.Code - @error.Message</MudText>
                            }
                        }
                    </MudStack>
                </MudTabPanel>


                <MudTabPanel Text="History">
                    <MudTable Items="_generations" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Created</MudTh><MudTh>Status</MudTh><MudTh>Validation</MudTh><MudTh>Provider</MudTh><MudTh>Total tokens</MudTh><MudTh>Duration</MudTh><MudTh>Credit</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                            <MudTd DataLabel="Status">@context.Status</MudTd>
                            <MudTd DataLabel="Validation">@(context.ValidationPassed ? "PASS" : "FAIL")</MudTd>
                            <MudTd DataLabel="Repair">@context.RepairAttemptCount</MudTd>
                            <MudTd DataLabel="Total tokens">@context.TotalTokens</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ServiceDto Service { get; set; } = new();

    private bool _loading = true;
    private bool _busy;
    private bool _enabled;
    private string _provider = "gommo_agent";
    private string _model = string.Empty;
    private int? _gommoAgentId;
    private string _gommoAgentIdBase = string.Empty;
    private string _connectionStatus = "Not configured";
    private decimal? _temperature;
    private int? _maxTokens;
    private int _maxRepairAttempts = 1;
    private string _versionName = string.Empty;
    private string _templateFileName = string.Empty;
    private string _templateJson = string.Empty;
    private string _descriptionFileName = string.Empty;
    private string _description = string.Empty;
    private IReadOnlyList<ServicePromptTrainingVersionDto> _versions = [];
    private IReadOnlyList<ServicePromptGenerationDto> _generations = [];
    private ServicePromptGenerationResult? _lastResult;
    private PromptAgentAuditReport? _audit;
    private ServicePromptAssistantDto? _assistantDto;
    private string _auditInput = string.Empty;
    private bool _auditing;

    private async Task RunAuditAsync()
    {
        if (_auditing) return;
        _auditing = true;
        try
        {
            var run = await AgentAudit.RunAsync(Service.Id, _auditInput, AuthState.CurrentUser);
            _audit = run.Report;
            _lastResult = run.Generation;
            var workspace = await AssistantService.LoadWorkspaceAsync(Service.Id);
            _assistantDto = workspace.Assistant;
            _generations = workspace.Generations;
            Snackbar.Add(PromptAgentAuditStatuses.Label(_audit.Status), AuditSeverity(_audit.Status));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không kiểm tra được agent: {ex.Message}", Severity.Error);
        }
        finally
        {
            _auditing = false;
        }
    }

    private static Severity AuditSeverity(string status) => status switch
    {
        PromptAgentAuditStatuses.Pass => Severity.Success,
        PromptAgentAuditStatuses.Fixed => Severity.Warning,
        _ => Severity.Error
    };

    private static string AuditAdvice(string status) => status switch
    {
        PromptAgentAuditStatuses.Pass => "Có thể mở dịch vụ cho khách.",
        PromptAgentAuditStatuses.Fixed => "Job vẫn chạy được vì TodoX tự bổ sung các mục màu vàng, nhưng chất lượng tốt hơn nếu agent tự trả đủ. Nên sửa hướng dẫn của agent (trên 79AI) theo các mục này.",
        PromptAgentAuditStatuses.Fail => "Job của khách sẽ báo 'Tạo prompt thất bại'. Sửa agent theo các mục màu đỏ rồi kiểm tra lại trước khi mở dịch vụ.",
        _ => "Kiểm tra cấu hình kết nối agent (Agent ID, Agent ID Base, Enabled) rồi chạy lại."
    };

    private static Color CheckColor(string status) => status switch
    {
        PromptAgentAuditCheckStatuses.Ok => Color.Success,
        PromptAgentAuditCheckStatuses.Fixed => Color.Warning,
        _ => Color.Error
    };

    private static string CheckLabel(string status) => status switch
    {
        PromptAgentAuditCheckStatuses.Ok => "Đạt",
        PromptAgentAuditCheckStatuses.Fixed => "TodoX tự bổ sung",
        _ => "Thiếu"
    };

    private ServicePromptTrainingVersionDto? PublishedVersion
        => _versions.FirstOrDefault(x => x.Status == ServicePromptTrainingStatus.Published);
    private ServicePromptTrainingVersionDto? DraftVersion
        => _versions.FirstOrDefault(x => x.Status == ServicePromptTrainingStatus.Draft);
    private string PublishedVersionLabel => PublishedVersion is null ? "None" : $"v{PublishedVersion.VersionNo} - {PublishedVersion.VersionName}";
    private string DraftVersionLabel => DraftVersion is null ? "None" : $"v{DraftVersion.VersionNo} - {DraftVersion.VersionName}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var workspace = await AssistantService.LoadWorkspaceAsync(Service.Id);
            ApplyWorkspace(workspace);
            _assistantDto = workspace.Assistant;
            _audit = await AgentAudit.GetAsync(Service.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not load Prompt Assistant: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyWorkspace(ServicePromptAssistantWorkspace workspace)
    {
        _enabled = workspace.Assistant.Enabled;
        _provider = workspace.Assistant.ProviderCode;
        _model = workspace.Assistant.ModelCode;
        _gommoAgentId = workspace.Assistant.GommoAgentId;
        _gommoAgentIdBase = workspace.Assistant.GommoAgentIdBase;
        _connectionStatus = _gommoAgentId is > 0 && !string.IsNullOrWhiteSpace(_gommoAgentIdBase) ? "Configured" : "Not configured";
        _temperature = workspace.Assistant.Temperature;
        _maxTokens = workspace.Assistant.MaxTokens;
        _maxRepairAttempts = workspace.Assistant.MaxRepairAttempts;
        _versions = workspace.TrainingVersions;
        _generations = workspace.Generations;
    }

    private async Task SaveAssistantAsync()
    {
        try
        {
            await AssistantService.SaveAssistantAsync(new(
                Service.Id, _enabled, "gommo_agent", _model, _gommoAgentId, _gommoAgentIdBase, _temperature, _maxTokens, _maxRepairAttempts));
            _connectionStatus = "Configured";
            Snackbar.Add("Prompt Assistant configuration saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save configuration: {ex.Message}", Severity.Error);
        }
    }

    private async Task TestConnectionAsync()
    {
        _busy = true;
        try
        {
            await AssistantService.SaveAssistantAsync(new(
                Service.Id, _enabled, "gommo_agent", _model, _gommoAgentId, _gommoAgentIdBase, _temperature, _maxTokens, _maxRepairAttempts));
            await AssistantService.TestConnectionAsync(Service.Id);
            _connectionStatus = "Test Passed";
            Snackbar.Add("Gommo Agent connection passed.", Severity.Success);
        }
        catch (Exception ex)
        {
            _connectionStatus = "Test Failed";
            Snackbar.Add($"Gommo Agent connection failed: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task UploadTemplateAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null || !string.Equals(Path.GetExtension(file.Name), ".json", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Template must be a .json file.", Severity.Error);
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(PromptAssistantOptions.Value.TemplateLimit);
            using var reader = new StreamReader(stream);
            using var document = System.Text.Json.JsonDocument.Parse(await reader.ReadToEndAsync());
            if (document.RootElement.ValueKind is not (System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array))
            {
                throw new InvalidOperationException("JSON root must be an object or array.");
            }

            _templateFileName = file.Name;
            _templateJson = System.Text.Json.JsonSerializer.Serialize(document.RootElement, ServicePromptJson.Options);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Invalid template: {ex.Message}", Severity.Error);
        }
    }

    private async Task UploadDescriptionAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        var extension = file is null ? string.Empty : Path.GetExtension(file.Name);
        if (file is null || !new[] { ".txt", ".md", ".json" }.Contains(extension, StringComparer.OrdinalIgnoreCase))
        {
            Snackbar.Add("Description must be .txt, .md, or .json.", Severity.Error);
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(PromptAssistantOptions.Value.DescriptionLimit);
            using var reader = new StreamReader(stream);
            var description = await reader.ReadToEndAsync();
            if (string.IsNullOrWhiteSpace(description))
            {
                throw new InvalidOperationException("Description cannot be empty.");
            }

            _descriptionFileName = file.Name;
            _description = description;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not read description: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveDraftAsync()
    {
        try
        {
            await AssistantService.SaveTrainingDraftAsync(
                new(Service.Id, _versionName, _templateFileName, _templateJson, _descriptionFileName, _description),
                AuthState.CurrentUser);
            Snackbar.Add("Training draft saved.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save draft: {ex.Message}", Severity.Error);
        }
    }

    private async Task PublishAsync(Guid id)
    {
        try
        {
            await AssistantService.PublishAsync(Service.Id, id);
            Snackbar.Add("Training version published.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not publish version: {ex.Message}", Severity.Error);
        }
    }

    private async Task ArchiveAsync(Guid id)
    {
        try
        {
            await AssistantService.ArchiveAsync(Service.Id, id);
            Snackbar.Add("Training version archived.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not archive version: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        ApplyWorkspace(await AssistantService.LoadWorkspaceAsync(Service.Id));
    }

    private async Task CopyJsonAsync()
    {
        if (_lastResult?.GeneratedJson is not null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _lastResult.GeneratedJson);
            Snackbar.Add("JSON copied.", Severity.Success);
        }
    }

    private async Task DownloadJsonAsync()
    {
        if (_lastResult?.GeneratedJson is null) return;
        await JS.InvokeVoidAsync("todoxDownload.saveTextFile", $"prompt-{_lastResult.GenerationId}.json", _lastResult.GeneratedJson);
    }

    private void Cancel() => MudDialog.Cancel();
}
