@using TodoX.Web.Services.PromptAssistant
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100">
            <MudText Typo="Typo.h6">Prompt Generated Successfully</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" aria-label="Đóng" />
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudGrid>
                <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">Title</MudText><MudText>@Title</MudText></MudItem>
                <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">Duration</MudText><MudText>@DurationSeconds s</MudText></MudItem>
                <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">Scenes</MudText><MudText>@SceneCount</MudText></MudItem>
            </MudGrid>
            <MudPaper Class="pa-3" Outlined="true">
                <MudText Typo="Typo.subtitle2">Metrics</MudText>
                <MudText Typo="Typo.caption">Tokens: @Metrics?.TotalTokens | Duration: @Metrics?.TotalDurationMs ms</MudText>
            </MudPaper>
            @if (_showPrompt)
            {
                <MudTextField T="string" Value="@PromptJson" Label="Generated JSON" Variant="Variant.Outlined" Lines="16" ReadOnly="true" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Visibility" OnClick="ViewPrompt">Xem Prompt</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyPrompt">Copy JSON</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadPrompt">Download JSON</MudButton>
        <MudButton OnClick="Close">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid GenerationId { get; set; }
    [Parameter] public string PromptJson { get; set; } = string.Empty;
    [Parameter] public string? Title { get; set; }
    [Parameter] public int? DurationSeconds { get; set; }
    [Parameter] public int SceneCount { get; set; }
    [Parameter] public PromptAssistantGenerateMetrics? Metrics { get; set; }

    private Task ViewPrompt()
    {
        _showPrompt = true;
        return Task.CompletedTask;
    }

    private bool _showPrompt;

    private async Task CopyPrompt()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", PromptJson);
    }

    private async Task DownloadPrompt()
    {
        await JS.InvokeVoidAsync("todoxDownload.saveTextFile", $"prompt-{GenerationId}.json", PromptJson);
    }

    private void Close() => MudDialog.Close();
}
