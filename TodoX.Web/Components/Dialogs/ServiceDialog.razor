@using TodoX.Web.Services
@using TodoX.Web.Models.Catalog
@using TodoX.Web.Models
@inject SystemImageStorage SystemImageStorage
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "Thêm dịch vụ" : "Chỉnh sửa dịch vụ")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField T="string"
                              Label="Mã dịch vụ"
                              @bind-Value="_model.ServiceCode"
                              Variant="Variant.Outlined"
                              Required="true"
                              ReadOnly="@(!_isNew)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="Engine" @bind-Value="_model.ServiceType" Variant="Variant.Outlined" Required="true">
                    @foreach (var engine in TodoXServiceEngineTypes.All)
                    {
                        <MudSelectItem T="string" Value="@engine.Value">@engine.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" Label="Nhóm dịch vụ" @bind-Value="_model.CategoryId" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var c in Categories)
                    {
                        <MudSelectItem T="Guid?" Value="@c.Id">@c.CategoryName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Tên dịch vụ" @bind-Value="_model.ServiceName" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Mô tả ngắn" @bind-Value="_model.ShortDescription" Variant="Variant.Outlined" Lines="2" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Mô tả chi tiết" @bind-Value="_model.Description" Variant="Variant.Outlined" Lines="4" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="Trạng thái" @bind-Value="_model.Status" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@TodoXServiceStatuses.Active">Hoạt động</MudSelectItem>
                    <MudSelectItem T="string" Value="@TodoXServiceStatuses.Inactive">Tạm ngưng</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int" Label="Thứ tự hiển thị" @bind-Value="_model.SortOrder" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Thumbnail URL" @bind-Value="_model.ThumbnailUrl" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Cover image URL" @bind-Value="_model.CoverImageUrl" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudPaper Class="service-thumbnail-tool pa-3" rounded="true">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3" Class="flex-wrap">
                            <div class="service-thumbnail-preview">
                                @if (!string.IsNullOrWhiteSpace(_model.ThumbnailUrl))
                                {
                                    <img src="@_model.ThumbnailUrl" alt="Thumbnail dịch vụ" />
                                }
                                else
                                {
                                    <div class="todox-mr-avatar-empty">
                                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
                                        <span>Chưa có thumbnail</span>
                                    </div>
                                }
                            </div>
                            <MudStack Spacing="2" Class="service-thumbnail-fields">
                                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                                    <label class="@($"profile-avatar-upload {(_thumbnailBusy ? "is-disabled" : string.Empty)}")">
                                        <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Small" />
                                        <span>Upload thumbnail</span>
                                        <InputFile OnChange="UploadThumbnail" accept="image/png,image/jpeg,image/webp" disabled="@_thumbnailBusy" />
                                    </label>
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Warning"
                                               StartIcon="@Icons.Material.Filled.AutoAwesome"
                                               Disabled="@_thumbnailBusy"
                                               OnClick="OpenIllustrationDialog">
                                        Tạo ảnh minh họa
                                    </MudButton>
                                </MudStack>
                                @if (_thumbnailBusy)
                                {
                                    <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                                }
                            </MudStack>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12">
                <MudExpansionPanels Elevation="0" Class="mt-2">
                    <MudExpansionPanel Text="Nâng cao">
                        <MudTextField T="string" Label="Workflow reference" @bind-Value="_model.WorkflowCode" Variant="Variant.Outlined" />
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="Cấu hình mặc định khi tạo job">
                        @if (IsRVideo)
                        {
                            <MudGrid>
                                <MudItem xs="12" sm="6"><MudSelect T="string" Label="Aspect ratio" @bind-Value="_defaults.AspectRatio" Variant="Variant.Outlined" Clearable="true"><MudSelectItem T="string" Value="@("9:16")">9:16</MudSelectItem><MudSelectItem T="string" Value="@("16:9")">16:9</MudSelectItem></MudSelect></MudItem>
                                <MudItem xs="12" sm="6"><MudSelect T="string" Label="Resolution" @bind-Value="_defaults.Resolution" Variant="Variant.Outlined" Clearable="true"><MudSelectItem T="string" Value="@("720p")">720p</MudSelectItem><MudSelectItem T="string" Value="@("1080p")">1080p</MudSelectItem><MudSelectItem T="string" Value="@("4K")">4K</MudSelectItem></MudSelect></MudItem>
                                <MudItem xs="12" sm="4"><MudNumericField T="int?" Label="Total seconds" @bind-Value="_defaults.TotalSeconds" Variant="Variant.Outlined" Min="1" /></MudItem>
                                <MudItem xs="12" sm="4"><MudNumericField T="int?" Label="Scene seconds" @bind-Value="_defaults.SceneSeconds" Variant="Variant.Outlined" Min="1" /></MudItem>
                                <MudItem xs="12" sm="4"><MudSelect T="string" Label="Execution mode" @bind-Value="_defaults.ExecutionMode" Variant="Variant.Outlined" Clearable="true"><MudSelectItem T="string" Value="@RVideoExecutionModes.Manual">manual</MudSelectItem><MudSelectItem T="string" Value="@RVideoExecutionModes.Auto">auto</MudSelectItem></MudSelect></MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="string" Label="Nhân vật tham chiếu mặc định" @bind-Value="_defaults.CharacterMode" Variant="Variant.Outlined" Clearable="true">
                                        <MudSelectItem T="string" Value="@("none")">Không sử dụng nhân vật</MudSelectItem>
                                        <MudSelectItem T="string" Value="@RVideoCharacterModes.Upload">Upload hình ảnh</MudSelectItem>
                                        <MudSelectItem T="string" Value="@RVideoCharacterModes.Library">Chọn từ Character Library</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12"><MudCheckBox @bind-Value="_defaults.UseReferenceImageForAllScenes" Label="Giữ nguyên hình ảnh tham khảo cho mọi scene" /></MudItem>
                                <MudItem xs="12" sm="4"><MudSelect T="string" Label="Voice mode" @bind-Value="_defaults.VoiceMode" Variant="Variant.Outlined" Clearable="true"><MudSelectItem T="string" Value="@RVideoVoiceModes.None">none</MudSelectItem><MudSelectItem T="string" Value="@RVideoVoiceModes.Native">native</MudSelectItem><MudSelectItem T="string" Value="@RVideoVoiceModes.Library">library</MudSelectItem></MudSelect></MudItem>
                                <MudItem xs="12" sm="4"><MudTextField T="string" Label="Voice catalog" @bind-Value="_defaults.VoiceCatalogCode" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="12" sm="4"><MudNumericField T="decimal?" Label="Voice volume" @bind-Value="_defaults.VoiceVolume" Variant="Variant.Outlined" Min="0m" Max="1m" Step="0.05m" /></MudItem>
                                <MudItem xs="12" sm="4"><MudNumericField T="decimal?" Label="TTS rate" @bind-Value="_defaults.DefaultTtsRate" Variant="Variant.Outlined" Min="0.1m" Max="4m" Step="0.05m" /></MudItem>
                                <MudItem xs="12" sm="4"><MudSelect T="string" Label="Music mode" @bind-Value="_defaults.MusicMode" Variant="Variant.Outlined" Clearable="true"><MudSelectItem T="string" Value="@RVideoMusicModes.None">none</MudSelectItem><MudSelectItem T="string" Value="@RVideoMusicModes.Library">library</MudSelectItem><MudSelectItem T="string" Value="@RVideoMusicModes.Upload">upload</MudSelectItem></MudSelect></MudItem>
                                <MudItem xs="12" sm="4"><MudTextField T="string" Label="Music catalog" @bind-Value="_defaults.MusicCatalogCode" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="12" sm="4"><MudNumericField T="decimal?" Label="Music volume" @bind-Value="_defaults.MusicVolume" Variant="Variant.Outlined" Min="0m" Max="1m" Step="0.05m" /></MudItem>
                            </MudGrid>
                        }
                        else if (IsTimelapse)
                        {
                            <MudGrid>
                                <MudItem xs="12" sm="6"><MudTextField T="string" Label="Profile code" @bind-Value="_defaults.ProfileCode" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="12" sm="6"><MudSelect T="string" Label="Ratio" @bind-Value="_defaults.Ratio" Variant="Variant.Outlined" Clearable="true"><MudSelectItem T="string" Value="@("16_9")">16_9</MudSelectItem><MudSelectItem T="string" Value="@("9_16")">9_16</MudSelectItem></MudSelect></MudItem>
                                <MudItem xs="12" sm="4"><MudNumericField T="int?" Label="Scene count" @bind-Value="_defaults.SceneCount" Variant="Variant.Outlined" Min="3" Max="6" /></MudItem>
                                <MudItem xs="12" sm="4"><MudSelect T="string" Label="Video mode" @bind-Value="_defaults.VideoMode" Variant="Variant.Outlined" Clearable="true"><MudSelectItem T="string" Value="@("fast")">fast</MudSelectItem><MudSelectItem T="string" Value="@("professional")">professional</MudSelectItem></MudSelect></MudItem>
                                <MudItem xs="12" sm="4"><MudCheckBox @bind-Value="_defaults.AutoFinish" Label="Auto finish" /></MudItem>
                            </MudGrid>
                        }
                        else if (IsRDance)
                        {
                            <MudGrid>
                                <MudItem xs="12" sm="6"><MudTextField T="string" Label="Model mode" @bind-Value="_defaults.ModelMode" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="12" sm="6"><MudTextField T="string" Label="Character/product mode" @bind-Value="_defaults.CharacterProductMode" Variant="Variant.Outlined" /></MudItem>
                            </MudGrid>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Class="todox-primary-btn" OnClick="Submit">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ServiceDto? Source { get; set; }
    [Parameter] public IReadOnlyList<ServiceCategoryDto> Categories { get; set; } = new List<ServiceCategoryDto>();

    private ServiceDto _model = new();
    private bool _isNew;
    private bool _thumbnailBusy;
    private ServiceJobDefaults _defaults = new();

    protected override void OnInitialized()
    {
        _isNew = Source is null;
        _model = Source is null
            ? new ServiceDto { Status = TodoXServiceStatuses.Active, SortOrder = 0, ServiceType = TodoXServiceEngineTypes.Timelapse }
            : new ServiceDto
            {
                Id = Source.Id,
                CategoryId = Source.CategoryId,
                CategoryName = Source.CategoryName,
                ServiceCode = Source.ServiceCode,
                ServiceName = Source.ServiceName,
                ServiceType = Source.ServiceType,
                Description = Source.Description,
                ShortDescription = Source.ShortDescription,
                ThumbnailUrl = Source.ThumbnailUrl,
                CoverImageUrl = Source.CoverImageUrl,
                WorkflowCode = Source.WorkflowCode,
                Status = TodoXServiceStatuses.Normalize(Source.Status),
                SortOrder = Source.SortOrder,
                JobDefaultsJson = Source.JobDefaultsJson
            };

        _defaults = ServiceJobDefaultsCodec.FromJson(_model.JobDefaultsJson);
    }

    private async Task UploadThumbnail(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        _thumbnailBusy = true;
        try
        {
            var url = await SystemImageStorage.SaveServiceThumbnailAsync(file);
            _model.ThumbnailUrl = url;
            Snackbar.Add("Đã upload thumbnail dịch vụ.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload thumbnail lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _thumbnailBusy = false;
        }
    }

    private async Task OpenIllustrationDialog()
    {
        var parameters = new DialogParameters
        {
            ["ServiceId"] = _model.Id == Guid.Empty ? null : _model.Id,
            ["ServiceCode"] = _model.ServiceCode,
            ["ServiceName"] = _model.ServiceName,
            ["ServiceGroupName"] = SelectedCategoryName,
            ["ServiceType"] = _model.ServiceType,
            ["ShortDescription"] = _model.ShortDescription,
            ["Description"] = _model.Description,
            ["CurrentThumbnailUrl"] = _model.ThumbnailUrl
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<ServiceIllustrationRenderDialog>(
            "Tạo ảnh minh họa dịch vụ",
            parameters,
            options);

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ServiceIllustrationDialogValue value)
        {
            return;
        }

        _model.ThumbnailUrl = value.SelectedImageUrl;
        StateHasChanged();
    }

    private string? SelectedCategoryName => Categories.FirstOrDefault(x => x.Id == _model.CategoryId)?.CategoryName ?? _model.CategoryName;

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_model.ServiceCode) || string.IsNullOrWhiteSpace(_model.ServiceName))
        {
            return;
        }

        _model.JobDefaultsJson = ServiceJobDefaultsCodec.ToJson(NormalizeDefaults());
        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();

    private bool IsRVideo => string.Equals(_model.ServiceType, TodoXServiceEngineTypes.RVideo, StringComparison.OrdinalIgnoreCase);
    private bool IsTimelapse => string.Equals(_model.ServiceType, TodoXServiceEngineTypes.Timelapse, StringComparison.OrdinalIgnoreCase);
    private bool IsRDance => string.Equals(_model.ServiceType, TodoXServiceEngineTypes.RDance, StringComparison.OrdinalIgnoreCase);

    private ServiceJobDefaults NormalizeDefaults()
    {
        return new ServiceJobDefaults
        {
            Version = Math.Max(1, _defaults.Version),
            AspectRatio = NormalizeText(_defaults.AspectRatio),
            Resolution = NormalizeText(_defaults.Resolution),
            TotalSeconds = NormalizePositiveInt(_defaults.TotalSeconds),
            SceneSeconds = NormalizePositiveInt(_defaults.SceneSeconds),
            ExecutionMode = NormalizeExecutionMode(_defaults.ExecutionMode),
            CharacterMode = NormalizeCharacterMode(_defaults.CharacterMode),
            UseReferenceImageForAllScenes = _defaults.UseReferenceImageForAllScenes,
            VoiceMode = NormalizeText(_defaults.VoiceMode),
            VoiceCatalogCode = NormalizeText(_defaults.VoiceCatalogCode),
            VoiceVolume = NormalizeVolume(_defaults.VoiceVolume),
            DefaultTtsRate = NormalizePositiveDecimal(_defaults.DefaultTtsRate),
            MusicMode = NormalizeText(_defaults.MusicMode),
            MusicCatalogCode = NormalizeText(_defaults.MusicCatalogCode),
            MusicVolume = NormalizeVolume(_defaults.MusicVolume),
            ProfileCode = NormalizeText(_defaults.ProfileCode),
            SceneCount = NormalizePositiveInt(_defaults.SceneCount),
            VideoMode = NormalizeText(_defaults.VideoMode),
            Ratio = NormalizeText(_defaults.Ratio),
            RequireVideoConfirmation = _defaults.RequireVideoConfirmation,
            AutoFinish = _defaults.AutoFinish,
            ModelMode = NormalizeText(_defaults.ModelMode),
            CharacterProductMode = NormalizeText(_defaults.CharacterProductMode)
        };
    }

    private static string? NormalizeText(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static int? NormalizePositiveInt(int? value)
        => value is > 0 ? value : null;

    private static decimal? NormalizePositiveDecimal(decimal? value)
        => value is > 0m ? value : null;

    private static decimal? NormalizeVolume(decimal? value)
        => value is >= 0m and <= 1m ? value : null;

    private static string? NormalizeExecutionMode(string? value)
        => string.Equals(value, RVideoExecutionModes.Auto, StringComparison.OrdinalIgnoreCase)
            ? RVideoExecutionModes.Auto
            : string.Equals(value, RVideoExecutionModes.Manual, StringComparison.OrdinalIgnoreCase)
                ? RVideoExecutionModes.Manual
                : null;

    private static string? NormalizeCharacterMode(string? value)
        => string.Equals(value, "none", StringComparison.OrdinalIgnoreCase)
            ? "none"
            : string.Equals(value, RVideoCharacterModes.Upload, StringComparison.OrdinalIgnoreCase)
                ? RVideoCharacterModes.Upload
                : string.Equals(value, RVideoCharacterModes.Library, StringComparison.OrdinalIgnoreCase)
                    ? RVideoCharacterModes.Library
                    : null;
}
