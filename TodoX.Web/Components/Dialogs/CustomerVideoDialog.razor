@using System.Diagnostics
@using Microsoft.AspNetCore.Components.Forms
@using TodoX.Web.Models
@using TodoX.Web.Services
@using TodoX.Web.Services.CustomerVideos
@using TodoX.Web.Services.Landing
@using TodoX.Web.Services.SharedMedia
@inject CustomerVideoRepository Repository
@inject CustomerVideoMediaService Media
@inject SharedMediaPathService Paths
@inject WalletService Wallets
@inject ISnackbar Snackbar
@inject ILogger<CustomerVideoDialog> Logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "Thêm video cho khách hàng" : "Chỉnh sửa video")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
            @if (!Paths.IsConfigured || !Paths.CanWrite()) { <MudAlert Severity="Severity.Warning">SharedMedia chưa sẵn sàng để upload.</MudAlert> }
            @if (IsNew)
            {
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="CustomerProfile" Label="Tài khoản khách hàng" Value="_customer" ValueChanged="CustomerChangedAsync" SearchFunc="SearchCustomersAsync"
                                         ToStringFunc="CustomerDisplay" Clearable="true" ResetValueOnEmptyText="true" MaxItems="30"
                                         Disabled="_busy" />
                        @if (_customer is not null && _balance is not null)
                        {
                            <MudText Typo="Typo.caption" Class="mt-1 d-block" Color="@(_balance < _points ? Color.Error : Color.Secondary)">Số dư hiện tại: @_balance.Value.ToString("#,0.##") điểm</MudText>
                        }
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudSelect T="string" Label="Loại video" Value="_model.ProductCode" ValueChanged="ProductChanged" Disabled="_busy">
                            @foreach (var product in Products.Where(x => x.IsActive))
                            {
                                <MudSelectItem Value="@product.ProductCode">@product.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="decimal" Label="Trừ điểm" @bind-Value="_points" Min="0" Format="#,0.##" Disabled="_busy"
                                         HelperText="Theo bảng giá, có thể sửa" />
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudText Typo="Typo.body2">
                    Khách hàng: <b>@Source!.CustomerName</b> · @Source.ProductName · @CustomerVideoRules.StatusLabel(Source.ChargeStatus) @Source.ChargedPoints.ToString("#,0.##") điểm
                </MudText>
            }
            <MudTextField T="string" Label="Tiêu đề video" @bind-Value="_model.Title" MaxLength="300" Disabled="_busy" />
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="2">
                        <MudText>Video MP4/WebM (tối đa @(Media.MaxBytes(true) / (1024 * 1024)) MB):</MudText>
                        <InputFile OnChange="@(args => UploadAsync(args, true))" accept=".mp4,.webm,video/mp4,video/webm" disabled="@_busy" />
                        @LibraryButton(true)
                        @if (_uploadingVideo)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">Đang tải lên và tối ưu video cho web (720p), có thể mất 1–2 phút...</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(_model.VideoUrl))
                        {
                            <video src="@_model.VideoUrl" poster="@_model.PosterUrl" controls playsinline preload="metadata" style="max-width:100%;max-height:300px"></video>
                        }
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Spacing="2">
                        <MudText>Ảnh bìa (không bắt buộc, JPG/PNG/WebP):</MudText>
                        <InputFile OnChange="@(args => UploadAsync(args, false))" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" disabled="@_busy" />
                        @LibraryButton(false)
                        @if (!string.IsNullOrWhiteSpace(_model.PosterUrl))
                        {
                            <img src="@_model.PosterUrl" alt="" style="max-width:100%;max-height:200px;object-fit:contain" />
                            <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="_busy" OnClick="@(() => _model.PosterUrl = null)">Bỏ ảnh bìa</MudButton>
                        }
                    </MudStack>
                </MudItem>
            </MudGrid>
            @if (_libraryVideo is { } libraryVideo)
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.subtitle2">Thư viện @(libraryVideo ? "video" : "ảnh bìa") đã tải lên</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudSelect T="string" Value="_librarySource" ValueChanged="@(v => _librarySource = v)" Dense="true" Margin="Margin.Dense" Style="min-width:180px">
                                <MudSelectItem Value="@string.Empty">Tất cả</MudSelectItem>
                                <MudSelectItem Value="@CustomerVideoMediaService.SourceCustomerVideos">@CustomerVideoMediaService.SourceCustomerVideos</MudSelectItem>
                                <MudSelectItem Value="@CustomerVideoMediaService.SourceVideoSamples">@CustomerVideoMediaService.SourceVideoSamples</MudSelectItem>
                            </MudSelect>
                            <MudButton Size="Size.Small" OnClick="@(() => _libraryVideo = null)">Đóng</MudButton>
                        </MudStack>
                    </MudStack>
                    @if (!LibraryFiles.Any())
                    {
                        <MudText Typo="Typo.caption">Chưa có tệp nào trong thư viện.</MudText>
                    }
                    else
                    {
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;max-height:420px;overflow:auto;margin-top:8px">
                            @foreach (var file in LibraryFiles)
                            {
                                var picked = file.Url == (libraryVideo ? _model.VideoUrl : _model.PosterUrl);
                                <div style="border:2px solid @(picked ? "var(--mud-palette-warning)" : "var(--mud-palette-lines-default)");border-radius:6px;padding:6px;display:flex;flex-direction:column;gap:4px">
                                    @if (libraryVideo)
                                    {
                                        <video src="@file.Url" preload="metadata" muted playsinline controls style="width:100%;height:180px;object-fit:contain;background:#000"></video>
                                    }
                                    else
                                    {
                                        <img src="@file.Url" alt="@file.FileName" loading="lazy" style="width:100%;height:160px;object-fit:contain;background:#111;cursor:pointer" @onclick="() => PickFromLibrary(file)" />
                                    }
                                    <MudText Typo="Typo.caption">@file.Source · @file.UploadedAtUtc.AddHours(7).ToString("dd/MM HH:mm") · @FormatSize(file.Size)</MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" Disabled="@picked" OnClick="() => PickFromLibrary(file)">@(picked ? "Đang dùng" : "Chọn")</MudButton>
                                </div>
                            }
                        </div>
                    }
                </MudPaper>
            }
            <MudTextField T="string" Label="Ghi chú cho khách hàng" @bind-Value="_model.Note" Lines="3" Disabled="_busy" />
            <MudTextField T="string" Label="Kịch bản video" @bind-Value="_model.Script" Lines="8" Disabled="_busy" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())" Disabled="_busy">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="SaveAsync" Disabled="_busy">
            @(IsNew ? (_points > 0 ? $"Thêm video và trừ {_points:#,0.##} điểm" : "Thêm video (miễn phí)") : "Lưu")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public CustomerVideo? Source { get; set; }
    [Parameter] public IReadOnlyList<CustomerVideoProduct> Products { get; set; } = [];
    [Parameter] public IReadOnlyList<CustomerProfile> Customers { get; set; } = [];

    private CustomerVideo _model = new();
    private CustomerProfile? _customer;
    private decimal _points;
    private decimal? _balance;
    private bool _busy;
    private bool _uploadingVideo;
    private string? _error;

    private bool IsNew => Source is null;

    // Library: reuse a file already on the server (an earlier upload, or a "Kho mẫu video" file) instead of uploading again.
    private bool? _libraryVideo;
    private string _librarySource = string.Empty;
    private IReadOnlyList<CustomerVideoLibraryFile> _library = [];

    private IEnumerable<CustomerVideoLibraryFile> LibraryFiles
        => string.IsNullOrEmpty(_librarySource) ? _library : _library.Where(x => x.Source == _librarySource);

    private RenderFragment LibraryButton(bool video) => @<MudButton Size="Size.Small" Variant="Variant.Outlined"
        StartIcon="@Icons.Material.Filled.VideoLibrary" Disabled="@_busy" OnClick="() => OpenLibrary(video)"
        Style="align-self:flex-start">Chọn từ thư viện</MudButton>;

    private void OpenLibrary(bool video)
    {
        _error = null;
        try
        {
            _library = Media.ListLibrary(video);
            _libraryVideo = video;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Customer video library listing failed. Video={Video}", video);
            _error = "Không mở được thư viện tệp. Vui lòng thử lại.";
        }
    }

    private void PickFromLibrary(CustomerVideoLibraryFile file)
    {
        if (_libraryVideo is not { } video) return;
        if (video) _model.VideoUrl = file.Url;
        else _model.PosterUrl = file.Url;
        Snackbar.Add(video ? "Đã chọn video từ thư viện." : "Đã chọn ảnh bìa từ thư viện.", Severity.Success);
        _libraryVideo = null;
    }

    private static string FormatSize(long bytes)
        => bytes >= 1024 * 1024 ? $"{bytes / (1024d * 1024):0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    protected override void OnInitialized()
    {
        if (Source is not null)
        {
            _model = new CustomerVideo
            {
                Id = Source.Id, CustomerId = Source.CustomerId, ProductCode = Source.ProductCode, Title = Source.Title,
                VideoUrl = Source.VideoUrl, PosterUrl = Source.PosterUrl, Note = Source.Note, Script = Source.Script
            };
            return;
        }

        var first = Products.FirstOrDefault(x => x.IsActive) ?? Products.FirstOrDefault();
        if (first is not null) ProductChanged(first.ProductCode);
    }

    private void ProductChanged(string code)
    {
        _model.ProductCode = code;
        _points = Products.FirstOrDefault(x => x.ProductCode == code)?.Points ?? 0;
    }

    private static string CustomerDisplay(CustomerProfile? customer)
        => customer is null ? string.Empty : $"{customer.CompanyName} ({customer.CustomerCode}{(string.IsNullOrWhiteSpace(customer.Email) ? "" : " · " + customer.Email)})";

    private Task<IEnumerable<CustomerProfile>> SearchCustomersAsync(string value, CancellationToken cancellationToken)
    {
        IEnumerable<CustomerProfile> result = Customers;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var term = value.Trim();
            result = result.Where(c => c.CompanyName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || c.CustomerCode.Contains(term, StringComparison.OrdinalIgnoreCase)
                || c.Email.Contains(term, StringComparison.OrdinalIgnoreCase)
                || c.Phone.Contains(term, StringComparison.OrdinalIgnoreCase)
                || c.ContactName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(result.Take(30));
    }

    private async Task CustomerChangedAsync(CustomerProfile? customer)
    {
        _customer = customer;
        _balance = null;
        if (_customer is null) return;
        try { _balance = await Wallets.GetBalanceAsync(_customer.Id); }
        catch (Exception ex) { Logger.LogWarning(ex, "Customer video balance lookup failed {CustomerId}", _customer.Id); }
    }

    private async Task UploadAsync(InputFileChangeEventArgs args, bool video)
    {
        if (_busy) return;
        _busy = true;
        _uploadingVideo = video;
        _error = null;
        try
        {
            var url = await Media.UploadAsync(args.File, video);
            if (video) _model.VideoUrl = url;
            else _model.PosterUrl = url;
            Snackbar.Add("Upload thành công.", Severity.Success);
        }
        catch (Exception ex)
        {
            var maxBytes = Media.MaxBytes(video);
            var category = IntroUploadDiagnostics.Classify(ex, Paths.IsConfigured && Paths.CanWrite());
            Logger.LogError(ex, "Customer video upload failed. FileName={FileName} FileSize={FileSize} Video={Video} ErrorCategory={ErrorCategory} CorrelationId={CorrelationId}",
                IntroUploadDiagnostics.SafeFileName(args.File.Name), args.File.Size, video, category, Activity.Current?.Id);
            _error = IntroUploadDiagnostics.Message(category, maxBytes);
        }
        finally { _busy = false; _uploadingVideo = false; }
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            CustomerVideoSaveResult result;
            if (IsNew)
            {
                _model.CustomerId = _customer?.Id ?? Guid.Empty;
                result = await Repository.CreateAsync(_model, _points);
            }
            else
            {
                result = await Repository.UpdateAsync(_model);
            }

            if (!result.Ok)
            {
                _error = result.Error;
                return;
            }

            Snackbar.Add(IsNew ? (_points > 0 ? $"Đã thêm video và trừ {_points:#,0.##} điểm của khách." : "Đã thêm video cho khách.") : "Đã lưu video.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.Id));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Customer video save failed.");
            _error = "Không lưu được video. Vui lòng thử lại.";
        }
        finally { _busy = false; }
    }
}
