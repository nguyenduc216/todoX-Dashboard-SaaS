@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="gap-2">
            <div>
                <MudText Typo="Typo.h6">@Title</MudText>
                <MudText Typo="Typo.caption" Class="todox-page-subtitle">Preview video ngành nghề Landing</MudText>
            </div>
            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@AspectRatio</MudChip>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(VideoUrl))
        {
            <video @ref="_videoElement" src="@VideoUrl" controls playsinline preload="metadata" autoplay="@AutoPlay" style="@VideoStyle"></video>
        }
        else
        {
            <MudAlert Severity="Severity.Info">Ngành nghề này chưa có video.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="Close">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? VideoUrl { get; set; }
    [Parameter] public string AspectRatio { get; set; } = "9:16";
    [Parameter] public bool AutoPlay { get; set; }

    private ElementReference _videoElement;

    private string VideoStyle => AspectRatio == "16:9"
        ? "width:100%;max-height:68vh;background:#000;border-radius:12px;object-fit:contain;"
        : "display:block;width:min(420px,100%);max-height:72vh;margin:0 auto;background:#000;border-radius:12px;object-fit:contain;";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !AutoPlay || string.IsNullOrWhiteSpace(VideoUrl))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("todoXVideoPreview.play", _videoElement);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private void Close() => MudDialog.Close();

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("todoXVideoPreview.pause", _videoElement);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }
}
