@using TodoX.Web.Models
@using TodoX.Web.Services.Studio
@inject StaffTaskRepository Tasks
@inject ILogger<StaffTaskDialog> Logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "Tạo công việc" : "Sửa công việc")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField T="string" Label="Tiêu đề" @bind-Value="_model.Title" Variant="Variant.Outlined" Required="true"
                              Counter="@StaffTaskRules.MaxTitleLength" MaxLength="@StaffTaskRules.MaxTitleLength"
                              autocomplete="off" Placeholder="Ví dụ: Quay video khai trương cửa hàng" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" Label="Người giao việc" @bind-Value="_model.AssignerUserId" Variant="Variant.Outlined" Clearable="true"
                           Placeholder="Chưa rõ" data-testid="staff-task-assigner">
                    @foreach (var person in Assignees)
                    {
                        <MudSelectItem T="Guid?" Value="@person.UserId">@person.Name@(person.IsStaff ? "" : " (quản trị)")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" Label="Người thực hiện" @bind-Value="_model.AssigneeUserId" Variant="Variant.Outlined" Clearable="true"
                           Placeholder="Chưa giao">
                    @foreach (var person in Assignees)
                    {
                        <MudSelectItem T="Guid?" Value="@person.UserId">@person.Name@(person.IsStaff ? "" : " (quản trị)")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="Guid?" Label="Khách hàng (không bắt buộc)" @bind-Value="_model.CustomerId" Variant="Variant.Outlined" Clearable="true"
                           Placeholder="Không gắn khách hàng">
                    @foreach (var customer in Customers.OrderBy(x => x.CompanyName))
                    {
                        <MudSelectItem T="Guid?" Value="@customer.Id">@customer.CompanyName (@customer.CustomerCode)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="7" sm="4">
                <MudDatePicker Label="Ngày thực hiện" @bind-Date="_startDate" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Clearable="true" />
            </MudItem>
            <MudItem xs="5" sm="2">
                <MudTimePicker Label="Giờ" @bind-Time="_startTime" Variant="Variant.Outlined" AmPm="false" Clearable="true" Disabled="@(_startDate is null)" />
            </MudItem>
            <MudItem xs="7" sm="4">
                <MudDatePicker Label="Dự kiến hoàn thành" @bind-Date="_dueDate" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Clearable="true"
                               HelperText="Quá hạn mà chưa xong sẽ báo Trễ hạn" />
            </MudItem>
            <MudItem xs="5" sm="2">
                <MudTimePicker Label="Giờ" @bind-Time="_dueTime" Variant="Variant.Outlined" AmPm="false" Clearable="true" Disabled="@(_dueDate is null)" />
            </MudItem>
            @if (!StaffTaskStatuses.IsOpen(_model.Status))
            {
                <MudItem xs="7" sm="4">
                    <MudDatePicker Label="Hoàn thành thực tế" @bind-Date="_endDate" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Clearable="true" />
                </MudItem>
                <MudItem xs="5" sm="2">
                    <MudTimePicker Label="Giờ" @bind-Time="_endTime" Variant="Variant.Outlined" AmPm="false" Clearable="true" Disabled="@(_endDate is null)" />
                </MudItem>
            }
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="Trạng thái" @bind-Value="_model.Status" Variant="Variant.Outlined">
                    @foreach (var status in StaffTaskStatuses.All)
                    {
                        <MudSelectItem Value="@status">@StaffTaskStatuses.Label(status)</MudSelectItem>
                    }
                </MudSelect>
                @if (_model.Status == StaffTaskStatuses.Done && _endDate is null)
                {
                    <MudText Typo="Typo.caption" Class="todox-page-subtitle">Để trống ngày hoàn thành thực tế: hệ thống ghi giờ lúc lưu.</MudText>
                }
            </MudItem>
            @if (ProductsEnabled)
            {
                <MudItem xs="12">
                    @* Sản phẩm: the library videos this task produced. *@
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="gap-2">
                        <MudText Typo="Typo.subtitle2">Sản phẩm (@_model.Products.Count)</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.VideoLibrary"
                                   OnClick="ToggleLibraryAsync" Disabled="_loadingLibrary">
                            @(_libraryOpen ? "Đóng thư viện" : "Chọn video từ thư viện")
                        </MudButton>
                    </MudStack>
                    @if (_model.Products.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="todox-page-subtitle">Chưa có sản phẩm. Chọn video công việc này làm ra từ thư viện.</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="1" Class="mt-1">
                            @foreach (var product in _model.Products)
                            {
                                <MudPaper Outlined="true" Class="pa-2 d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Small" />
                                    <a href="@product.VideoUrl" target="_blank" rel="noopener" style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@product.DisplayTitle</a>
                                    <MudText Typo="Typo.caption" Class="todox-page-subtitle" Style="white-space:nowrap">@product.Source</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Bỏ sản phẩm" OnClick="@(() => Remove(product))" />
                                </MudPaper>
                            }
                        </MudStack>
                    }
                    @if (_libraryOpen)
                    {
                        <MudPaper Outlined="true" Class="pa-3 mt-2">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="7">
                                    <MudTextField T="string" @bind-Value="_librarySearch" Placeholder="Tìm theo tên video..." Immediate="true" autocomplete="off"
                                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                                </MudItem>
                                <MudItem xs="12" sm="5">
                                    <MudSelect T="string" @bind-Value="_librarySource" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        <MudSelectItem Value="@string.Empty">Tất cả nguồn</MudSelectItem>
                                        @foreach (var source in _library.Select(x => x.Source).OfType<string>().Distinct())
                                        {
                                            <MudSelectItem Value="@source">@source</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                            @if (!LibraryShown.Any())
                            {
                                <MudText Typo="Typo.caption" Class="mt-2 d-block">Không có video nào khớp.</MudText>
                            }
                            else
                            {
                                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;max-height:420px;overflow:auto;margin-top:8px">
                                    @foreach (var file in LibraryShown)
                                    {
                                        var picked = IsPicked(file);
                                        <div style="border:2px solid @(picked ? "var(--mud-palette-warning)" : "var(--mud-palette-lines-default)");border-radius:6px;padding:6px;display:flex;flex-direction:column;gap:4px">
                                            @if (!string.IsNullOrWhiteSpace(file.PosterUrl))
                                            {
                                                <img src="@file.PosterUrl" alt="" loading="lazy" style="width:100%;height:150px;object-fit:contain;background:#111;cursor:pointer" @onclick="() => Toggle(file)" />
                                            }
                                            else
                                            {
                                                <video src="@file.VideoUrl" preload="metadata" muted playsinline style="width:100%;height:150px;object-fit:contain;background:#000;cursor:pointer" @onclick="() => Toggle(file)"></video>
                                            }
                                            <MudText Typo="Typo.caption" Style="font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@file.DisplayTitle">@file.DisplayTitle</MudText>
                                            <MudText Typo="Typo.caption" Class="todox-page-subtitle">@file.Source@(file.UploadedAt is { } at ? " · " + at.ToString("dd/MM/yyyy") : "")</MudText>
                                            <MudStack Row="true" Spacing="1">
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="@(picked ? Color.Default : Color.Warning)" OnClick="() => Toggle(file)" Style="flex:1">@(picked ? "Bỏ chọn" : "Chọn")</MudButton>
                                                <MudIconButton Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" Href="@file.VideoUrl" Target="_blank" aria-label="Xem video" />
                                            </MudStack>
                                        </div>
                                    }
                                </div>
                            }
                        </MudPaper>
                    }
                </MudItem>
            }
            <MudItem xs="12">
                <MudTextField T="string" Label="Ghi chú" @bind-Value="_model.Note" Variant="Variant.Outlined" Lines="4" AutoGrow="true"
                              autocomplete="off" Placeholder="Yêu cầu, địa điểm, tài liệu cần chuẩn bị..." />
            </MudItem>
            @if (!_isNew)
            {
                <MudItem xs="12">
                    <MudDivider Class="mb-3" />
                    <StaffTaskHistory TaskId="@_model.Id" CanComment="@CanComment" />
                </MudItem>
            }
        </MudGrid>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Class="todox-primary-btn" OnClick="Submit">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public StaffTask? Source { get; set; }
    [Parameter] public Guid? DefaultAssigneeId { get; set; }
    /// <summary>Người giao việc mặc định khi tạo việc: người đang đăng nhập.</summary>
    [Parameter] public Guid? DefaultAssignerId { get; set; }
    [Parameter] public bool CanComment { get; set; }
    [Parameter] public IReadOnlyList<CustomerProfile> Customers { get; set; } = [];
    [Parameter] public IReadOnlyList<PlanAssignee> Assignees { get; set; } = [];
    [Parameter] public bool ProductsEnabled { get; set; }

    private bool _libraryOpen;
    private bool _loadingLibrary;
    private IReadOnlyList<StaffTaskProduct>? _libraryCache;
    private IReadOnlyList<StaffTaskProduct> _library = [];
    private string _librarySearch = string.Empty;
    private string _librarySource = string.Empty;

    private IEnumerable<StaffTaskProduct> LibraryShown => _library
        .Where(x => string.IsNullOrEmpty(_librarySource) || x.Source == _librarySource)
        .Where(x => string.IsNullOrWhiteSpace(_librarySearch)
                    || x.DisplayTitle.Contains(_librarySearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool IsPicked(StaffTaskProduct file)
        => _model.Products.Any(p => string.Equals(p.VideoUrl, file.VideoUrl, StringComparison.OrdinalIgnoreCase));

    private async Task ToggleLibraryAsync()
    {
        _error = null;
        if (_libraryOpen) { _libraryOpen = false; return; }
        _loadingLibrary = true;
        try
        {
            _library = _libraryCache ??= await Tasks.ListLibraryAsync();
            _libraryOpen = true;
        }
        catch (UnauthorizedAccessException ex) { _error = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Staff task library listing failed.");
            _error = "Không mở được thư viện video. Vui lòng thử lại.";
        }
        finally { _loadingLibrary = false; }
    }

    private void Toggle(StaffTaskProduct file)
    {
        if (IsPicked(file)) { Remove(file); return; }
        if (_model.Products.Count >= StaffTaskRepository.MaxProducts)
        {
            _error = $"Mỗi công việc tối đa {StaffTaskRepository.MaxProducts} sản phẩm.";
            return;
        }
        _model.Products.Add(file with { UploadedAt = null });
    }

    private void Remove(StaffTaskProduct product)
        => _model.Products.RemoveAll(p => string.Equals(p.VideoUrl, product.VideoUrl, StringComparison.OrdinalIgnoreCase));

    private StaffTask _model = new();
    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private DateTime? _dueDate;
    private TimeSpan? _dueTime;
    private DateTime? _endDate;
    private TimeSpan? _endTime;
    private bool _isNew;
    private string? _error;

    protected override void OnInitialized()
    {
        _isNew = Source is null;
        _model = Source is null
            ? new StaffTask { Status = StaffTaskStatuses.New, AssigneeUserId = DefaultAssigneeId, AssignerUserId = DefaultAssignerId }
            : new StaffTask
            {
                Id = Source.Id,
                Title = Source.Title,
                Note = Source.Note,
                CustomerId = Source.CustomerId,
                AssigneeUserId = Source.AssigneeUserId,
                AssignerUserId = Source.AssignerUserId,
                StartAt = Source.StartAt,
                DueAt = Source.DueAt,
                CompletedAt = Source.CompletedAt,
                Status = StaffTaskStatuses.Normalize(Source.Status),
                Products = Source.Products.ToList()
            };
        _startDate = _model.StartAt?.Date;
        _startTime = _model.StartAt?.TimeOfDay;
        _dueDate = _model.DueAt?.Date;
        _dueTime = _model.DueAt?.TimeOfDay;
        _endDate = _model.CompletedAt?.Date;
        _endTime = _model.CompletedAt?.TimeOfDay;
    }

    internal static DateTime? Combine(DateTime? date, TimeSpan? time) => date is { } d ? d.Date + (time ?? TimeSpan.Zero) : null;

    private void Submit()
    {
        _model.StartAt = Combine(_startDate, _startTime);
        _model.DueAt = Combine(_dueDate, _dueTime);
        _model.CompletedAt = StaffTaskStatuses.IsOpen(_model.Status) ? null : Combine(_endDate, _endTime);
        _error = StaffTaskRules.Validate(_model);
        if (_error is null) MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
