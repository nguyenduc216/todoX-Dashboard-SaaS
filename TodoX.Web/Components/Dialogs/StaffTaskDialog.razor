@using TodoX.Web.Models
@using TodoX.Web.Services.Studio

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "Tạo công việc" : "Sửa công việc")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField T="string" Label="Tiêu đề" @bind-Value="_model.Title" Variant="Variant.Outlined" Required="true"
                              Counter="@StaffTaskRules.MaxTitleLength" MaxLength="@StaffTaskRules.MaxTitleLength"
                              autocomplete="off" Placeholder="Ví dụ: Quay video khai trương cửa hàng" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" Label="Người thực hiện" @bind-Value="_model.AssigneeUserId" Variant="Variant.Outlined" Clearable="true"
                           Placeholder="Chưa giao">
                    @foreach (var person in Assignees)
                    {
                        <MudSelectItem T="Guid?" Value="@person.UserId">@person.Name@(person.IsStaff ? "" : " (quản trị)")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" Label="Khách hàng (không bắt buộc)" @bind-Value="_model.CustomerId" Variant="Variant.Outlined" Clearable="true"
                           Placeholder="Không gắn khách hàng">
                    @foreach (var customer in Customers.OrderBy(x => x.CompanyName))
                    {
                        <MudSelectItem T="Guid?" Value="@customer.Id">@customer.CompanyName (@customer.CustomerCode)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="7" sm="4">
                <MudDatePicker Label="Ngày thực hiện" @bind-Date="_startDate" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Clearable="true" />
            </MudItem>
            <MudItem xs="5" sm="2">
                <MudTimePicker Label="Giờ" @bind-Time="_startTime" Variant="Variant.Outlined" AmPm="false" Clearable="true" Disabled="@(_startDate is null)" />
            </MudItem>
            <MudItem xs="7" sm="4">
                <MudDatePicker Label="Ngày hoàn thành" @bind-Date="_endDate" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" Clearable="true" />
            </MudItem>
            <MudItem xs="5" sm="2">
                <MudTimePicker Label="Giờ" @bind-Time="_endTime" Variant="Variant.Outlined" AmPm="false" Clearable="true" Disabled="@(_endDate is null)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="Trạng thái" @bind-Value="_model.Status" Variant="Variant.Outlined">
                    @foreach (var status in StaffTaskStatuses.All)
                    {
                        <MudSelectItem Value="@status">@StaffTaskStatuses.Label(status)</MudSelectItem>
                    }
                </MudSelect>
                @if (_model.Status == StaffTaskStatuses.Done && _endDate is null)
                {
                    <MudText Typo="Typo.caption" Class="todox-page-subtitle">Để trống ngày hoàn thành: hệ thống ghi giờ lúc lưu.</MudText>
                }
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Ghi chú" @bind-Value="_model.Note" Variant="Variant.Outlined" Lines="4" AutoGrow="true"
                              autocomplete="off" Placeholder="Yêu cầu, địa điểm, tài liệu cần chuẩn bị..." />
            </MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Class="todox-primary-btn" OnClick="Submit">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public StaffTask? Source { get; set; }
    [Parameter] public Guid? DefaultAssigneeId { get; set; }
    [Parameter] public IReadOnlyList<CustomerProfile> Customers { get; set; } = [];
    [Parameter] public IReadOnlyList<PlanAssignee> Assignees { get; set; } = [];

    private StaffTask _model = new();
    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private DateTime? _endDate;
    private TimeSpan? _endTime;
    private bool _isNew;
    private string? _error;

    protected override void OnInitialized()
    {
        _isNew = Source is null;
        _model = Source is null
            ? new StaffTask { Status = StaffTaskStatuses.New, AssigneeUserId = DefaultAssigneeId }
            : new StaffTask
            {
                Id = Source.Id,
                Title = Source.Title,
                Note = Source.Note,
                CustomerId = Source.CustomerId,
                AssigneeUserId = Source.AssigneeUserId,
                StartAt = Source.StartAt,
                CompletedAt = Source.CompletedAt,
                Status = Source.Status
            };
        _startDate = _model.StartAt?.Date;
        _startTime = _model.StartAt?.TimeOfDay;
        _endDate = _model.CompletedAt?.Date;
        _endTime = _model.CompletedAt?.TimeOfDay;
    }

    internal static DateTime? Combine(DateTime? date, TimeSpan? time) => date is { } d ? d.Date + (time ?? TimeSpan.Zero) : null;

    private void Submit()
    {
        _model.StartAt = Combine(_startDate, _startTime);
        _model.CompletedAt = Combine(_endDate, _endTime);
        _error = StaffTaskRules.Validate(_model);
        if (_error is null) MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
