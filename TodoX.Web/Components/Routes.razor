@using TodoX.Web.Components.Pages
@inject AuthStateService AuthState
@inject AccountService Accounts
@inject NavigationManager Navigation

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @if (_authBootstrapError is not null)
        {
            <div class="d-flex justify-content-center align-items-center min-vh-100">
                <MudPaper Class="pa-6 text-center" Elevation="2">
                    <MudAlert Severity="Severity.Error">@_authBootstrapError</MudAlert>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RetryBootstrapAsync">
                        Thử lại
                    </MudButton>
                </MudPaper>
            </div>
        }
        else if (_initializing || !AuthState.IsInitialized)
        {
            <div class="d-flex justify-content-center align-items-center min-vh-100">
                <MudPaper Class="pa-6 text-center" Elevation="2">
                    <MudProgressCircular Indeterminate="true" Color="Color.Warning" />
                    <MudText Class="mt-3">Đang tải phiên đăng nhập...</MudText>
                </MudPaper>
            </div>
        }
        else if (!NavigationAccessRules.CanAccessPath(AuthState.CurrentUser, CurrentPath))
        {
            <AccessDenied />
        }
        else
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        }
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private string CurrentPath => NavigationAccessRules.NormalizePath(new Uri(Navigation.Uri).AbsolutePath);

    private bool _initializing;
    private string? _authBootstrapError;
    private static readonly TimeSpan AuthBootstrapTimeout = TimeSpan.FromSeconds(12);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || AuthState.IsInitialized || _initializing)
        {
            return;
        }

        await BootstrapAuthAsync();
    }

    private async Task RetryBootstrapAsync()
    {
        AuthState.ResetInitializationForRetry();
        await BootstrapAuthAsync();
    }

    private async Task BootstrapAuthAsync()
    {
        _authBootstrapError = null;
        _initializing = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var bootstrap = AuthState.InitializeAsync(id => Accounts.RehydrateSessionAsync(id));
            var completed = await Task.WhenAny(bootstrap, Task.Delay(AuthBootstrapTimeout));
            if (completed != bootstrap)
            {
                _authBootstrapError = "Không thể tải phiên đăng nhập.";
                AuthState.ResetInitializationForRetry();
            }
            else
            {
                await bootstrap;
                if (AuthState.IsInitialized
                    && !AuthState.IsAuthenticated
                    && !NavigationAccessRules.IsPublicPath(CurrentPath))
                {
                    Navigation.NavigateTo("/login", replace: true);
                    return;
                }
            }
        }
        catch
        {
            _authBootstrapError = "Không thể tải phiên đăng nhập.";
            AuthState.ResetInitializationForRetry();
        }
        finally
        {
            _initializing = false;
        }

        await InvokeAsync(StateHasChanged);
    }
}
