    });

    private async Task EnsureEditableAsync()
    {
        if (AuthState.CurrentUser is null) return;
        if (_job is null)
        {
            throw new InvalidOperationException("Không tìm thấy video quảng cáo thời trang.");
        }
    }

    private void EnsureReferenceProviderReady()
    {
        if (!string.IsNullOrWhiteSpace(_referenceReadinessError))
        {
            throw new InvalidOperationException(_referenceReadinessError);
        }
    }

    private void EnsureMotionProviderReady()
    {
        if (!string.IsNullOrWhiteSpace(_motionReadinessError))
        {
            throw new InvalidOperationException(_motionReadinessError);
        }
    }

    private async Task StageTikTokAsync() => await RunAsync(async () =>
    {
        await EnsureEditableAsync();
        _job = await DanceSell.StageTikTokAsync(_job!.Id, _tiktokUrl, AuthState.CurrentUser!);
        _tiktokUrl = _job.MotionSourceUrl ?? _tiktokUrl;
        _motionFileName = "TikTok MP4";
        _motionFileSize = null;
        _motionUploadError = null;
