@page "/jobs/rdance/{JobId:guid}"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Options
@using TodoX.Web.Services.DanceSell
@inject AuthStateService AuthState
@inject IDanceSellPhase2Service DanceSell
@inject IDanceSellReferenceImageService References
@inject IDanceSellRepository DanceRepo
@inject IDanceSellCostEstimator Costs
@inject IDanceSellProviderCatalog ProviderCatalog
@inject IOptionsMonitor<DanceSellPhase2Options> DanceOptions
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject WalletService Wallet
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Video nhảy quảng cáo thời trang</PageTitle>

<MudStack Spacing="3" Class="rdance-fashion-page">
    <MudText Typo="Typo.h4" Class="todox-page-title">Video nhảy quảng cáo thời trang</MudText>
    <MudText Typo="Typo.body1" Class="todox-page-subtitle">Tạo video quảng cáo thời trang từ chuyển động TikTok hoặc video MP4.</MudText>

    @if (!AuthState.IsInitialized)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (AuthState.CurrentUser is null)
    {
        <MudAlert Severity="Severity.Warning">Vui lòng đăng nhập để mở trang này.</MudAlert>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_readinessError))
        {
            <MudAlert Severity="Severity.Error">@_readinessError</MudAlert>
        }

        <MudTabs Rounded="true" Elevation="0" @bind-ActivePanelIndex="_tabIndex">
            <MudTabPanel Text="Thông tin">
                <MudGrid Class="mt-4">
                    <MudItem xs="12" md="7">
                        <MudPaper Class="todox-panel pa-4">
                            <MudStack Spacing="3">
                                <MudText Typo="Typo.h6">Thông tin dự án</MudText>
                                <MudTextField T="string" Label="Tên dự án" Variant="Variant.Outlined" @bind-Value="_title" Disabled="@_busy" />
                                <MudSelect T="string" Label="Danh mục thời trang" Variant="Variant.Outlined" @bind-Value="_category" Disabled="@_busy">
                                    <MudSelectItem Value="@("shirt")">Áo</MudSelectItem>
                                    <MudSelectItem Value="@("pants")">Quần</MudSelectItem>
                                    <MudSelectItem Value="@("dress")">Váy</MudSelectItem>
                                    <MudSelectItem Value="@("set")">Set đồ</MudSelectItem>
                                    <MudSelectItem Value="@("outerwear")">Áo khoác</MudSelectItem>
                                    <MudSelectItem Value="@("other")">Khác</MudSelectItem>
                                </MudSelect>
                                <MudTextField T="string" Label="Link TikTok" Variant="Variant.Outlined" @bind-Value="_tiktokUrl" Disabled="@_busy" />
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(_busy || string.IsNullOrWhiteSpace(_tiktokUrl))" OnClick="StageTikTokAsync">
                                    Tải và kiểm tra video
                                </MudButton>
                                @if (HasTikTokSource)
                                {
                                    <MudPaper Outlined="true" Class="rdance-motion-file pa-3">
                                        <MudStack Spacing="1">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="rdance-motion-file-copy">
                                                    <MudIcon Icon="@Icons.Material.Filled.MusicNote" Size="Size.Small" />
                                                    <MudText Typo="Typo.body2">Nguồn chuyển động: TikTok</MudText>
                                                </MudStack>
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="OpenTikTokAsync">Mở TikTok</MudButton>
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Class="rdance-source-url">Link gốc: @_job?.MotionSourceUrl</MudText>
                                        </MudStack>
                                    </MudPaper>
                                }
                                <MudDivider />
                                <MudText Typo="Typo.subtitle2">Hoặc tải video chuyển động MP4</MudText>
                                <label class="@MotionUploadZoneClass" @ondragenter="OnMotionDragEnter" @ondragleave="OnMotionDragLeave" @ondragover:preventDefault="true" @ondrop:preventDefault="true" @ondrop="OnMotionDrop">
                                    <InputFile class="rdance-hidden-file-input" OnChange="OnMotionSelected" accept="video/mp4" disabled="@_busy" />
                                    <span class="rdance-upload-icon">
                                        @if (_busy)
                                        {
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Warning" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" />
                                        }
                                    </span>
                                    <span class="rdance-upload-title">Kéo thả video MP4 vào đây</span>
                                    <span class="rdance-upload-subtitle">hoặc bấm để chọn video</span>
                                    <span class="rdance-upload-limit">MP4 · tối đa @MaxMotionVideoLabel</span>
                                </label>
                                @if (!string.IsNullOrWhiteSpace(_motionUploadError))
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true">@_motionUploadError</MudAlert>
                                }
                                @if (!string.IsNullOrWhiteSpace(MotionSourceName))
                                {
                                    <MudPaper Outlined="true" Class="rdance-motion-file pa-3">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="rdance-motion-file-copy">
                                                <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">@MotionSourceName</MudText>
                                                @if (_motionFileSize is long size)
                                                {
                                                    <MudText Typo="Typo.caption">@FormatBytes(size)</MudText>
                                                }
                                            </MudStack>
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Video chuyển động đã sẵn sàng</MudChip>
                                            <label class="rdance-replace-button">
                                                <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" />
                                                <span>Thay video</span>
                                                <InputFile class="rdance-hidden-file-input" OnChange="OnMotionSelected" accept="video/mp4" disabled="@_busy" />
                                            </label>
                                        </MudStack>
                                    </MudPaper>
                                }
                                @if (!string.IsNullOrWhiteSpace(_job?.MotionVideoUrl))
                                {
                                    <video src="@_job.MotionVideoUrl" controls muted playsinline class="rdance-media-player"></video>
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Nguồn chuyển động đã sẵn sàng</MudChip>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info">Cần staging TikTok hoặc tải MP4 trước khi tiếp tục.</MudAlert>
                                }
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudPaper Class="todox-panel pa-4">
                            <MudText Typo="Typo.h6">Đầu ra</MudText>
                            <MudList T="string" Dense="true">
                                <MudListItem T="string">Dịch vụ: Video nhảy quảng cáo thời trang</MudListItem>
                                <MudListItem T="string">Tỷ lệ: 9:16</MudListItem>
                                <MudListItem T="string">Định dạng: MP4</MudListItem>
                                <MudListItem T="string">Model: Kling Motion Control</MudListItem>
                            </MudList>
                            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning" Disabled="@(_job?.MotionVideoMediaId is null || _busy)" OnClick="@(() => _tabIndex = 1)">
                                Tiếp tục
                            </MudButton>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Hình ảnh">
                <MudGrid Class="mt-4">
                    <MudItem xs="12" md="4">
                        <MudPaper Class="todox-panel pa-4">
                            <MudText Typo="Typo.h6">Ảnh người mẫu *</MudText>
                            @if (!string.IsNullOrWhiteSpace(_job?.CharacterImageUrl))
                            {
                                @Preview(_job.CharacterImageUrl, "Ảnh người mẫu")
                            }
                            <label class="@CharacterImageUploadZoneClass" @ondragenter="OnCharacterDragEnter" @ondragleave="OnCharacterDragLeave" @ondragover:preventDefault="true" @ondrop:preventDefault="true" @ondrop="OnCharacterDrop">
                                <InputFile class="rdance-hidden-file-input" OnChange="OnCharacterSelected" accept="@AcceptedImageTypes" disabled="@_busy" />
                                <span class="rdance-upload-icon">
                                    @if (_busy)
                                    {
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Warning" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" />
                                    }
                                </span>
                                <span class="rdance-upload-title">@(!string.IsNullOrWhiteSpace(_job?.CharacterImageUrl) ? "Thay ảnh" : "Kéo thả ảnh vào đây")</span>
                                @if (string.IsNullOrWhiteSpace(_job?.CharacterImageUrl))
                                {
                                    <span class="rdance-upload-subtitle">hoặc bấm để chọn ảnh</span>
                                }
                                <span class="rdance-upload-limit">PNG / JPG / JPEG / WEBP · tối đa @MaxImageLabel</span>
                            </label>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Class="todox-panel pa-4">
                            <MudText Typo="Typo.h6">Ảnh sản phẩm (tuỳ chọn)</MudText>
                            @if (!string.IsNullOrWhiteSpace(_job?.ProductImageUrl))
                            {
                                @Preview(_job.ProductImageUrl, "Ảnh sản phẩm")
                            }
                            <label class="@ProductImageUploadZoneClass" @ondragenter="OnProductDragEnter" @ondragleave="OnProductDragLeave" @ondragover:preventDefault="true" @ondrop:preventDefault="true" @ondrop="OnProductDrop">
                                <InputFile class="rdance-hidden-file-input" OnChange="OnProductSelected" accept="@AcceptedImageTypes" disabled="@_busy" />
                                <span class="rdance-upload-icon">
                                    @if (_busy)
                                    {
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Warning" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" />
                                    }
                                </span>
                                <span class="rdance-upload-title">@(!string.IsNullOrWhiteSpace(_job?.ProductImageUrl) ? "Thay ảnh" : "Kéo thả ảnh vào đây")</span>
                                @if (string.IsNullOrWhiteSpace(_job?.ProductImageUrl))
                                {
                                    <span class="rdance-upload-subtitle">hoặc bấm để chọn ảnh</span>
                                }
                                <span class="rdance-upload-limit">PNG / JPG / JPEG / WEBP · tối đa @MaxImageLabel</span>
                            </label>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Class="todox-panel pa-4">
                            <MudText Typo="Typo.h6">Ảnh dùng để tạo video</MudText>
                            <MudText Typo="Typo.body2" Class="rdance-reference-help">@ReferenceHelpText</MudText>
                            @Preview(_job?.PreparedReferenceUrl, "Ảnh dùng để tạo video")
                            <MudChip T="string" Color="@ReferenceColor" Size="Size.Small">@ReferenceLabel</MudChip>
                            @if (_job?.PreparedReferenceStatus == DanceSellReferenceStatuses.Approved)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Đã duyệt</MudChip>
                            }
                            else if (_latestReference?.Status == DanceSellReferenceStatuses.Ready)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="@_busy" OnClick="ApproveLatestReferenceAsync">Duyệt ảnh</MudButton>
                            }
                            else if (_job?.PreparedReferenceStatus == DanceSellReferenceStatuses.Failed || _latestReference?.Status == DanceSellReferenceStatuses.Failed)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(_busy || _job?.CharacterMediaId is null)" OnClick="AutoPrepareReferenceAsync">Tạo lại ảnh</MudButton>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
                <MudAlert Severity="Severity.Info" Class="mt-3">Chỉ ảnh tham chiếu đã duyệt mới được phép render video. Tạo lại ảnh sẽ tạo phiên bản mới.</MudAlert>
                @if (_job?.PreparedReferenceStatus == DanceSellReferenceStatuses.Approved)
                {
                    <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Warning" OnClick="@(() => _tabIndex = 2)">Tiếp tục tạo video</MudButton>
                }
            </MudTabPanel>

            <MudTabPanel Text="Video">
                <MudGrid Class="mt-4">
                    <MudItem xs="12" md="7">
                        <MudPaper Class="todox-panel pa-4">
                            <MudText Typo="Typo.h6">Xem trước</MudText>
                            @if (!string.IsNullOrWhiteSpace(_job?.MotionVideoUrl))
                            {
                                <video src="@_job.MotionVideoUrl" controls muted playsinline class="rdance-media-player"></video>
                            }
                            @Preview(_job?.PreparedReferenceUrl, "Ảnh tham chiếu đã duyệt")
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudPaper Class="todox-panel pa-4">
                            <MudText Typo="Typo.h6">Tóm tắt render</MudText>
                            <MudList T="string" Dense="true">
                                <MudListItem T="string">Dịch vụ: Video nhảy quảng cáo thời trang</MudListItem>
                                <MudListItem T="string">Provider chính: 79AI</MudListItem>
                                <MudListItem T="string">Model: Kling Motion Control</MudListItem>
                                <MudListItem T="string">Tỷ lệ: 9:16</MudListItem>
                                <MudListItem T="string">Ước tính: @(_estimate?.EstimatedTodoxPoints?.ToString("0.##") ?? "chưa cấu hình") điểm</MudListItem>
                                @if (_balance is not null)
                                {
                                    <MudListItem T="string">Số dư: @_balance.Value.ToString("0.##") điểm</MudListItem>
                                }
                            </MudList>
                            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Warning" Disabled="@(!CanRender || _busy)" OnClick="ConfirmAndQueueAsync">Tạo video</MudButton>
                            @if (IsActive)
                            {
                                <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Error" Disabled="@_busy" OnClick="CancelAsync">Dừng render</MudButton>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Kết quả">
                <MudStack Spacing="3" Class="mt-4">
                    @if (_job is null || string.IsNullOrWhiteSpace(_job.ResultVideoUrl))
                    {
                        <MudAlert Severity="Severity.Info">Kết quả sẽ xuất hiện sau khi render hoàn tất.</MudAlert>
                    }
                    else
                    {
                        <MudPaper Class="todox-panel pa-4">
                            <MudText Typo="Typo.h6">Video nhảy quảng cáo thời trang</MudText>
                            <video src="@_job.ResultVideoUrl" controls playsinline class="rdance-result-player"></video>
                            <MudStack Row="true" Class="flex-wrap gap-2 mt-3">
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="@(() => JS.InvokeVoidAsync("open", _job.ResultVideoUrl))">Xem video</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="RetryAsync">Render lại video</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/jobs/rdance/new"))">Tạo video mới</MudButton>
                            </MudStack>
                        </MudPaper>
                    }
                    <MudText Typo="Typo.h6">Lịch sử video quảng cáo thời trang</MudText>
                    @foreach (var item in _history)
                    {
                        <MudPaper Class="todox-panel pa-3" Outlined="true">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                                <MudText>@(item.Title ?? "Video nhảy quảng cáo thời trang")</MudText>
                                <MudChip T="string" Color="@StatusColor(item.Status)" Size="Size.Small">@item.Status</MudChip>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => OpenAsync(item.Id))">Mở</MudButton>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    }
</MudStack>

@code {
    [Parameter] public Guid JobId { get; set; }

    private int _tabIndex;
    private bool _busy;
    private string _title = "Video nhảy quảng cáo thời trang";
    private string _category = "shirt";
    private string _tiktokUrl = string.Empty;
    private DanceSellJobDto? _job;
    private DanceSellReferenceVersionDto? _latestReference;
    private IReadOnlyList<DanceSellJobDto> _history = Array.Empty<DanceSellJobDto>();
    private IReadOnlyList<DanceSellProviderRouteDto> _motionRoutes = Array.Empty<DanceSellProviderRouteDto>();
    private DanceSellCostEstimate? _estimate;
    private decimal? _balance;
    private string? _readinessError;
    private string? _loadError;
    private string? _motionFileName;
    private long? _motionFileSize;
    private string? _motionUploadError;
    private bool _motionDragActive;
    private bool _characterDragActive;
    private bool _productDragActive;
    private CancellationTokenSource? _pollCts;
    private PeriodicTimer? _pollTimer;

    private const string AcceptedImageTypes = "image/png,image/jpeg,image/webp";
    private bool CanRender => _job?.Status is not (DanceSellJobStatuses.Queued or DanceSellJobStatuses.Submitted or DanceSellJobStatuses.Rendering)
        && _job?.MotionVideoMediaId is not null
        && _job?.PreparedReferenceStatus == DanceSellReferenceStatuses.Approved;
    private bool IsActive => _job?.Status is DanceSellJobStatuses.Queued or DanceSellJobStatuses.Submitted or DanceSellJobStatuses.Rendering;
    private long MaxImageBytes => (long)Math.Max(1, DanceOptions.CurrentValue.MaxImageMb) * 1024 * 1024;
    private long MaxMotionVideoBytes => (long)Math.Max(1, DanceOptions.CurrentValue.MaxVideoMb) * 1024 * 1024;
    private string MaxImageLabel => $"{Math.Max(1, DanceOptions.CurrentValue.MaxImageMb)}MB";
    private string MaxMotionVideoLabel => $"{Math.Max(1, DanceOptions.CurrentValue.MaxVideoMb)}MB";
    private string MotionUploadZoneClass => $"rdance-upload-zone{(_motionDragActive ? " is-dragging" : string.Empty)}{(_busy ? " is-busy" : string.Empty)}";
    private string CharacterImageUploadZoneClass => $"rdance-upload-zone rdance-image-upload-zone{(_characterDragActive ? " is-dragging" : string.Empty)}{(_busy ? " is-busy" : string.Empty)}";
    private string ProductImageUploadZoneClass => $"rdance-upload-zone rdance-image-upload-zone{(_productDragActive ? " is-dragging" : string.Empty)}{(_busy ? " is-busy" : string.Empty)}";
    private string ReferenceHelpText => _job?.ProductMediaId is not null
        ? "AI sẽ kết hợp ảnh người mẫu và ảnh sản phẩm để tạo ảnh dùng cho video."
        : "Ảnh người mẫu sẽ được dùng trực tiếp để tạo video.";
    private string? MotionSourceName => !string.IsNullOrWhiteSpace(_motionFileName)
        ? _motionFileName
        : _job?.MotionSourceType == DanceSellMotionSourceTypes.TikTok
            ? "TikTok MP4"
            : !string.IsNullOrWhiteSpace(_job?.MotionVideoUrl)
                ? "Video MP4"
                : null;
    private string ReferenceLabel => _job?.PreparedReferenceStatus switch
    {
        DanceSellReferenceStatuses.Approved => "Đã duyệt",
        DanceSellReferenceStatuses.Ready => "Chờ duyệt",
        DanceSellReferenceStatuses.Generating => "Đang tạo",
        DanceSellReferenceStatuses.Failed => "Lỗi",
        _ => "Chưa có"
    };
    private Color ReferenceColor => _job?.PreparedReferenceStatus == DanceSellReferenceStatuses.Approved ? Color.Success : Color.Warning;
    private bool HasTikTokSource => _job?.MotionSourceType == DanceSellMotionSourceTypes.TikTok && !string.IsNullOrWhiteSpace(_job.MotionSourceUrl);

    protected override void OnInitialized()
    {
        AuthState.OnChange += HandleAuthChange;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!AuthState.IsInitialized || AuthState.CurrentUser is null)
        {
            return;
        }

        await ReloadAsync();
        StartPolling();
    }

    private async Task ReloadAsync()
    {
        if (AuthState.CurrentUser is null) return;
        _loadError = null;
        _readinessError = null;
        try
        {
            var motionRoute = await ProviderCatalog.GetDefaultRouteAsync(DanceSellOperationTypes.MotionVideo);
            if (!motionRoute.ProviderCode.Equals(DanceSellConstants.ProviderCode, StringComparison.OrdinalIgnoreCase)
                || !motionRoute.ModelName.Equals(DanceSellConstants.Model, StringComparison.OrdinalIgnoreCase))
            {
                _readinessError = "Dịch vụ video nhảy quảng cáo thời trang chưa được cấu hình Motion Control.";
            }

            _motionRoutes = new[] { motionRoute };
        }
        catch (Exception)
        {
            _motionRoutes = Array.Empty<DanceSellProviderRouteDto>();
            _readinessError = "Dịch vụ video nhảy quảng cáo thời trang chưa được cấu hình Motion Control.";
        }

        try
        {
            _job = await DanceSell.GetAsync(JobId, AuthState.CurrentUser);
            if (_job.MotionSourceType == DanceSellMotionSourceTypes.TikTok
                && !string.IsNullOrWhiteSpace(_job.MotionSourceUrl))
            {
                _tiktokUrl = _job.MotionSourceUrl;
            }
            var versions = await DanceRepo.ListReferenceVersionsAsync(_job.Id);
            _latestReference = versions.OrderByDescending(x => x.VersionNo).FirstOrDefault();
            await RefreshEstimateAsync();
        }
        catch (Exception ex)
        {
            _job = null;
            _latestReference = null;
            _loadError = ex.Message == "DANCE_SELL_UNAUTHORIZED"
                ? "Bạn không có quyền xem video này."
                : "Không tìm thấy video quảng cáo thời trang.";
        }

        _history = await DanceSell.ListAsync(AuthState.CurrentUser, 30);
        await InvokeAsync(StateHasChanged);
    }

    private void HandleAuthChange() => _ = InvokeAsync(async () =>
    {
        if (AuthState.CurrentUser is { IsCustomer: true })
        {
            await ReloadAsync();
            StartPolling();
        }

        StateHasChanged();
    });

    private async Task EnsureDraftAsync()
    {
        if (AuthState.CurrentUser is null) return;
        if (!string.IsNullOrWhiteSpace(_readinessError))
        {
            throw new InvalidOperationException(_readinessError);
        }

        if (_job is null)
        {
            throw new InvalidOperationException("Không tìm thấy video quảng cáo thời trang.");
        }
    }

    private async Task StageTikTokAsync() => await RunAsync(async () =>
    {
        await EnsureDraftAsync();
        _job = await DanceSell.StageTikTokAsync(_job!.Id, _tiktokUrl, AuthState.CurrentUser!);
        _tiktokUrl = _job.MotionSourceUrl ?? _tiktokUrl;
        _motionFileName = "TikTok MP4";
        _motionFileSize = null;
        _motionUploadError = null;
        Snackbar.Add("Đã staging video TikTok.", Severity.Success);
        await ReloadAsync();
    });

    private Task OpenTikTokAsync()
    {
        if (!string.IsNullOrWhiteSpace(_job?.MotionSourceUrl))
        {
            Navigation.NavigateTo(_job.MotionSourceUrl, forceLoad: true);
        }

        return Task.CompletedTask;
    }

    private async Task OnMotionSelected(InputFileChangeEventArgs args)
    {
        _motionDragActive = false;
        var file = args.File;
        var error = ValidateMotionVideo(file);
        if (!string.IsNullOrWhiteSpace(error))
        {
            _motionUploadError = error;
            Snackbar.Add(error, Severity.Error);
            await InvokeAsync(StateHasChanged);
            return;
        }

        _motionFileName = file.Name;
        _motionFileSize = file.Size;
        _motionUploadError = null;
        if (await UploadAsync(args, MaxMotionVideoBytes, (bytes, uploadedFile) => DanceSell.UploadMotionAsync(_job!.Id, bytes, uploadedFile.Name, uploadedFile.ContentType, AuthState.CurrentUser!)))
        {
            await ReloadAsync();
        }
    }

    private async Task OnCharacterSelected(InputFileChangeEventArgs args)
    {
        _characterDragActive = false;
        if (await UploadAsync(args, MaxImageBytes, (bytes, file) => DanceSell.UploadCharacterAsync(_job!.Id, bytes, file.Name, file.ContentType, AuthState.CurrentUser!)))
        {
            await AutoPrepareReferenceAsync();
        }
    }

    private async Task OnProductSelected(InputFileChangeEventArgs args)
    {
        _productDragActive = false;
        if (await UploadAsync(args, MaxImageBytes, (bytes, file) => DanceSell.UploadProductAsync(_job!.Id, bytes, file.Name, file.ContentType, AuthState.CurrentUser!)))
        {
            await AutoPrepareReferenceAsync();
        }
    }

    private async Task<bool> UploadAsync(InputFileChangeEventArgs args, long maxBytes, Func<byte[], IBrowserFile, Task<DanceSellJobDto>> save)
    {
        var saved = false;
        await RunAsync(async () =>
        {
            await EnsureDraftAsync();
            var file = args.File;
            await using var input = file.OpenReadStream(maxBytes);
            using var buffer = new MemoryStream();
            await input.CopyToAsync(buffer);
            _job = await save(buffer.ToArray(), file);
            saved = true;
            Snackbar.Add("Tải tệp thành công.", Severity.Success);
        });
        return saved;
    }

    private async Task AutoPrepareReferenceAsync()
    {
        if (_job is null || _busy)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await EnsureDraftAsync();
            _job = await References.AutoPrepareAsync(_job!.Id, AuthState.CurrentUser!);
            var versions = await DanceRepo.ListReferenceVersionsAsync(_job.Id);
            _latestReference = versions.OrderByDescending(x => x.VersionNo).FirstOrDefault();
            await RefreshEstimateAsync();
        });
    }

    private string? ValidateMotionVideo(IBrowserFile file)
    {
        if (file.Size <= 0)
        {
            return "Video không hợp lệ.";
        }

        if (file.Size > MaxMotionVideoBytes)
        {
            return "Video vượt quá dung lượng cho phép.";
        }

        if (string.IsNullOrWhiteSpace(file.Name)
            || (!file.ContentType.Equals("video/mp4", StringComparison.OrdinalIgnoreCase)
                && !Path.GetExtension(file.Name).Equals(".mp4", StringComparison.OrdinalIgnoreCase)))
        {
            return "Chỉ hỗ trợ video MP4.";
        }

        return null;
    }

    private void OnMotionDragEnter(DragEventArgs _) => _motionDragActive = true;
    private void OnMotionDragLeave(DragEventArgs _) => _motionDragActive = false;
    private void OnMotionDrop(DragEventArgs _) => _motionDragActive = false;
    private void OnCharacterDragEnter(DragEventArgs _) => _characterDragActive = true;
    private void OnCharacterDragLeave(DragEventArgs _) => _characterDragActive = false;
    private void OnCharacterDrop(DragEventArgs _) => _characterDragActive = false;
    private void OnProductDragEnter(DragEventArgs _) => _productDragActive = true;
    private void OnProductDragLeave(DragEventArgs _) => _productDragActive = false;
    private void OnProductDrop(DragEventArgs _) => _productDragActive = false;

    private async Task ApproveCharacterAsync() => await RunAsync(async () =>
    {
        _job = await References.ApproveCharacterAsync(_job!.Id, AuthState.CurrentUser!);
        await ReloadAsync();
    });

    private async Task ApproveLatestReferenceAsync() => await RunAsync(async () =>
    {
        _job = await References.ApproveAsync(_job!.Id, _latestReference!.Id, AuthState.CurrentUser!);
        await ReloadAsync();
    });

    private async Task ConfirmAndQueueAsync()
    {
        if (!string.IsNullOrWhiteSpace(_readinessError))
        {
            Snackbar.Add(_readinessError, Severity.Error);
            return;
        }

        await RefreshEstimateAsync();
        var points = _estimate?.EstimatedTodoxPoints?.ToString("0.##") ?? "chưa cấu hình";
        var confirmed = await DialogService.ShowMessageBoxAsync("Xác nhận tạo video",
            (MarkupString)$"Tạo video <b>{_title}</b> bằng <b>Kling Motion Control</b>, tỷ lệ <b>9:16</b>, ước tính <b>{points} điểm</b>?",
            yesText: "Xác nhận tạo video", cancelText: "Quay lại chỉnh sửa");
        if (confirmed == true)
        {
            await RunAsync(async () =>
            {
                await UpdateBusinessAsync();
                _job = await DanceSell.QueueRenderAsync(_job!.Id, AuthState.CurrentUser!);
                _tabIndex = 3;
                await ReloadAsync();
            });
        }
    }

    private async Task CancelAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Dừng render", "Dừng job đang chạy?", yesText: "Dừng", cancelText: "Tiếp tục");
        if (confirmed == true)
        {
            await RunAsync(async () =>
            {
                _job = await DanceSell.CancelAsync(_job!.Id, "Customer requested stop.", AuthState.CurrentUser!);
                await ReloadAsync();
            });
        }
    }

    private async Task RetryAsync() => await RunAsync(async () =>
    {
        _job = await DanceSell.RetryAsync(_job!.Id, AuthState.CurrentUser!);
        await ReloadAsync();
    });

    private Task OpenAsync(Guid id)
    {
        Navigation.NavigateTo($"/jobs/rdance/{id}");
        return Task.CompletedTask;
    }

    private async Task UpdateBusinessAsync()
        => _job = await DanceSell.UpdateBusinessAsync(_job!.Id, new DanceSellUpdateBusinessRequest
        {
            Title = _title,
            Prompt = BuildPrompt(),
            PlacementMode = DanceSellPlacementModes.WearProduct,
            ReferenceMode = DanceSellReferenceModes.GenerateReference,
            Mode = "720p",
            CharacterOrientation = "image"
        }, AuthState.CurrentUser!);

    private async Task RefreshEstimateAsync()
    {
        var route = _motionRoutes.FirstOrDefault(x => x.ProviderCode.Equals(DanceSellConstants.ProviderCode, StringComparison.OrdinalIgnoreCase)) ?? _motionRoutes.FirstOrDefault();
        if (route is null) return;
        _estimate = await Costs.EstimateAsync(route, "720p", null);
        if (AuthState.CurrentUser?.CustomerId is Guid customerId) _balance = await Wallet.GetBalanceAsync(customerId);
    }

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        try { await action(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; await InvokeAsync(StateHasChanged); }
    }

    private string BuildPrompt()
        => $"Create a fashion dance video. Category: {_category}. Preserve identity, face, anatomy and product design. Dress the person in the supplied product, keep colors, patterns and logos consistent, follow the staged motion naturally, no text, watermark, extra people or duplicated limbs.";

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1024L * 1024 * 1024)
        {
            return $"{bytes / 1024d / 1024d / 1024d:0.##} GB";
        }

        return bytes >= 1024L * 1024
            ? $"{bytes / 1024d / 1024d:0.##} MB"
            : $"{bytes / 1024d:0.##} KB";
    }

    private static RenderFragment Preview(string? url, string alt) => @<div class="rdance-media-preview">
        @if (!string.IsNullOrWhiteSpace(url))
        {
            <img src="@url" alt="@alt" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
        }
    </div>;

    private static Color StatusColor(string status) => status switch
    {
        DanceSellJobStatuses.Completed => Color.Success,
        DanceSellJobStatuses.Failed or DanceSellJobStatuses.Timeout => Color.Error,
        DanceSellJobStatuses.Queued or DanceSellJobStatuses.Submitted or DanceSellJobStatuses.Rendering => Color.Warning,
        _ => Color.Default
    };

    private void StartPolling()
    {
        _pollCts = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = PollLoopAsync(_pollCts.Token);
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            while (_pollTimer is not null && await _pollTimer.WaitForNextTickAsync(ct))
                if (IsActive) await InvokeAsync(ReloadAsync);
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthChange;
        _pollCts?.Cancel();
        _pollTimer?.Dispose();
        _pollCts?.Dispose();
    }
}

