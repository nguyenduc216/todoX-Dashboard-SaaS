    private static DateTime RenderStartUtc(DanceSellJobDto job)
        => DateTime.SpecifyKind(job.SubmittedAt ?? job.CreatedAt, DateTimeKind.Utc);

    private DateTime? RenderEndUtc(DanceSellJobDto job)
        => IsCoreCancelled ? _renderJob?.CancelledAt : job.CompletedAt;

    private TimeSpan RenderDuration(DanceSellJobDto job)
    {
        var end = RenderEndUtc(job) is DateTime completed
            ? DateTime.SpecifyKind(completed, DateTimeKind.Utc)
            : DateTime.UtcNow;
        var duration = end - RenderStartUtc(job);
        return duration < TimeSpan.Zero ? TimeSpan.Zero : duration;
    }

    private static string FormatVietnamTime(DateTime? value)
    {
        if (value is null) return "—";
        var utc = DateTime.SpecifyKind(value.Value, DateTimeKind.Utc);
        var zone = ResolveVietnamTimeZone();
        return TimeZoneInfo.ConvertTimeFromUtc(utc, zone).ToString("dd/MM/yyyy HH:mm:ss");
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
        {
            return $"{(int)duration.TotalHours} giờ {duration.Minutes:00} phút {duration.Seconds:00} giây";
        }

        if (duration.TotalMinutes >= 1)
        {
            return $"{(int)duration.TotalMinutes} phút {duration.Seconds:00} giây";
        }

        return $"{Math.Max(0, (int)duration.TotalSeconds)} giây";
    }

    private static TimeZoneInfo ResolveVietnamTimeZone()
    {
        foreach (var id in new[] { "SE Asia Standard Time", "Asia/Ho_Chi_Minh" })
        {
            try
            {
                return TimeZoneInfo.FindSystemTimeZoneById(id);
            }
            catch (TimeZoneNotFoundException) { }
            catch (InvalidTimeZoneException) { }
        }

        return TimeZoneInfo.Utc;
    }

