    private async Task PollReferenceComparisonAsync(Guid versionId) => await RunAsync(async () =>
    {
        await ReferenceComparison.PollAsync(_job!.Id, versionId, AuthState.CurrentUser!);
        await ReloadAsync();
    });

    private async Task ScoreReferenceComparisonAsync(Guid versionId) => await RunAsync(async () =>
    {
        await ReferenceComparison.ScoreAsync(_job!.Id, versionId, new DanceSellReferenceComparisonScoreRequest
        {
            ShirtColorFidelity = _scoreShirtColor,
            GarmentShapeFidelity = _scoreGarmentShape,
            GraphicTextFidelity = _scoreGraphicText,
            LogoArtworkFidelity = _scoreLogoArtwork,
            SelectedBottomFidelity = _scoreSelectedBottom,
            IdentityPreservation = _scoreIdentity
        }, AuthState.CurrentUser!);
        Snackbar.Add("A/B score saved.", Severity.Success);
        await ReloadAsync();
    });

    private async Task ConfirmAndQueueAsync()
    {
        if (!string.IsNullOrWhiteSpace(_motionReadinessError))
        {
            Snackbar.Add(_motionReadinessError, Severity.Error);
            return;
        }

        EnsureMotionProviderReady();
        await RefreshEstimateAsync();
        var points = _estimate?.EstimatedTodoxPoints?.ToString("0.##") ?? "chưa cấu hình";
        var confirmed = await DialogService.ShowMessageBoxAsync("Xác nhận tạo video",
            (MarkupString)$"Tạo video <b>{_title}</b> bằng <b>Kling Motion Control</b>, tỷ lệ <b>9:16</b>, ước tính <b>{points} điểm</b>?",
            yesText: "Xác nhận tạo video", cancelText: "Quay lại chỉnh sửa");
        if (confirmed == true)
        {
            await RunAsync(async () =>
            {
                await UpdateBusinessAsync();
                _job = await DanceSell.GetAsync(_job!.Id, AuthState.CurrentUser!);
                if (_job.PreparedReferenceStatus != DanceSellReferenceStatuses.Approved
                    || string.IsNullOrWhiteSpace(_job.PreparedReferenceUrl))
                {
                    throw new InvalidOperationException("DANCE_SELL_REFERENCE_NOT_APPROVED");
                }

                _job = await DanceSell.QueueRenderAsync(_job!.Id, AuthState.CurrentUser!);
                _tabIndex = 3;
                await ReloadAsync();
            });
        }
    }

    private async Task CancelAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Dừng render", "Dừng job đang chạy?", yesText: "Dừng", cancelText: "Tiếp tục");
        if (confirmed == true)
        {
            await RunAsync(async () =>
            {
                _job = await DanceSell.CancelAsync(_job!.Id, "Customer requested stop.", AuthState.CurrentUser!);
                await ReloadAsync();
                Snackbar.Add("Đã dừng tạo video.", Severity.Success);
            });
        }
    }

    private async Task RetryAsync() => await RunAsync(async () =>
    {
        _job = await DanceSell.RetryAsync(_job!.Id, AuthState.CurrentUser!);
        _tabIndex = 3;
        await ReloadAsync();
    });

    private Task OpenAsync(Guid id)
    {
        Navigation.NavigateTo($"/jobs/rdance/{id}");
        return Task.CompletedTask;
    }

    private async Task UpdateBusinessAsync()
        => _job = await DanceSell.UpdateBusinessAsync(_job!.Id, new DanceSellUpdateBusinessRequest
        {
            Title = _title,
            Prompt = BuildPrompt(),
            PlacementMode = DanceSellPlacementModes.WearProduct,
            ReferenceMode = DanceSellReferenceModes.GenerateReference,
            Mode = "720p",
            CharacterOrientation = "image"
        }, AuthState.CurrentUser!);

    private async Task RefreshEstimateAsync()
    {
        var route = _motionRoutes.FirstOrDefault(x => x.ProviderCode.Equals(DanceSellConstants.ProviderCode, StringComparison.OrdinalIgnoreCase)) ?? _motionRoutes.FirstOrDefault();
        if (route is null) return;
        var providerMode = DanceSellMotionProviderContract.ResolveProviderMode(route, "720p");
        _estimate = await Costs.EstimateAsync(route, providerMode, null);
        if (AuthState.CurrentUser?.CustomerId is Guid customerId) _balance = await Wallet.GetBalanceAsync(customerId);
    }

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        try { await action(); }
        catch (Exception ex) { Snackbar.Add(CustomerErrorMessage(ex), Severity.Error); }
        finally { _busy = false; await InvokeAsync(StateHasChanged); }
    }

    private static string CustomerErrorMessage(Exception ex)
    {
        var message = ex.Message;
        if (message.Contains("DANCE_SELL_INVALID_PRODUCT", StringComparison.OrdinalIgnoreCase))
        {
            return "Ảnh sản phẩm chưa sẵn sàng. Vui lòng tải lại ảnh sản phẩm.";
        }

        if (message.Contains("DANCE_SELL_INVALID_CHARACTER", StringComparison.OrdinalIgnoreCase))
        {
            return "Ảnh người mẫu chưa sẵn sàng. Vui lòng tải lại ảnh người mẫu.";
        }

        if (message.Contains("DANCE_SELL_REFERENCE_NOT_APPROVED", StringComparison.OrdinalIgnoreCase))
        {
            return "Ảnh dùng để tạo video đã thay đổi. Vui lòng tạo và duyệt lại ảnh trước khi render.";
        }

        if (message.Contains("DANCE_SELL_CANCEL_FAILED", StringComparison.OrdinalIgnoreCase))
        {
            return "Không thể dừng video lúc này. Vui lòng thử lại.";
        }

        return message;
    }

    private string BuildPrompt()
        => $"Create a fashion dance video. Category: {_category}. Preserve identity, face, anatomy and product design. Dress the person in the supplied product, keep colors, patterns and logos consistent, follow the staged motion naturally, no text, watermark, extra people or duplicated limbs.";

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1024L * 1024 * 1024)
        {
            return $"{bytes / 1024d / 1024d / 1024d:0.##} GB";
        }

        return bytes >= 1024L * 1024
            ? $"{bytes / 1024d / 1024d:0.##} MB"
            : $"{bytes / 1024d:0.##} KB";
    }

    private DanceSellReferenceVersionDto? FindComparisonVersion(string modelName)
        => _referenceVersions
            .Where(x => string.Equals(x.ProviderModel, modelName, StringComparison.OrdinalIgnoreCase) && IsComparisonVersion(x))
            .OrderByDescending(x => x.VersionNo)
            .FirstOrDefault();

    private static bool IsComparisonVersion(DanceSellReferenceVersionDto version)
        => (version.RequestJson?.Contains(DanceSellConstants.ReferenceComparisonExperiment, StringComparison.Ordinal) == true)
           || (version.ResponseJson?.Contains(DanceSellConstants.ReferenceComparisonExperiment, StringComparison.Ordinal) == true)
           || (version.ErrorJson?.Contains(DanceSellConstants.ReferenceComparisonExperiment, StringComparison.Ordinal) == true);

    private static Color ComparisonStatusColor(DanceSellReferenceVersionDto? version) => version?.Status switch
    {
        DanceSellReferenceStatuses.Ready => Color.Success,
        DanceSellReferenceStatuses.Generating => Color.Warning,
        DanceSellReferenceStatuses.Failed => Color.Error,
        _ => Color.Default
    };

    private static RenderFragment Preview(string? url, string alt) => @<div class="rdance-media-preview">
        @if (!string.IsNullOrWhiteSpace(url))
        {
            <img src="@url" alt="@alt" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
        }
    </div>;

    private static Color StatusColor(string status) => status switch
    {
        DanceSellJobStatuses.Completed => Color.Success,
        DanceSellJobStatuses.Failed or DanceSellJobStatuses.Timeout => Color.Error,
        DanceSellJobStatuses.Queued or DanceSellJobStatuses.Submitted or DanceSellJobStatuses.Rendering => Color.Warning,
        _ => Color.Default
    };

    private void StartPolling()
    {
        StopPolling();
        _pollCts = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = PollLoopAsync(_pollCts.Token);
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollTimer?.Dispose();
        _pollCts?.Dispose();
        _pollCts = null;
        _pollTimer = null;
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            while (_pollTimer is not null && await _pollTimer.WaitForNextTickAsync(ct))
            {
                if (IsReferenceGenerating)
                {
                    await InvokeAsync(AutoPrepareReferenceAsync);
                }
                else if (IsActive)
                {
                    var wasActive = IsActive;
                    await InvokeAsync(() => ReloadAsync(wasActive));
                    if (wasActive && !IsActive)
                    {
                        StopPolling();
                    }
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthChange;
        _pollCts?.Cancel();
        _pollTimer?.Dispose();
        _pollCts?.Dispose();
    }
}

