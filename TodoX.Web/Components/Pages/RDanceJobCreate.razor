@page "/jobs/rdance/new"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Options
@using TodoX.Web.Components.Dialogs
@using TodoX.Web.Models.Catalog
@using TodoX.Web.Services.DanceSell
@inject CatalogRepository Catalog
@inject AuthStateService AuthState
@inject IDanceSellPhase2Service DanceSell
@inject IDanceSellReferenceImageService References
@inject IDanceSellProviderCatalog ProviderCatalog
@inject IOptionsMonitor<DanceSellPhase2Options> DanceOptions
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IRDanceFeatureService RDanceFeatures

<PageTitle>Video nhảy quảng cáo thời trang</PageTitle>

<MudStack Spacing="3" Class="rdance-create-page">
    @if (!AuthState.IsInitialized)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (AuthState.CurrentUser is not { IsCustomer: true })
    {
        <MudAlert Severity="Severity.Warning">Vui lòng đăng nhập bằng tài khoản khách hàng.</MudAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_readinessError))
        {
            <MudAlert Severity="Severity.Error">@_readinessError</MudAlert>
        }

        @if (RDanceFeatures.IsNewUiEnabled)
        {
        <div class="rdance-page-container rdance-onepage-layout">
            <MudPaper Class="todox-panel rdance-header-card">
                <div class="rdance-header-row">
                    <div class="rdance-header-copy">
                        <div class="rdance-header-title-row">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                           Color="Color.Default"
                                           OnClick="@(() => Navigation.NavigateTo("/create"))"
                                           aria-label="Quay lại kho dịch vụ" />
                            <div class="rdance-header-title-editor">
                                <MudTextField T="string"
                                              Label="Tên video"
                                              Variant="Variant.Text"
                                              Class="rdance-header-title-input"
                                              @bind-Value="_title"
                                              Disabled="@_busy" />
                                <MudText Typo="Typo.body2" Class="rdance-muted-line">Tạo video quảng cáo thời trang từ chuyển động TikTok hoặc video MP4.</MudText>
                            </div>
                        </div>
                    </div>
                    <div class="rdance-header-actions">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.OpenInBrowser"
                                   Href="@Navigation.Uri"
                                   Target="_blank">
                            Xem Browser
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@_busy"
                                   OnClick="CreateDraftAndOpenAsync">
                            Lưu thay đổi
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.MovieCreation"
                                   Disabled="@(_busy || !CanSubmitSource)"
                                   OnClick="CreateDraftAndOpenAsync">
                            Tạo video
                        </MudButton>
                    </div>
                </div>
            </MudPaper>

            <div class="rdance-workflow-grid">
                <MudPaper Class="todox-panel rdance-step-card">
                    <div class="rdance-step-head">
                        <span class="rdance-step-chip">1</span>
                        <div>
                            <MudText Typo="Typo.h6">Hình ảnh tham chiếu</MudText>
                            <MudText Typo="Typo.body2" Class="rdance-muted-line">Người mẫu, sản phẩm và khung ảnh chính.</MudText>
                        </div>
                    </div>
                    <div class="rdance-step1-layout">
                        <div class="rdance-thumbnail-stack">
                            <label class="rdance-thumbnail" title="Ảnh người mẫu">
                                <span class="rdance-thumbnail-inner">
                                    @if (!string.IsNullOrWhiteSpace(_job?.CharacterImageUrl))
                                    {
                                        <img src="@_job.CharacterImageUrl" alt="Ảnh người mẫu" class="rdance-thumbnail-image" />
                                    }
                                    else
                                    {
                                        <span class="rdance-thumbnail-empty"><MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" /><span>Ảnh người mẫu</span></span>
                                    }
                                </span>
                                <InputFile class="rdance-hidden-file-input" OnChange="OnCharacterSelected" accept="@AcceptedImageTypes" disabled="@_busy" />
                            </label>
                            <label class="rdance-thumbnail" title="Ảnh sản phẩm">
                                <span class="rdance-thumbnail-inner">
                                    @if (!string.IsNullOrWhiteSpace(_job?.ProductImageUrl))
                                    {
                                        <img src="@_job.ProductImageUrl" alt="Ảnh sản phẩm" class="rdance-thumbnail-image" />
                                    }
                                    else
                                    {
                                        <span class="rdance-thumbnail-empty"><MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" /><span>Ảnh sản phẩm</span></span>
                                    }
                                </span>
                                <InputFile class="rdance-hidden-file-input" OnChange="OnProductSelected" accept="@AcceptedImageTypes" disabled="@_busy" />
                            </label>
                            <button type="button"
                                    class="rdance-thumbnail rdance-merge-thumbnail"
                                    title="Ghép ảnh"
                                    disabled="@(_busy || _job?.CharacterMediaId is null || _job?.ProductMediaId is null)"
                                    @onclick="GenerateReferenceAsync">
                                <span class="rdance-thumbnail-inner">
                                    @if (!string.IsNullOrWhiteSpace(_job?.PreparedReferenceUrl))
                                    {
                                        <img src="@_job.PreparedReferenceUrl" alt="Ảnh ghép" class="rdance-thumbnail-image" />
                                    }
                                    else
                                    {
                                        <span class="rdance-thumbnail-empty"><MudIcon Icon="@Icons.Material.Filled.Merge" Size="Size.Small" /><span>Ghép ảnh</span></span>
                                    }
                                </span>
                            </button>
                        </div>
                        <div class="rdance-media-frame rdance-main-frame">
                            @if (!string.IsNullOrWhiteSpace(CreateReferenceImageUrl))
                            {
                                <img src="@CreateReferenceImageUrl" alt="Ảnh tham chiếu" class="rdance-frame-media rdance-frame-image" />
                            }
                            else
                            {
                                <div class="rdance-empty-media"><MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" /><span>Ảnh tham chiếu</span></div>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_imageUploadError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">@_imageUploadError</MudAlert>
                    }
                </MudPaper>

                <MudPaper Class="todox-panel rdance-step-card">
                    <div class="rdance-step-head">
                        <span class="rdance-step-chip">2</span>
                        <div>
                            <MudText Typo="Typo.h6">Video tham chiếu</MudText>
                            <MudText Typo="Typo.body2" Class="rdance-muted-line">Nguồn video 9:16.</MudText>
                        </div>
                    </div>
                    <div class="rdance-media-frame rdance-video-frame">
                        @if (!string.IsNullOrWhiteSpace(_job?.MotionVideoUrl))
                        {
                            <video src="@_job.MotionVideoUrl" controls muted playsinline class="rdance-frame-media rdance-frame-video"></video>
                        }
                        else
                        {
                            <div class="rdance-empty-media"><MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" /><span>Video tham chiếu</span></div>
                        }
                        <div class="rdance-overlay-actions">
                            <MudIconButton Icon="@Icons.Custom.Brands.TikTok"
                                           Class="@TikTokOverlayButtonClass"
                                           Disabled="@_busy"
                                           aria-label="TikTok"
                                           OnClick="OpenTikTokEditorAsync" />
                            <label class="@UploadOverlayButtonClass" title="Tải lên video">
                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" />
                                <InputFile class="rdance-hidden-file-input"
                                           OnChange="OnMotionSelected"
                                           accept="video/mp4"
                                           disabled="@(_busy || !CanSubmitSource)" />
                            </label>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_motionUploadError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">@_motionUploadError</MudAlert>
                    }
                </MudPaper>

                <MudPaper Class="todox-panel rdance-step-card">
                    <div class="rdance-step-head">
                        <span class="rdance-step-chip">3</span>
                        <div>
                            <MudText Typo="Typo.h6">Kết quả</MudText>
                            <MudText Typo="Typo.body2" Class="rdance-muted-line">Video đầu ra 9:16.</MudText>
                        </div>
                    </div>
                    <div class="rdance-media-frame rdance-result-frame">
                        <div class="rdance-empty-media">
                            <MudIcon Icon="@Icons.Material.Filled.PlayCircleOutline" Size="Size.Large" />
                            <span>Video kết quả</span>
                        </div>
                    </div>
                </MudPaper>

                <MudPaper Class="todox-panel rdance-step-card rdance-step-card--compact">
                    <div class="rdance-step-head">
                        <span class="rdance-step-chip">4</span>
                        <MudText Typo="Typo.h6">Trạng thái</MudText>
                    </div>
                    <div class="rdance-status-list">
                        <div class="rdance-status-item">
                            <div><MudIcon Icon="@CreateStatusIcon(CreateReferenceStatusKey)" Color="@CreateStatusColor(CreateReferenceStatusKey)" Size="Size.Small" /> <span>Hình ảnh tham chiếu</span></div>
                            <span class="@CreateStatusClass(CreateReferenceStatusKey)">@CreateStatusLabel(CreateReferenceStatusKey)</span>
                        </div>
                        <div class="rdance-status-item">
                            <div><MudIcon Icon="@CreateStatusIcon(CreateMotionStatusKey)" Color="@CreateStatusColor(CreateMotionStatusKey)" Size="Size.Small" /> <span>Video tham chiếu</span></div>
                            <span class="@CreateStatusClass(CreateMotionStatusKey)">@CreateStatusLabel(CreateMotionStatusKey)</span>
                        </div>
                        <div class="rdance-status-item">
                            <div><MudIcon Icon="@CreateStatusIcon(CreateRenderStatusKey)" Color="@CreateStatusColor(CreateRenderStatusKey)" Size="Size.Small" /> <span>Render kết quả</span></div>
                            <span class="@CreateStatusClass(CreateRenderStatusKey)">@CreateStatusLabel(CreateRenderStatusKey)</span>
                        </div>
                        <div class="rdance-status-item">
                            <div><MudIcon Icon="@CreateStatusIcon(CreateResultStatusKey)" Color="@CreateStatusColor(CreateResultStatusKey)" Size="Size.Small" /> <span>Video kết quả</span></div>
                            <span class="@CreateStatusClass(CreateResultStatusKey)">@CreateStatusLabel(CreateResultStatusKey)</span>
                        </div>
                    </div>
                </MudPaper>
            </div>
        </div>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="@(() => Navigation.NavigateTo("/create"))" />
                <div>
                    <MudText Typo="Typo.h4" Class="todox-page-title">Video nhảy quảng cáo thời trang</MudText>
                    <MudText Typo="Typo.body1" Class="todox-page-subtitle">Tạo video quảng cáo thời trang từ chuyển động TikTok hoặc video MP4.</MudText>
                </div>
            </MudStack>
            <MudGrid>
                <MudItem xs="12" lg="7">
                    <MudPaper Class="todox-card pa-4" rounded="true">
                        <MudStack Spacing="3">
                            <MudTextField T="string" Label="Tên video" Variant="Variant.Outlined" @bind-Value="_title" Disabled="@_busy" />
                            <MudSwitch T="bool" Color="Color.Warning" @bind-Value="_autoFinish" Disabled="@_busy">Tự động hoàn thành</MudSwitch>
                            <MudSelect T="string" Label="Danh mục thời trang" Variant="Variant.Outlined" @bind-Value="_category" Disabled="@_busy">
                                <MudSelectItem Value="@("shirt")">Áo</MudSelectItem>
                                <MudSelectItem Value="@("pants")">Quần</MudSelectItem>
                                <MudSelectItem Value="@("dress")">Váy</MudSelectItem>
                                <MudSelectItem Value="@("set")">Set đồ</MudSelectItem>
                                <MudSelectItem Value="@("outerwear")">Áo khoác</MudSelectItem>
                                <MudSelectItem Value="@("other")">Khác</MudSelectItem>
                            </MudSelect>
                            <MudSelect T="string" Label="Tỷ lệ video" Variant="Variant.Outlined" @bind-Value="_ratio" Disabled="@_busy">
                                <MudSelectItem Value="@("9:16")">9:16</MudSelectItem>
                                <MudSelectItem Value="@("16:9")">16:9</MudSelectItem>
                            </MudSelect>
                            <MudText Typo="Typo.caption" Class="rdance-auto-finish-help">
                                @(_autoFinish ? "Hệ thống sẽ tự động chuẩn bị ảnh, duyệt ảnh và tạo video khi dữ liệu đã đầy đủ." : "Bạn sẽ xác nhận từng bước trước khi tạo video.")
                            </MudText>
                            <MudTextField T="string" Label="Link TikTok" Variant="Variant.Outlined" @bind-Value="_tiktokUrl" Disabled="@_busy" />
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(_busy || !CanSubmitSource || string.IsNullOrWhiteSpace(_tiktokUrl))" OnClick="StageTikTokAndOpenAsync">Tải và kiểm tra video</MudButton>
                            <div class="rdance-source-divider"><span>HOẶC</span></div>
                            <label class="@MotionUploadZoneClass">
                                <InputFile class="rdance-hidden-file-input" OnChange="OnMotionSelected" accept="video/mp4" disabled="@(_busy || !CanSubmitSource)" />
                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" />
                                <span class="rdance-upload-title">Kéo thả video MP4 vào đây</span>
                                <span class="rdance-upload-subtitle">hoặc bấm để chọn video</span>
                                <span class="rdance-upload-limit">MP4 · tối đa @MaxMotionVideoLabel</span>
                            </label>
                            @if (!string.IsNullOrWhiteSpace(_motionUploadError))
                            {
                                <MudAlert Severity="Severity.Error" Dense="true">@_motionUploadError</MudAlert>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="5">
                    <MudPaper Class="todox-card pa-4" rounded="true">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.overline">THÔNG TIN DỊCH VỤ</MudText>
                            <MudText Typo="Typo.h6">Video nhảy quảng cáo thời trang</MudText>
                            <MudList T="string" Dense="true">
                                <MudListItem T="string">Dịch vụ: Video nhảy quảng cáo thời trang</MudListItem>
                                <MudListItem T="string">Tỷ lệ: @_ratio</MudListItem>
                            </MudList>
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.MovieCreation" Disabled="@(_busy || !CanSubmitSource)" OnClick="CreateDraftAndOpenAsync">Tạo video và tiếp tục</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    }
</MudStack>

@code {
    [SupplyParameterFromQuery] public Guid? ServiceId { get; set; }
    [SupplyParameterFromQuery] public string? ServiceCode { get; set; }

    private const string DefaultTitle = "Video nhảy quảng cáo thời trang";
    private string _title = DefaultTitle;
    private string _category = "shirt";
    private string _tiktokUrl = string.Empty;
    private DanceSellJobDto? _job;
    private string? _readinessError;
    private string? _imageUploadError;
    private string? _motionUploadError;
    private bool _motionDragActive;
    private bool _busy;
    private bool _autoFinish = true;
    private string _ratio = "9:16";

    private const string AcceptedImageTypes = "image/png,image/jpeg,image/webp";
    private bool CanSubmitSource => string.IsNullOrWhiteSpace(_readinessError);
    private string? CreateReferenceImageUrl => _job?.PreparedReferenceUrl ?? _job?.CharacterImageUrl ?? _job?.ProductImageUrl;
    private long MaxMotionVideoBytes => (long)Math.Max(1, DanceOptions.CurrentValue.MaxVideoMb) * 1024 * 1024;
    private long MaxImageBytes => (long)Math.Max(1, DanceOptions.CurrentValue.MaxImageMb) * 1024 * 1024;
    private string MaxMotionVideoLabel => $"{Math.Max(1, DanceOptions.CurrentValue.MaxVideoMb)}MB";
    private string MaxImageLabel => $"{Math.Max(1, DanceOptions.CurrentValue.MaxImageMb)}MB";
    private string MotionUploadZoneClass => $"rdance-upload-zone{(_motionDragActive ? " is-dragging" : string.Empty)}{(_busy ? " is-busy" : string.Empty)}";
    private string TikTokOverlayButtonClass => $"rdance-overlay-button {(_job?.MotionSourceType == DanceSellMotionSourceTypes.TikTok || !string.IsNullOrWhiteSpace(_tiktokUrl) ? "is-active" : "is-inactive")}";
    private string UploadOverlayButtonClass => $"rdance-overlay-button {(_job?.MotionSourceType == DanceSellMotionSourceTypes.Upload || !string.IsNullOrWhiteSpace(_job?.MotionVideoUrl) ? "is-active" : "is-inactive")}";
    private string CreateReferenceStatusKey => _job?.PreparedReferenceStatus switch
    {
        DanceSellReferenceStatuses.Generating => "yellow",
        DanceSellReferenceStatuses.Ready => "yellow",
        DanceSellReferenceStatuses.Approved when !string.IsNullOrWhiteSpace(_job?.PreparedReferenceUrl) => "green",
        DanceSellReferenceStatuses.Failed => "gray",
        _ when _job?.PreparedReferenceUrl is not null
            || _job?.CharacterMediaId is not null
            || _job?.ProductMediaId is not null => "yellow",
        _ => "gray"
    };
    private string CreateMotionStatusKey => _job?.SourceStageStatus switch
    {
        DanceSellSourceStageStatuses.Resolving
            or DanceSellSourceStageStatuses.Downloading
            or DanceSellSourceStageStatuses.Staging => "yellow",
        DanceSellSourceStageStatuses.Failed => "gray",
        DanceSellSourceStageStatuses.Ready when _job?.MotionVideoMediaId is not null
            && !string.IsNullOrWhiteSpace(_job.MotionVideoUrl) => "green",
        _ when _job?.MotionVideoMediaId is not null
            || !string.IsNullOrWhiteSpace(_job?.MotionVideoUrl) => "yellow",
        _ => "gray"
    };
    private string CreateRenderStatusKey => _job?.Status switch
    {
        DanceSellJobStatuses.Queued
            or DanceSellJobStatuses.Submitted
            or DanceSellJobStatuses.Rendering => "yellow",
        DanceSellJobStatuses.Completed => "green",
        _ => "gray"
    };
    private string CreateResultStatusKey => _job?.Status switch
    {
        DanceSellJobStatuses.Queued
            or DanceSellJobStatuses.Submitted
            or DanceSellJobStatuses.Rendering => "yellow",
        DanceSellJobStatuses.Completed when !string.IsNullOrWhiteSpace(_job.ResultVideoUrl) => "green",
        _ => "gray"
    };
    private static Color CreateStatusColor(string key) => key switch
    {
        "green" => Color.Success,
        "yellow" => Color.Warning,
        _ => Color.Default
    };
    private static string CreateStatusClass(string key) => $"rdance-status-pill {key switch
    {
        "green" => "is-green",
        "yellow" => "is-yellow",
        _ => "is-gray"
    }}";
    private static string CreateStatusIcon(string key)
        => key == "green" ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked;
    private static string CreateStatusLabel(string key) => key switch
    {
        "green" => "Hoàn tất",
        "yellow" => "Đang xử lý",
        _ => "Chưa có dữ liệu"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadServiceDefaultsAsync();
        await CheckReadinessAsync();
    }

    private async Task LoadServiceDefaultsAsync()
    {
        CatalogServiceView? service = (await Catalog.GetActiveCatalogServicesAsync())
            .FirstOrDefault(x => string.Equals(x.ServiceCode, FixedTodoXServiceCatalog.RDance, StringComparison.OrdinalIgnoreCase));

        if (service is null)
        {
            return;
        }

        var defaults = ServiceJobDefaultsCodec.FromJson(service.JobDefaultsJson);
        if (defaults.Ratio is "9_16" or "16_9")
        {
            _ratio = defaults.Ratio == "16_9" ? "16:9" : "9:16";
        }
        if (defaults.AutoFinish.HasValue)
        {
            _autoFinish = defaults.AutoFinish.Value;
        }
    }

    private async Task CheckReadinessAsync()
    {
        _readinessError = null;
        try
        {
            var route = await ProviderCatalog.GetDefaultRouteAsync(DanceSellOperationTypes.MotionVideo);
            if (!route.ProviderCode.Equals(DanceSellConstants.ProviderCode, StringComparison.OrdinalIgnoreCase)
                || !route.ModelName.Equals(DanceSellConstants.Model, StringComparison.OrdinalIgnoreCase))
            {
                _readinessError = "Dịch vụ video nhảy quảng cáo thời trang chưa được cấu hình Motion Control.";
            }
        }
        catch
        {
            _readinessError = "Dịch vụ video nhảy quảng cáo thời trang chưa được cấu hình Motion Control.";
        }
    }

    private async Task CreateDraftAndOpenAsync()
        => await RunAsync(async () =>
        {
            var job = await (RDanceFeatures.IsNewUiEnabled ? EnsureDraftAsync() : CreateDraftAsync());
            Navigation.NavigateTo($"/jobs/rdance/{job.Id}");
        });

    private async Task StageTikTokAndOpenAsync()
        => await RunAsync(async () =>
        {
            var job = await (RDanceFeatures.IsNewUiEnabled ? EnsureDraftAsync() : CreateDraftAsync());
            _job = await DanceSell.StageTikTokAsync(job.Id, _tiktokUrl.Trim(), AuthState.CurrentUser!);
            Navigation.NavigateTo($"/jobs/rdance/{job.Id}");
        });

    private async Task OpenTikTokEditorAsync()
    {
        var parameters = new DialogParameters<RDanceTikTokUrlDialog>
        {
            { x => x.CurrentUrl, _tiktokUrl }
        };
        var options = new DialogOptions
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Small
        };
        var dialog = await DialogService.ShowAsync<RDanceTikTokUrlDialog>("TikTok URL", parameters, options);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not string url || string.IsNullOrWhiteSpace(url))
        {
            return;
        }

        _tiktokUrl = url.Trim();
        await StageTikTokAndOpenAsync();
    }

    private async Task GenerateReferenceAsync()
        => await RunAsync(async () =>
        {
            var job = await EnsureDraftAsync();
            if (job.CharacterMediaId is null || job.ProductMediaId is null)
            {
                return;
            }

            _job = await References.AutoPrepareAsync(job.Id, AuthState.CurrentUser!);
            Snackbar.Add("Đã bắt đầu ghép ảnh.", Severity.Success);
        });

    private async Task OnCharacterSelected(InputFileChangeEventArgs args)
        => await OnImageSelectedAsync(args, character: true);

    private async Task OnProductSelected(InputFileChangeEventArgs args)
        => await OnImageSelectedAsync(args, character: false);

    private async Task OnImageSelectedAsync(InputFileChangeEventArgs args, bool character)
    {
        var file = args.File;
        var error = ValidateImage(file);
        if (!string.IsNullOrWhiteSpace(error))
        {
            _imageUploadError = error;
            Snackbar.Add(error, Severity.Error);
            await InvokeAsync(StateHasChanged);
            return;
        }

        _imageUploadError = null;
        await RunAsync(async () =>
        {
            var job = await EnsureDraftAsync();
            await using var input = file.OpenReadStream(MaxImageBytes);
            using var buffer = new MemoryStream();
            await input.CopyToAsync(buffer);
            _job = character
                ? await DanceSell.UploadCharacterAsync(job.Id, buffer.ToArray(), file.Name, file.ContentType, AuthState.CurrentUser!)
                : await DanceSell.UploadProductAsync(job.Id, buffer.ToArray(), file.Name, file.ContentType, AuthState.CurrentUser!);
            Snackbar.Add("Tải ảnh thành công.", Severity.Success);
        });
    }

    private async Task OnMotionSelected(InputFileChangeEventArgs args)
    {
        _motionDragActive = false;
        var file = args.File;
        var error = ValidateMotionVideo(file);
        if (!string.IsNullOrWhiteSpace(error))
        {
            _motionUploadError = error;
            Snackbar.Add(error, Severity.Error);
            await InvokeAsync(StateHasChanged);
            return;
        }

        _motionUploadError = null;
        await RunAsync(async () =>
        {
            var job = await (RDanceFeatures.IsNewUiEnabled ? EnsureDraftAsync() : CreateDraftAsync());
            await using var input = file.OpenReadStream(MaxMotionVideoBytes);
            using var buffer = new MemoryStream();
            await input.CopyToAsync(buffer);
            _job = await DanceSell.UploadMotionAsync(job.Id, buffer.ToArray(), file.Name, file.ContentType, AuthState.CurrentUser!);
            _job = await DanceSell.GetAsync(job.Id, AuthState.CurrentUser!);
            if (!HasAutoFinishPrerequisites(_job))
            {
                return;
            }

            Navigation.NavigateTo($"/jobs/rdance/{job.Id}");
        });
    }

    private static bool HasAutoFinishPrerequisites(DanceSellJobDto job)
        => job.MotionVideoMediaId is not null
            && !string.IsNullOrWhiteSpace(job.MotionVideoUrl)
            && job.SourceStageStatus == DanceSellSourceStageStatuses.Ready
            && !string.IsNullOrWhiteSpace(job.PreparedReferenceUrl)
            && job.PreparedReferenceStatus == DanceSellReferenceStatuses.Approved;

    private async Task<DanceSellJobDto> EnsureDraftAsync()
    {
        if (_job is not null)
        {
            return _job;
        }

        _job = await CreateDraftAsync();
        return _job;
    }

    private async Task<DanceSellJobDto> CreateDraftAsync()
    {
        if (!string.IsNullOrWhiteSpace(_readinessError))
        {
            throw new InvalidOperationException(_readinessError);
        }

        _title = string.IsNullOrWhiteSpace(_title) ? DefaultTitle : _title.Trim();
        return await DanceSell.CreateJobAsync(new DanceSellCreateJobRequest
        {
            Title = _title,
            Prompt = BuildPrompt(),
            PlacementMode = DanceSellPlacementModes.WearProduct,
            ReferenceMode = DanceSellReferenceModes.GenerateReference,
            Mode = "720p",
            Ratio = _ratio,
            CharacterOrientation = "image",
            AutoFinish = _autoFinish
        }, AuthState.CurrentUser!);
    }

    private string? ValidateImage(IBrowserFile file)
    {
        if (file.Size <= 0)
        {
            return "Ảnh không hợp lệ.";
        }

        if (file.Size > MaxImageBytes)
        {
            return "Ảnh vượt quá dung lượng cho phép.";
        }

        var extension = Path.GetExtension(file.Name);
        if (string.IsNullOrWhiteSpace(file.Name)
            || (!file.ContentType.Equals("image/png", StringComparison.OrdinalIgnoreCase)
                && !file.ContentType.Equals("image/jpeg", StringComparison.OrdinalIgnoreCase)
                && !file.ContentType.Equals("image/webp", StringComparison.OrdinalIgnoreCase)
                && extension is not ".png" and not ".jpg" and not ".jpeg" and not ".webp"))
        {
            return "Chỉ hỗ trợ ảnh PNG, JPG, JPEG hoặc WEBP.";
        }

        return null;
    }

    private string? ValidateMotionVideo(IBrowserFile file)
    {
        if (file.Size <= 0)
        {
            return "Video không hợp lệ.";
        }

        if (file.Size > MaxMotionVideoBytes)
        {
            return "Video vượt quá dung lượng cho phép.";
        }

        if (string.IsNullOrWhiteSpace(file.Name)
            || (!file.ContentType.Equals("video/mp4", StringComparison.OrdinalIgnoreCase)
                && !Path.GetExtension(file.Name).Equals(".mp4", StringComparison.OrdinalIgnoreCase)))
        {
            return "Chỉ hỗ trợ video MP4.";
        }

        return null;
    }

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy || AuthState.CurrentUser is not { IsCustomer: true })
        {
            return;
        }

        _busy = true;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string BuildPrompt()
        => RDanceFeatures.IsNewUiEnabled
            ? "Create a fashion dance advertising video. Preserve identity, face, anatomy and product design. Dress the person in the supplied product, keep colors, patterns and logos consistent, follow the staged motion naturally, no text, watermark, extra people or duplicated limbs."
            : $"Create a fashion dance advertising video. Category: {_category}. Preserve identity, face, anatomy and product design. Dress the person in the supplied product, keep colors, patterns and logos consistent, follow the staged motion naturally, no text, watermark, extra people or duplicated limbs.";

    private void OnMotionDragEnter(DragEventArgs _) => _motionDragActive = true;
    private void OnMotionDragLeave(DragEventArgs _) => _motionDragActive = false;
    private void OnMotionDrop(DragEventArgs _) => _motionDragActive = false;
}

