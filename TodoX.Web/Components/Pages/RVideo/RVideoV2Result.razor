@using TodoX.Web.Models
@using TodoX.Web.Services.VideoRender
@inject IRVideoProjectFinalizationService RVideoFinalization
@inject ISnackbar Snackbar
@inject AuthStateService AuthState
<div class="rv2-result">
@if(JobView is null)
{
  <div class="rv2-skel rv2-result-skel"></div>
}
else
{
  var p = JobView.Project;
  var ready = p.Scenes.Count(x=>x.Status==VideoSceneStatuses.VideoReady);
  <section class="rv2-result-card">
    <div class="rv2-result-media">
      @if(!string.IsNullOrWhiteSpace(p.FinalVideoUrl))
      {
        <video @key="JobView.Project.FinalVideoUrl" src="@p.FinalVideoUrl" controls playsinline preload="metadata" class="rv2-final-video"></video>
      }
      else
      {
        <div class="rv2-final-ph">
          <MudIcon Icon="@Icons.Material.Outlined.Movie" />
          <span>Chưa có video hoàn chỉnh</span>
          <span class="rv2-result-hint">@ready/@p.Scenes.Count scene đã có video. Video được ghép tự động khi mọi scene sẵn sàng.</span>
        </div>
      }
    </div>

    <div class="rv2-result-meta">
      <span class="rv2-result-chip">@RVideoUserText.Status(p.Status)</span>
      <span>@p.Scenes.Count scene · @p.TotalSeconds s</span>
      <span class="rv2-result-time">Cập nhật @p.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
    </div>

    @if(!string.IsNullOrWhiteSpace(p.ErrorMessage))
    {
      <MudAlert Severity="Severity.Error" Dense="true">Ghép video thất bại: @p.ErrorMessage. Bạn có thể ghép lại; bản trước vẫn được giữ.</MudAlert>
    }

    <div class="rv2-result-actions">
      <RVideoRecomposeAction @key="JobView.Project.Id" @ref="_recompose" Project="JobView.Project" OnReloadRequested="OnReloadRequested" OnSubmitRequested="ReMergeAsync" />
      @if(!string.IsNullOrWhiteSpace(p.FinalVideoUrl))
      {
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" Href="@p.FinalVideoUrl" Target="_blank">Tải video</MudButton>
      }
    </div>
  </section>
}
</div>
@code{
[Parameter] public RVideoJobView? JobView{get;set;}
[Parameter] public EventCallback OnReloadRequested { get; set; }
RVideoRecomposeAction? _recompose;

async Task ReMergeAsync()
{
    if (_recompose is not null) await _recompose.SubmitAsync();
}
}
