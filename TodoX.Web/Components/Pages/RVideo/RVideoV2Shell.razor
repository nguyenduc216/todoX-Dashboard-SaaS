@page "/r-video"
@page "/r-video/{JobId:guid}"
@using TodoX.Web.Services.VideoRender
@inject NavigationManager Navigation
@inject AuthStateService AuthState
@inject IRVideoJobService RVideoJobs
@inject ILogger<RVideoV2Shell> Logger

<PageTitle>RVideo V2 — TodoX</PageTitle>

<div class="rv2-shell">
    <header class="rv2-header">
        <div class="rv2-title-row">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" OnClick="GoBackLegacy" aria-label="Quay lại giao diện cũ" title="Quay lại giao diện cũ" />
            <div class="rv2-title">
                <span class="rv2-title-text">@(_jobView?.Project.Title is { Length: > 0 } t ? t : "RVideo")</span>
                @if (_jobView is not null)
                {
                    <span class="rv2-techline">@_aspectRatio · @_resolution · @TotalSeconds · @SceneCount scene</span>
                }
            </div>
        </div>
        <MudTabs Class="rv2-tabs" Rounded="true" ApplyEffectsToContainer="true" @bind-ActivePanelIndex="TabIndex">
            <MudTabPanel Text="Thông tin" />
            <MudTabPanel Text="Xem trước" />
            <MudTabPanel Text="Kết quả" />
        </MudTabs>
        @* Thin, absolutely positioned bar: refreshes never shift the layout. *@
        <div class="rv2-refresh-bar @(_refreshing ? "rv2-refresh-bar--on" : null)"></div>
    </header>

    <main class="rv2-body">
        @if (!string.IsNullOrWhiteSpace(_loadWarning))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@_loadWarning</MudAlert>
        }

        @* Tabs stay mounted after their first visit so switching never re-initializes or re-queries. *@
        @if (_visitedTabs.Contains(0))
        {
            <div class="rv2-tab-pane" hidden="@(_tabIndex != 0)"><RVideoV2Info JobView="_jobView" JobId="JobId" OnReloadRequested="ReloadAsync" /></div>
        }
        @if (_visitedTabs.Contains(1))
        {
            <div class="rv2-tab-pane" hidden="@(_tabIndex != 1)"><RVideoV2Preview JobView="_jobView" IsActive="@(_tabIndex == 1)" OnReloadRequested="ReloadAsync" /></div>
        }
        @if (_visitedTabs.Contains(2))
        {
            <div class="rv2-tab-pane" hidden="@(_tabIndex != 2)"><RVideoV2Result JobView="_jobView" OnReloadRequested="ReloadAsync" /></div>
        }
    </main>
</div>

@code {
    [Parameter] public Guid? JobId { get; set; }

    private int _tabIndex;
    private readonly HashSet<int> _visitedTabs = new() { 0 };
    private bool _refreshing;
    private string? _loadWarning;
    private RVideoJobView? _jobView;
    private Guid? _loadedJobId;
    private Task? _reloadTask;
    private bool _reloadPending;
    private string _aspectRatio = "—";
    private string _resolution = "—";

    private int TabIndex
    {
        get => _tabIndex;
        set
        {
            if (value == _tabIndex) return;
            _tabIndex = value;
            // Returning to an already-mounted preview/result tab refreshes silently in the background.
            if (!_visitedTabs.Add(value) && value != 0 && _jobView is not null) _ = ReloadAsync();
        }
    }

    private string TotalSeconds => (_jobView?.Project.TotalSeconds ?? 0) == 0 ? "—" : $"{_jobView!.Project.TotalSeconds}s";
    private string SceneCount => (_jobView?.Project.Scenes.Count ?? 0).ToString();

    protected override async Task OnParametersSetAsync()
    {
        if (JobId is null || AuthState.CurrentUser is null) return;
        if (_loadedJobId == JobId && _jobView is not null) return;
        _loadedJobId = JobId;
        _jobView = null;
        await ReloadAsync();
    }

    // Overlapping reload requests (poll + user action) collapse into at most one follow-up reload.
    internal Task ReloadAsync()
    {
        if (_reloadTask is { IsCompleted: false })
        {
            _reloadPending = true;
            return _reloadTask;
        }
        _reloadTask = ReloadLoopAsync();
        return _reloadTask;
    }

    private async Task ReloadLoopAsync()
    {
        do
        {
            _reloadPending = false;
            await LoadOnceAsync();
        } while (_reloadPending);
    }

    private async Task LoadOnceAsync()
    {
        if (JobId is null || AuthState.CurrentUser is null) return;
        _refreshing = true;
        _loadWarning = null;
        StateHasChanged();
        try
        {
            var view = await RVideoJobs.GetByJobIdAsync(JobId.Value, AuthState.CurrentUser);
            if (view is null) _loadWarning = "Không tìm thấy job.";
            else
            {
                _jobView = view;
                (_aspectRatio, _resolution) = ParseRenderSettings(view.Project.OriginalPrompt);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "RVideo V2 load job failed {JobId}", JobId);
            // Keep the last good view on a transient refresh failure.
            _loadWarning = _jobView is null ? "Không tải được job." : "Không làm mới được dữ liệu, đang hiển thị bản gần nhất.";
        }
        finally { _refreshing = false; StateHasChanged(); }
    }

    private static (string Aspect, string Resolution) ParseRenderSettings(string? prompt)
    {
        try
        {
            var model = new TodoXVideoPromptParser().Parse(prompt ?? string.Empty).Model;
            return (model.AspectRatio ?? "—", model.Resolution ?? "—");
        }
        catch { return ("—", "—"); }
    }

    private void GoBackLegacy()
    {
        if (JobId is not null)
            Navigation.NavigateTo($"/render-job?jobId={JobId}");
        else
            Navigation.NavigateTo("/render-job");
    }
}
