  private async Task UploadMusicAsync(InputFileChangeEventArgs args){
    var file=args.File;
    if(file is null || JobView is null || AuthState.CurrentUser is null) return;
    _advSaving=true; StateHasChanged();
    try{
      AiStudioCatalogRules.ValidateMusicMp3Upload(file.Name, file.ContentType, file.Size);
      await using var stream=file.OpenReadStream(AiStudioCatalogRules.MaxAudioBytes);
      using var memory=new MemoryStream(); await stream.CopyToAsync(memory);
      await Tenant.EnsureLoadedAsync();
      var media=await MediaFiles.SaveAsync(memory.ToArray(), file.Name, "audio/mpeg", "rvideo_music",
        AuthState.CurrentUser.UserId, AuthState.CurrentUser.CustomerId, Tenant.TenantId);
      _pendingMusicSnapshot=new UploadedMusicSnapshot("UPLOAD", file.Name, media.ObjectKey ?? string.Empty, media.PublicUrl ?? media.FileUrl ?? string.Empty, "audio/mpeg", file.Size);
      _advMusicMode=RVideoMusicModes.Upload; _advMusicCode=null;
    }catch(Exception ex){
      Logger.LogWarning(ex,"RVIDEO_V2_INFO_UPLOAD_MUSIC_FAILED");
      Snackbar.Add(RVideoUserText.Error(ex.Message) ?? "Không tải được file nhạc.",Severity.Error);
      return;
    }finally{ _advSaving=false; }
    await SaveSettingsAsync();
    Snackbar.Add("Đã tải file nhạc nền.",Severity.Success);
  }
