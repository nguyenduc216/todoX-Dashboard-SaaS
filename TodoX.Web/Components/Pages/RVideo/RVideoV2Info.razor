      SelectedCharacterId=s?.SelectedCharacterId,
      CharacterSnapshot=string.IsNullOrWhiteSpace(s?.CharacterSnapshotJson)?null:System.Text.Json.JsonSerializer.Deserialize<object>(s!.CharacterSnapshotJson!),
      VoiceMode=_advVoiceMode,
      VoiceCatalogCode=_advVoiceMode==RVideoVoiceModes.Library?_advVoiceCode:null,
      // Library choices carry the catalog item as snapshot (same as the legacy page); never a stale one.
      VoiceSnapshot=_advVoiceMode!=RVideoVoiceModes.Library ? null
        : (object?)_voices.FirstOrDefault(x=>string.Equals(x.Code,_advVoiceCode,StringComparison.OrdinalIgnoreCase))
          ?? (s?.VoiceSnapshotJson is { Length:>0 }?System.Text.Json.JsonSerializer.Deserialize<object>(s!.VoiceSnapshotJson!):null),
      DefaultTtsRate=_advTtsRate,
      MusicCatalogCode=_advMusicMode==RVideoMusicModes.Library && !string.IsNullOrWhiteSpace(_advMusicCode)?_advMusicCode:null,
      MusicSnapshot=_advMusicMode==RVideoMusicModes.None ? null
        : _advMusicMode==RVideoMusicModes.Library ? (object?)_music.FirstOrDefault(x=>string.Equals(x.Code,_advMusicCode,StringComparison.OrdinalIgnoreCase))
