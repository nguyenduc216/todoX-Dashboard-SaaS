@using TodoX.Web.Services.VideoRender
@using TodoX.Web.Services.PromptAssistant
@using TodoX.Web.Services.AiCharacters
@using TodoX.Web.Components.Dialogs
@inject TodoX.Web.Services.IAiStudioCatalogService Catalog
@inject IRVideoJobService RVideoJobs
@inject IRVideoPromptGenerationAction PromptAction
@inject IServicePromptAssistantService PromptAssistant
@inject IAiCharacterService Characters
@inject TodoX.Web.Services.Media.IMediaFileService MediaFiles
@inject TenantContext Tenant
@inject AuthStateService AuthState
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<RVideoV2Info> Logger
@implements IAsyncDisposable
<div class="rv2-info">
  <div class="rv2-info-grid">
    <section class="rv2-info-main">
      <MudTextField T="string" @bind-Value="_titleWorking" Label="Tiêu đề" Variant="Variant.Outlined" Immediate="true" OnBlur="HandleTitleBlurAsync" />
      <div class="rv2-section-head mt-2">
        <MudText Typo="Typo.subtitle2">Nội dung video mong muốn</MudText>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
          <MudTooltip Text="Nhập nội dung bằng giọng nói">
            <MudIconButton Icon="@Icons.Material.Filled.Mic" Size="Size.Small" Disabled="@(!_speechSupported)" OnClick="ToggleSpeechAsync" />
          </MudTooltip>
          <MudTooltip Text="Tạo Prompt AI nhanh">
            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" OnClick="OpenQuickPromptAsync" Disabled="@_generating" />
          </MudTooltip>
        </MudStack>
      </div>
      <MudTextField T="string" Value="_workingInput" ValueChanged="HandleWorkingInputChanged" Immediate="true" Variant="Variant.Outlined" Lines="8" Placeholder="Hãy mô tả video..." />
      <div class="rv2-info-cta">
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" Disabled="@(!CanGenerate)" OnClick="HandleGenerateAsync">Tạo Prompt AI</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="HandleReloadAsync" Disabled="@_generating">Làm mới</MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="HandleHistoryAsync" Disabled="@_generating">Lịch sử</MudButton>
      </div>
      @if (_generating) { <MudProgressLinear Indeterminate="true" Color="Color.Warning" Class="mt-2" /> }
      @if (!string.IsNullOrWhiteSpace(_status)) { <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@_status</MudAlert> }
      @if (JobView is null) { <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">Chưa chọn job.</MudAlert> }
    </section>
    <section class="rv2-info-side">
      <div class="rv2-section-head mb-2">
        <MudText Typo="Typo.subtitle2">Hình ảnh tham chiếu (@InputReferences.Count)</MudText>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
          @* Compact reference-source controls: exactly two icon-only buttons (Upload + Character).
             Upload uses a hidden native <input type=file> triggered via JS; the input is fully
             clipped so no native file-input chrome ever renders. Character opens the picker dialog. *@
          <MudTooltip Text="Tải ảnh tham chiếu">
            <span class="rv2-ref-btn @(ActiveReferenceSource=="upload" ? "rv2-ref-btn--active" : null) @(_uploading || JobView is null ? "rv2-ref-btn--disabled" : null)"
                  role="button" tabindex="@(_uploading || JobView is null ? -1 : 0)"
                  aria-label="Tải ảnh tham chiếu" aria-pressed="@(ActiveReferenceSource=="upload")"
                  title="Tải ảnh tham chiếu"
                  @onclick="TriggerUploadPickerAsync" @onkeydown="HandleUploadKeyDownAsync">
              <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Small" />
              <InputFile Class="rv2-ref-file" OnChange="UploadReferenceAsync" accept="image/png,image/jpeg,image/webp"
                         disabled="@(_uploading || JobView is null)" aria-hidden="true" tabindex="-1" />
            </span>
          </MudTooltip>
          <MudTooltip Text="Chọn từ Character">
            <span class="rv2-ref-btn @(ActiveReferenceSource=="character" ? "rv2-ref-btn--active" : null) @(_uploading || JobView is null ? "rv2-ref-btn--disabled" : null)"
                  role="button" tabindex="@(_uploading || JobView is null ? -1 : 0)"
                  aria-label="Chọn từ Character" aria-pressed="@(ActiveReferenceSource=="character")"
                  title="Chọn từ Character"
                  @onclick="OpenCharacterPickerAsync">
              <MudIcon Icon="@Icons.Material.Filled.FaceRetouchingNatural" Size="Size.Small" />
            </span>
          </MudTooltip>
        </MudStack>
      </div>
      @if (_uploading) { <MudProgressLinear Indeterminate="true" Color="Color.Warning" Class="mb-2" /> }
      @if (InputReferences.Count == 0)
      {
        <MudText Typo="Typo.caption" Class="rv2-ref-empty">Chưa có ảnh tham chiếu.</MudText>
      }
      else
      {
        <div class="rv2-ref-grid">
          @foreach (var r in InputReferences)
          {
            <div class="rv2-ref-card">
              @if (!string.IsNullOrWhiteSpace(r.Url)) { <img src="@r.Url" alt="@r.Label" /> }
              else { <div class="rv2-ref-ph">@r.Label</div> }
              <div class="rv2-ref-foot">
                <span class="rv2-ref-kind">@r.KindLabel</span>
                <span class="rv2-ref-name" title="@r.Label">@r.Label</span>
                <MudTooltip Text="Gỡ tham chiếu">
                  <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Disabled="@_uploading" OnClick="@(() => RemoveReferenceAsync(r))" />
                </MudTooltip>
              </div>
            </div>
          }
        </div>
      }
    </section>
  </div>
  <MudExpansionPanels Elevation="0" Dense="true" Class="rv2-advanced">
    <MudExpansionPanel Text="Cài đặt nâng cao" Expanded="@_adv" ExpandedChanged="@(v=>_adv=v)">
      <MudGrid Class="mt-2">
        <MudItem xs="12" sm="4"><MudNumericField T="int" Value="_advTotalSeconds" ValueChanged="@(async v=>await HandleAdvancedTotalSecondsChangedAsync(v))" Label="Tổng giây" Variant="Variant.Outlined" Min="1" Disabled="@_advSaving"/></MudItem>
        <MudItem xs="12" sm="4"><MudNumericField T="int" Value="_advSceneSeconds" ValueChanged="@(async v=>await HandleAdvancedSceneSecondsChangedAsync(v))" Label="Giây/scene" Variant="Variant.Outlined" Min="1" Disabled="@_advSaving"/></MudItem>
        <MudItem xs="12" sm="4"><MudSelect T="string" Value="_advAspect" ValueChanged="@(async v=>await HandleAdvancedAspectChangedAsync(v))" Label="Tỷ lệ" Variant="Variant.Outlined" Disabled="@_advSaving"><MudSelectItem Value="@("16:9")">16:9</MudSelectItem><MudSelectItem Value="@("9:16")">9:16</MudSelectItem></MudSelect></MudItem>
        <MudItem xs="12" sm="4"><MudSelect T="string" Value="_advResolution" ValueChanged="@(async v=>await HandleAdvancedResolutionChangedAsync(v))" Label="Độ phân giải" Variant="Variant.Outlined" Disabled="@_advSaving"><MudSelectItem Value="@("720p")">720p</MudSelectItem><MudSelectItem Value="@("1080p")">1080p</MudSelectItem></MudSelect></MudItem>
        <MudItem xs="12" sm="4"><MudSwitch T="bool" Value="_advThinkScenes" ValueChanged="@(async v=>await HandleAdvancedThinkScenesChangedAsync(v))" Label="Tự tách scene (ThinkScenes)" Color="Color.Primary" Disabled="@_advSaving"/></MudItem>
        <MudItem xs="12" sm="4">
          <MudText Typo="Typo.caption" Class="rv2-adv-label">Chế độ xử lý</MudText>
          <MudRadioGroup T="string" Value="_advExecutionMode" ValueChanged="@(async v=>await HandleAdvancedExecutionModeChangedAsync(v))">
            <MudRadio T="string" Value="@RVideoExecutionModes.Manual" Color="Color.Warning" Size="Size.Small">Duyệt từng bước</MudRadio>
            <MudRadio T="string" Value="@RVideoExecutionModes.Auto" Color="Color.Warning" Size="Size.Small">Tự động thực hiện</MudRadio>
          </MudRadioGroup>
        </MudItem>
        <MudItem xs="12" sm="4">
          <MudText Typo="Typo.caption" Class="rv2-adv-label">Chế độ giọng đọc</MudText>
          <MudRadioGroup T="string" Value="_advVoiceMode" ValueChanged="@(async v=>await HandleAdvancedVoiceModeChangedAsync(v))">
            <MudRadio T="string" Value="@RVideoVoiceModes.None" Size="Size.Small">Không dùng giọng đọc</MudRadio>
            <MudRadio T="string" Value="@RVideoVoiceModes.Native" Size="Size.Small">AI Native Voice</MudRadio>
            <MudRadio T="string" Value="@RVideoVoiceModes.Library" Size="Size.Small">Giọng từ thư viện</MudRadio>
          </MudRadioGroup>
        </MudItem>
        @if (_advVoiceMode == RVideoVoiceModes.Library)
        {
          <MudItem xs="12" sm="4">
            <MudSelect T="string" Value="_advVoiceCode" ValueChanged="@(async v=>await HandleAdvancedVoiceCodeChangedAsync(v))" Label="Giọng đọc" Variant="Variant.Outlined" Dense="true" Disabled="@_advSaving">
              @foreach (var v in _voices) { <MudSelectItem Value="@v.Code">@v.Name (@v.Code)</MudSelectItem> }
            </MudSelect>
          </MudItem>
          <MudItem xs="12" sm="4"><MudNumericField T="decimal" Value="_advTtsRate" ValueChanged="@(async v=>await HandleAdvancedTtsRateChangedAsync(v))" Label="Tốc độ đọc" Variant="Variant.Outlined" Min="0.5m" Max="2.0m" Step="0.1m" Disabled="@_advSaving"/></MudItem>
        }
        <MudItem xs="12" sm="4">
          <MudSelect T="string" Value="_advMusicCode" ValueChanged="@(async v=>await HandleAdvancedMusicCodeChangedAsync(v))" Label="Nhạc nền" Variant="Variant.Outlined" Dense="true" Disabled="@_advSaving" Clearable="true">
            @foreach (var m in _music) { <MudSelectItem Value="@m.Code">@m.Name (@m.Code)</MudSelectItem> }
          </MudSelect>
        </MudItem>
        @if (!string.IsNullOrWhiteSpace(_advMusicCode))
        {
          <MudItem xs="12" sm="4"><MudNumericField T="decimal" Value="_advMusicVolume" ValueChanged="@(async v=>await HandleAdvancedMusicVolumeChangedAsync(v))" Label="Âm lượng nhạc" Variant="Variant.Outlined" Min="0m" Max="1m" Step="0.1m" Disabled="@_advSaving"/></MudItem>
        }
      </MudGrid>
    </MudExpansionPanel>
  </MudExpansionPanels>
</div>
@code{

  [Parameter] public RVideoJobView? JobView{get;set;}
  [Parameter] public Guid? JobId{get;set;}
  [Parameter] public EventCallback OnReloadRequested{get;set;}
  private bool _adv=false;
  private string _titleWorking=string.Empty;
  private string _workingInput=string.Empty;
  private string _baselineInput=string.Empty;
  private bool _hasBaseline;
  private bool _uploading;
  private bool _generating; private string? _status;
  private bool _speechSupported; private string? _prevTitle;
  private PromptSpeechHandler? _speech;
  private readonly List<TodoX.Web.Models.AiStudioVoiceDto> _voices = new();
  private readonly List<TodoX.Web.Models.AiStudioMusicDto> _music = new();
  private string _advExecutionMode = RVideoExecutionModes.Manual;
  private string _advVoiceMode = RVideoVoiceModes.None;
  private string? _advVoiceCode;
  private decimal _advTtsRate = 1.0m;
  private string? _advMusicCode;
  private decimal _advMusicVolume = 0.8m;
  protected override async Task OnInitializedAsync(){
    _speech = new PromptSpeechHandler(JS, "rvideo-v2-info", async t=>{ _workingInput = QuickPromptTranscriptMerger.AppendTranscript(_workingInput,t); await InvokeAsync(StateHasChanged); }, async ()=> await InvokeAsync(StateHasChanged));
    await _speech.InitializeAsync(); _speechSupported = _speech.IsSupported;
  }
  private long? _lastWorkingProjectId; private Guid? _lastWorkingActiveId;
  private async Task LoadCatalogsAsync(){
    if(_voices.Count==0){ try{ _voices.AddRange(await Catalog.ListVoicesAsync(activeOnly:true)); }catch{} }
    if(_music.Count==0){ try{ _music.AddRange(await Catalog.ListMusicAsync(activeOnly:true)); }catch{} }
  }
  private static string CharacterLabel(string mode)=> mode switch{
    RVideoCharacterModes.Upload=>"Upload ảnh",
    RVideoCharacterModes.Library=>"Character Library",
    _=>"Không dùng"
  };
  protected override async Task OnParametersSetAsync(){
    await LoadCatalogsAsync();
    var t = JobView?.Project.Title ?? string.Empty;
    if(_prevTitle != t){ _prevTitle=t; _titleWorking=t; }
    if(JobView!=null && (_lastWorkingProjectId != JobView.Project.Id || _lastWorkingActiveId != JobView.Project.ActivePromptGenerationId)){
      _lastWorkingProjectId = JobView.Project.Id; _lastWorkingActiveId = JobView.Project.ActivePromptGenerationId;
      await HydratePromptFromActiveAsync();
    }
    SyncAdvFromView();
  }
  private async Task HydratePromptFromActiveAsync(){
    if(JobView==null) return;
    var pid = JobView.Project.Id; var aid = JobView.Project.ActivePromptGenerationId;
    if(aid.HasValue && aid.Value != Guid.Empty){
      ServicePromptGenerationDto? ag = null;
      try{ ag = await PromptAssistant.GetProjectGenerationAsync(pid, aid.Value); }catch{}
      if(ag is null){ try{ var gens = await PromptAssistant.GetProjectGenerationsAsync(pid); ag = gens.FirstOrDefault(g=>g.Id==aid.Value); }catch{} }
      if(ag is null){
        // Active generation is missing/unloadable: surface honest empty-state, never fall back to generated content.
        _workingInput = string.Empty; _baselineInput = string.Empty; _hasBaseline = true; _status = "Không tải được nội dung prompt đang active.";
        return;
      }
      // Canonical source = persisted raw user_input of the active generation.
      // The producer stores the ASSEMBLED agent input (BuildAgentInput wrapper); recover the
      // user's original text with the verified inverse (PromptAssistantEndpoints.ExtractUserInput),
      // exactly as the legacy RVideo route does. Never surface the wrapper or generated JSON here.
      _workingInput = ResolveRawUserInput(ag.UserInput);
      _baselineInput = _workingInput; _hasBaseline = true;
      return;
    }
    // No active generation yet: keep any in-progress edit; otherwise start empty without reconstructing from generated JSON.
    if(!_hasBaseline && string.IsNullOrWhiteSpace(_workingInput)){ _workingInput = string.Empty; _baselineInput = string.Empty; _hasBaseline = true; }
  }
  // Recovers the raw user-entered source from a persisted generation user_input.
  // Older generations stored the assembled agent input (BuildAgentInput wrapper); we unwrap it with the
  // verified inverse used by the legacy route (PromptAssistantEndpoints.ExtractUserInput). When the value
  // is a recognized wrapper but the raw source cannot be recovered, we surface an honest empty state
  // instead of ever putting instructions/wrapper text into the editor. Values that are not a recognized
  // wrapper (already-raw rows) are returned verbatim, so no user content is stripped.
  private static string ResolveRawUserInput(string? storedUserInput, string fallback = ""){
    var stored = storedUserInput ?? string.Empty;
    if(string.IsNullOrWhiteSpace(stored)) return fallback;
    var extracted = PromptAssistantEndpoints.ExtractUserInput(stored);
    if(extracted is not null) return extracted;
    if(stored.StartsWith("CONTENT MODE:", StringComparison.Ordinal)) return fallback;
    return stored;
  }
  private void HandleWorkingInputChanged(string v){
    _workingInput = v ?? string.Empty; _status = null;
  }
  private bool CanGenerate => !_generating && RVideoPromptBaseline.IsDirty(_workingInput, _baselineInput, _hasBaseline);
  private bool CanGenerateFirstTime => !_generating && !RVideoPromptBaseline.IsEmpty(_workingInput);
  public async ValueTask DisposeAsync(){ if(_speech!=null) await _speech.DisposeAsync(); if(_module is not null){ try{ await _module.DisposeAsync(); }catch{} } }


  private async Task HandleTitleBlurAsync(){
    if(JobView==null||JobId==null||AuthState.CurrentUser==null) return;
    var v=(_titleWorking??string.Empty).Trim(); if(string.IsNullOrWhiteSpace(v)||v==JobView.Project.Title) return;
    var req=RVideoJobUpdateHelper.BuildSafeUpdate(JobView, titleOverride:v);
    await RVideoJobs.UpdateAsync(JobId.Value, req, AuthState.CurrentUser);
    if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
  }
  private async Task HandleGenerateAsync(){
    if(_generating) return;
    if(!CanGenerate && !CanGenerateFirstTime) return;
    if(RVideoPromptBaseline.IsEmpty(_workingInput)) return;
    if(JobId==null||JobView==null||AuthState.CurrentUser==null) return;
    var sid=JobView.CoreJob.ServiceId; if(sid==null||sid==Guid.Empty){ Snackbar.Add("Thiếu ServiceId.",Severity.Warning); return; }
    var ok=await JS.InvokeAsync<bool>("confirm","Tạo prompt AI sẽ ghi đè nội dung hiện tại. Tiếp tục?");
    if(!ok) return; if(_generating) return;
    _generating=true; _status="Đang tạo prompt..."; StateHasChanged();
    try{
      var outcome=await PromptAction.GenerateAsync(new RVideoPromptGenerationRequest(sid.Value,_workingInput,AuthState.CurrentUser,JobView.Project.Id),CancellationToken.None);
      if(!outcome.Result.ValidationPassed || string.IsNullOrWhiteSpace(outcome.Result.GeneratedJson)){ Snackbar.Add("Tạo prompt thất bại.",Severity.Error); return; }
      var req=RVideoJobUpdateHelper.BuildSafeUpdate(JobView, promptOverride:outcome.Result.GeneratedJson!);
      await RVideoJobs.UpdateAsync(JobId.Value, req, AuthState.CurrentUser);
      // Confirm the new generation is active, then advance baseline to the persisted user_input.
      if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
      var reloaded = await WaitForActiveGenerationAsync(outcome.Result.GenerationId);
      if(reloaded is not null){
        _workingInput = ResolveRawUserInput(reloaded.UserInput, fallback:_workingInput);
        _baselineInput = _workingInput; _hasBaseline = true;
      } else {
        // Reload not confirmed: keep the user's edit and do NOT advance baseline.
        Snackbar.Add("Đã tạo prompt nhưng chưa xác nhận được bản active. Tải lại trang để kiểm tra.",Severity.Warning);
      }
      Snackbar.Add("Đã tạo prompt.",Severity.Success); _status="Đã tạo prompt.";
    }catch(Exception ex){ Logger.LogWarning(ex,"generate failed"); Snackbar.Add("Lỗi tạo prompt.",Severity.Error); }
    finally{ _generating=false; StateHasChanged(); }
  }
  private async Task<ServicePromptGenerationDto?> WaitForActiveGenerationAsync(Guid generationId){
    try{
      var ag = await PromptAssistant.GetProjectGenerationAsync(JobView!.Project.Id, generationId);
      if(ag is not null) return ag;
    }catch{}
    try{
      var gens = await PromptAssistant.GetProjectGenerationsAsync(JobView!.Project.Id);
      return gens.FirstOrDefault(g=>g.Id==generationId);
    }catch{ return null; }
  }
  private async Task HandleReloadAsync(){ if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync(); await HydratePromptFromActiveAsync(); _status="Đã làm mới."; }
  private async Task HandleHistoryAsync(){
    if(JobView==null) return;
    var gens=await PromptAssistant.GetProjectGenerationsAsync(JobView.Project.Id);
    if(gens.Count==0){ Snackbar.Add("Chưa có lịch sử.",Severity.Info); return; }
    var last=gens.OrderByDescending(g=>g.CreatedAt).First();
    var applied=await PromptAssistant.SetActiveProjectGenerationAsync(JobView.Project.Id, last.Id);
    if(!applied){ Snackbar.Add("Không áp dụng được bản lịch sử.",Severity.Error); return; }
    await PromptAssistant.GetProjectGenerationAsync(JobView.Project.Id, last.Id);
    _workingInput = ResolveRawUserInput(last.UserInput); _baselineInput = _workingInput; _hasBaseline = true;
    if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
    Snackbar.Add("Đã áp dụng bản mới nhất.",Severity.Success);
  }
  private async Task ToggleSpeechAsync(){ if(_speech!=null) await _speech.ToggleAsync(); }
  private async Task OpenQuickPromptAsync(){
    var p=new DialogParameters{ ["CanonicalInput"]=_workingInput, ["OnApplyInput"]=(Func<string,Task>)(async v=>{ _workingInput=v; await InvokeAsync(StateHasChanged); }), ["OnGenerate"]=(Func<Task>)(async ()=>await HandleGenerateAsync()), ["Generating"]=_generating };
    await Dialogs.ShowAsync<QuickPromptDialog>("",p,new DialogOptions{ MaxWidth=MaxWidth.Large, FullWidth=true });
  }
  private int _advTotalSeconds; private int _advSceneSeconds; private string _advAspect="9:16"; private string _advResolution="720p"; private bool _advThinkScenes; private bool _advSaving;
  protected void SyncAdvFromView(){ if(JobView==null) return; _advTotalSeconds=JobView.Project.TotalSeconds; _advSceneSeconds=JobView.Project.SceneSeconds; _advThinkScenes=JobView.Project.ThinkScenes;
    var s=JobView.Settings; if(s!=null){ _advExecutionMode=s.ExecutionMode; _advVoiceMode=s.VoiceMode; _advVoiceCode=s.VoiceCatalogCode; _advTtsRate=s.DefaultTtsRate; _advMusicCode=s.MusicCatalogCode; _advMusicVolume=s.MusicVolume; }
    try{ var u=RVideoJobUpdateHelper.BuildSafeUpdate(JobView); _advAspect=u.AspectRatio; _advResolution=u.Resolution; }catch{} }
  private async Task HandleAdvancedTotalSecondsChangedAsync(int v){ if(JobView==null||JobId==null||AuthState.CurrentUser==null) return; _advSaving=true; try{ var req=RVideoJobUpdateHelper.BuildSafeUpdate(JobView, totalSecondsOverride:v); await RVideoJobs.UpdateAsync(JobId.Value,req,AuthState.CurrentUser); if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync(); }finally{ _advSaving=false; } }
  private async Task HandleAdvancedSceneSecondsChangedAsync(int v){ if(JobView==null||JobId==null||AuthState.CurrentUser==null) return; _advSaving=true; try{ var req=RVideoJobUpdateHelper.BuildSafeUpdate(JobView, sceneSecondsOverride:v); await RVideoJobs.UpdateAsync(JobId.Value,req,AuthState.CurrentUser); if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync(); }finally{ _advSaving=false; } }
  private async Task HandleAdvancedAspectChangedAsync(string v){ if(JobView==null||JobId==null||AuthState.CurrentUser==null) return; _advSaving=true; try{ var req=RVideoJobUpdateHelper.BuildSafeUpdate(JobView, aspectRatioOverride:v); await RVideoJobs.UpdateAsync(JobId.Value,req,AuthState.CurrentUser); if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync(); }finally{ _advSaving=false; } }
  private async Task HandleAdvancedResolutionChangedAsync(string v){ if(JobView==null||JobId==null||AuthState.CurrentUser==null) return; _advSaving=true; try{ var req=RVideoJobUpdateHelper.BuildSafeUpdate(JobView, resolutionOverride:v); await RVideoJobs.UpdateAsync(JobId.Value,req,AuthState.CurrentUser); if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync(); }finally{ _advSaving=false; } }
  private async Task HandleAdvancedThinkScenesChangedAsync(bool v){ if(JobView==null||JobId==null||AuthState.CurrentUser==null) return; _advSaving=true; try{ var req=RVideoJobUpdateHelper.BuildSafeUpdate(JobView, thinkScenesOverride:v); await RVideoJobs.UpdateAsync(JobId.Value,req,AuthState.CurrentUser); if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync(); }finally{ _advSaving=false; } }
  private RVideoJobSettingsRequest BuildSettingsOverride(){
    var s=JobView?.Settings;
    return new RVideoJobSettingsRequest{
      ExecutionMode=_advExecutionMode,
      SkipCharacter=s?.SkipCharacter??false,
      UseReferenceImageForAllScenes=s?.UseReferenceImageForAllScenes??false,
      CharacterMode=s?.CharacterMode??RVideoCharacterModes.None,
      SelectedCharacterId=s?.SelectedCharacterId,
      CharacterSnapshot=string.IsNullOrWhiteSpace(s?.CharacterSnapshotJson)?null:System.Text.Json.JsonSerializer.Deserialize<object>(s!.CharacterSnapshotJson!),
      VoiceMode=_advVoiceMode,
      VoiceCatalogCode=_advVoiceMode==RVideoVoiceModes.Library?_advVoiceCode:null,
      VoiceSnapshot=s?.VoiceSnapshotJson is { Length:>0 }?System.Text.Json.JsonSerializer.Deserialize<object>(s!.VoiceSnapshotJson!):null,
      DefaultTtsRate=_advTtsRate,
      MusicCatalogCode=string.IsNullOrWhiteSpace(_advMusicCode)?null:_advMusicCode,
      MusicSnapshot=s?.MusicSnapshotJson is { Length:>0 }?System.Text.Json.JsonSerializer.Deserialize<object>(s!.MusicSnapshotJson!):null,
      MusicVolume=_advMusicVolume
    };
  }
  private async Task SaveSettingsAsync(){
    if(JobView==null||JobId==null||AuthState.CurrentUser==null) return;
    _advSaving=true;
    try{
      var req=RVideoJobUpdateHelper.BuildSafeUpdate(JobView, settingsOverride:BuildSettingsOverride());
      await RVideoJobs.UpdateAsync(JobId.Value,req,AuthState.CurrentUser);
      if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
    } finally { _advSaving=false; }
  }
  private async Task HandleAdvancedExecutionModeChangedAsync(string v){ if(string.Equals(v,_advExecutionMode)) return; _advExecutionMode=v; await SaveSettingsAsync(); }
  private async Task HandleAdvancedVoiceModeChangedAsync(string v){ if(string.Equals(v,_advVoiceMode)) return; _advVoiceMode=v; if(v!=RVideoVoiceModes.Library){ _advVoiceCode=null; } await SaveSettingsAsync(); }
  private async Task HandleAdvancedVoiceCodeChangedAsync(string v){ if(string.Equals(v,_advVoiceCode)) return; _advVoiceCode=v; await SaveSettingsAsync(); }
  private async Task HandleAdvancedTtsRateChangedAsync(decimal v){ if(v==_advTtsRate) return; _advTtsRate=v; await SaveSettingsAsync(); }
  private async Task HandleAdvancedMusicCodeChangedAsync(string? v){ if(string.Equals(v,_advMusicCode)) return; _advMusicCode=v; await SaveSettingsAsync(); }
  private async Task HandleAdvancedMusicVolumeChangedAsync(decimal v){ if(v==_advMusicVolume) return; _advMusicVolume=v; await SaveSettingsAsync(); }
  // INPUT references only: a single canonical reference slot (Upload XOR Character).
  // Scene static images are generated OUTPUTS and intentionally NOT projected here.
  // Exactly one card is produced so the list can never show two entries for the same image:
  // an active character slot (CharacterMode != None && !SkipCharacter) wins; otherwise the
  // project upload URL is used; otherwise the list is empty.
  private List<RefItem> InputReferences{ get{
    var list=new List<RefItem>(); var pr=JobView?.Project; if(pr==null) return list;
    var s=JobView?.Settings;
    if(s!=null && !s.SkipCharacter && !string.Equals(s.CharacterMode,RVideoCharacterModes.None,StringComparison.OrdinalIgnoreCase)){
      var snap=ParseCharacterSnapshot(s.CharacterSnapshotJson);
      var isUploadMode=string.Equals(s.CharacterMode,RVideoCharacterModes.Upload,StringComparison.OrdinalIgnoreCase);
      var url = isUploadMode
        ? ReadSnapshot(snap,"fileUrl","url","storageKey","objectKey")
        : ReadSnapshot(snap,"masterImageUrl","fileUrl","url","masterImageObjectKey","storageKey","objectKey");
      // Fall back to the project upload URL only in Upload mode (same physical source as the character slot).
      if(string.IsNullOrWhiteSpace(url) && isUploadMode) url = pr.UploadedCharacterUrl ?? pr.SourceImageUrl;
      var name = ReadSnapshot(snap,"name","characterName") ?? (isUploadMode ? "Ảnh tải lên" : CharacterLabel(s.CharacterMode));
      var kind = isUploadMode ? "Upload" : "Character";
      var source = isUploadMode ? "upload" : "character";
      if(!string.IsNullOrWhiteSpace(url)) list.Add(new(url!,name!,kind,source));
      return list;
    }
    if(!string.IsNullOrWhiteSpace(pr.UploadedCharacterUrl))
      list.Add(new(pr.UploadedCharacterUrl!,"Ảnh tải lên","Upload","upload"));
    else if(!string.IsNullOrWhiteSpace(pr.SourceImageUrl))
      list.Add(new(pr.SourceImageUrl!,"Ảnh nguồn","Upload","upload"));
    return list;
  }}
  // Canonical contract exposes a single character slot (CharacterMode + SelectedCharacterId + snapshot).
  private const int MaxCharacterReferences = 1;
  // Exactly one reference source may be active at a time: Character XOR Upload.
  // Returns "upload", "character", or null when no reference is set.
  private string? ActiveReferenceSource{
    get{
      var s=JobView?.Settings;
      if(s!=null && !s.SkipCharacter && !string.Equals(s.CharacterMode,RVideoCharacterModes.None,StringComparison.OrdinalIgnoreCase)){
        return string.Equals(s.CharacterMode,RVideoCharacterModes.Upload,StringComparison.OrdinalIgnoreCase) ? "upload" : "character";
      }
      var pr=JobView?.Project;
      if(pr!=null && (!string.IsNullOrWhiteSpace(pr.UploadedCharacterUrl) || !string.IsNullOrWhiteSpace(pr.SourceImageUrl))) return "upload";
      return null;
    }
  }
  private bool CanUploadReference => !_uploading && JobView is not null;
  // Keyboard parity for the upload control: a non-native button element does not forward
  // Enter/Space to the hidden file input, so trigger the picker explicitly.
  private async Task HandleUploadKeyDownAsync(KeyboardEventArgs e){
    if(!CanUploadReference) return;
    if(e.Key=="Enter" || e.Key==" " || e.Key=="Spacebar"){ await TriggerUploadPickerAsync(); }
  }
  private IJSObjectReference? _module;
  private async Task<IJSObjectReference?> GetModuleAsync(){
    if(_module is not null) return _module;
    try{ _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/RVideo/RVideoV2Info.razor.js"); }
    catch(Exception ex){ Logger.LogWarning(ex,"RVIDEO_V2_INFO_MODULE_IMPORT_FAILED"); }
    return _module;
  }
  private async Task TriggerUploadPickerAsync(){
    if(!CanUploadReference) return;
    try{ var m=await GetModuleAsync(); if(m is not null) await m.InvokeVoidAsync("triggerFileInput", ".rv2-ref-file"); }
    catch(Exception ex){ Logger.LogWarning(ex,"RVIDEO_V2_INFO_UPLOAD_TRIGGER_FAILED"); }
  }
  private IReadOnlyCollection<long> SelectedCharacterIds{
    get{
      var s=JobView?.Settings;
      var ids=new List<long>();
      if(s?.SelectedCharacterId is long id) ids.Add(id);
      return ids;
    }
  }
  private static System.Text.Json.Nodes.JsonObject? ParseCharacterSnapshot(string? json){
    if(string.IsNullOrWhiteSpace(json)) return null;
    try{ return System.Text.Json.Nodes.JsonNode.Parse(json) as System.Text.Json.Nodes.JsonObject; }catch{ return null; }
  }
  private static string? ReadSnapshot(System.Text.Json.Nodes.JsonObject? src, params string[] names){
    if(src is null) return null;
    foreach(var n in names){ var v=src[n]?.GetValue<string>(); if(!string.IsNullOrWhiteSpace(v)) return v; }
    return null;
  }
private async Task UploadReferenceAsync(InputFileChangeEventArgs args){
    if(JobView==null||JobId==null||AuthState.CurrentUser==null) return;
    _uploading=true; _status=null; StateHasChanged();
    try{
      var file=args.File;
      await using var stream=file.OpenReadStream(12*1024*1024);
      using var memory=new MemoryStream(); await stream.CopyToAsync(memory);
      await Tenant.EnsureLoadedAsync();
      var media=await MediaFiles.SaveAsync(memory.ToArray(), file.Name, file.ContentType, "rvideo_character",
        AuthState.CurrentUser.UserId, AuthState.CurrentUser.CustomerId, Tenant.TenantId);
      var url=media.PublicUrl ?? media.FileUrl ?? string.Empty;
      if(string.IsNullOrWhiteSpace(url)){ Snackbar.Add("Tải ảnh thất bại: không nhận được URL.",Severity.Error); return; }
      // Canonical upload mutation: persist the reference as the project SourceImageUrl + Upload character snapshot.
      var snapshot=new UploadedCharacterSnapshot("UPLOAD", file.Name, media.ObjectKey ?? string.Empty, url);
      var settings=BuildReferenceSettings(RVideoCharacterModes.Upload, null, snapshot);
      var req=RVideoJobUpdateHelper.BuildSafeUpdate(JobView, sourceImageUrlOverride:url, settingsOverride:settings);
      await RVideoJobs.UpdateAsync(JobId.Value, req, AuthState.CurrentUser);
      if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
      Snackbar.Add("Đã tải ảnh tham chiếu.",Severity.Success);
    }catch(Exception ex){ Logger.LogWarning(ex,"RVIDEO_V2_INFO_UPLOAD_REFERENCE_FAILED"); Snackbar.Add(ex.Message,Severity.Error); }
    finally{ _uploading=false; StateHasChanged(); }
  }
  private async Task OpenCharacterPickerAsync(){
    if(JobView==null||JobId==null||AuthState.CurrentUser==null) return;
    var p=new DialogParameters{ ["SelectedIds"]=SelectedCharacterIds, ["MaxSelectable"]=(int?)MaxCharacterReferences };
    var dlg=await Dialogs.ShowAsync<RVideoCharacterPickerDialog>("",p,new DialogOptions{ MaxWidth=MaxWidth.Medium, FullWidth=true });
    var result=await dlg.Result;
    if(result is null || result.Canceled) return; // Cancel = no mutation.
    if(result.Data is not List<long> picked || picked.Count==0) return;
    if(picked.Count > MaxCharacterReferences){
      Snackbar.Add($"Chỉ hỗ trợ tối đa {MaxCharacterReferences} Character cho mỗi job.",Severity.Warning);
      return;
    }
    var characterId=picked[0];
    ActiveCharacterDto? character=null;
    try{ var active=await Characters.GetActiveCharactersAsync(AuthState.CurrentUser); character=active.FirstOrDefault(c=>c.Id==characterId); }
    catch(Exception ex){ Logger.LogWarning(ex,"RVIDEO_V2_INFO_CHARACTER_LOOKUP_FAILED"); }
    if(character is null){ Snackbar.Add("Không tìm thấy Character đã chọn.",Severity.Warning); return; }
    var snap=new { source="LIBRARY", id=character.Id, name=character.CharacterName, masterImageUrl=character.MasterImageUrl, storageKey=character.MasterImageObjectKey };
    var settings=BuildReferenceSettings(RVideoCharacterModes.Library, character.Id, snap);
    try{
      var req=RVideoJobUpdateHelper.BuildSafeUpdate(JobView, settingsOverride:settings);
      await RVideoJobs.UpdateAsync(JobId.Value, req, AuthState.CurrentUser);
      if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
      Snackbar.Add("Đã chọn Character tham chiếu.",Severity.Success);
    }catch(Exception ex){ Logger.LogWarning(ex,"RVIDEO_V2_INFO_CHARACTER_APPLY_FAILED"); Snackbar.Add(ex.Message,Severity.Error); }
  }
// Builds the canonical settings request for a reference change, carrying all untouched settings forward.
  private RVideoJobSettingsRequest BuildReferenceSettings(string characterMode, long? selectedCharacterId, object? characterSnapshot){
    var s=JobView?.Settings;
    return new RVideoJobSettingsRequest{
      ExecutionMode=s?.ExecutionMode??RVideoExecutionModes.Manual,
      SkipCharacter=false,
      UseReferenceImageForAllScenes=s?.UseReferenceImageForAllScenes??false,
      CharacterMode=characterMode,
      SelectedCharacterId=selectedCharacterId,
      CharacterSnapshot=characterSnapshot,
      VoiceMode=s?.VoiceMode??RVideoVoiceModes.None,
      VoiceCatalogCode=s?.VoiceCatalogCode,
      VoiceSnapshot=s?.VoiceSnapshotJson is { Length:>0 }?System.Text.Json.JsonSerializer.Deserialize<object>(s.VoiceSnapshotJson!):null,
      DefaultTtsRate=s?.DefaultTtsRate??1.0m,
      MusicCatalogCode=s?.MusicCatalogCode,
      MusicSnapshot=s?.MusicSnapshotJson is { Length:>0 }?System.Text.Json.JsonSerializer.Deserialize<object>(s.MusicSnapshotJson!):null,
      MusicVolume=s?.MusicVolume??0.8m
    };
  }
  private RVideoJobSettingsRequest BuildClearedReferenceSettings(){
    var s=JobView?.Settings;
    return new RVideoJobSettingsRequest{
      ExecutionMode=s?.ExecutionMode??RVideoExecutionModes.Manual,
      SkipCharacter=true,
      UseReferenceImageForAllScenes=s?.UseReferenceImageForAllScenes??false,
      CharacterMode=RVideoCharacterModes.None,
      SelectedCharacterId=null,
      CharacterSnapshot=null,
      VoiceMode=s?.VoiceMode??RVideoVoiceModes.None,
      VoiceCatalogCode=s?.VoiceCatalogCode,
      VoiceSnapshot=s?.VoiceSnapshotJson is { Length:>0 }?System.Text.Json.JsonSerializer.Deserialize<object>(s.VoiceSnapshotJson!):null,
      DefaultTtsRate=s?.DefaultTtsRate??1.0m,
      MusicCatalogCode=s?.MusicCatalogCode,
      MusicSnapshot=s?.MusicSnapshotJson is { Length:>0 }?System.Text.Json.JsonSerializer.Deserialize<object>(s.MusicSnapshotJson!):null,
      MusicVolume=s?.MusicVolume??0.8m
    };
  }
  private async Task RemoveReferenceAsync(RefItem item){
    if(JobView==null||JobId==null||AuthState.CurrentUser==null) return;
    _uploading=true; StateHasChanged();
    try{
      var settings=BuildClearedReferenceSettings();
      var req=string.Equals(item.Source,"upload",StringComparison.OrdinalIgnoreCase)
        ? RVideoJobUpdateHelper.BuildSafeUpdate(JobView, sourceImageUrlOverride:string.Empty, settingsOverride:settings)
        : RVideoJobUpdateHelper.BuildSafeUpdate(JobView, settingsOverride:settings);
      await RVideoJobs.UpdateAsync(JobId.Value, req, AuthState.CurrentUser);
      if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
      Snackbar.Add("Đã gỡ tham chiếu.",Severity.Success);
    }catch(Exception ex){ Logger.LogWarning(ex,"RVIDEO_V2_INFO_REMOVE_REFERENCE_FAILED"); Snackbar.Add(ex.Message,Severity.Error); }
    finally{ _uploading=false; StateHasChanged(); }
  }
  private sealed record RefItem(string Url,string Label,string KindLabel,string Source);
}
