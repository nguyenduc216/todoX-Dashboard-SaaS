  private async Task HandleGenerateAsync(){
    if(_generating) return;
    if(!CanGenerate && !CanGenerateFirstTime) return;
    if(RVideoPromptBaseline.IsEmpty(_workingInput)) return;
    if(JobId==null||JobView==null||AuthState.CurrentUser==null) return;
    var sid=JobView.CoreJob.ServiceId; if(sid==null||sid==Guid.Empty){ Snackbar.Add("Thiếu ServiceId.",Severity.Warning); return; }
    var ok=await JS.InvokeAsync<bool>("confirm","Tạo prompt AI sẽ ghi đè nội dung hiện tại. Tiếp tục?");
    if(!ok) return; if(_generating) return;
    var wantLinked=_linkedVideo;
    _generating=true; _status="Đang tạo prompt..."; StateHasChanged();
    try{
      var outcome=await PromptAction.GenerateAsync(new RVideoPromptGenerationRequest(sid.Value,_workingInput,AuthState.CurrentUser,JobView.Project.Id,
        CharacterReference:BuildPromptCharacterReference(),
        DurationSeconds:_creativeMode && _creativeDuration>0 ? _creativeDuration : null,
        CreativeMode:_creativeMode),CancellationToken.None);
      if(!outcome.Result.ValidationPassed || string.IsNullOrWhiteSpace(outcome.Result.GeneratedJson)){ Snackbar.Add(PromptFailureMessage(outcome.Result),Severity.Error); return; }
      var req=RVideoJobUpdateHelper.BuildSafeUpdate(JobView, promptOverride:outcome.Result.GeneratedJson!);
      await RVideoJobs.UpdateAsync(JobId.Value, req, AuthState.CurrentUser);
      // Confirm the new generation is active, then advance baseline to the persisted user_input.
      if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
      var reloaded = await WaitForActiveGenerationAsync(outcome.Result.GenerationId);
      // First prompt of the job: build the scenes straight away (what "Tạo / phân tách scene" did in V1).
      if(JobView is not null && JobView.Project.Scenes.Count == 0){
        var seeded=await Pipeline.CreateScenesFromPromptAsync(JobView.Project.Id, wantLinked, AuthState.CurrentUser);
        if(seeded.Started){ Snackbar.Add(seeded.Reason, Severity.Success); wantLinked=false; _linkedPending=null;
          if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync(); }
      }
      // New scenes replace the old ones: keep "Video liên kết" as the user had it.
      if(wantLinked && JobView is not null){
        try{ await SceneLinks.SetProjectLinkedAsync(JobView.Project.Id, true, AuthState.CurrentUser); _linkedPending=null;
             if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync(); }
        catch(Exception ex){ Logger.LogWarning(ex,"RVIDEO_V2_INFO_APPLY_LINKED_FAILED"); }
      }
      if(reloaded is not null){
        _workingInput = ResolveRawUserInput(reloaded.UserInput, fallback:_workingInput);
        _baselineInput = _workingInput; _hasBaseline = true;
      } else {
        // Reload not confirmed: keep the user's edit and do NOT advance baseline.
        Snackbar.Add("Đã tạo prompt nhưng chưa xác nhận được bản active. Tải lại trang để kiểm tra.",Severity.Warning);
      }
      Snackbar.Add("Đã tạo prompt.",Severity.Success); _status="Đã tạo prompt.";
    }catch(Exception ex){ Logger.LogWarning(ex,"generate failed"); Snackbar.Add("Lỗi tạo prompt.",Severity.Error); }
    finally{ _generating=false; StateHasChanged(); }
  }
  // Tells the user why the AI script was rejected instead of a bare "failed".
  internal static string PromptFailureMessage(TodoX.Web.Services.PromptAssistant.ServicePromptGenerationResult result){
    var errors=result.ValidationErrors ?? [];
    if(errors.Count==0) return string.IsNullOrWhiteSpace(result.ErrorMessage) ? "Tạo prompt thất bại." : $"Tạo prompt thất bại: {result.ErrorMessage}";
    var reasons=errors.Select(e=>e.Code switch{
        "duration_out_of_range"=>$"thời lượng scene phải từ {TodoX.Web.Services.PromptAssistant.PromptAssistantVideoOutputValidator.MinSceneSeconds} đến {TodoX.Web.Services.PromptAssistant.PromptAssistantVideoOutputValidator.MaxSceneSeconds} giây",
        "required_text"=>$"thiếu {e.Path.Split('.').Last()}",
        "required_scenes"=>"AI không trả về scene nào",
        "tts_rate_invalid"=>"thiếu tốc độ đọc",
        _=>e.Message }).Distinct().Take(3);
    return $"Tạo prompt thất bại (AI trả kết quả chưa đúng định dạng: {string.Join("; ",reasons)}). Vui lòng thử lại.";
  }
  private async Task<ServicePromptGenerationDto?> WaitForActiveGenerationAsync(Guid generationId){
