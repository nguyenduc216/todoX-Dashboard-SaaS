  // --- Draft of "Nội dung video mong muốn": saved 2s after typing stops, or with "Lưu nháp".
  private bool _draftDirty; private bool _draftSaving; private DateTimeOffset? _draftSavedAt; private string? _draftError;
  private CancellationTokenSource? _draftDebounce;
  private string DraftStatusText => _draftSaving ? "Đang lưu nháp…"
    : _draftError is not null ? _draftError
    : _draftDirty ? "Có thay đổi chưa lưu"
    : _draftSavedAt is { } at ? $"Đã lưu nháp lúc {at.ToLocalTime():HH:mm:ss}" : "Nội dung được tự động lưu khi bạn gõ";
  private void ScheduleDraftSave(){
    _draftDebounce?.Cancel();
    var cts = _draftDebounce = new CancellationTokenSource();
    _ = Task.Run(async () => {
      try{ await Task.Delay(2000, cts.Token); }catch(TaskCanceledException){ return; }
      await InvokeAsync(SaveDraftNowAsync);
    });
  }
  private async Task SaveDraftNowAsync(){
    if(JobId is null || AuthState.CurrentUser is null || _draftSaving || !_draftDirty) return;
    _draftDebounce?.Cancel();
    var text = _workingInput;
    _draftSaving = true; _draftError = null; StateHasChanged();
    try{
      _draftSavedAt = await RVideoJobs.SaveDraftInputAsync(JobId.Value, text, AuthState.CurrentUser);
      if(string.Equals(text, _workingInput, StringComparison.Ordinal)) _draftDirty = false;
    }catch(Exception ex){
      Logger.LogWarning(ex, "RVIDEO_V2_DRAFT_SAVE_FAILED jobId={JobId}", JobId);
      _draftError = "Chưa lưu được nháp, sẽ thử lại khi bạn gõ tiếp.";
    }finally{ _draftSaving = false; StateHasChanged(); }
  }
  // A draft typed after the active prompt was generated wins over the generation's input when the page opens.
  private void ApplyNewerDraft(DateTimeOffset? generatedAt){
    if(JobView is null) return;
    var (text, savedAt) = RVideoDraftInput.Read(JobView.CoreJob.Input);
    if(string.IsNullOrWhiteSpace(text) || savedAt is null) return;
    if(generatedAt is { } g && savedAt <= g) return;
    _workingInput = text!; _draftSavedAt = savedAt; _draftDirty = false;
  }
