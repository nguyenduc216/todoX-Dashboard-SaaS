@using TodoX.Web.Services.VideoRender
@using TodoX.Web.Services.PromptAssistant
@using TodoX.Web.Services.AiCharacters
@using TodoX.Web.Components.Dialogs
@inject TodoX.Web.Services.IAiStudioCatalogService Catalog
@inject IRVideoJobService RVideoJobs
@inject IRVideoSceneLinkService SceneLinks
@inject IRVideoScenePipelineService Pipeline
@inject TodoX.Web.Services.Platform.ICoreServiceCatalogService CoreCatalog
@inject IRVideoPromptGenerationAction PromptAction
@inject IServicePromptAssistantService PromptAssistant
@inject IAiCharacterService Characters
@inject TodoX.Web.Services.Media.IMediaFileService MediaFiles
@inject TenantContext Tenant
@inject AuthStateService AuthState
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<RVideoV2Info> Logger
@implements IAsyncDisposable
<div class="rv2-info">
  <div class="rv2-info-grid">
    <section class="rv2-info-main">
      <MudTextField T="string" @bind-Value="_titleWorking" Label="Tiêu đề" Variant="Variant.Outlined" Immediate="true" OnBlur="HandleTitleBlurAsync" />
      <div class="rv2-section-head mt-2">
        <MudText Typo="Typo.subtitle2">Nội dung video mong muốn</MudText>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
          <MudTooltip Text="@(Listening ? "Đang nghe - bấm để dừng" : "Nhập nội dung bằng giọng nói")">
            <MudIconButton Icon="@(Listening ? Icons.Material.Filled.StopCircle : Icons.Material.Filled.Mic)" Color="@(Listening ? Color.Error : Color.Default)"
                           Size="Size.Small" Disabled="@(!_speechSupported)" OnClick="ToggleSpeechAsync" aria-label="Nhập bằng giọng nói" />
          </MudTooltip>
          <MudTooltip Text="Tạo Prompt AI nhanh">
            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" OnClick="OpenQuickPromptAsync" Disabled="@_generating" />
          </MudTooltip>
        </MudStack>
      </div>
      <MudTextField T="string" Value="_workingInput" ValueChanged="HandleWorkingInputChanged" Immediate="true" Variant="Variant.Outlined" Lines="6" Placeholder="Hãy mô tả video..." />
      <div class="rv2-draft-status" data-testid="rv2-draft-status">
        <span>@DraftStatusText</span>
        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_draftSaving || JobId is null || !_draftDirty)" OnClick="SaveDraftNowAsync">Lưu nháp</MudButton>
      </div>
      @if (Listening)
      {
        <div class="rv2-speech-live" role="status" aria-live="polite">
          <span class="rv2-speech-dot" aria-hidden="true"></span>
          <span>@(string.IsNullOrWhiteSpace(_speech?.InterimTranscript) ? "Đang nghe… hãy nói, chữ sẽ tự điền vào ô. Bấm micro để dừng." : _speech!.InterimTranscript)</span>
        </div>
      }
      else if (!string.IsNullOrWhiteSpace(_speech?.ErrorMessage))
      {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">@_speech!.ErrorMessage</MudAlert>
      }
      else if (!_speechSupported && _speechChecked)
      {
        <MudText Typo="Typo.caption" Class="rv2-adv-label">Trình duyệt này chưa hỗ trợ nhập bằng giọng nói (dùng Chrome hoặc Edge).</MudText>
      }
      <div class="rv2-info-cta">
        <MudButton Class="rv2-info-primary" Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.AutoAwesome" Disabled="@(!CanGenerate)" OnClick="HandleGenerateAsync">Tạo Prompt AI</MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="HandleReloadAsync" Disabled="@_generating">Làm mới</MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.History" OnClick="HandleHistoryAsync" Disabled="@_generating">Lịch sử</MudButton>
      </div>
      <div class="rv2-info-creative">
        <MudCheckBox T="bool" Value="_creativeMode" ValueChanged="HandleCreativeModeChangedAsync" Color="Color.Warning" Dense="true" Disabled="@(_generating || _advSaving)" Label="TodoX sáng tạo nội dung" />
        @if (_creativeMode)
        {
          <MudNumericField T="int" @bind-Value="_creativeDuration" Label="Thời lượng mục tiêu (giây)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="600" Disabled="@_generating" Class="rv2-info-creative-dur" />
        }
      </div>
      <div class="rv2-info-linked">
        <MudSwitch T="bool" Value="_linkedVideo" ValueChanged="HandleLinkedVideoChangedAsync" Color="Color.Warning" Disabled="@(_advSaving || _generating || JobView is null)"
                   Label="Video liên kết (cảnh sau bắt đầu từ khung cuối của cảnh trước)" />
        @if ((JobView?.Project.Scenes.Count ?? 0) < 2)
        {
          <MudText Typo="Typo.caption" Class="rv2-adv-label">Áp dụng cho các scene khi tạo Prompt AI.</MudText>
        }
      </div>
      @if (_generating) { <MudProgressLinear Indeterminate="true" Color="Color.Warning" Class="mt-2" /> }
      @if (!string.IsNullOrWhiteSpace(_status)) { <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@_status</MudAlert> }
      @if (JobView is null && JobId is null) { <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">Chưa chọn job.</MudAlert> }
    </section>
    <section class="rv2-info-side">
      <div class="rv2-section-head mb-2">
        <MudText Typo="Typo.subtitle2">Hình ảnh tham chiếu (@InputReferences.Count)</MudText>
      </div>
      @* Reference-source controls: two large labelled buttons (Upload + Character library).
         Upload uses a hidden native <input type=file> triggered via JS; the input is fully
         clipped so no native file-input chrome ever renders. Character opens the picker dialog. *@
      <div class="rv2-ref-actions">
        <MudTooltip Text="Tải ảnh tham chiếu (PNG, JPG, WEBP)">
          <span class="rv2-ref-btn rv2-ref-btn--big @(ActiveReferenceSource=="upload" ? "rv2-ref-btn--active" : null) @(_uploading || JobView is null ? "rv2-ref-btn--disabled" : null)"
                role="button" tabindex="@(_uploading || JobView is null ? -1 : 0)"
                aria-label="Tải ảnh tham chiếu" aria-pressed="@(ActiveReferenceSource=="upload")"
                title="Tải ảnh tham chiếu"
                @onclick="TriggerUploadPickerAsync" @onkeydown="HandleUploadKeyDownAsync">
            <MudIcon Icon="@Icons.Material.Filled.Upload" />
            <span class="rv2-ref-btn-text">Tải ảnh lên</span>
          </span>
        </MudTooltip>
        <MudTooltip Text="Chọn từ Character">
          <span class="rv2-ref-btn rv2-ref-btn--big @(ActiveReferenceSource=="character" ? "rv2-ref-btn--active" : null) @(_uploading || JobView is null ? "rv2-ref-btn--disabled" : null)"
                role="button" tabindex="@(_uploading || JobView is null ? -1 : 0)"
                aria-label="Chọn từ Character" aria-pressed="@(ActiveReferenceSource=="character")"
                title="Chọn từ Character"
                @onclick="OpenCharacterPickerAsync">
            <MudIcon Icon="@Icons.Material.Filled.FaceRetouchingNatural" />
            <span class="rv2-ref-btn-text">Chọn từ thư viện Character</span>
          </span>
        </MudTooltip>
      </div>
      @* Hidden native file input — lives outside any visible button so the browser never renders
         its filename chrome. JS triggers it via the .rv2-ref-file class selector.
         Inline style guarantees hiding even if CSS isolation fails to scope. *@
      <InputFile Class="rv2-ref-file" OnChange="UploadReferenceAsync" accept="image/png,image/jpeg,image/webp"
                 disabled="@(_uploading || JobView is null)" aria-hidden="true" tabindex="-1"
                 style="position:absolute;left:-9999px;top:-9999px;width:0;height:0;overflow:hidden;opacity:0;pointer-events:none" />
      @if (_uploading) { <MudProgressLinear Indeterminate="true" Color="Color.Warning" Class="mb-2" /> }
      @if (InputReferences.Count == 0)
      {
        <MudText Typo="Typo.caption" Class="rv2-ref-empty">Chưa có ảnh tham chiếu. Thêm ảnh nhân vật/sản phẩm để video giữ đúng gương mặt, trang phục.</MudText>
      }
      else
      {
        <div class="rv2-ref-grid">
          @foreach (var r in InputReferences)
          {
            <div class="rv2-ref-card">
              @if (!string.IsNullOrWhiteSpace(r.Url)) { <img src="@r.Url" alt="@r.Label" /> }
              else { <div class="rv2-ref-ph">@r.Label</div> }
              <div class="rv2-ref-foot">
                <span class="rv2-ref-kind">@r.KindLabel</span>
                <span class="rv2-ref-name" title="@r.Label">@r.Label</span>
                <MudTooltip Text="Gỡ tham chiếu">
                  <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Disabled="@_uploading" OnClick="@(() => RemoveReferenceAsync(r))" />
                </MudTooltip>
              </div>
            </div>
          }
        </div>
      }
      <MudCheckBox T="bool" Value="_advUseRefAll" ValueChanged="HandleUseRefAllChangedAsync" Dense="true" Class="mt-2" Disabled="@(_advSaving || JobView is null)"
                   Label="Giữ nguyên hình ảnh tham khảo cho mọi scene" />
    </section>
  </div>
  @if (JobView is not null)
  {
    <div class="rv2-next" data-testid="rv2-next-step">
      <MudText Typo="Typo.subtitle2">Các bước tạo video@(IsAuto ? " (chế độ tự động: sau bước 2 hệ thống tự chạy ảnh → video)" : null)</MudText>
      <ol class="rv2-steps">
        <li class="@StepClass(PromptHasScenes, true)">
          <span class="rv2-step-no">1</span>
          <div class="rv2-step-body">
            <b>Nhập nội dung → Tạo Prompt AI</b>
            <span class="rv2-step-note">@(PromptHasScenes ? "Đã có prompt." : "Nhập mô tả video ở ô trên (hoặc bấm micro để nói), rồi bấm Tạo Prompt AI.")</span>
          </div>
        </li>
        <li class="@StepClass(SceneCount > 0, PromptHasScenes)">
          <span class="rv2-step-no">2</span>
          <div class="rv2-step-body">
            <b>Tạo scene</b>
            <span class="rv2-step-note">@(SceneCount > 0 ? $"Đã có {SceneCount} scene." : "Chia prompt thành các scene.")</span>
          </div>
          @if (SceneCount == 0)
          {
            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.ViewCarousel" Disabled="@(_pipelineBusy || !PromptHasScenes)" OnClick="CreateScenesAsync">Tạo scene</MudButton>
          }
          else if (PromptHasScenes)
          {
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_pipelineBusy" OnClick="RecreateScenesAsync">Tạo lại scene</MudButton>
          }
        </li>
        <li class="@StepClass(SceneCount > 0 && ImagesReady == SceneCount, SceneCount > 0)">
          <span class="rv2-step-no">3</span>
          <div class="rv2-step-body">
            <b>Tạo ảnh</b>
            <span class="rv2-step-note">@(JobView.Settings?.UseReferenceImageForAllScenes == true ? "Dùng ảnh tham chiếu chung cho mọi scene, không cần tạo ảnh." : SceneCount == 0 ? "Sau khi có scene." : $"{ImagesReady}/{SceneCount} scene đã có ảnh.")</span>
          </div>
          @if (!IsAuto && JobView.Settings?.UseReferenceImageForAllScenes != true)
          {
            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.AddPhotoAlternate" Disabled="@(_pipelineBusy || SceneCount == 0 || ImagesReady == SceneCount)" OnClick="CreateImagesAsync">Tạo ảnh</MudButton>
          }
        </li>
        <li class="@StepClass(SceneCount > 0 && VideosReady == SceneCount, SceneCount > 0)">
          <span class="rv2-step-no">4</span>
          <div class="rv2-step-body">
            <b>Tạo video</b>
            <span class="rv2-step-note">@(SceneCount == 0 ? "Sau khi có scene và ảnh." : $"{VideosReady}/{SceneCount} scene đã có video. Xem trước số điểm trước khi tạo.")</span>
          </div>
          <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Movie" Disabled="@(SceneCount == 0)" OnClick="OpenPreviewAsync" data-testid="rv2-step-create-video">@(IsAuto ? "Xem tiến trình" : "Tạo video")</MudButton>
        </li>
      </ol>
      @if (_pipelineBusy) { <MudProgressLinear Indeterminate="true" Color="Color.Warning" /> }
    </div>
  }
  <MudExpansionPanels Elevation="0" Dense="true" Class="rv2-advanced">
    <MudExpansionPanel Text="Cài đặt nâng cao" Expanded="@_adv" ExpandedChanged="@(v=>_adv=v)">
      <MudGrid Class="mt-2">
        <MudItem xs="6" sm="4"><MudNumericField T="int" Value="_advTotalSeconds" ValueChanged="@(async v=>await HandleAdvancedTotalSecondsChangedAsync(v))" Label="Tổng giây" Variant="Variant.Outlined" Min="1" Disabled="@_advSaving"/></MudItem>
        <MudItem xs="6" sm="4"><MudNumericField T="int" Value="_advSceneSeconds" ValueChanged="@(async v=>await HandleAdvancedSceneSecondsChangedAsync(v))" Label="Giây/scene" Variant="Variant.Outlined" Min="1" Disabled="@_advSaving"/></MudItem>
        <MudItem xs="6" sm="4"><MudSelect T="string" Value="_advAspect" ValueChanged="@(async v=>await HandleAdvancedAspectChangedAsync(v))" Label="Tỷ lệ" Variant="Variant.Outlined" Disabled="@_advSaving"><MudSelectItem Value="@("16:9")">16:9</MudSelectItem><MudSelectItem Value="@("9:16")">9:16</MudSelectItem></MudSelect></MudItem>
        <MudItem xs="6" sm="4"><MudSelect T="string" Value="_advResolution" ValueChanged="@(async v=>await HandleAdvancedResolutionChangedAsync(v))" Label="Độ phân giải" Variant="Variant.Outlined" Disabled="@_advSaving"><MudSelectItem Value="@("720p")">720p</MudSelectItem><MudSelectItem Value="@("1080p")">1080p</MudSelectItem></MudSelect></MudItem>
        <MudItem xs="12" sm="4"><MudSwitch T="bool" Value="_advThinkScenes" ValueChanged="@(async v=>await HandleAdvancedThinkScenesChangedAsync(v))" Label="Tự tách scene (ThinkScenes)" Color="Color.Primary" Disabled="@_advSaving"/></MudItem>
        <MudItem xs="12" sm="4">
          <MudText Typo="Typo.caption" Class="rv2-adv-label">Chế độ xử lý</MudText>
          <MudRadioGroup T="string" Value="_advExecutionMode" ValueChanged="@(async v=>await HandleAdvancedExecutionModeChangedAsync(v))">
            <MudRadio T="string" Value="@RVideoExecutionModes.Manual" Color="Color.Warning" Size="Size.Small">Duyệt từng bước</MudRadio>
            <MudRadio T="string" Value="@RVideoExecutionModes.Auto" Color="Color.Warning" Size="Size.Small">Tự động thực hiện</MudRadio>
          </MudRadioGroup>
        </MudItem>
        <MudItem xs="12" sm="4">
          <MudText Typo="Typo.caption" Class="rv2-adv-label">Chế độ giọng đọc</MudText>
          <MudRadioGroup T="string" Value="_advVoiceMode" ValueChanged="@(async v=>await HandleAdvancedVoiceModeChangedAsync(v))">
            <MudRadio T="string" Value="@RVideoVoiceModes.None" Size="Size.Small">Không dùng giọng đọc</MudRadio>
            <MudRadio T="string" Value="@RVideoVoiceModes.Native" Size="Size.Small">AI Native Voice</MudRadio>
            <MudRadio T="string" Value="@RVideoVoiceModes.Library" Size="Size.Small">Giọng từ thư viện</MudRadio>
          </MudRadioGroup>
        </MudItem>
        @if (_advVoiceMode == RVideoVoiceModes.Library)
        {
          <MudItem xs="12" sm="4">
            <MudSelect T="string" Value="_advVoiceCode" ValueChanged="@(async v=>await HandleAdvancedVoiceCodeChangedAsync(v))" Label="Giọng đọc" Variant="Variant.Outlined" Dense="true" Disabled="@_advSaving"
                       OnOpen="@(async ()=>{ await EnsureVoicesLoadedAsync(); StateHasChanged(); })">
              @foreach (var v in _voices) { <MudSelectItem Value="@v.Code">@v.Name (@v.Code)</MudSelectItem> }
            </MudSelect>
            @if (_voices.Count == 0)
            {
              <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.caption" Color="Color.Warning">@(_voicesLoading ? "Đang tải thư viện giọng đọc..." : "Chưa tải được thư viện giọng đọc.")</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_voicesLoading" OnClick="@(async ()=>{ await EnsureVoicesLoadedAsync(); if(string.IsNullOrWhiteSpace(_advVoiceCode) && _voices.Count>0){ _advVoiceCode=DefaultLibraryVoiceCode(_voices); await SaveSettingsAsync(); } })">Tải lại</MudButton>
              </MudStack>
            }
          </MudItem>
          <MudItem xs="12" sm="4"><MudNumericField T="decimal" Value="_advTtsRate" ValueChanged="@(async v=>await HandleAdvancedTtsRateChangedAsync(v))" Label="Tốc độ đọc" Variant="Variant.Outlined" Min="0.5m" Max="2.0m" Step="0.1m" Disabled="@_advSaving"/></MudItem>
        }
        <MudItem xs="12" sm="4">
          <MudText Typo="Typo.caption" Class="rv2-adv-label">Nhạc nền</MudText>
          <MudRadioGroup T="string" Value="_advMusicMode" ValueChanged="@(async v=>await HandleMusicModeChangedAsync(v))">
            <MudRadio T="string" Value="@RVideoMusicModes.None" Size="Size.Small">Không dùng</MudRadio>
            <MudRadio T="string" Value="@RVideoMusicModes.Library" Size="Size.Small">Chọn từ Music Library</MudRadio>
            <MudRadio T="string" Value="@RVideoMusicModes.Upload" Size="Size.Small">Tải lên file MP3</MudRadio>
          </MudRadioGroup>
        </MudItem>
        @if (_advMusicMode == RVideoMusicModes.Library)
        {
          <MudItem xs="12" sm="4">
            <MudSelect T="string" Value="_advMusicCode" ValueChanged="@(async v=>await HandleAdvancedMusicCodeChangedAsync(v))" Label="Music" Variant="Variant.Outlined" Dense="true" Disabled="@_advSaving">
              @foreach (var m in _music) { <MudSelectItem Value="@m.Code">@m.Name (@m.Code)</MudSelectItem> }
            </MudSelect>
          </MudItem>
        }
        else if (_advMusicMode == RVideoMusicModes.Upload)
        {
          <MudItem xs="12" sm="4">
            @* Hidden native input (same pattern as the reference upload), opened by the button below. *@
            <InputFile Class="rv2-music-file" OnChange="UploadMusicAsync" accept="audio/mpeg,.mp3" disabled="@_advSaving" aria-hidden="true" tabindex="-1"
                       style="position:absolute;left:-9999px;top:-9999px;width:0;height:0;overflow:hidden;opacity:0;pointer-events:none" />
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.MusicNote" Disabled="@_advSaving" OnClick="TriggerMusicPickerAsync">
              @(string.IsNullOrWhiteSpace(UploadedMusicName) ? "Chọn file MP3" : "Đổi file MP3")
            </MudButton>
            @if (!string.IsNullOrWhiteSpace(UploadedMusicName)) { <MudText Typo="Typo.caption">Đang dùng: @UploadedMusicName</MudText> }
          </MudItem>
        }
        @if (_advMusicMode != RVideoMusicModes.None)
        {
          <MudItem xs="12" sm="4"><MudNumericField T="decimal" Value="_advMusicVolume" ValueChanged="@(async v=>await HandleAdvancedMusicVolumeChangedAsync(v))" Label="Âm lượng nhạc" Variant="Variant.Outlined" Min="0m" Max="1m" Step="0.1m" Disabled="@_advSaving"/></MudItem>
        }
      </MudGrid>
    </MudExpansionPanel>
  </MudExpansionPanels>
</div>
@code{

  [Parameter] public RVideoJobView? JobView{get;set;}
  [Parameter] public Guid? JobId{get;set;}
  [Parameter] public EventCallback OnReloadRequested{get;set;}
  [Parameter] public EventCallback OnOpenPreview{get;set;}
  private bool _pipelineBusy;
  private int SceneCount => JobView?.Project.Scenes.Count ?? 0;
  private bool IsAuto => string.Equals(JobView?.Settings?.ExecutionMode, RVideoExecutionModes.Auto, StringComparison.OrdinalIgnoreCase);
  private int ImagesReady => JobView is null ? 0 : RVideoScenePipelineService.CountScenesWithImage(JobView.Project);
  private int VideosReady => JobView is null ? 0 : RVideoScenePipelineService.CountScenesWithVideo(JobView.Project);
  private static string StepClass(bool done, bool available) => done ? "rv2-step rv2-step--done" : available ? "rv2-step rv2-step--current" : "rv2-step";
  private bool PromptHasScenes => JobView is not null && RVideoScenePipelineService.PromptHasScenes(JobView.Project);
  private async Task OpenPreviewAsync(){ if(OnOpenPreview.HasDelegate) await OnOpenPreview.InvokeAsync(); }
  private async Task CreateScenesAsync(){
    if(JobView is null || AuthState.CurrentUser is null || _pipelineBusy) return;
    _pipelineBusy=true; StateHasChanged();
    try{
      var result=await Pipeline.CreateScenesFromPromptAsync(JobView.Project.Id, _linkedVideo, AuthState.CurrentUser);
      Snackbar.Add(result.Reason, result.Started ? Severity.Success : Severity.Warning);
      if(!result.Started) return;
      _linkedPending=null;
      if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
      await OpenPreviewAsync();
    }finally{ _pipelineBusy=false; StateHasChanged(); }
  }
  private async Task RecreateScenesAsync(){
    var ok=await Dialogs.ShowMessageBoxAsync("Tạo lại scene",
      "Tạo lại toàn bộ scene từ prompt hiện tại? Các scene đang có (kể cả ảnh/video đã tạo) sẽ được thay bằng scene mới.",
      yesText:"Tạo lại", cancelText:"Hủy");
    if(ok==true) await CreateScenesAsync();
  }
  private async Task CreateImagesAsync(){
    if(JobView is null || AuthState.CurrentUser is null || _pipelineBusy) return;
    _pipelineBusy=true; StateHasChanged();
    try{
      var result=await Pipeline.EnqueueMissingImagesAsync(JobView.Project.Id, AuthState.CurrentUser);
      Snackbar.Add(result.Reason, result.Started ? Severity.Success : Severity.Info);
      if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
      if(result.Started) await OpenPreviewAsync();
    }finally{ _pipelineBusy=false; StateHasChanged(); }
  }
  private bool _adv=false;
  private string _titleWorking=string.Empty;
  private string _workingInput=string.Empty;
  private string _baselineInput=string.Empty;
  private bool _hasBaseline;
  private bool _uploading;
  private bool _generating; private string? _status;
  private bool _speechSupported; private string? _prevTitle;
  private PromptSpeechHandler? _speech;
  private readonly List<TodoX.Web.Models.AiStudioVoiceDto> _voices = new();
  private readonly List<TodoX.Web.Models.AiStudioMusicDto> _music = new();
  private string _advExecutionMode = RVideoExecutionModes.Manual;
  private string _advVoiceMode = RVideoVoiceModes.None;
  private string? _advVoiceCode;
  private decimal _advTtsRate = 1.0m;
  private string? _advMusicCode;
  private decimal _advMusicVolume = 0.8m;
  private string _advMusicMode = RVideoMusicModes.None;
  private object? _pendingMusicSnapshot; // freshly uploaded MP3 snapshot, until the reload confirms it
  private bool _advUseRefAll;
  private bool _linkedVideo;
  private bool? _linkedPending; // choice made before the project had scenes; seeded from the service default
  private bool _creativeMode;
  private int _creativeDuration = 30;
  private bool _creativeDurationSeeded;
  private bool _speechChecked;
  private bool Listening => _speech?.State is PromptSpeechState.Listening or PromptSpeechState.RequestingPermission;
  // JS interop is only available after the first interactive render (not while prerendering).
  protected override async Task OnAfterRenderAsync(bool firstRender){
    if(!firstRender || _speech is not null) return;
    _speech = new PromptSpeechHandler(JS, "rvideo-v2-info", async t=>{ _workingInput = QuickPromptTranscriptMerger.AppendTranscript(_workingInput,t); await InvokeAsync(StateHasChanged); },
      async ()=> await InvokeAsync(StateHasChanged), interimPreview:true);
    await _speech.InitializeAsync(); _speechSupported = _speech.IsSupported; _speechChecked = true;
    StateHasChanged();
