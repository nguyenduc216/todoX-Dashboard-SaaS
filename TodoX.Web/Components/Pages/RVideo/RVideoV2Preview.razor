// TODOX-20261028-RVIDEO-RERENDER-RESTORE-001: rerender with the project's saved aspect ratio/resolution, not provider defaults.
ScenePromptMetadata WithRenderSettings(ScenePromptMetadata metadata)
{
  var settings = RVideoRules.ResolveRenderSettings(JobView!.Project.OriginalPrompt);
  metadata.Extra["aspect_ratio"] = settings.AspectRatio;
  metadata.Extra["resolution"] = settings.Resolution;
  return metadata;
}
// === Scene media history (image / video) with strict type + ownership separation ===

async Task OpenImageHistoryAsync(VideoProjectSceneDto scene)
{
  if(AuthState.CurrentUser is null) return;
  IReadOnlyList<SceneImageVersionDto> versions;
  try { versions = await SceneVersions.ListImageVersionsAsync(scene.Id, AuthState.CurrentUser); }
  catch { Snackbar.Add("Không tải được lịch sử ảnh.", Severity.Error); return; }
  var items = versions.Select(v => new TodoX.Web.Components.Dialogs.MediaHistoryItem
  {
    Key = v.Id.ToString(),
    VersionLabel = $"Ảnh v{v.VersionNumber}",
    Title = $"Scene {scene.SceneIndex} · ảnh v{v.VersionNumber}",
    Status = v.Status,
    StatusColor = StatusColorFor(v.Status),
    CreatedAt = v.CreatedAt,
    IsSelected = v.IsSelected,
    CanSelect = string.Equals(v.Status, "completed", StringComparison.OrdinalIgnoreCase),
    IsVideo = false,
    MediaUrl = v.PublicUrl,
    Prompt = v.ImagePromptSnapshot
  }).ToList();
  var p = new DialogParameters{ ["Title"]="Lịch sử ảnh", ["Items"]=items };
  var dlg = await DialogService.ShowAsync<TodoX.Web.Components.Dialogs.MediaHistoryDialog>("Lịch sử ảnh", p, new DialogOptions{ CloseButton=true, MaxWidth=MaxWidth.Medium, FullWidth=true });
  var result = await dlg.Result;
  if(result is null || result.Canceled || result.Data is not string key || !Guid.TryParse(key, out var versionId)) return;
  await SelectImageVersionAsync(scene, versionId);
}

