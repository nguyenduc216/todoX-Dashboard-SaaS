@using TodoX.Web.Models
@using TodoX.Web.Services.VideoRender
@inject AuthStateService AuthState
@inject IRVideoSceneDraftValidator SceneDraftValidator
@inject IRVideoSceneDraftSaveAction SceneDraftSave
@inject IRVideoSceneCollectionAction SceneCollection
@inject IRVideoSceneVideoModelOptionsService ModelOptions
@inject IRVideoSceneAddDefaultResolver AddDefaults
@inject IRVideoSceneVideoRenderAction SceneVideoRender
@inject IRVideoSceneImageRenderAction SceneImageRender
@inject ISceneMediaVersioningService SceneVersions
@inject ILogger<RVideoV2Preview> Logger
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<div class="rv2-preview">
@if(JobView is null)
{
  <div class="rv2-pv-layout" aria-busy="true">
    <div class="rv2-pv-list">@for(var i=0;i<4;i++){<div class="rv2-skel rv2-skel-card"></div>}</div>
    <div class="rv2-pv-detail"><div class="rv2-skel rv2-skel-media"></div><div class="rv2-skel rv2-skel-line"></div><div class="rv2-skel rv2-skel-line rv2-skel-short"></div></div>
  </div>
}
else
{
  var scenes = OrderedScenes;
  <div class="rv2-pv-toolbar">
    <span class="rv2-pv-progress"><strong>@scenes.Count(x=>x.Status==VideoSceneStatuses.VideoReady)/@scenes.Count</strong> scene xong · @JobView.Project.TotalSeconds s</span>
    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="HandleAddSceneAsync" Disabled="@_busy">Thêm scene</MudButton>
  </div>
  @if(JobView.Settings?.UseReferenceImageForAllScenes == true)
  {
    <div class="rv2-pv-note">Đang dùng ảnh tham chiếu chung cho mọi scene. Tắt trong Cài đặt nâng cao để tạo ảnh riêng.</div>
  }
  <div class="rv2-pv-layout">
    <nav class="rv2-pv-list" aria-label="Danh sách scene">
      @foreach(var s in scenes)
      {
        <button type="button" @key="s.Id" class="rv2-pv-card @(SelectedSceneId==s.Id?"rv2-pv-card--active":null)" @onclick="@(()=>SelectScene(s.Id))" aria-current="@(SelectedSceneId==s.Id?"true":null)">
          <span class="rv2-pv-thumb">
            @if(!string.IsNullOrWhiteSpace(s.StaticImageUrl)){<img src="@s.StaticImageUrl" alt="" loading="lazy" decoding="async" />}
            else{<MudIcon Icon="@Icons.Material.Outlined.Image" Size="Size.Small" />}
            @if(BusyLabel(s) is not null){<span class="rv2-pv-thumb-busy" aria-hidden="true"><span class="rv2-spin"></span></span>}
            @if(!string.IsNullOrWhiteSpace(s.SceneVideoUrl)){<span class="rv2-pv-thumb-badge"><MudIcon Icon="@Icons.Material.Filled.PlayArrow" Style="font-size:14px" /></span>}
          </span>
          <span class="rv2-pv-card-body">
            <span class="rv2-pv-card-title">Scene @s.SceneIndex.ToString("00") <span class="rv2-pv-card-dur">@s.DurationSeconds s</span></span>
            <span class="rv2-pv-card-text">@UserSceneText(s)</span>
            <span class="rv2-pv-status rv2-pv-status--@StatusTone(s)">@VideoStatus(s)</span>
          </span>
        </button>
      }
    </nav>

    @if(ActiveScene is { } a)
    {
      <section class="rv2-pv-detail" @key="a.Id">
        <div class="rv2-pv-detail-head">
          <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" OnClick="PrevScene" Disabled="@IsFirst" aria-label="Scene trước" />
          <span class="rv2-pv-detail-title">Scene @a.SceneIndex.ToString("00") <span class="rv2-pv-muted">/ @scenes.Count.ToString("00")</span></span>
          <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" OnClick="NextScene" Disabled="@IsLast" aria-label="Scene sau" />
          <span class="rv2-pv-status rv2-pv-status--@StatusTone(a)">@if(StatusTone(a)=="busy"){<span class="rv2-spin" aria-hidden="true"></span>}@VideoStatus(a)</span>
          <MudSpacer />
          <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Thao tác khác">
            <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(()=>HandleEditAsync(a))" Disabled="@_busy">Chỉnh prompt</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.PhotoLibrary" OnClick="@(()=>OpenImageHistoryAsync(a))">Lịch sử ảnh</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.VideoLibrary" OnClick="@(()=>OpenVideoHistoryAsync(a))">Lịch sử video</MudMenuItem>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowUpward" OnClick="@(()=>HandleMoveAsync(a,-1))" Disabled="@(a.SceneIndex<=1 || _busy)">Lên</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowDownward" OnClick="@(()=>HandleMoveAsync(a,1))" Disabled="@(a.SceneIndex>=scenes.Count || _busy)">Xuống</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(()=>HandleDeleteAsync(a))" Disabled="@_busy">Xóa scene</MudMenuItem>
          </MudMenu>
        </div>

        <div class="rv2-pv-media">
          @if(_mediaErrors.TryGetValue(a.Id, out var mErr) && mErr)
          {
            <div class="rv2-pv-media-empty">
              <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" />
              <span>Không tải được media</span>
              <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(()=>RetryMediaLoad(a.Id))">Thử lại</MudButton>
            </div>
          }
          else if(ShowVideo(a))
          {
            <video @key="a.SceneVideoUrl" src="@a.SceneVideoUrl" poster="@a.StaticImageUrl" controls playsinline preload="metadata" @onerror="@(()=>OnMediaError(a.Id))"></video>
          }
          else if(!string.IsNullOrWhiteSpace(a.StaticImageUrl))
          {
            <img src="@a.StaticImageUrl" alt="Ảnh scene @a.SceneIndex" decoding="async" @onclick="@(()=>OpenRef(a.StaticImageUrl!))" @onerror="@(()=>OnMediaError(a.Id))" />
          }
          else
          {
            <div class="rv2-pv-media-empty"><MudIcon Icon="@Icons.Material.Outlined.Image" /><span>Chưa có ảnh và video</span></div>
          }
          @* Non-interactive overlay: the previous video stays playable underneath while a new attempt runs. *@
          @if(BusyLabel(a) is { } busyLabel)
          {
            <div class="rv2-pv-media-busy" role="status"><span class="rv2-spin rv2-spin--lg" aria-hidden="true"></span><span>@busyLabel</span></div>
          }
          @if(!string.IsNullOrWhiteSpace(a.SceneVideoUrl) && !string.IsNullOrWhiteSpace(a.StaticImageUrl))
          {
            <div class="rv2-pv-media-switch" role="group" aria-label="Chọn media">
              <button type="button" class="@(ShowVideo(a)?"on":null)" @onclick="@(()=>_showImage.Remove(a.Id))">Video</button>
              <button type="button" class="@(ShowVideo(a)?null:"on")" @onclick="@(()=>_showImage.Add(a.Id))">Ảnh</button>
            </div>
          }
        </div>

        <MudTextField T="string" Class="rv2-pv-content" Value="@UserSceneText(a)" ValueChanged="@(v=>HandleContentChangedAsync(a,v))" Label="Nội dung scene" Variant="Variant.Outlined" Lines="3" Placeholder="Nội dung scene..." FullWidth="true" Margin="Margin.Dense" Disabled="@_busy" />

        <div class="rv2-pv-settings">
          @if(_optsReady)
          {
            <MudSelect T="string" Label="Model video" Value="@ResolveModelKey(a)" ValueChanged="@(v=>HandleModelChangedAsync(a,v))" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@_busy">@foreach(var o in _opts){<MudSelectItem Value="@o.Key">@o.Label</MudSelectItem>}</MudSelect>
            <MudSelect T="int" Label="Thời lượng" Value="@a.DurationSeconds" ValueChanged="@(v=>HandleDurationChangedAsync(a,v))" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@_busy">@foreach(var d in DurationsFor(a)){<MudSelectItem Value="@d">@d giây</MudSelectItem>}</MudSelect>
          }
          else
          {
            <div class="rv2-skel rv2-skel-field"></div><div class="rv2-skel rv2-skel-field"></div>
          }
        </div>

        <div class="rv2-pv-actions">
          <MudButton Variant="Variant.Outlined" Size="Size.Medium" StartIcon="@Icons.Material.Filled.AddPhotoAlternate" OnClick="@(()=>HandleRerenderImageAsync(a))" Disabled="@ImageBlocked(a)">@(string.IsNullOrWhiteSpace(a.StaticImageUrl) ? "Tạo ảnh" : "Tạo lại ảnh")</MudButton>
          <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Medium" StartIcon="@Icons.Material.Filled.Movie" OnClick="@(()=>HandleRerenderVideoAsync(a))" Disabled="@(NeedsExplicitOperation(a) ? _busy : VideoBlocked(a))">@(NeedsExplicitOperation(a) ? "Tạo lượt video mới" : "Render lại video")</MudButton>
          @* Hidden trigger: the primary video button routes to it when a new explicit operation is required. *@
          <RVideoSupersedeButton @ref="_supersedeButtons[a.Id]" ProjectId="@JobView.Project.Id" Scene="@a" ServiceId="@JobView.CoreJob.ServiceId" HideTrigger="true"
            Visible="@NeedsExplicitOperation(a)" Disabled="@_busy" CurrentJobId="@VideoState(a)?.LatestJob?.Id" Generation="@VideoState(a)?.Generation"
            OutcomeUnknown="@(VideoState(a)?.HasProviderIdentity == true || VideoState(a)?.HasActiveJob == true || VideoState(a)?.SubmitBlockReason != SceneVideoSubmitBlockReason.None)" OnQueued="OnReloadRequested" />
        </div>
      </section>
    }
  </div>
  @if(_showRef is not null){<div class="rv2-lightbox" @onclick="@(()=>_showRef=null)"><img src="@_showRef" alt="" /></div>}
  @if(_pendingDelete is not null)
  {
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1400">
      <MudPaper Class="pa-4 rv2-confirm"><MudText>Xóa scene @_pendingDelete.SceneIndex?</MudText><div class="d-flex gap-2 mt-3 justify-end"><MudButton OnClick="@(()=>_pendingDelete=null)">Hủy</MudButton><MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ConfirmDeleteAsync">Xóa</MudButton></div></MudPaper>
    </MudOverlay>
  }
}
</div>
@code{
[Parameter] public RVideoJobView? JobView{get;set;}
[Parameter] public EventCallback OnReloadRequested { get; set; }
// Polling runs only while the preview tab is visible.
[Parameter] public bool IsActive { get; set; } = true;
long? SelectedSceneId; string? _showRef; bool _busy; VideoProjectSceneDto? _pendingDelete;
readonly HashSet<long> _showImage = new();
private readonly SemaphoreSlim _gate = new(1,1);
readonly HashSet<long> _rerenderingImage = new();
readonly HashSet<long> _activeImageScenes = new();
// FEATURE_ID: TODOX-RVIDEO-VIDEO-RERENDER; CHANGE_ID: TODOX-20261025-SCENE07-UI-001.
// Poll persisted operation state through the existing shell reload; never enqueue from a timer.
readonly CancellationTokenSource _pollCancellation = new();
Task? _operationPolling;
bool HasRunningOperation() => _activeImageScenes.Count > 0 || _videoStates.Values.Any(state => state.HasActiveJob
    && state.LatestJob?.Status != "pending_reconciliation");

async Task PollOperationsAsync(CancellationToken ct)
{
 try
 {
  using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
  while(await timer.WaitForNextTickAsync(ct))
  {
   if(!HasRunningOperation() || !OnReloadRequested.HasDelegate) return;
   if(!IsActive) continue;
   await InvokeAsync(async () => { if(!_busy && !ct.IsCancellationRequested) { _pollRefresh = true; await OnReloadRequested.InvokeAsync(); } });
  }
 }
 catch(OperationCanceledException) when(ct.IsCancellationRequested) { }
 catch(Exception ex) { Logger.LogWarning(ex, "RVIDEO_V2_OPERATION_POLL_FAILED"); }
}
bool ImageBlocked(VideoProjectSceneDto scene) => _busy || _rerenderingImage.Contains(scene.Id)
    || _activeImageScenes.Contains(scene.Id) || JobView?.Settings?.UseReferenceImageForAllScenes == true;
readonly Dictionary<long, SceneVideoUiState> _videoStates = new();
readonly Dictionary<long, RVideoSupersedeButton> _supersedeButtons = new();
SceneVideoUiState? VideoState(VideoProjectSceneDto scene) => _videoStates.GetValueOrDefault(scene.Id);
bool NeedsExplicitOperation(VideoProjectSceneDto scene) => VideoState(scene) is { } state
  && state.RequiresExplicitOperation;

int _videoStateRevision;
bool _pollRefresh;
// Scene states are refreshed in place (never cleared), so statuses and buttons do not flicker on reload.
// The selected scene loads first; a poll-driven refresh only re-queries scenes with work in flight.
protected override async Task OnParametersSetAsync()
{
  var revision = ++_videoStateRevision;
  var pollOnly = _pollRefresh; _pollRefresh = false;
  if(JobView is null || AuthState.CurrentUser is not { } user) return;
  var scenes = JobView.Project.Scenes;
  var ids = scenes.Select(x=>x.Id).ToHashSet();
  foreach(var gone in _videoStates.Keys.Where(k=>!ids.Contains(k)).ToArray()) _videoStates.Remove(gone);
  _activeImageScenes.RemoveWhere(k=>!ids.Contains(k));
  var targets = scenes
    .Where(s=>!pollOnly || !_videoStates.ContainsKey(s.Id) || IsSceneBusy(s))
    .OrderBy(s=>s.Id==SelectedSceneId ? 0 : 1).ThenBy(s=>s.SceneIndex).ToArray();
  var first = true;
  foreach(var scene in targets)
  {
    try
    {
      var state = await SceneVersions.GetSceneVideoUiStateAsync(scene.Id, user);
      if(revision != _videoStateRevision) return;
      _videoStates[scene.Id] = state;
      var imageActive = await SceneVersions.HasActiveImageVersionAsync(scene.Id);
      if(revision != _videoStateRevision) return;
      if(imageActive) _activeImageScenes.Add(scene.Id); else _activeImageScenes.Remove(scene.Id);
    }
    catch(Exception ex) { Logger.LogWarning(ex, "RVIDEO_V2_VIDEO_STATE_UNAVAILABLE sceneId={SceneId}", scene.Id); }
    if(first && targets.Length > 1) { first = false; StateHasChanged(); }
  }
}
bool IsSceneBusy(VideoProjectSceneDto scene)
  => _activeImageScenes.Contains(scene.Id)
  || (_videoStates.TryGetValue(scene.Id, out var st) && st.HasActiveJob)
  || scene.Status is VideoSceneStatuses.VideoRendering or VideoSceneStatuses.VideoQueued;
bool VideoBlocked(VideoProjectSceneDto scene) => _busy
  || !_videoStates.TryGetValue(scene.Id, out var state) || state.HasActiveJob
  || state.SubmitBlockReason != SceneVideoSubmitBlockReason.None;
string VideoStatus(VideoProjectSceneDto scene)
{
  if(!_videoStates.TryGetValue(scene.Id, out var state)) return "Đang tải…";
  if(state.LatestJob?.Status == "pending_reconciliation") return "Chưa thể thử lại";
  if(state.HasActiveJob) return "Đang tạo video";
  if(_activeImageScenes.Contains(scene.Id)) return "Đang tạo ảnh";
  if(state.SubmitBlockReason != SceneVideoSubmitBlockReason.None) return "Chưa thể thử lại";
  return RVideoUserText.Status(state.LatestJob?.Status ?? scene.Status);
}

IReadOnlyList<SceneVideoModelOption> _opts = Array.Empty<SceneVideoModelOption>();
bool _optsReady;
Task<IReadOnlyList<SceneVideoModelOption>>? _optsTask; // in-flight options fetch (started off the render path)
int _sceneVersion; // version guard for rapid scene switching
readonly Dictionary<long,bool> _mediaErrors = new();
// Only durations the selected model supports (plus the current value) are offered.
IReadOnlyList<int> DurationsFor(VideoProjectSceneDto scene)
{
  var opt = _opts.FirstOrDefault(x=>string.Equals(x.Key, ResolveModelKey(scene), StringComparison.OrdinalIgnoreCase));
  return (opt?.Durations ?? _opts.SelectMany(x=>x.Durations)).Append(scene.DurationSeconds).Distinct().OrderBy(x=>x).ToArray();
}
IReadOnlyList<VideoProjectSceneDto> OrderedScenes => JobView?.Project.Scenes.OrderBy(x=>x.SceneIndex).ToList() ?? new List<VideoProjectSceneDto>();
bool ShowVideo(VideoProjectSceneDto s) => !string.IsNullOrWhiteSpace(s.SceneVideoUrl) && !_showImage.Contains(s.Id);
// Spinner label for a scene with work in flight; null when idle.
string? BusyLabel(VideoProjectSceneDto scene) => StatusTone(scene) != "busy"
    || (_videoStates.TryGetValue(scene.Id, out var rs) && rs.LatestJob?.Status == "pending_reconciliation") ? null
  : _activeImageScenes.Contains(scene.Id) && !(_videoStates.TryGetValue(scene.Id, out var st) && st.HasActiveJob) ? "Đang tạo ảnh…" : "Đang tạo video…";
string StatusTone(VideoProjectSceneDto scene)
{
  if(!_videoStates.TryGetValue(scene.Id, out var state)) return "muted";
  if(state.HasActiveJob || _activeImageScenes.Contains(scene.Id)) return "busy";
  if(state.LatestJob?.Status == "pending_reconciliation" || state.SubmitBlockReason != SceneVideoSubmitBlockReason.None) return "warn";
  return scene.Status switch { VideoSceneStatuses.VideoReady => "ok", VideoSceneStatuses.Failed => "error",
    VideoSceneStatuses.VideoRendering or VideoSceneStatuses.VideoQueued => "busy", _ => "muted" };
}
// Parsed scene metadata cached per prompt text for read-only rendering; handlers still parse a fresh copy to mutate.
readonly Dictionary<long,(string? Prompt, ScenePromptMetadata Meta)> _metaCache = new();
ScenePromptMetadata ReadMeta(VideoProjectSceneDto s)
{
  if(_metaCache.TryGetValue(s.Id, out var c) && string.Equals(c.Prompt, s.ScenePrompt, StringComparison.Ordinal)) return c.Meta;
  var m = ScenePromptMetadata.FromScene(s);
  _metaCache[s.Id] = (s.ScenePrompt, m);
  return m;
}

protected override void OnParametersSet()
{
  // Select first/selected scene immediately from metadata — no async wait.
  if(JobView?.Project.Scenes.Count > 0 && (SelectedSceneId == null || JobView.Project.Scenes.All(x=>x.Id!=SelectedSceneId)))
    SelectedSceneId = JobView.Project.Scenes.OrderBy(x=>x.SceneIndex).First().Id;
  // Use cached options synchronously if available (avoids blocking first render).
  if(!_optsReady)
  {
    var cached = ModelOptions.GetCachedOptions();
    if(cached is { Count: > 0 }) { _opts = cached; _optsReady = true; }
    // RVID-UI-V2-PREVIEW-LOAD.2: start the single background fetch off the render path and
    // reuse it in OnAfterRenderAsync, removing the skeleton-content flicker on entry.
    else if(_optsTask is null) { _optsTask = ModelOptions.GetOptionsAsync(); }
  }
}

protected override async Task OnAfterRenderAsync(bool firstRender)
{
  if(!_pollCancellation.IsCancellationRequested && HasRunningOperation() && (_operationPolling is null || _operationPolling.IsCompleted))
    _operationPolling = PollOperationsAsync(_pollCancellation.Token);
  if(firstRender && !_optsReady)
  {
    // Load model options in background — UI already rendered with skeleton/metadata.
    try
    {
      _optsTask ??= ModelOptions.GetOptionsAsync();
      _opts = await _optsTask;
      _optsReady = true;
      StateHasChanged();
    }
    catch { /* options will remain empty; selects show no items but scene metadata is visible */ }
  }
}

void SelectScene(long id)
{
  if(SelectedSceneId == id) return;
  _sceneVersion++;
  SelectedSceneId = id;
  // Clear media error for newly selected scene so it retries on mount.
  _mediaErrors.Remove(id);
}

void OnMediaError(long sceneId) => _mediaErrors[sceneId] = true;
void RetryMediaLoad(long sceneId) { _mediaErrors.Remove(sceneId); }

VideoProjectSceneDto? ActiveScene=>JobView?.Project.Scenes.FirstOrDefault(x=>x.Id==SelectedSceneId);
bool IsFirst=> OrderedScenes.FirstOrDefault()?.Id==SelectedSceneId;
bool IsLast=> OrderedScenes.LastOrDefault()?.Id==SelectedSceneId;
void PrevScene(){var o=OrderedScenes.ToList(); var i=o.FindIndex(x=>x.Id==SelectedSceneId); if(i>0) SelectScene(o[i-1].Id);}
void NextScene(){var o=OrderedScenes.ToList(); var i=o.FindIndex(x=>x.Id==SelectedSceneId); if(i>=0&&i<o.Count-1) SelectScene(o[i+1].Id);}
void OpenRef(string u){if(!string.IsNullOrWhiteSpace(u)) _showRef=u;}
string UserSceneText(VideoProjectSceneDto s){
  try{
    var meta=ReadMeta(s);
    return meta.ScenePurpose ?? s.Title ?? string.Empty;
  }catch{ return s.Title ?? string.Empty; }
}
async Task HandleContentChangedAsync(VideoProjectSceneDto scene,string v){
  if(JobView is null || AuthState.CurrentUser is null) return;
  if(string.Equals(v?.Trim(),UserSceneText(scene),StringComparison.Ordinal)) return;
  var metadata=ScenePromptMetadata.FromScene(scene);
  metadata.ScenePurpose=string.IsNullOrWhiteSpace(v)?null:v.Trim();
  await DoSaveAsync(scene,metadata,scene.DurationSeconds);
}
async Task HandleEditAsync(VideoProjectSceneDto scene){
 if(JobView is null) return;
 var parameters = new DialogParameters{ [nameof(TodoX.Web.Components.Dialogs.ScenePromptEditorDialog.Metadata)] = ScenePromptMetadata.FromScene(scene) };
 var opts = new DialogOptions{ CloseButton=true, FullWidth=true, MaxWidth=MaxWidth.Medium };
 var dialog = await DialogService.ShowAsync<TodoX.Web.Components.Dialogs.ScenePromptEditorDialog>($"Chinh prompt scene {scene.SceneIndex}", parameters, opts);
 var result = await dialog.Result;
 if(result is null || result.Canceled || result.Data is not ScenePromptMetadata metadata) return;
 await DoSaveAsync(scene, metadata, scene.DurationSeconds);
}

async Task DoSaveAsync(VideoProjectSceneDto scene, ScenePromptMetadata metadata, int? durationOverride=null){
 if(AuthState.CurrentUser is null || JobView is null) return;
 if(!await _gate.WaitAsync(0)){ Snackbar.Add("Đang lưu, vui lòng đợi.", Severity.Info); return; }
 _busy=true;
 try{
   var pre = SceneDraftValidator.Validate(metadata, durationOverride ?? scene.DurationSeconds);
   if(!pre.IsValid){ Snackbar.Add("Nội dung scene chưa hợp lệ.", Severity.Error); return; }
   var dur = durationOverride ?? scene.DurationSeconds;
   var req = new VideoProjectSaveSceneDraftRequest{ SceneId=scene.Id, Status=scene.Status, Title=scene.Title, SceneIndex=scene.SceneIndex, ScenePrompt=metadata.Serialize(), ImagePrompt=metadata.ImagePrompt, VideoPrompt=metadata.MotionPrompt, ImageUrl=scene.StaticImageUrl, ImagePath=scene.StaticImagePath, VideoUrl=scene.SceneVideoUrl, VideoPath=scene.SceneVideoPath, DurationSeconds=dur, ErrorMessage=scene.ErrorMessage };
   var res = await SceneDraftSave.SaveAsync(req, AuthState.CurrentUser.UserId, metadata);
   if(!res.Success){ Snackbar.Add("Không thể lưu scene.", Severity.Error); return; }
   Snackbar.Add("Đã lưu scene.", Severity.Success);
   if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
 } finally { _busy=false; _gate.Release(); }
}

async Task HandleMoveAsync(VideoProjectSceneDto scene, int dir){
 if(JobView is null || AuthState.CurrentUser is null) return;
 if(!await _gate.WaitAsync(0)) return;
 _busy=true;
 try{
   var res = await SceneCollection.MoveSceneAsync(JobView.Project.Id, scene.Id, dir, AuthState.CurrentUser);
   if(!res.Success){ Snackbar.Add("Không thể di chuyển scene.", Severity.Error); return; }
   if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
 } finally { _busy=false; _gate.Release(); }
}

async Task HandleDeleteAsync(VideoProjectSceneDto scene){ _pendingDelete=scene; }
async Task ConfirmDeleteAsync(){
 var scene=_pendingDelete; _pendingDelete=null; if(scene is null || JobView is null || AuthState.CurrentUser is null) return;
 if(!await _gate.WaitAsync(0)) return; _busy=true;
 try{ var res = await SceneCollection.DeleteSceneAsync(JobView.Project.Id, scene.Id, AuthState.CurrentUser); if(!res.Success){ Snackbar.Add("Không thể xóa scene.", Severity.Error); return; } Snackbar.Add("Đã xóa scene.", Severity.Success); if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync(); } finally { _busy=false; _gate.Release(); }
}

async Task HandleAddSceneAsync(){
 if(JobView is null || AuthState.CurrentUser is null) return;
 if(!await _gate.WaitAsync(0)) return;
 _busy=true;
 try{
   var idx = JobView.Project.Scenes.Count + 1;
   var req = AddDefaults.BuildAddRequest(JobView.Project, idx);
   var res = await SceneCollection.AddSceneAsync(JobView.Project.Id, req, AuthState.CurrentUser);
   if(!res.Success){ Snackbar.Add("Không thể thêm scene.", Severity.Error); return; }
   Snackbar.Add("Đã thêm scene.", Severity.Success);
   if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
 } finally { _busy=false; _gate.Release(); }
}
string ResolveModelKey(VideoProjectSceneDto scene){
 var meta = ReadMeta(scene);
 if(meta.Extra.TryGetValue("video_model", out var k) && !string.IsNullOrWhiteSpace(k))
 {
   var selected=_opts.FirstOrDefault(x=>string.Equals(x.Key,k,StringComparison.OrdinalIgnoreCase)
     || string.Equals(x.Key.Replace('|','/'),k,StringComparison.OrdinalIgnoreCase));
   if(selected is not null) return selected.Key;
 }
 return _opts.FirstOrDefault()?.Key ?? string.Empty;
}
async Task HandleModelChangedAsync(VideoProjectSceneDto scene, string key){
 var opt = _opts.FirstOrDefault(x=>string.Equals(x.Key,key,StringComparison.OrdinalIgnoreCase));
 if(opt is null){ Snackbar.Add("Model không hợp lệ.", Severity.Error); return; }
 var meta = ScenePromptMetadata.FromScene(scene);
 meta.Extra["video_model"]=opt.Key;
 // validate duration against selected model
 var dur = scene.DurationSeconds;
 if(!opt.Durations.Contains(dur))
 {
   dur = RVideoSceneVideoModelOptionsService.ResolveNearestDuration(dur, opt.Durations);
   meta.Extra["video_duration"]=dur.ToString();
 }
 else if(meta.Extra.ContainsKey("video_duration"))
 {
   // keep existing duration if supported
 }
 meta.Extra["video_duration"] = dur.ToString(System.Globalization.CultureInfo.InvariantCulture);
 await DoSaveAsync(scene, meta, dur);
}
async Task HandleDurationChangedAsync(VideoProjectSceneDto scene, int dur){
 var meta = ScenePromptMetadata.FromScene(scene);
 var key = ResolveModelKey(scene);
 var opt = _opts.FirstOrDefault(x=>string.Equals(x.Key,key,StringComparison.OrdinalIgnoreCase));
 if(opt is null || !RVideoSceneVideoModelOptionsService.IsSupportedDuration(opt, dur))
 {
   Snackbar.Add("Thời lượng không được model đã chọn hỗ trợ.", Severity.Error); return;
 }
 meta.Extra["video_model"]=opt.Key;
 meta.Extra["video_duration"] = dur.ToString(System.Globalization.CultureInfo.InvariantCulture);
 await DoSaveAsync(scene, meta, dur);
}
async Task HandleRerenderVideoAsync(VideoProjectSceneDto scene)
{
 if(NeedsExplicitOperation(scene) && _supersedeButtons.TryGetValue(scene.Id,out var button))
 { await button.RunAsync(); return; }

 if(JobView is null || AuthState.CurrentUser is null || !await _gate.WaitAsync(0)) return;
 _busy = true;
 try
 {
  var user = AuthState.CurrentUser;
  var currentState = await SceneVersions.GetSceneVideoUiStateAsync(scene.Id, user);
  _videoStates[scene.Id] = currentState;
  if(currentState.HasActiveJob || currentState.SubmitBlockReason != SceneVideoSubmitBlockReason.None)
  { Snackbar.Add("Chưa thể thử lại", Severity.Info); return; }
  var versions = await SceneVersions.ListSceneVideoVersionsAsync(scene.Id, user);
  if(versions.OrderByDescending(v=>v.VersionNumber).FirstOrDefault()?.Status == "pending_reconciliation")
  { Snackbar.Add("Chưa thể thử lại", Severity.Warning); return; }
  var latest = versions.OrderByDescending(v=>v.VersionNumber).FirstOrDefault();
  var request = new RVideoSceneVideoRenderRequest(JobView.Project.Id, scene, WithRenderSettings(ScenePromptMetadata.FromScene(scene)), JobView.CoreJob.ServiceId,
   latest?.Id, latest?.RenderJobId);
  var estimate = await SceneVideoRender.EstimateAsync(request);
  if(!estimate.CanStart)
  { Snackbar.Add("Không đủ điểm hoặc không thể ước tính chi phí video.", Severity.Warning); return; }
  var confirm = await DialogService.ShowMessageBoxAsync("Render lại video",
   $"Scene {scene.SceneIndex:00}: {estimate.EstimatedPoints:0.##} điểm; hiện có {estimate.AvailablePoints:0.##} điểm.",
   yesText: "Xác nhận render lại", cancelText: "Hủy");
  if(confirm != true) return;
  var result = await SceneVideoRender.EnqueueRerenderAsync(request, user);
  if(!result.Success) { Snackbar.Add(RVideoUserText.ActionError(result.ErrorCode, result.ErrorMessage), Severity.Error); return; }
  Snackbar.Add(result.AlreadyActive ? "Scene đang có job video." : $"Đang tạo video. Job: {result.RenderJobId}", result.AlreadyActive ? Severity.Info : Severity.Success);
  if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
 }
 catch(Exception ex) { Logger.LogWarning(ex, "RVIDEO_V2_RENDER_ACTION_FAILED"); Snackbar.Add("Chưa thể thử lại", Severity.Error); }
 finally { _busy = false; _gate.Release(); }
}
async Task HandleRerenderImageAsync(VideoProjectSceneDto scene)
{
 if(ImageBlocked(scene)) return;
 if(JobView is null || AuthState.CurrentUser is null || !await _gate.WaitAsync(0)) return;
 _busy = true; _rerenderingImage.Add(scene.Id);
 try
 {
  var user = AuthState.CurrentUser;
  if(await SceneVersions.HasActiveImageVersionAsync(scene.Id))
  { _activeImageScenes.Add(scene.Id); Snackbar.Add("Scene đang có job ảnh.", Severity.Info); return; }
  var meta = ScenePromptMetadata.FromScene(scene);
  if(string.IsNullOrWhiteSpace(meta.ImagePrompt)) { Snackbar.Add("Cần nhập prompt ảnh trước khi render.", Severity.Warning); return; }
  var aspectRatio = new TodoXVideoPromptParser().Parse(JobView.Project.OriginalPrompt ?? string.Empty).Model.AspectRatio;
  var request = new RVideoSceneImageRenderRequest(JobView.Project.Id, scene, meta, aspectRatio ?? string.Empty, JobView.CoreJob.ServiceId, JobView.CoreJob.JobId);
  var estimate = await SceneImageRender.EstimateAsync(request);
  if(!estimate.CanStart) { Snackbar.Add("Không đủ điểm hoặc không thể ước tính chi phí ảnh.", Severity.Warning); return; }
  var confirm = await DialogService.ShowMessageBoxAsync("Render lại hình", $"Scene {scene.SceneIndex:00}: {estimate.ImageRate:0.##} điểm; hiện có {estimate.AvailablePoints:0.##} điểm.", yesText:"Xác nhận render lại", cancelText:"Hủy");
  if(confirm != true) return;
  var result = await SceneImageRender.EnqueueRerenderAsync(request, user);
  if(!result.Success) { Snackbar.Add(RVideoUserText.ActionError(result.ErrorCode, result.ErrorMessage), Severity.Error); return; }
  Snackbar.Add(result.AlreadyActive ? "Scene đang có job ảnh." : $"Đã gửi render lại ảnh. Job: {result.RenderJobId}", result.AlreadyActive ? Severity.Info : Severity.Success);
  if(OnReloadRequested.HasDelegate) await OnReloadRequested.InvokeAsync();
 }
 catch(Exception ex) { Logger.LogWarning(ex, "RVIDEO_V2_RENDER_ACTION_FAILED"); Snackbar.Add("Chưa thể thử lại", Severity.Error); }
 finally { _rerenderingImage.Remove(scene.Id); _busy = false; _gate.Release(); }
}
