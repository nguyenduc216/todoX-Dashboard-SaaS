@page "/create"
@implements IDisposable
@using TodoX.Web.Models.Catalog
@using TodoX.Web.Models.Timelapse
@inject AuthStateService AuthState
@inject CatalogRepository Catalog
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Tạo video</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4" Class="todox-page-title">Tạo video</MudText>
        <MudText Typo="Typo.body1" Class="todox-page-subtitle">Chọn một dịch vụ todoX để bắt đầu.</MudText>
    </div>

    @if (!AuthState.IsInitialized)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (AuthState.CurrentUser is not { IsCustomer: true })
    {
        <MudAlert Severity="Severity.Warning">Vui lòng đăng nhập bằng tài khoản khách hàng.</MudAlert>
    }
    else if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        <MudGrid Class="todox-service-grid">
            @foreach (var service in _services)
            {
                <MudItem xs="12" sm="6" md="4" lg="4">
                    <MudPaper Class="todox-card todox-service-card pa-0" rounded="true">
                        <div class="todox-service-media">
                            @if (!string.IsNullOrWhiteSpace(service.ThumbnailUrl))
                            {
                                <img src="@service.ThumbnailUrl" alt="@service.DisplayName" />
                            }
                            else if (!string.IsNullOrWhiteSpace(service.CoverImageUrl))
                            {
                                <img src="@service.CoverImageUrl" alt="@service.DisplayName" />
                            }
                            else
                            {
                                <div class="todox-service-media-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" />
                                </div>
                            }
                        </div>

                        <div class="todox-service-body pa-4">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="gap-2">
                                    <MudText Typo="Typo.h6" Class="todox-service-title">@service.DisplayName</MudText>
                                </MudStack>

                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="todox-service-desc">
                                    @service.Description
                                </MudText>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                                    <div>
                                        <span class="todox-service-price">@service.StartingPriceSummary</span>
                                    </div>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Warning"
                                               StartIcon="@Icons.Material.Filled.ArrowForward"
                                               OnClick="@(() => OpenService(service))">
                                        Tạo video
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        @if (_services.Count == 0)
        {
            <MudAlert Severity="Severity.Info">Hiện chưa có dịch vụ khả dụng.</MudAlert>
        }
    }
</MudStack>

@code {
    private IReadOnlyList<CatalogServiceView> _services = Array.Empty<CatalogServiceView>();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthChange;
        await LoadServicesAsync();
    }

    public void Dispose() => AuthState.OnChange -= HandleAuthChange;

    private void HandleAuthChange() => _ = InvokeAsync(async () =>
    {
        await LoadServicesAsync();
        StateHasChanged();
    });

    private async Task LoadServicesAsync()
    {
        _error = null;
        if (AuthState.CurrentUser is not { IsCustomer: true })
        {
            _services = Array.Empty<CatalogServiceView>();
            _loading = false;
            return;
        }

        _loading = true;
        try
        {
            _services = (await Catalog.GetActiveCatalogServicesAsync())
                .OrderBy(x => x.SortOrder)
                .ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenService(CatalogServiceView service)
    {
        var route = CustomerServiceRouting.Resolve(service.ServiceType, service.Id, service.ServiceCode);
        if (!string.IsNullOrWhiteSpace(route.Route))
        {
            Navigation.NavigateTo(route.Route);
            return;
        }

        Snackbar.Add(route.Message ?? "Dịch vụ hiện chưa khả dụng.", Severity.Info);
    }
}
