@page "/create"
@implements IDisposable
@using TodoX.Web.Models.Catalog
@using TodoX.Web.Models.Timelapse
@inject AuthStateService AuthState
@inject AccountService Accounts
@inject CatalogRepository Catalog
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Kho dịch vụ video</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4" Class="todox-page-title">Kho dịch vụ video</MudText>
        <MudText Typo="Typo.body1" Class="todox-page-subtitle">Chọn dịch vụ phù hợp để bắt đầu tạo job.</MudText>
    </div>

    @if (!AuthState.IsInitialized)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (AuthState.CurrentUser is not { IsCustomer: true })
    {
        <MudAlert Severity="Severity.Warning">Vui lòng đăng nhập bằng tài khoản khách hàng.</MudAlert>
    }
    else if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_services.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Hiện chưa có dịch vụ khả dụng.</MudAlert>
    }
    else
    {
        <MudGrid Class="todox-service-grid">
            @foreach (var service in _services)
            {
                <MudItem xs="12" sm="6" md="4" lg="4">
                    <ServiceCatalogCard Service="service"
                                        ShowFavorite="true"
                                        IsFavorite="@_favoriteServiceIds.Contains(service.Id)"
                                        PrimaryActionLabel="Tạo video"
                                        OnFavoriteChanged="ToggleFavoriteAsync"
                                        OnPrimaryAction="OpenServiceAsync" />
                </MudItem>
            }
        </MudGrid>
    }
</MudStack>

@code {
    private IReadOnlyList<CatalogServiceView> _services = Array.Empty<CatalogServiceView>();
    private HashSet<Guid> _favoriteServiceIds = new();
    private bool _loading = true;
    private bool _hasServiceUnavailableInfo;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthChange;
        await LoadServicesAsync();
    }

    public void Dispose() => AuthState.OnChange -= HandleAuthChange;

    private void HandleAuthChange() => _ = InvokeAsync(async () =>
    {
        await LoadServicesAsync();
        StateHasChanged();
    });

    private async Task LoadServicesAsync()
    {
        _error = null;
        if (AuthState.CurrentUser is not { IsCustomer: true } user || user.CustomerId is null)
        {
            _services = Array.Empty<CatalogServiceView>();
            _favoriteServiceIds = new HashSet<Guid>();
            _loading = false;
            return;
        }

        _loading = true;
        try
        {
            _services = SortServices(await Catalog.GetActiveCatalogServicesAsync());
            _favoriteServiceIds = (await Accounts.GetFavoriteServiceIdsAsync(user.UserId, user.CustomerId.Value)).ToHashSet();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static IReadOnlyList<CatalogServiceView> SortServices(IEnumerable<CatalogServiceView> services)
        => services
            .OrderBy(x => x.SortOrder)
            .ThenBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.ServiceCode, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private static string? ImageUrl(CatalogServiceView service)
        => !string.IsNullOrWhiteSpace(service.ThumbnailUrl) ? service.ThumbnailUrl : service.CoverImageUrl;

    private async Task ToggleFavoriteAsync(Guid serviceId)
    {
        var user = AuthState.CurrentUser;
        if (user is not { IsCustomer: true } || user.CustomerId is null)
        {
            return;
        }

        var wasFavorite = _favoriteServiceIds.Contains(serviceId);
        if (wasFavorite)
        {
            _favoriteServiceIds.Remove(serviceId);
        }
        else
        {
            _favoriteServiceIds.Add(serviceId);
        }

        var (ok, isFavorite, message) = await Accounts.ToggleFavoriteAsync(user, serviceId);
        if (!ok)
        {
            if (wasFavorite)
            {
                _favoriteServiceIds.Add(serviceId);
            }
            else
            {
                _favoriteServiceIds.Remove(serviceId);
            }

            Snackbar.Add(message, Severity.Error);
            return;
        }

        if (isFavorite)
        {
            _favoriteServiceIds.Add(serviceId);
        }
        else
        {
            _favoriteServiceIds.Remove(serviceId);
        }

        Snackbar.Add(message, Severity.Success);
    }

    private async Task OpenServiceAsync(CatalogServiceView service)
    {
        var route = CustomerServiceRouting.Resolve(service.ServiceType, service.Id, service.ServiceCode);
        if (!string.IsNullOrWhiteSpace(route.Route))
        {
            if (_hasServiceUnavailableInfo)
            {
                Snackbar.Clear();
                _hasServiceUnavailableInfo = false;
            }

            Navigation.NavigateTo(route.Route);
            return;
        }

        _hasServiceUnavailableInfo = true;
        Snackbar.Add(route.Message ?? "Dịch vụ hiện chưa khả dụng.", Severity.Info);
    }
}
