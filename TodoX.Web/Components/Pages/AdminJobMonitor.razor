@page "/admin/job-monitor"
@implements IDisposable
@using Microsoft.AspNetCore.Components.Web
@using TodoX.Web.Models
@inject IAdminJobMonitorService Monitor
@inject AuthStateService AuthState
@inject ILogger<AdminJobMonitor> Logger

<PageTitle>Giám sát job</PageTitle>

@if (!AuthState.IsInitialized)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
}
else if (!AdminEndpointAuthorization.IsAdmin(AuthState.CurrentUser))
{
    <MudAlert Severity="Severity.Error">Bạn không có quyền truy cập trang này.</MudAlert>
}
else
{
    <div class="job-monitor">
        <header class="monitor-heading">
            <div>
                <h1>Giám sát job</h1>
                <p>@_page.UnfinishedCount.ToString("N0") job chưa hoàn thành / @_page.TotalCount.ToString("N0") job phù hợp</p>
            </div>
            <button type="button" class="monitor-button" disabled="@_loading" @onclick="RefreshAllAsync">Làm mới</button>
        </header>

        <div class="monitor-filters">
            <input type="search" class="filter-search" placeholder="Tên job hoặc ID"
                   aria-label="Tìm theo tên job hoặc ID" @bind="_searchText" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" />
            <select aria-label="Tên dịch vụ" value="@_query.Service" @onchange="@(args => SetServiceAsync(args.Value?.ToString()))">
                <option value="">Tất cả dịch vụ</option>
                @foreach (var service in _options.Services)
                {
                    <option value="@service">@service</option>
                }
            </select>
            <select aria-label="Người thực hiện" value="@_query.UserId" @onchange="@(args => SetUserAsync(args.Value?.ToString()))">
                <option value="">Tất cả người thực hiện</option>
                @foreach (var user in _options.Users)
                {
                    <option value="@user.Id">@user.Label</option>
                }
            </select>
            <select aria-label="Loại job" value="@_query.Kind" @onchange="@(args => SetKindAsync(args.Value?.ToString()))">
                <option value="">Tất cả loại job</option>
                <option value="@AdminJobMonitorKinds.RVideo">RVideo</option>
                <option value="@AdminJobMonitorKinds.RDance">RDance</option>
                <option value="@AdminJobMonitorKinds.Timelapse">Timelapse</option>
            </select>
            <select aria-label="Trạng thái" value="@_query.Status" @onchange="@(args => SetStatusAsync(args.Value?.ToString()))">
                <option value="">Tất cả trạng thái</option>
                @foreach (var status in StatusOptions)
                {
                    <option value="@status">@AdminJobMonitorRules.StatusLabel(status)</option>
                }
            </select>
            <label class="filter-date">
                <span>Từ ngày</span>
                <input type="date" @bind="_fromDate" @bind:after="ApplyFiltersAsync" />
            </label>
            <label class="filter-date">
                <span>Đến ngày</span>
                <input type="date" @bind="_toDate" @bind:after="ApplyFiltersAsync" />
            </label>
            <div class="filter-actions">
                <button type="button" class="monitor-button" disabled="@_loading" @onclick="ApplyFiltersAsync">Tìm kiếm</button>
                <button type="button" class="monitor-button secondary" disabled="@_loading" @onclick="ClearFiltersAsync">Xóa lọc</button>
            </div>
        </div>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }

        <div class="monitor-table-wrap" aria-busy="@(_loading ? "true" : "false")">
            <table class="monitor-table">
                <thead>
                    <tr>
                        <th aria-label="Mở rộng"></th>
                        <th>Ảnh</th>
                        <th>Tên job</th>
                        <th>Loại job</th>
                        <th>Dịch vụ</th>
                        <th>Người thực hiện</th>
                        <th>Ngày thực hiện</th>
                        <th class="numeric">Credit</th>
                        <th>Trạng thái</th>
                        <th class="numeric">Số scene</th>
                        <th>Video kết quả</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_page.Items.Count == 0)
                    {
                        <tr><td colspan="11" class="monitor-empty">@(_loading ? "Đang tải danh sách job..." : "Không có job phù hợp.")</td></tr>
                    }
                    @foreach (var job in _page.Items)
                    {
                        var expanded = _expandedJobId == job.Id;
                        <tr @key="job.Id" class="job-row @(expanded ? "expanded" : null)" @onclick="@(() => ToggleScenesAsync(job))">
                            <td>
                                <button type="button" class="expand-button" aria-expanded="@(expanded ? "true" : "false")"
                                        aria-label="@(expanded ? "Ẩn danh sách scene" : "Xem danh sách scene")"
                                        @onclick="@(() => ToggleScenesAsync(job))" @onclick:stopPropagation="true">@(expanded ? "▾" : "▸")</button>
                            </td>
                            <td>
                                @if (job.ThumbnailUrl is { } thumbnail)
                                {
                                    <button type="button" class="media-thumb" aria-label="Xem ảnh" @onclick="@(() => ShowImage(thumbnail))" @onclick:stopPropagation="true">
                                        <img src="@thumbnail" alt="" loading="lazy" />
                                    </button>
                                }
                                else
                                {
                                    <span class="media-empty">-</span>
                                }
                            </td>
                            <td class="job-title" title="@job.Title">@job.Title</td>
                            <td><span class="kind-tag">@AdminJobMonitorRules.KindLabel(job.Kind)</span></td>
                            <td>@job.ServiceName</td>
                            <td>
                                <span class="user-name">@job.UserName</span>
                                <small>@job.UserEmail</small>
                            </td>
                            <td class="nowrap">@FormatTime(job.CreatedAt)</td>
                            <td class="numeric">@FormatCredits(job.Credits)</td>
                            <td><span class="status-tag status-@job.Status">@AdminJobMonitorRules.StatusLabel(job.Status)</span></td>
                            <td class="numeric">@job.SceneCount</td>
                            <td>
                                @if (job.ResultVideoUrl is { } result)
                                {
                                    <button type="button" class="monitor-button small" @onclick="@(() => ShowVideo(result))" @onclick:stopPropagation="true">Xem video</button>
                                }
                                else
                                {
                                    <span class="media-empty">-</span>
                                }
                            </td>
                        </tr>
                        @if (expanded)
                        {
                            <tr @key="@($"{job.Id}-scenes")" class="scene-row">
                                <td colspan="11">
                                    @if (_scenesLoadingJobId == job.Id)
                                    {
                                        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                                    }
                                    else if (_scenesError is not null)
                                    {
                                        <MudAlert Severity="Severity.Error">@_scenesError</MudAlert>
                                    }
                                    else if (_scenes.GetValueOrDefault(job.Id) is not { Count: > 0 } scenes)
                                    {
                                        <p class="monitor-empty">Job này chưa có scene.</p>
                                    }
                                    else
                                    {
                                        <table class="scene-table">
                                            <thead>
                                                <tr>
                                                    <th>Scene</th>
                                                    <th>Hình ảnh</th>
                                                    <th>Video</th>
                                                    <th>Trạng thái</th>
                                                    <th class="numeric">Credit</th>
                                                    <th>Ngày tạo</th>
                                                    <th>Ngày hoàn thành</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (var i = 0; i < scenes.Count; i++)
                                                {
                                                    var scene = scenes[i];
                                                    <tr>
                                                        <td>@(i + 1)</td>
                                                        <td>
                                                            @if (scene.ImageUrl is { } image)
                                                            {
                                                                <button type="button" class="media-thumb" aria-label="Xem ảnh scene" @onclick="@(() => ShowImage(image))">
                                                                    <img src="@image" alt="" loading="lazy" />
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <span class="media-empty">-</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (scene.VideoUrl is { } video)
                                                            {
                                                                <button type="button" class="monitor-button small" @onclick="@(() => ShowVideo(video))">Xem video</button>
                                                            }
                                                            else
                                                            {
                                                                <span class="media-empty">-</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <span class="status-tag status-@scene.Status">@AdminJobMonitorRules.StatusLabel(scene.Status)</span>
                                                            @if (scene.ErrorMessage is { } sceneError)
                                                            {
                                                                <small class="scene-error">@sceneError</small>
                                                            }
                                                        </td>
                                                        <td class="numeric">@(scene.Credits is decimal credits ? FormatCredits(credits) : "-")</td>
                                                        <td class="nowrap">@FormatTime(scene.CreatedAt)</td>
                                                        <td class="nowrap">@(scene.CompletedAt is DateTime completed ? FormatTime(completed) : "-")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        @if (job.Kind == AdminJobMonitorKinds.Timelapse)
                                        {
                                            <p class="scene-note">Timelapse tính credit theo cả job nên từng scene không có credit riêng.</p>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <nav class="monitor-pagination" aria-label="Phân trang">
            <span class="page-summary">Trang @_query.Page / @Math.Max(1, _page.TotalPages)</span>
            <button type="button" class="page-button" disabled="@(_loading || _query.Page <= 1)" @onclick="@(() => ChangePageAsync(_query.Page - 1))">Trước</button>
            @foreach (var number in AdminJobMonitorRules.PageWindow(_query.Page, _page.TotalPages))
            {
                if (number == 0)
                {
                    <span class="page-gap">…</span>
                }
                else
                {
                    <button type="button" class="page-button @(number == _query.Page ? "current" : null)" disabled="@_loading"
                            aria-current="@(number == _query.Page ? "page" : null)" @onclick="@(() => ChangePageAsync(number))">@number</button>
                }
            }
            <button type="button" class="page-button" disabled="@(_loading || _query.Page >= _page.TotalPages)" @onclick="@(() => ChangePageAsync(_query.Page + 1))">Sau</button>
        </nav>
    </div>

    @if (_previewUrl is not null)
    {
        <div class="media-preview" role="dialog" aria-modal="true" aria-label="Xem media" @onclick="ClosePreview">
            <button type="button" class="monitor-button" @onclick="ClosePreview" @onclick:stopPropagation="true">Đóng</button>
            @if (_previewIsVideo)
            {
                <video src="@_previewUrl" controls autoplay preload="metadata" @onclick:stopPropagation="true"></video>
            }
            else
            {
                <img src="@_previewUrl" alt="" @onclick:stopPropagation="true" />
            }
        </div>
    }
}

@code {
    private static readonly string[] StatusOptions =
    [
        AdminJobMonitorStatuses.Draft,
        AdminJobMonitorStatuses.Queued,
        AdminJobMonitorStatuses.Processing,
        AdminJobMonitorStatuses.Paused,
        AdminJobMonitorStatuses.Completed,
        AdminJobMonitorStatuses.Failed,
        AdminJobMonitorStatuses.Cancelled
    ];

    private readonly AdminJobMonitorQuery _query = new();
    private readonly Dictionary<Guid, IReadOnlyList<AdminJobMonitorScene>> _scenes = new();
    private AdminJobMonitorPage _page = new();
    private string _searchText = string.Empty;
    private AdminJobMonitorFilterOptions _options = new();
    private DateOnly? _fromDate;
    private DateOnly? _toDate;
    private string? _error;
    private string? _scenesError;
    private string? _previewUrl;
    private Guid? _expandedJobId;
    private Guid? _scenesLoadingJobId;
    private bool _previewIsVideo;
    private bool _loading;
    private bool _loaded;
    private bool _disposed;
    private int _loadVersion;

    protected override void OnInitialized() => AuthState.OnChange += HandleAuthChange;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadOnceAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        AuthState.OnChange -= HandleAuthChange;
    }

    private void HandleAuthChange() => _ = InvokeAsync(LoadOnceAsync);

    private async Task LoadOnceAsync()
    {
        if (_disposed) return;
        // The page renders its guard from AuthState, so it must repaint when auth finishes loading.
        if (_loaded || !AuthState.IsInitialized || !AdminEndpointAuthorization.IsAdmin(AuthState.CurrentUser))
        {
            StateHasChanged();
            return;
        }

        _loaded = true;
        await Task.WhenAll(LoadJobsAsync(), LoadOptionsAsync());
    }

    private async Task LoadOptionsAsync()
    {
        try
        {
            _options = await Monitor.GetFilterOptionsAsync(AuthState.CurrentUser!);
            if (!_disposed) StateHasChanged();
        }
        catch (Exception ex)
        {
            // The list stays usable without these two filters.
            Logger.LogError(ex, "ADMIN_JOB_MONITOR_OPTIONS_FAILED");
        }
    }

    private async Task LoadJobsAsync()
    {
        var version = ++_loadVersion;
        _loading = true;
        _error = null;
        StateHasChanged();
        try
        {
            var page = await Monitor.GetJobsAsync(AuthState.CurrentUser!, _query);
            if (version != _loadVersion || _disposed) return;
            if (page.Items.Count == 0 && _query.Page > 1)
            {
                _query.Page = 1;
                await LoadJobsAsync();
                return;
            }

            _page = page;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ADMIN_JOB_MONITOR_LOAD_FAILED");
            if (version == _loadVersion) _error = "Không tải được danh sách job. Vui lòng thử lại.";
        }

        if (version == _loadVersion && !_disposed)
        {
            _loading = false;
            StateHasChanged();
        }
    }

    // Scenes are read only when a job is opened and kept until the next refresh.
    private async Task ToggleScenesAsync(AdminJobMonitorJob job)
    {
        _scenesError = null;
        if (_expandedJobId == job.Id)
        {
            _expandedJobId = null;
            return;
        }

        _expandedJobId = job.Id;
        if (_scenes.ContainsKey(job.Id))
        {
            _scenesLoadingJobId = null;
            return;
        }

        _scenesLoadingJobId = job.Id;
        StateHasChanged();
        try
        {
            _scenes[job.Id] = await Monitor.GetScenesAsync(AuthState.CurrentUser!, job.Kind, job.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ADMIN_JOB_MONITOR_SCENES_FAILED jobId={JobId} kind={Kind}", job.Id, job.Kind);
            if (_expandedJobId == job.Id) _scenesError = "Không tải được danh sách scene. Vui lòng thử lại.";
        }

        if (_scenesLoadingJobId == job.Id) _scenesLoadingJobId = null;
    }

    private Task RefreshAllAsync() => Task.WhenAll(RefreshAsync(), LoadOptionsAsync());

    private Task RefreshAsync()
    {
        _scenes.Clear();
        _expandedJobId = null;
        _scenesLoadingJobId = null;
        _scenesError = null;
        return LoadJobsAsync();
    }

    private Task ChangePageAsync(int page)
    {
        _query.Page = page;
        return RefreshAsync();
    }

    private Task SetKindAsync(string? kind)
    {
        _query.Kind = kind;
        return ApplyFiltersAsync();
    }

    private Task SetServiceAsync(string? service)
    {
        _query.Service = service;
        return ApplyFiltersAsync();
    }

    private Task SetUserAsync(string? userId)
    {
        _query.UserId = Guid.TryParse(userId, out var id) ? id : null;
        return ApplyFiltersAsync();
    }

    private Task SetStatusAsync(string? status)
    {
        _query.Status = status;
        return ApplyFiltersAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await ApplyFiltersAsync();
    }

    private Task ApplyFiltersAsync()
    {
        _query.Search = _searchText;
        _query.FromUtc = _fromDate is { } from ? AdminJobMonitorRules.LocalDayStartUtc(from) : null;
        _query.ToUtc = _toDate is { } to ? AdminJobMonitorRules.LocalDayEndUtc(to) : null;
        return ChangePageAsync(1);
    }

    private Task ClearFiltersAsync()
    {
        _searchText = string.Empty;
        _fromDate = _toDate = null;
        _query.Kind = _query.Status = _query.Service = null;
        _query.UserId = null;
        return ApplyFiltersAsync();
    }

    private void ShowImage(string url)
    {
        _previewUrl = url;
        _previewIsVideo = false;
    }

    private void ShowVideo(string url)
    {
        _previewUrl = url;
        _previewIsVideo = true;
    }

    private void ClosePreview() => _previewUrl = null;

    private static string FormatTime(DateTime value) => value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    private static string FormatCredits(decimal value) => value.ToString("0.##");
}
