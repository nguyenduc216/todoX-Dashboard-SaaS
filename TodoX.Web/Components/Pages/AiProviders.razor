    private IEnumerable<string> ProviderWarnings(AiProviderListItemDto provider)
    {
        if (!provider.Enabled)
        {
            yield return "Provider disabled";
        }

        if (ProviderModelCount(provider.ProviderCode) == 0)
        {
            yield return "No active models";
        }

        if (string.Equals(provider.ProviderCode, "79ai", StringComparison.OrdinalIgnoreCase)
            && (_ai79CredentialMetadata is null || !_ai79CredentialMetadata.AccountEnabled))
        {
            yield return "No credential";
        }
    }

