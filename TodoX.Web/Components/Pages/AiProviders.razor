    private static string FormatSyncChangeSummary(AiProviderSyncChangeDto change)
    {
        if (string.Equals(change.ChangeType, "PRICE_CHANGED", StringComparison.OrdinalIgnoreCase))
        {
            return FormatPriceChangeSummary(change);
        }

        if (string.Equals(change.ChangeType, "PRICE_ADDED", StringComparison.OrdinalIgnoreCase))
        {
            return $"Giá mới: {change.EntityKey}";
        }

        if (string.Equals(change.ChangeType, "PRICE_DISABLED", StringComparison.OrdinalIgnoreCase))
        {
            return $"Giá đã vô hiệu hóa: {change.EntityKey}";
        }

        return change.AfterJson ?? change.BeforeJson ?? change.ChangeType;
    }

    private static string FormatPriceChangeSummary(AiProviderSyncChangeDto change)
    {
        var before = ReadPrice(change.BeforeJson);
        var after = ReadPrice(change.AfterJson);
        if (before is null || after is null)
        {
            return change.EntityKey;
        }

        var providerBefore = before.ProviderPrice?.ToString("0.####") ?? "-";
        var providerAfter = after.ProviderPrice?.ToString("0.####") ?? "-";
        var sellBefore = before.SellPoints?.ToString("0.####") ?? "-";
        var sellAfter = after.SellPoints?.ToString("0.####") ?? "-";
        var note = before.SellPoints == after.SellPoints
            ? "Giá provider thay đổi · Giá TodoX giữ nguyên"
            : "Giá provider và Giá TodoX thay đổi";
        return $"{change.EntityKey}\n79AI: {providerBefore} -> {providerAfter} credits\nTodoX sell: {sellBefore} -> {sellAfter} pts\nStatus: {note}";
    }

    private static AiModelPriceDto? ReadPrice(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<AiModelPriceDto>(json);
        }
        catch
        {
            return null;
        }
    }

    private sealed class QuickDefaultRow
    {
        public QuickDefaultRow(AiFeatureProviderCatalogItem feature, List<ProviderOptionDto> options)
        {
            Feature = feature;
            AllOptions = options;
            RefreshModelOptions();
        }

        public AiFeatureProviderCatalogItem Feature { get; }
        public List<ProviderOptionDto> AllOptions { get; }
        public long? SelectedProviderId { get; set; }
        public long? SelectedCapabilityId { get; set; }
        public string? Warning { get; set; }
        public List<ProviderOptionDto> ModelOptions { get; private set; } = new();
        public IEnumerable<ProviderOptionDto> ProviderOptions => AllOptions
            .GroupBy(x => x.ProviderId)
            .Select(x => x.OrderByDescending(o => o.IsDefault).First())
            .OrderBy(x => x.ProviderName);
        public ProviderOptionDto? SelectedCapability => AllOptions.FirstOrDefault(x => x.ProviderCapabilityId == SelectedCapabilityId);

        public void RefreshModelOptions()
        {
            ModelOptions = SelectedProviderId is long providerId
                ? AllOptions.Where(x => x.ProviderId == providerId).OrderByDescending(x => x.IsDefault).ThenBy(x => x.DisplayName).ToList()
                : new List<ProviderOptionDto>();
        }
    }

    private sealed record ModelVariantRow(string Mode, string Resolution, string Duration, string Ratio, string Availability);
