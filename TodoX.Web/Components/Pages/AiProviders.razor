@page "/admin/ai-providers"
@using TodoX.Web.Components.Dialogs
@using TodoX.Web.Models
@using TodoX.Web.Services.AiProviders
@implements IDisposable
@inject AuthStateService AuthState
@inject IAiProviderService Providers
@inject IAiProviderModelService ModelService
@inject IAiPricingService Pricing
@inject IAiProviderSyncService Syncs
@inject IAi79CredentialMigrationService Ai79CredentialMigration
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<AiProviders> Logger

<PageTitle>AI Providers</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4" Class="todox-page-title">AI Providers</MudText>
        <MudText Typo="Typo.body1" Class="todox-page-subtitle">Quản lý nhà cung cấp AI, model, capability, giá vốn và đồng bộ catalog.</MudText>
    </div>

    @if (!AuthState.IsInitialized)
    {
        <MudPaper Class="todox-card pa-4">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Color="Color.Warning" />
                <MudText>Đang xác thực...</MudText>
            </MudStack>
        </MudPaper>
    }
    else if (!IsAdmin)
    {
        <MudAlert Severity="Severity.Error">Bạn cần quyền quản trị TodoX để mở trang này.</MudAlert>
    }
    else
    {
        <MudGrid Class="ai-provider-summary-grid">
            <MudItem xs="6" md="3">
                <MudPaper Class="todox-card pa-3" rounded="true">
                    <MudText Typo="Typo.caption" Class="todox-page-subtitle">Tổng provider</MudText>
                    <MudText Typo="Typo.h5">@_providers.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="todox-card pa-3" rounded="true">
                    <MudText Typo="Typo.caption" Class="todox-page-subtitle">Provider đang bật</MudText>
                    <MudText Typo="Typo.h5">@_providers.Count(x => x.Enabled)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="todox-card pa-3" rounded="true">
                    <MudText Typo="Typo.caption" Class="todox-page-subtitle">Model đang hoạt động</MudText>
                    <MudText Typo="Typo.h5">@_models.Count(x => x.Enabled && !x.IsDeprecated)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="todox-card pa-3" rounded="true">
                    <MudText Typo="Typo.caption" Class="todox-page-subtitle">Lần đồng bộ gần nhất</MudText>
                    <MudText Typo="Typo.body2">@(LatestSync?.CreatedAt.ToString("yyyy-MM-dd HH:mm") ?? "-")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudTabs Rounded="true" Elevation="0" Class="pt-3" @bind-ActivePanelIndex="_activeTabIndex">
            <MudTabPanel Text="TỔNG QUAN">
                <MudPaper Class="todox-card pa-4" rounded="true">
                    <MudText Typo="Typo.h6">Tổng quan hệ thống Provider</MudText>
                    <MudText Typo="Typo.body2" Class="todox-page-subtitle">Theo dõi nhanh provider, credential, model, đồng bộ catalog và cảnh báo vận hành.</MudText>
                    <MudDivider Class="my-3" />
                    <MudTable Items="_providers" Dense="true" Hover="true" T="AiProviderListItemDto">
                        <HeaderContent>
                            <MudTh>Provider</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Default account</MudTh>
                            <MudTh>Credential</MudTh>
                            <MudTh>Models</MudTh>
                            <MudTh>Last sync</MudTh>
                            <MudTh>Health</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="p">
                            <MudTd DataLabel="Provider">
                                <MudText Typo="Typo.body2"><b>@p.ProviderName</b></MudText>
                                <MudText Typo="Typo.caption" Class="todox-page-subtitle">@p.ProviderCode</MudText>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Size="Size.Small" Color="@(p.Enabled ? Color.Success : Color.Default)">@(p.Enabled ? "Đang bật" : "Tắt")</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Default account">@(p.EnabledCapabilityCount > 0 ? "Đã cấu hình" : "-")</MudTd>
                            <MudTd DataLabel="Credential">@ProviderCredentialSummary(p)</MudTd>
                            <MudTd DataLabel="Models">@ProviderModelCount(p.ProviderCode)</MudTd>
                            <MudTd DataLabel="Last sync">@ProviderLastSyncLabel(p.Id)</MudTd>
                            <MudTd DataLabel="Health">
                                @foreach (var warning in ProviderWarnings(p))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@warning</MudChip>
                                }
                                @if (!ProviderWarnings(p).Any())
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">OK</MudChip>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                    @if (_ai79CredentialMetadata is not null)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-3">
                            79AI credential: account @(_ai79CredentialMetadata.AccountEnabled ? "enabled" : "disabled"),
                            role @_ai79CredentialMetadata.CredentialRole,
                            hint @(_ai79CredentialMetadata.MaskedHint ?? "****"),
                            secure @_ai79CredentialMetadata.SecureStatus,
                            key @_ai79CredentialMetadata.KeyVersion,
                            last used @(_ai79CredentialMetadata.LastUsedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-").
                        </MudAlert>
                    }
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="PROVIDER">
        <MudGrid>
            <MudItem xs="12" md="5">
                <MudPaper Class="todox-card pa-4" rounded="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6">Danh sách provider</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Disabled="@_loading" OnClick="ReloadProviders" />
                    </MudStack>
                    <MudDivider Class="my-3" />
                    @if (_loading)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                    }
                    else if (_providers.Count == 0)
                    {
                        <MudText Class="todox-page-subtitle">Chưa có provider nào.</MudText>
                    }
                    else
                    {
                        <MudTable Items="_providers" Hover="true" Dense="true" T="AiProviderListItemDto"
                                  OnRowClick="@(args => args.Item is not null ? SelectProviderAsync(args.Item) : Task.CompletedTask)"
                                  RowClassFunc="ProviderRowClass"
                                  Class="provider-table">
                            <HeaderContent>
                                <MudTh Class="provider-col-provider">Provider</MudTh>
                                <MudTh Class="provider-col-type">Loại</MudTh>
                                <MudTh Class="provider-col-priority">Ưu tiên</MudTh>
                                <MudTh Class="provider-col-enabled">Bật</MudTh>
                                <MudTh Class="provider-col-capabilities">Capabilities</MudTh>
                                <MudTh Class="provider-col-actions"></MudTh>
                            </HeaderContent>
                            <RowTemplate Context="p">
                                <MudTd DataLabel="Provider" Class="provider-col-provider">
                                    <span @onclick:stopPropagation="true">
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="provider-name-button pa-0" OnClick="@(() => SelectProviderAsync(p))">
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.body2"><b>@p.ProviderName</b></MudText>
                                                <MudText Typo="Typo.caption" Class="todox-page-subtitle">@p.ProviderCode @(p.IsSystem ? "· hệ thống" : "")</MudText>
                                            </MudStack>
                                        </MudButton>
                                    </span>
                                </MudTd>
                                <MudTd DataLabel="Loại" Class="provider-col-type">@p.ProviderType</MudTd>
                                <MudTd DataLabel="Ưu tiên" Class="provider-col-priority">@p.Priority</MudTd>
                                <MudTd DataLabel="Bật" Class="provider-col-enabled">
                                    <MudIcon Icon="@(p.Enabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                             Color="@(p.Enabled ? Color.Success : Color.Default)" Size="Size.Small" />
                                </MudTd>
                                <MudTd DataLabel="Capabilities" Class="provider-col-capabilities">@p.EnabledCapabilityCount / @p.CapabilityCount</MudTd>
                                <MudTd DataLabel="Actions" Class="provider-col-actions">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true">
                                        <MudMenuItem Disabled="@_busy" OnClick="@(() => EditProviderAsync(p))">Sửa provider</MudMenuItem>
                                        <MudMenuItem Disabled="@_busy" OnClick="@(() => OpenProviderModelsAsync(p))">Quản lý model</MudMenuItem>
                                        <MudMenuItem Disabled="@_busy" OnClick="@(() => CheckProviderConnectionAsync(p))">Kiểm tra kết nối</MudMenuItem>
                                        <MudMenuItem Disabled="@_busy" OnClick="@(() => OpenProviderSyncAsync(p))">Đồng bộ ngay</MudMenuItem>
                                    </MudMenu>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="7">
                @if (_selected is null)
                {
                    <MudPaper Class="todox-card pa-5" rounded="true">
                        <MudText Class="todox-page-subtitle">Chọn một provider để xem và chỉnh sửa cấu hình.</MudText>
                    </MudPaper>
                }
                else
                {
                    <MudPaper Class="todox-card pa-5" rounded="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">@_selected.ProviderName <MudChip T="string" Size="Size.Small" Color="Color.Default">@_selected.ProviderCode</MudChip></MudText>
                            <MudStack Row="true" Spacing="2" Class="flex-wrap">
                                @if (IsSelected79Ai)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Key" Disabled="@_busy" OnClick="Migrate79AiCredentialAsync">Khởi tạo credential bảo mật</MudButton>
                                }
                                <MudButton Class="todox-primary-btn" StartIcon="@Icons.Material.Filled.Save" Disabled="@_busy" OnClick="SaveProvider">Lưu provider</MudButton>
                            </MudStack>
                        </MudStack>
                        @if (IsSelected79Ai && _ai79CredentialMetadata is not null)
                        {
                            <MudStack Row="true" Spacing="1" Class="flex-wrap mt-2">
                                <MudChip T="string" Size="Size.Small" Color="@(_ai79CredentialMetadata.AccountEnabled ? Color.Success : Color.Default)">Account: @(_ai79CredentialMetadata.AccountEnabled ? "enabled" : "disabled")</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="@(_ai79CredentialMetadata.MappingEnabled ? Color.Success : Color.Default)">Role: @_ai79CredentialMetadata.CredentialRole</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">Status: @_ai79CredentialMetadata.SecureStatus</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">Key: @_ai79CredentialMetadata.KeyVersion</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@(_ai79CredentialMetadata.MaskedHint ?? "****")</MudChip>
                                @if (_ai79CredentialMetadata.LastUsedAt is not null)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Last used: @_ai79CredentialMetadata.LastUsedAt.Value.ToString("yyyy-MM-dd HH:mm")</MudChip>
                                }
                            </MudStack>
                        }
                        <MudDivider Class="my-3" />
                        <MudGrid>
                            <MudItem xs="12"><MudText Typo="Typo.subtitle2">Thông tin chung</MudText></MudItem>
                            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_providerEdit.ProviderName" Label="Tên provider" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_providerEdit.Priority" Label="Ưu tiên" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12"><MudTextField @bind-Value="_providerEdit.BaseUrl" Label="Base URL" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_providerEdit.ApiKeyConfigName" Label="API key config name" HelperText="Tên biến cấu hình (VD: OpenRouter__ApiKey). Không nhập API key thật." Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" sm="6" Class="d-flex align-center"><MudSwitch @bind-Value="_providerEdit.Enabled" Color="Color.Success" Label="Bật provider" /></MudItem>
                            <MudItem xs="12"><MudTextField @bind-Value="_providerEdit.Description" Label="Mô tả" Lines="2" Variant="Variant.Outlined" /></MudItem>
                        </MudGrid>
                    </MudPaper>

                    <MudPaper Class="todox-card pa-5 mt-3" rounded="true">
                        <MudText Typo="Typo.h6">Capabilities</MudText>
                        <MudText Typo="Typo.body2" Class="todox-page-subtitle">Capability là năng lực provider hỗ trợ. Chi phí nội bộ legacy không phải giá bán dịch vụ cho khách hàng.</MudText>
                        <MudDivider Class="my-3" />
                        @if (_capabilities.Count == 0)
                        {
                            <MudText Class="todox-page-subtitle">Provider này chưa có capability.</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="3">
                                @foreach (var cap in _capabilities)
                                {
                                    <MudPaper Outlined="true" Class="pa-3" rounded="true">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.subtitle1"><b>@cap.DisplayName</b>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@cap.CapabilityCode</MudChip>
                                                @if (cap.IsDefault)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Mặc định</MudChip>
                                                }
                                            </MudText>
                                            <MudStack Row="true" Spacing="1">
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                                           StartIcon="@Icons.Material.Filled.Star" Disabled="@(_busy || cap.IsDefault || !cap.Enabled || !_providerEdit.Enabled)"
                                                           OnClick="@(() => SetDefault(cap))">Đặt mặc định</MudButton>
                                                <MudButton Size="Size.Small" Class="todox-primary-btn" StartIcon="@Icons.Material.Filled.Save"
                                                           Disabled="@_busy" OnClick="@(() => SaveCapability(cap))">Lưu</MudButton>
                                            </MudStack>
                                        </MudStack>
                                        <MudGrid Class="mt-1">
                                            <MudItem xs="12" sm="6"><MudTextField @bind-Value="cap.DisplayName" Label="Tên hiển thị" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                            <MudItem xs="12" sm="6"><MudTextField @bind-Value="cap.ModelName" Label="Model name" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                            <MudItem xs="12" sm="6"><MudTextField @bind-Value="cap.EndpointPath" Label="Endpoint path" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                            <MudItem xs="6" sm="3">
                                                <MudSelect @bind-Value="cap.UnitType" Label="Đơn vị" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                    @foreach (var u in AiProviderCatalog.UnitTypes)
                                                    {
                                                        <MudSelectItem Value="u">@u</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="6" sm="3"><MudNumericField @bind-Value="cap.UnitCostPoints" Label="Chi phí nội bộ legacy" HelperText="Không phải giá bán dịch vụ cho khách hàng." Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" /></MudItem>
                                            <MudItem xs="6" sm="6" Class="d-flex align-center"><MudSwitch @bind-Value="cap.Enabled" Color="Color.Success" Label="Bật capability" /></MudItem>
                                            <MudItem xs="6" sm="6" Class="d-flex align-center"><MudSwitch @bind-Value="cap.AllowUserSelect" Color="Color.Primary" Label="Cho user chọn" /></MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="MODEL & VARIANT">
                <MudPaper Class="todox-card pa-4" rounded="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                        <MudText Typo="Typo.h6">Danh sách model</MudText>
                        <MudStack Row="true" Spacing="2" Class="flex-wrap">
                            <MudSelect T="string?" Dense="true" Variant="Variant.Outlined" Label="Provider" Value="@_modelProviderFilter" ValueChanged="OnModelProviderFilterChanged" Style="min-width:180px">
                                <MudSelectItem T="string?" Value="@((string?)null)">Tất cả</MudSelectItem>
                                @foreach (var provider in _providers)
                                {
                                    <MudSelectItem T="string?" Value="@provider.ProviderCode">@provider.ProviderName</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string?" Dense="true" Variant="Variant.Outlined" Label="Media" Value="@_modelMediaFilter" ValueChanged="OnModelMediaFilterChanged" Style="min-width:140px">
                                <MudSelectItem T="string?" Value="@((string?)null)">Tất cả</MudSelectItem>
                                <MudSelectItem T="string?" Value="@("image")">Image</MudSelectItem>
                                <MudSelectItem T="string?" Value="@("video")">Video</MudSelectItem>
                            </MudSelect>
                            <MudSelect T="string?" Dense="true" Variant="Variant.Outlined" Label="Status" Value="@_modelStatusFilter" ValueChanged="OnModelStatusFilterChanged" Style="min-width:160px">
                                <MudSelectItem T="string?" Value="@((string?)null)">Tất cả</MudSelectItem>
                                <MudSelectItem T="string?" Value="@("ACTIVE")">ACTIVE</MudSelectItem>
                                <MudSelectItem T="string?" Value="@("DEPRECATED")">DEPRECATED</MudSelectItem>
                                <MudSelectItem T="string?" Value="@("MAINTENANCE")">MAINTENANCE</MudSelectItem>
                            </MudSelect>
                            <MudCheckBox @bind-Value="_modelEnabledOnly" Label="Chỉ model bật" />
                            <MudTextField @bind-Value="_modelSearch" Variant="Variant.Outlined" Placeholder="Tìm theo code/tên" Style="min-width:220px" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="ReloadModelsAsync">Lọc</MudButton>
                        </MudStack>
                    </MudStack>
                    <MudDivider Class="my-3" />
                    @if (_loadingModels)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                    }
                    else if (_models.Count == 0)
                    {
                        <MudText Class="todox-page-subtitle">Chưa có model nào.</MudText>
                    }
                    else
                    {
                        <MudTable Items="_models" Dense="true" Hover="true" T="AiProviderModelListItemDto"
                                  OnRowClick="@(args => args.Item is not null ? OpenModelDialogAsync(args.Item) : Task.CompletedTask)" RowClass="cursor-pointer">
                            <HeaderContent>
                                <MudTh>Model</MudTh>
                                <MudTh>Media</MudTh>
                                <MudTh>Mode</MudTh>
                                <MudTh>Duration</MudTh>
                                <MudTh>Resolution</MudTh>
                                <MudTh>Giá vốn từ</MudTh>
                                <MudTh>Trạng thái</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate Context="m">
                                <MudTd DataLabel="Model">
                                    <span @onclick:stopPropagation="true">
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="provider-name-button pa-0" OnClick="@(() => OpenModelDialogAsync(m))">
                                            <MudText Typo="Typo.body2"><b>@m.DisplayName</b></MudText>
                                        </MudButton>
                                    </span>
                                    <MudText Typo="Typo.caption" Class="todox-page-subtitle">@m.ProviderCode · @m.ProviderModelCode</MudText>
                                    @if (!string.IsNullOrWhiteSpace(m.Description))
                                    {
                                        <MudText Typo="Typo.caption">@m.Description</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Media">@m.MediaType</MudTd>
                                <MudTd DataLabel="Mode">@FormatStrings(m.SupportedModes)</MudTd>
                                <MudTd DataLabel="Duration">@FormatDurations(m.SupportedDurations)</MudTd>
                                <MudTd DataLabel="Resolution">@FormatStrings(m.SupportedResolutions)</MudTd>
                                <MudTd DataLabel="Giá vốn từ">
                                    @if (m.PriceSummary is null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Chưa có bảng giá</MudChip>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(m.PriceSummary.StatusMessage))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@m.PriceSummary.StatusMessage</MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption">@m.PriceSummary.ProviderPrice?.ToString("0.####") credits</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Trạng thái">
                                    <MudChip T="string" Size="Size.Small" Color="@(m.Enabled ? Color.Success : Color.Default)">@(m.Enabled ? "ON" : "OFF")</MudChip>
                                    @if (m.IsDeprecated)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">DEPRECATED</MudChip>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Actions">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true">
                                        <MudMenuItem OnClick="@(() => OpenModelDialogAsync(m))">Chi tiết</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => OpenModelCostDialogAsync(m))">Giá vốn</MudMenuItem>
                                        <MudMenuItem Disabled="@_busy" OnClick="@(() => ToggleModelAsync(m))">Bật/tắt</MudMenuItem>
                                        <MudMenuItem Disabled="@_busy" OnClick="@(() => SyncModelProviderAsync(m))">Đồng bộ/làm mới model</MudMenuItem>
                                    </MudMenu>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="GIÁ VỐN">
                <MudPaper Class="todox-card pa-4" rounded="true">
                    <MudText Typo="Typo.h6">Giá vốn Provider</MudText>
                    <MudText Typo="Typo.body2" Class="todox-page-subtitle">Giá do nhà cung cấp trả về hoặc được xác minh. Dùng để tính chi phí thực tế TodoX. Không phải giá bán cho khách hàng.</MudText>
                    <MudDivider Class="my-3" />
                    @if (_selectedModel is null)
                    {
                        <MudAlert Severity="Severity.Info">Chọn một model ở tab MODEL & VARIANT để xem bảng giá vốn provider.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="_selectedPrices" Dense="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Mode</MudTh><MudTh>Resolution</MudTh><MudTh>Quality label</MudTh><MudTh>Duration</MudTh><MudTh>Ratio</MudTh><MudTh>Provider price</MudTh><MudTh>Provider unit</MudTh><MudTh>Internal cost</MudTh><MudTh>Price source</MudTh><MudTh>Active</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="price">
                                <MudTd DataLabel="Mode">@DisplayValue(price.Mode)</MudTd>
                                <MudTd DataLabel="Resolution"><b>@DisplayValue(price.Resolution)</b></MudTd>
                                <MudTd DataLabel="Quality label">@GetQualityLabel(_selectedModel.MediaType, price.Resolution)</MudTd>
                                <MudTd DataLabel="Duration">@(price.DurationSeconds is null ? "-" : $"{price.DurationSeconds}s")</MudTd>
                                <MudTd DataLabel="Ratio">@DisplayValue(price.Ratio)</MudTd>
                                <MudTd DataLabel="Provider price">@price.ProviderPrice?.ToString("0.####")</MudTd>
                                <MudTd DataLabel="Provider unit">@price.ProviderPriceUnit</MudTd>
                                <MudTd DataLabel="Internal cost">@price.InternalCostPoints?.ToString("0.####") internal points</MudTd>
                                <MudTd DataLabel="Price source"><MudChip T="string" Size="Size.Small" Color="@PriceSourceColor(price.PriceSource)">@PriceSourceLabel(price.PriceSource)</MudChip></MudTd>
                                <MudTd DataLabel="Active">
                                    <MudSwitch @bind-Value="price.Active" Color="Color.Success" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                        <MudExpansionPanels Class="mt-3" Elevation="0">
                            <MudExpansionPanel Text="Legacy sell pricing">
                                <MudAlert Severity="Severity.Warning" Class="mb-3">Giá bán khách hàng sẽ được cấu hình theo Dịch vụ, không theo model provider.</MudAlert>
                                <MudTable Items="_selectedPrices" Dense="true" Hover="true">
                                    <HeaderContent>
                                        <MudTh>Configuration</MudTh><MudTh>Sell points</MudTh><MudTh>Mode</MudTh><MudTh>Markup</MudTh><MudTh>Minimum</MudTh><MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="price">
                                        <MudTd DataLabel="Configuration">@FormatPriceLabel(price)</MudTd>
                                        <MudTd DataLabel="Sell points">
                                            <MudNumericField T="decimal?" Value="@price.SellPoints" ValueChanged="@((decimal? value) => price.SellPoints = value)" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(!CanEditSellPoints(price))" HideSpinButtons="true" />
                                        </MudTd>
                                        <MudTd DataLabel="Mode">
                                            <MudSelect T="string" Value="@price.SellPriceMode" ValueChanged="@((string value) => price.SellPriceMode = value)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                                <MudSelectItem T="string" Value=@("AUTO")>AUTO</MudSelectItem>
                                                <MudSelectItem T="string" Value=@("FIXED")>FIXED</MudSelectItem>
                                                <MudSelectItem T="string" Value=@("MARKUP")>MARKUP</MudSelectItem>
                                            </MudSelect>
                                        </MudTd>
                                        <MudTd DataLabel="Markup">
                                            <MudNumericField T="decimal?" Value="@price.MarkupPercent" ValueChanged="@((decimal? value) => price.MarkupPercent = value)" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                                        </MudTd>
                                        <MudTd DataLabel="Minimum">
                                            <MudNumericField T="decimal?" Value="@price.MinimumPoints" ValueChanged="@((decimal? value) => price.MinimumPoints = value)" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                                        </MudTd>
                                        <MudTd DataLabel="Actions">
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@_busy" OnClick="@(() => SavePriceAsync(price))">Lưu</MudButton>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="MẶC ĐỊNH">
                <MudPaper Class="todox-card pa-4" rounded="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                        <div>
                            <MudText Typo="Typo.h6">Cài đặt mặc định TodoX</MudText>
                            <MudText Typo="Typo.body2" Class="todox-page-subtitle">Cấu hình này quyết định model backend mặc định. Giá bán cho khách hàng được cấu hình theo dịch vụ.</MudText>
                        </div>
                        <MudButton Class="todox-primary-btn" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_busy || _loadingQuickDefaults || !CanSaveQuickDefaults)" OnClick="SaveQuickDefaultsAsync">Lưu mặc định</MudButton>
                    </MudStack>
                    <MudDivider Class="my-3" />
                    @if (_loadingQuickDefaults)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                    }
                    else
                    {
                        <MudTable Items="_quickDefaults" Dense="true" Hover="true" T="QuickDefaultRow">
                            <HeaderContent>
                                <MudTh>Chức năng</MudTh>
                                <MudTh>Provider</MudTh>
                                <MudTh>Model</MudTh>
                                <MudTh>Status</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="row">
                                <MudTd DataLabel="Chức năng">
                                    <MudText Typo="Typo.body2"><b>@row.Feature.DisplayName</b></MudText>
                                    <MudText Typo="Typo.caption" Class="todox-page-subtitle">@row.Feature.CapabilityCode · @row.Feature.MediaKind</MudText>
                                </MudTd>
                                <MudTd DataLabel="Provider">
                                    <MudSelect T="long?" Value="@row.SelectedProviderId" ValueChanged="@((long? value) => OnQuickProviderChanged(row, value))" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@_busy">
                                        <MudSelectItem T="long?" Value="@((long?)null)">Chọn provider</MudSelectItem>
                                        @foreach (var provider in row.ProviderOptions)
                                        {
                                            <MudSelectItem T="long?" Value="@provider.ProviderId">@provider.ProviderName (@provider.ProviderCode)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd DataLabel="Model">
                                    <MudSelect T="long?" Value="@row.SelectedCapabilityId" ValueChanged="@((long? value) => OnQuickModelChanged(row, value))" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="@(_busy || row.SelectedProviderId is null || row.ModelOptions.Count == 0)">
                                        <MudSelectItem T="long?" Value="@((long?)null)">Chọn model</MudSelectItem>
                                        @foreach (var model in row.ModelOptions)
                                        {
                                            <MudSelectItem T="long?" Value="@model.ProviderCapabilityId">@ModelOptionLabel(model)</MudSelectItem>
                                        }
                                    </MudSelect>
                                    @if (row.SelectedCapability is not null)
                                    {
                                        <MudText Typo="Typo.caption" Class="todox-page-subtitle">Provider model: @row.SelectedCapability.ModelName · @row.SelectedCapability.CapabilityCode</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Status">
                                    @if (row.SelectedCapability is null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Chưa chọn model</MudChip>
                                    }
                                    else if (row.SelectedCapability.IsDefault)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Đang dùng</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Sẽ cập nhật</MudChip>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row.Warning))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning">@row.Warning</MudText>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="ĐỒNG BỘ">
                <MudPaper Class="todox-card pa-4" rounded="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                        <MudText Typo="Typo.h6">Lịch sử đồng bộ</MudText>
                        <MudStack Row="true" Spacing="2" Class="flex-wrap">
                            <MudSelect T="long?" Dense="true" Variant="Variant.Outlined" Label="Provider" Value="@_selectedProviderForSync" ValueChanged="OnSyncProviderChanged" Style="min-width:220px">
                                @foreach (var provider in _providers)
                                {
                                    <MudSelectItem T="long?" Value="@((long?)provider.Id)">@provider.ProviderName</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" Disabled="@(_busy || _selectedProviderForSync is null)" OnClick="SyncSelectedProviderAsync">Đồng bộ ngay</MudButton>
                        </MudStack>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="todox-page-subtitle">@_syncMessage</MudText>
                    @if (LatestSync is not null)
                    {
                        <MudStack Row="true" Spacing="1" Class="flex-wrap mt-2">
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Last sync: @LatestSync.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">Status: @LatestSync.Status</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">New: @LatestSync.ModelInsertedCount</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Updated: @LatestSync.ModelUpdatedCount</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Unavailable: @LatestSync.ModelUnavailableCount</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Price changes: @LatestSync.PriceChangedCount</MudChip>
                        </MudStack>
                    }
                    <MudDivider Class="my-3" />
                    @if (_selectedSyncChanges.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2">Chi tiết sync gần nhất</MudText>
                        <MudTable Items="_selectedSyncChanges" Dense="true" Hover="true">
                            <HeaderContent>
                                <MudTh>Type</MudTh><MudTh>Entity</MudTh><MudTh>Summary</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="change">
                                <MudTd DataLabel="Type">@change.ChangeType</MudTd>
                                <MudTd DataLabel="Entity">@change.EntityKey</MudTd>
                                <MudTd DataLabel="Summary"><MudText Style="white-space: pre-line">@FormatSyncChangeSummary(change)</MudText></MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    <MudDivider Class="my-3" />
                    @if (_syncHistory.Count == 0)
                    {
                        <MudText Class="todox-page-subtitle">Chưa có lịch sử đồng bộ.</MudText>
                    }
                    else
                    {
                        <MudTable Items="_syncHistory" Dense="true" Hover="true" T="AiProviderSyncHeaderDto">
                            <HeaderContent>
                                <MudTh>Thời gian</MudTh><MudTh>Trigger</MudTh><MudTh>Status</MudTh><MudTh>Model mới</MudTh><MudTh>Model đổi</MudTh><MudTh>Unavailable</MudTh><MudTh>Price change</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Thời gian">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
                                <MudTd DataLabel="Trigger">@context.Trigger</MudTd>
                                <MudTd DataLabel="Status">@context.Status</MudTd>
                                <MudTd DataLabel="Model mới">@context.ModelInsertedCount</MudTd>
                                <MudTd DataLabel="Model đổi">@context.ModelUpdatedCount</MudTd>
                                <MudTd DataLabel="Unavailable">@context.ModelUnavailableCount</MudTd>
                                <MudTd DataLabel="Price change">@context.PriceChangedCount</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="NÂNG CAO">
                <MudPaper Class="todox-card pa-4" rounded="true">
                    <MudText Typo="Typo.h6">Công cụ nâng cao</MudText>
                    <MudText Typo="Typo.body2" Class="todox-page-subtitle">Công cụ kỹ thuật, kiểm thử chi phí và dữ liệu raw phục vụ vận hành provider.</MudText>
                    <MudExpansionPanels Class="mt-3" Elevation="0">
                        <MudExpansionPanel Text="EstimateCost">
                            <MudGrid>
                                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_estimateRequest.ProviderCode" Label="Provider code" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_estimateRequest.ProviderModelCode" Label="Provider model code" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_estimateRequest.Mode" Label="Mode" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_estimateRequest.Resolution" Label="Resolution" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_estimateRequest.Ratio" Label="Ratio" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="12" sm="4"><MudNumericField @bind-Value="_estimateRequest.DurationSeconds" Label="Duration seconds" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="12" sm="4"><MudNumericField @bind-Value="_estimateRequest.Quantity" Label="Quantity" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="12" sm="4" Class="d-flex align-center"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Calculate" OnClick="EstimateAsync">Estimate</MudButton></MudItem>
                            </MudGrid>
                            @if (_estimateResult is not null)
                            {
                                <MudAlert Severity="@(_estimateResult.Success ? Severity.Success : Severity.Warning)" Class="mt-3">
                                    @(_estimateResult.Message ?? _estimateResult.ErrorCode)
                                </MudAlert>
                            }
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="Raw model JSON">
                            <MudText Typo="Typo.caption" Class="todox-page-subtitle">@(_selectedModel?.RawJson ?? "Chọn model để xem raw JSON.")</MudText>
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="Provider health diagnostic">
                            <MudAlert Severity="Severity.Info">Dùng nút kiểm tra kết nối trong tab PROVIDER để xác thực cấu hình Base URL và credential name an toàn.</MudAlert>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    }
</MudStack>

<style>
