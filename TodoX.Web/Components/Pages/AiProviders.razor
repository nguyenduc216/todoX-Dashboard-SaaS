    private async Task OpenModelDialogAsync(AiProviderModelListItemDto item, int initialTabIndex)
    {
        await SelectModelAsync(item);
        if (_selectedModel is null)
        {
            Snackbar.Add("Không tìm thấy model.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<AiProviderModelDetailDialog>
        {
            { x => x.Model, _selectedModel },
            { x => x.CurrentUser, AuthState.CurrentUser },
            { x => x.InitialTabIndex, initialTabIndex }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };
        var dialog = await DialogService.ShowAsync<AiProviderModelDetailDialog>($"Chi tiết model · {_selectedModel.DisplayName}", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: bool changed } && changed)
        {
            await ReloadSelectedModelAsync();
            await ReloadModelsAsync();
        }
    }

