</style>

@code {
    private bool _loading = true;
    private bool _loadingQuickDefaults = true;
    private bool _loadingModels = true;
    private bool _busy;
    private List<AiProviderListItemDto> _providers = new();
    private List<AiProviderModelListItemDto> _models = new();
    private AiProviderDetailDto? _selected;
    private AiProviderModelDetailDto? _selectedModel;
    private UpdateAiProviderRequest _providerEdit = new();
    private List<AiProviderCapabilityDto> _capabilities = new();
    private List<AiProviderModelCapabilityDto> _selectedCapabilities = new();
    private List<AiModelPriceDto> _selectedPrices = new();
    private List<AiProviderSyncChangeDto> _selectedSyncChanges = new();
    private List<QuickDefaultRow> _quickDefaults = new();
    private string? _modelProviderFilter;
    private string? _modelMediaFilter;
    private string? _modelStatusFilter;
    private bool _modelEnabledOnly = true;
    private string? _modelSearch;
    private long? _selectedProviderForSync;
    private string? _syncMessage;
    private ProviderAccountCredentialMetadata? _ai79CredentialMetadata;
    private List<AiProviderSyncHeaderDto> _syncHistory = new();
    private EstimateCostRequestDto _estimateRequest = new() { Quantity = 1 };
    private EstimateCostResponseDto? _estimateResult;
    private int _activeTabIndex;
    private bool _pageInitialized;
    private bool _initializingPage;
    private bool _authorizationDenialLogged;
    private AiProviderSyncHeaderDto? LatestSync => _syncHistory.FirstOrDefault();
    private bool IsSelected79Ai => string.Equals(_selected?.ProviderCode, "79ai", StringComparison.OrdinalIgnoreCase);

    private bool CanSaveQuickDefaults
        => _quickDefaults.Count == AiFeatureProviderCatalog.QuickDefaultFeatures.Count
           && _quickDefaults.All(x => x.SelectedCapabilityId is not null && string.IsNullOrWhiteSpace(x.Warning));

    private bool IsAdmin => AuthState.CurrentUser?.Role is TodoXUserRole.Admin or TodoXUserRole.SystemOperator || AuthState.CurrentUser?.IsRoot == true;

    private string ProviderRowClass(AiProviderListItemDto provider, int index)
        => _selected?.Id == provider.Id ? "provider-row-selected cursor-pointer" : "cursor-pointer";

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthStateChanged;
        await EnsurePageInitializedAsync();
    }

    private void HandleAuthStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (!AuthState.IsInitialized)
            {
                StateHasChanged();
                return;
            }

            if (!IsAdmin)
            {
                LogAuthorizationDenied();
                _pageInitialized = false;
                _loading = false;
                _loadingModels = false;
                StateHasChanged();
                return;
            }

            await EnsurePageInitializedAsync();
            StateHasChanged();
        });
    }

    private async Task EnsurePageInitializedAsync()
    {
        if (!AuthState.IsInitialized || !IsAdmin || _pageInitialized || _initializingPage)
        {
            if (AuthState.IsInitialized && !IsAdmin)
            {
                LogAuthorizationDenied();
            }

            return;
        }

        _initializingPage = true;
        try
        {
            await ReloadProviders();
            _pageInitialized = true;
            _authorizationDenialLogged = false;
        }
        finally
        {
            _initializingPage = false;
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthStateChanged;
    }

    private void LogAuthorizationDenied()
    {
        if (_authorizationDenialLogged)
        {
            return;
        }

        var user = AuthState.CurrentUser;
        Logger.LogWarning(
            "AI_PROVIDERS_AUTH_DENIED userId={UserId} role={Role} isRoot={IsRoot} isAuthenticated={IsAuthenticated} isInitialized={IsInitialized}",
            user?.UserId,
            user?.Role,
            user?.IsRoot,
            user?.IsAuthenticated ?? false,
            AuthState.IsInitialized);
        _authorizationDenialLogged = true;
    }

    private async Task ReloadProviders()
    {
        _loading = true;
        _loadingQuickDefaults = true;
        try
        {
            _providers = (await Providers.GetProvidersAsync()).ToList();
            _selectedProviderForSync ??= _providers.FirstOrDefault()?.Id;
            await LoadQuickDefaultsAsync();
            await ReloadModelsAsync();
        }
        finally
        {
            _loading = false;
            _loadingQuickDefaults = false;
        }
    }

    private async Task LoadQuickDefaultsAsync()
    {
        var rows = new List<QuickDefaultRow>();
        foreach (var feature in AiFeatureProviderCatalog.QuickDefaultFeatures.OrderBy(x => x.SortOrder))
        {
            var options = (await Providers.GetSelectableProvidersAsync(feature.CapabilityCode)).ToList();
            var row = new QuickDefaultRow(feature, options);
            var selected = options.FirstOrDefault(x => x.IsDefault) ?? (options.Count == 1 ? options[0] : null);
            if (selected is not null)
            {
                row.SelectedProviderId = selected.ProviderId;
                row.SelectedCapabilityId = selected.ProviderCapabilityId;
                row.RefreshModelOptions();
            }
            else
            {
                row.RefreshModelOptions();
            }

            if (options.Count == 0)
            {
                row.Warning = "Chưa có provider/model được bật cho chức năng này.";
            }

            rows.Add(row);
        }

        _quickDefaults = rows;
    }

    private void OnQuickProviderChanged(QuickDefaultRow row, long? providerId)
    {
        row.SelectedProviderId = providerId;
        row.SelectedCapabilityId = null;
        row.RefreshModelOptions();
        if (row.ModelOptions.Count == 1)
        {
            row.SelectedCapabilityId = row.ModelOptions[0].ProviderCapabilityId;
        }
        row.Warning = row.ModelOptions.Count == 0 && providerId is not null
            ? "Provider chưa có model được bật cho chức năng này."
            : null;
    }

    private void OnQuickModelChanged(QuickDefaultRow row, long? providerCapabilityId)
    {
        row.SelectedCapabilityId = providerCapabilityId;
        row.Warning = null;
    }

    private async Task SaveQuickDefaultsAsync()
    {
        if (AuthState.CurrentUser is null) return;
        var selectedIds = _quickDefaults
            .Select(x => x.SelectedCapabilityId)
            .Where(x => x is not null)
            .Select(x => x!.Value)
            .ToList();

        if (selectedIds.Count != AiFeatureProviderCatalog.QuickDefaultFeatures.Count)
        {
            Snackbar.Add("Vui lòng chọn đủ provider và model cho tất cả chức năng.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await Providers.SetDefaultCapabilitiesAsync(selectedIds, AuthState.CurrentUser);
            Snackbar.Add("Đã lưu cài đặt provider mặc định.", Severity.Success);
            if (_selected is not null)
            {
                await RefreshSelected();
            }
            else
            {
                await ReloadProviders();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ModelOptionLabel(ProviderOptionDto option)
    {
        var model = string.IsNullOrWhiteSpace(option.ModelName) ? option.DisplayName : option.ModelName;
        return $"{model} · {option.DisplayName} · {option.UnitCostPoints:0.####} điểm/{option.UnitType}";
    }

    private async Task SelectProviderAsync(AiProviderListItemDto item)
    {
        try
        {
            _selected = await Providers.GetProviderAsync(item.Id);
            if (_selected is null)
            {
                Snackbar.Add("Không tìm thấy provider.", Severity.Warning);
                return;
            }

            _selectedProviderForSync = _selected.Id;
            _syncHistory = (await ModelService.GetSyncHistoryAsync(_selected.Id)).ToList();
            _providerEdit = new UpdateAiProviderRequest
            {
                ProviderName = _selected.ProviderName,
                BaseUrl = _selected.BaseUrl,
                ApiKeyConfigName = _selected.ApiKeyConfigName,
                Enabled = _selected.Enabled,
                Priority = _selected.Priority,
                Description = _selected.Description,
                ConfigJson = _selected.ConfigJson
            };
            _capabilities = _selected.Capabilities.ToList();
            _ai79CredentialMetadata = IsSelected79Ai ? await Ai79CredentialMigration.GetMetadataAsync() : null;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task Migrate79AiCredentialAsync()
    {
        if (!IsSelected79Ai || AuthState.CurrentUser is null)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Xác nhận",
            "Khởi tạo credential bảo mật 79AI từ credential runtime legacy hiện có?",
            yesText: "Khởi tạo",
            cancelText: "Hủy");
        if (confirmed != true)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Ai79CredentialMigration.MigrateAsync(AuthState.CurrentUser.UserId);
            _ai79CredentialMetadata = result.Metadata;
            Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Warning);
            await ReloadProviders();
            if (_selected is not null)
            {
                _selected = await Providers.GetProviderAsync(_selected.Id);
                if (_selected is not null)
                {
                    _providerEdit = new UpdateAiProviderRequest
                    {
                        ProviderName = _selected.ProviderName,
                        BaseUrl = _selected.BaseUrl,
                        ApiKeyConfigName = _selected.ApiKeyConfigName,
                        Enabled = _selected.Enabled,
                        Priority = _selected.Priority,
                        Description = _selected.Description,
                        ConfigJson = _selected.ConfigJson
                    };
                }
            }
        }
        catch
        {
            Snackbar.Add("Không thể khởi tạo credential bảo mật 79AI.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

