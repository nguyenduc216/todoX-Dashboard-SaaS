@attribute [StreamRendering]
@page "/jobs/rvideo/{JobId:guid}"
@implements IDisposable
@inject AuthStateService AuthState
@inject TodoX.Web.Services.VideoRender.IRVideoJobService RVideoJobs
@inject ILogger<RVideoJobDetail> Logger

<PageTitle>RVIDEO Job</PageTitle>
@switch (_bootstrapState)
{
    case RVideoDetailBootstrapState.WaitingForAuth:
    case RVideoDetailBootstrapState.LoadingJob:
        <MudPaper Class="pa-6 ma-4" Outlined="true" Style="min-height:65vh" role="status" aria-live="polite">
            <MudSkeleton Width="45%" Height="48px" />
            <MudStack Row="true" Spacing="3" Class="my-4">
                <MudText>Thông tin</MudText><MudText>Xem trước</MudText><MudText>Kết quả</MudText>
            </MudStack>
            <MudDivider />
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="my-4">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Warning" />
                <MudText>@(_loadingSlow ? "Dữ liệu đang tải lâu hơn dự kiến, vui lòng đợi..." : "Đang tải dữ liệu job...")</MudText>
            </MudStack>
            <MudSkeleton Height="180px" /><MudSkeleton Width="80%" Height="32px" />
            <MudSkeleton Width="65%" Height="32px" />
        </MudPaper>
        break;
    case RVideoDetailBootstrapState.Error:
        <MudAlert Severity="@_alertSeverity">
            @_loadWarning
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="LoadJobAsync" Disabled="@_loadInProgress">
            Thử tải lại
        </MudButton>
        break;
    case RVideoDetailBootstrapState.Ready:
        @if (!string.IsNullOrWhiteSpace(_loadWarning))
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_loadWarning</MudAlert>
        }
        @if (_view is not null)
        {
            <RenderVideoJobs Embedded="true"
                             JobId="@JobId"
                             ProjectId="@_view.Project.Id"
                             InitialProject="@_view.Project"
                             ServiceId="@_view.CoreJob.ServiceId"
                             ServiceCode="@_view.CoreJob.ServiceCode" />
        }
        break;
}

@code {
    private static readonly TimeSpan LoadTimeout = TimeSpan.FromSeconds(15);

    [Parameter] public Guid JobId { get; set; }

    private TodoX.Web.Services.VideoRender.RVideoJobView? _view;
    private RVideoDetailBootstrapState _bootstrapState = RVideoDetailBootstrapState.WaitingForAuth;
    private Severity _alertSeverity = Severity.Error;
    private string? _loadWarning;
    private bool _loadInProgress;
    private Guid? _loadedJobId;
    private Guid? _currentJobId;
    private bool _loadingSlow;
    private bool _disposed;
    private CancellationTokenSource? _loadingNotice;

    private enum RVideoDetailBootstrapState
    {
        WaitingForAuth,
        LoadingJob,
        Ready,
        Error
    }

    protected override void OnInitialized()
    {
        AuthState.OnChange += HandleAuthStateChanged;
        _ = ObserveLoadingAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_currentJobId != JobId)
        {
            _currentJobId = JobId;
            _loadedJobId = null;
            _view = null;
            _loadWarning = null;
            _alertSeverity = Severity.Error;
            _bootstrapState = AuthState.IsInitialized
                ? RVideoDetailBootstrapState.LoadingJob
                : RVideoDetailBootstrapState.WaitingForAuth;
        }

        if (AuthState.IsInitialized)
        {
            Logger.LogInformation("RVIDEO_DETAIL_AUTH_READY jobId={JobId}", JobId);
            await LoadJobAsync();
        }
        else
        {
            Logger.LogInformation("RVIDEO_DETAIL_WAITING_AUTH jobId={JobId}", JobId);
            _bootstrapState = RVideoDetailBootstrapState.WaitingForAuth;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadingNotice?.Cancel();
        _loadingNotice?.Dispose();
        AuthState.OnChange -= HandleAuthStateChanged;
    }

    private void HandleAuthStateChanged() => _ = InvokeAsync(async () =>
    {
        if (AuthState.IsInitialized)
        {
            Logger.LogInformation("RVIDEO_DETAIL_AUTH_READY jobId={JobId}", JobId);
            await LoadJobAsync();
        }

        StateHasChanged();
    });

    private async Task ObserveLoadingAsync()
    {
        _loadingNotice = new CancellationTokenSource();
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), _loadingNotice.Token);
            if (_disposed) return;
            _loadingSlow = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(TimeSpan.FromSeconds(20), _loadingNotice.Token);
            if (!_disposed && _bootstrapState == RVideoDetailBootstrapState.WaitingForAuth)
            {
                _loadWarning = "Chưa thể khởi tạo phiên đăng nhập. Vui lòng thử tải lại.";
                _bootstrapState = RVideoDetailBootstrapState.Error;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadJobAsync()
    {
        if (!AuthState.IsInitialized)
        {
            Logger.LogInformation("RVIDEO_DETAIL_WAITING_AUTH jobId={JobId}", JobId);
            _loadWarning = "Phiên đăng nhập chưa sẵn sàng. Vui lòng thử tải lại sau ít giây.";
            _bootstrapState = RVideoDetailBootstrapState.Error;
            return;
        }

        if (_loadInProgress || _loadedJobId == JobId)
        {
            return;
        }

        if (AuthState.CurrentUser is not { IsCustomer: true } user)
        {
            _view = null;
            _loadedJobId = null;
            _loadWarning = "Please sign in with a customer account.";
            _alertSeverity = Severity.Warning;
            _bootstrapState = RVideoDetailBootstrapState.Error;
            return;
        }

        _loadInProgress = true;
        _loadWarning = null;
        _alertSeverity = Severity.Error;
        _bootstrapState = RVideoDetailBootstrapState.LoadingJob;
        Logger.LogInformation("RVIDEO_DETAIL_LOAD_START jobId={JobId}", JobId);
        CancellationTokenSource? timeout = null;
        var requestedJob = JobId;
        var loadWatch = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            timeout = new CancellationTokenSource(LoadTimeout);
            var loaded = await RVideoJobs.GetByJobIdAsync(requestedJob, user, timeout.Token).WaitAsync(LoadTimeout);
            if (_disposed || JobId != requestedJob) return;
            _view = loaded;
            if (_view is null)
            {
                _loadedJobId = null;
                _loadWarning = "RVIDEO job was not found.";
                _bootstrapState = RVideoDetailBootstrapState.Error;
            }
            else
            {
                _loadedJobId = JobId;
                _bootstrapState = RVideoDetailBootstrapState.Ready;
                Logger.LogInformation("RVIDEO_DETAIL_LOAD_SUCCESS jobId={JobId} projectId={ProjectId}", JobId, _view.Project.Id);
            }
        }
        catch (Exception ex) when (ex is TimeoutException || ex is OperationCanceledException && timeout?.Token.IsCancellationRequested == true)
        {
            if (_disposed || JobId != requestedJob) return;
            Logger.LogWarning(ex, "RVIDEO_DETAIL_LOAD_TIMEOUT jobId={JobId} timeoutSeconds={TimeoutSeconds}", JobId, LoadTimeout.TotalSeconds);
            _view = null;
            _loadedJobId = null;
            _loadWarning = "Tải dữ liệu job quá thời gian chờ. Vui lòng thử tải lại.";
            _bootstrapState = RVideoDetailBootstrapState.Error;
        }
        catch (Exception ex)
        {
            if (_disposed || JobId != requestedJob) return;
            Logger.LogError(ex, "RVIDEO_DETAIL_LOAD_FAILED jobId={JobId}", JobId);
            _view = null;
            _loadedJobId = null;
            _loadWarning = "Không thể tải dữ liệu job. Vui lòng thử tải lại.";
            _bootstrapState = RVideoDetailBootstrapState.Error;
        }
        finally
        {
            Logger.LogInformation("RVIDEO_PARENT_BOOTSTRAP_DURATION jobId={JobId} durationMs={DurationMs} state={State}", requestedJob, loadWatch.ElapsedMilliseconds, _bootstrapState);
            timeout?.Dispose();
            _loadInProgress = false;
            if (!_disposed && JobId != requestedJob) _ = InvokeAsync(LoadJobAsync);
        }
    }
}
