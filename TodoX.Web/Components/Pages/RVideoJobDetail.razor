@page "/jobs/rvideo/{JobId:guid}"
@using TodoX.Web.Components.Pages.RVideo
@implements IDisposable
@inject AuthStateService AuthState

<PageTitle>RVIDEO Job</PageTitle>

@* RVideo V2 is the job UI; the legacy V1 editor is no longer reachable for customers. *@
@if (!AuthState.IsInitialized)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
}
else
{
    <RVideoV2Shell JobId="@JobId" />
}

@code {
    [Parameter] public Guid JobId { get; set; }

    protected override void OnInitialized() => AuthState.OnChange += HandleAuthChanged;

    private void HandleAuthChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => AuthState.OnChange -= HandleAuthChanged;
}
