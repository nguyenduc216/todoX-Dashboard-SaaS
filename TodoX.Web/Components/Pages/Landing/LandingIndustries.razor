@page "/landing/industries"
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@using TodoX.Web.Data
@using TodoX.Web.Models
@using TodoX.Web.Models.Landing
@using TodoX.Web.Services
@using TodoX.Web.Services.Landing
@inject AuthStateService AuthState
@inject AccountService Accounts
@inject TodoXConnectionFactory DbFactory
@inject IWebHostEnvironment Env
@inject IConfiguration Config
@inject ISnackbar Snackbar

<PageTitle>Giải pháp ngành nghề Landing</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-3">
        <div>
            <MudText Typo="Typo.h4" Class="todox-page-title">Giải pháp theo ngành nghề</MudText>
            <MudText Typo="Typo.body1" Class="todox-page-subtitle">Quản lý nội dung, thumbnail và video clip hiển thị trên todox.vn.</MudText>
        </div>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Refresh</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Add" OnClick="NewItem">Thêm ngành</MudButton>
        </MudStack>
    </MudStack>

    @if (!_ready)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (!CanManage)
    {
        <MudAlert Severity="Severity.Error">Bạn không có quyền quản lý nội dung Landing Page.</MudAlert>
    }
    else if (!_schemaReady)
    {
        <MudAlert Severity="Severity.Warning">Chưa cập nhật database cho phân hệ Giải pháp ngành nghề. Hãy chạy file SQL 20260809_landing_industry_solutions.sql.</MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Video/thumbnail được lưu vào thư mục media của Landing. Production nên cấu hình biến <b>LandingIndustryMedia__RootPath</b> trỏ tới thư mục <b>wwwroot/media/industries</b> của site todox.vn.
        </MudAlert>

        <MudGrid>
            <MudItem xs="12" lg="7">
                <MudPaper Class="todox-table-card pa-4">
                    <MudTable Items="@_items" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Loading="_loading">
                        <HeaderContent>
                            <MudTh>Thứ tự</MudTh>
                            <MudTh>Thumbnail</MudTh>
                            <MudTh>Ngành nghề</MudTh>
                            <MudTh>Tỷ lệ</MudTh>
                            <MudTh>Video</MudTh>
                            <MudTh>Hiển thị</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Thứ tự">@context.DisplayOrder</MudTd>
                            <MudTd DataLabel="Thumbnail">
                                @if (!string.IsNullOrWhiteSpace(context.ThumbnailUrl))
                                {
                                    <img src="@context.ThumbnailUrl" alt="@context.Title" style="width:84px;height:54px;object-fit:cover;border-radius:8px;" />
                                }
                            </MudTd>
                            <MudTd DataLabel="Ngành nghề">
                                <MudText Typo="Typo.subtitle2">@context.Title</MudText>
                                <MudText Typo="Typo.caption">@context.Slug</MudText>
                            </MudTd>
                            <MudTd DataLabel="Tỷ lệ"><MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.AspectRatio</MudChip></MudTd>
                            <MudTd DataLabel="Video">@(string.IsNullOrWhiteSpace(context.VideoUrl) ? "Chưa có" : "Đã upload")</MudTd>
                            <MudTd DataLabel="Hiển thị"><MudSwitch T="bool" Value="@context.IsActive" ReadOnly="true" Color="Color.Success" /></MudTd>
                            <MudTd>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="@(() => EditAsync(context.Id))">Sửa</MudButton>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent><MudText Class="pa-4">Chưa có dữ liệu ngành nghề.</MudText></NoRecordsContent>
                    </MudTable>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="5">
                <MudPaper Class="todox-panel pa-4">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">@(_edit.Id is null ? "Thêm ngành nghề" : "Cập nhật ngành nghề")</MudText>

                        <MudTextField T="string" Label="Tên ngành *" Variant="Variant.Outlined" @bind-Value="_edit.Title" />
                        <MudTextField T="string" Label="Slug" Variant="Variant.Outlined" @bind-Value="_edit.Slug" HelperText="Để trống sẽ tự tạo từ tên ngành." />
                        <MudTextField T="string" Label="Mô tả ngắn" Lines="2" Variant="Variant.Outlined" @bind-Value="_edit.ShortDescription" Counter="500" MaxLength="500" />
                        <MudTextField T="string" Label="Nội dung diễn giải trong popup" Lines="5" Variant="Variant.Outlined" @bind-Value="_edit.Description" />

                        <MudGrid>
                            <MudItem xs="6">
                                <MudSelect T="string" Label="Tỷ lệ video" Variant="Variant.Outlined" @bind-Value="_edit.AspectRatio">
                                    <MudSelectItem Value="@("9:16")">9:16</MudSelectItem>
                                    <MudSelectItem Value="@("16:9")">16:9</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField T="int" Label="Thứ tự" Variant="Variant.Outlined" @bind-Value="_edit.DisplayOrder" Min="0" />
                            </MudItem>
                        </MudGrid>

                        <MudSwitch T="bool" @bind-Value="_edit.IsActive" Color="Color.Success" Label="Hiển thị trên Landing Page" />

                        <MudDivider />
                        <MudText Typo="Typo.subtitle2">Thumbnail</MudText>
                        @if (!string.IsNullOrWhiteSpace(_edit.ThumbnailUrl))
                        {
                            <img src="@_edit.ThumbnailUrl" alt="Thumbnail" style="width:100%;max-height:210px;object-fit:cover;border-radius:12px;" />
                        }
                        <InputFile OnChange="ThumbnailSelected" accept="image/jpeg,image/png,image/webp" />
                        <MudText Typo="Typo.caption">JPG, PNG hoặc WEBP. Khuyến nghị 1200×1500 cho video dọc.</MudText>

                        <MudDivider />
                        <MudText Typo="Typo.subtitle2">Video clip</MudText>
                        @if (!string.IsNullOrWhiteSpace(_edit.VideoUrl))
                        {
                            <video src="@_edit.VideoUrl" controls preload="metadata" style="width:100%;max-height:320px;background:#000;border-radius:12px;"></video>
                        }
                        <InputFile OnChange="VideoSelected" accept="video/mp4,video/webm,video/quicktime" />
                        <MudText Typo="Typo.caption">MP4/WEBM/MOV. Khuyến nghị MP4 H.264; tối đa 200 MB.</MudText>

                        <MudStack Row="true" Spacing="2" Class="flex-wrap gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Save" Disabled="@_saving" OnClick="SaveAsync">Lưu nội dung</MudButton>
                            <MudButton Variant="Variant.Outlined" OnClick="NewItem">Làm mới</MudButton>
                            @if (_edit.Id is not null)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Disabled="@_saving" OnClick="DeleteAsync">Xóa</MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    private readonly LandingIndustrySolutionRepository _repositoryPlaceholder = null!;
    private LandingIndustrySolutionRepository Repository => new(DbFactory);
    private bool _ready;
    private bool _schemaReady;
    private bool _loading;
    private bool _saving;
    private IReadOnlyList<LandingIndustrySolution> _items = Array.Empty<LandingIndustrySolution>();
    private LandingIndustrySolutionEdit _edit = NewEdit();
    private IBrowserFile? _thumbnailFile;
    private IBrowserFile? _videoFile;

    private bool CanManage => AuthState.CurrentUser is not null
        && !AuthState.CurrentUser.IsCustomer
        && (AuthState.CurrentUser.IsRoot || AuthState.CurrentUser.Role is TodoXUserRole.Admin or TodoXUserRole.SystemOperator);

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsInitialized)
        {
            await AuthState.InitializeAsync(id => Accounts.RehydrateSessionAsync(id));
        }

        _ready = true;
        if (!CanManage) return;
        _schemaReady = await Repository.IsReadyAsync();
        if (_schemaReady) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!CanManage || !_schemaReady) return;
        try
        {
            _loading = true;
            _items = await Repository.ListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không tải được danh sách: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void NewItem()
    {
        _edit = NewEdit();
        _thumbnailFile = null;
        _videoFile = null;
    }

    private async Task EditAsync(Guid id)
    {
        var item = await Repository.GetAsync(id);
        if (item is null) return;

        _edit = new LandingIndustrySolutionEdit
        {
            Id = item.Id,
            Slug = item.Slug,
            Title = item.Title,
            ShortDescription = item.ShortDescription,
            Description = item.Description,
            ThumbnailUrl = item.ThumbnailUrl,
            VideoUrl = item.VideoUrl,
            AspectRatio = item.AspectRatio,
            DisplayOrder = item.DisplayOrder,
            IsActive = item.IsActive
        };
        _thumbnailFile = null;
        _videoFile = null;
    }

    private void ThumbnailSelected(InputFileChangeEventArgs e) => _thumbnailFile = e.File;
    private void VideoSelected(InputFileChangeEventArgs e) => _videoFile = e.File;

    private async Task SaveAsync()
    {
        if (!CanManage || AuthState.CurrentUser is null || _saving) return;
        if (string.IsNullOrWhiteSpace(_edit.Title))
        {
            Snackbar.Add("Vui lòng nhập tên ngành nghề.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            _edit.Title = _edit.Title.Trim();
            _edit.Slug = string.IsNullOrWhiteSpace(_edit.Slug) ? Slugify(_edit.Title) : Slugify(_edit.Slug);
            _edit.AspectRatio = _edit.AspectRatio == "16:9" ? "16:9" : "9:16";

            if (_thumbnailFile is not null)
                _edit.ThumbnailUrl = await SaveMediaAsync(_thumbnailFile, "thumb", 15 * 1024 * 1024);

            if (_videoFile is not null)
                _edit.VideoUrl = await SaveMediaAsync(_videoFile, "video", 200L * 1024 * 1024);

            var id = await Repository.UpsertAsync(_edit, AuthState.CurrentUser.UserId);
            Snackbar.Add("Đã cập nhật Giải pháp ngành nghề trên Landing Page.", Severity.Success);
            await LoadAsync();
            await EditAsync(id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không lưu được dữ liệu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_edit.Id is null || !CanManage || _saving) return;
        _saving = true;
        try
        {
            await Repository.DeleteAsync(_edit.Id.Value);
            Snackbar.Add("Đã xóa ngành nghề.", Severity.Success);
            NewItem();
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<string> SaveMediaAsync(IBrowserFile file, string kind, long maxBytes)
    {
        if (file.Size > maxBytes)
            throw new InvalidOperationException($"File {kind} vượt quá dung lượng cho phép.");

        var root = Config["LandingIndustryMedia:RootPath"];
        if (string.IsNullOrWhiteSpace(root))
        {
            root = Path.GetFullPath(Path.Combine(Env.ContentRootPath, "..", "TodoX.Landing", "wwwroot", "media", "industries"));
        }

        Directory.CreateDirectory(root);

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowed = kind == "thumb"
            ? new[] { ".jpg", ".jpeg", ".png", ".webp" }
            : new[] { ".mp4", ".webm", ".mov" };
        if (!allowed.Contains(extension))
            throw new InvalidOperationException("Định dạng file không được hỗ trợ.");

        var baseSlug = string.IsNullOrWhiteSpace(_edit.Slug) ? Slugify(_edit.Title) : _edit.Slug;
        var fileName = $"{baseSlug}-{kind}-{DateTimeOffset.UtcNow:yyyyMMddHHmmss}-{Guid.NewGuid():N}{extension}";
        var fullPath = Path.Combine(root, fileName);

        await using var target = File.Create(fullPath);
        await using var source = file.OpenReadStream(maxBytes);
        await source.CopyToAsync(target);

        return $"/media/industries/{fileName}";
    }

    private static LandingIndustrySolutionEdit NewEdit() => new()
    {
        AspectRatio = "9:16",
        DisplayOrder = 10,
        IsActive = true
    };

    private static string Slugify(string value)
    {
        var normalized = value.Trim().ToLowerInvariant()
            .Replace("đ", "d")
            .Replace("Đ", "d");
        normalized = RemoveVietnameseMarks(normalized);
        normalized = Regex.Replace(normalized, "[^a-z0-9]+", "-");
        return normalized.Trim('-');
    }

    private static string RemoveVietnameseMarks(string value)
    {
        var formD = value.Normalize(System.Text.NormalizationForm.FormD);
        var chars = formD.Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray();
        return new string(chars).Normalize(System.Text.NormalizationForm.FormC);
    }
}
