    @@media (max-width: 768px) {
        .industry-edit-modal-backdrop { padding: 8px; align-items: flex-end; }
        .industry-edit-modal { width: 100%; max-height: 94vh; border-radius: 16px 16px 0 0; }
        .industry-edit-modal-header,
        .industry-edit-modal-footer { padding: 14px 16px; }
        .industry-edit-modal-body { padding: 16px; }
        .industry-video-manager-modal,
        .industry-video-editor-modal { width: 100%; }
    }
</style>

@code {
    private bool _ready;
    private bool _schemaReady;
    private bool _videoLibraryReady;
    private bool _mediaReady;
    private bool _loading;
    private bool _saving;
    private bool _editOpen;
    private bool _videoManagerOpen;
    private bool _videoEditorOpen;
    private bool _videoLoading;
    private bool _videoSaving;
    private IReadOnlyList<LandingIndustrySolution> _items = Array.Empty<LandingIndustrySolution>();
    private IReadOnlyList<LandingIndustryVideo> _industryVideos = Array.Empty<LandingIndustryVideo>();
    private Dictionary<Guid, int> _videoCounts = new();
    private LandingIndustrySolution? _videoIndustry;
    private LandingIndustrySolutionEdit _edit = NewEdit();
    private LandingIndustryVideoEdit _videoEdit = NewVideoEdit();
    private IBrowserFile? _thumbnailFile;
    private IBrowserFile? _videoFile;
    private IBrowserFile? _videoThumbnailFile;
    private IBrowserFile? _videoUploadFile;

    private bool CanView => AuthState.CurrentUser is not null && !AuthState.CurrentUser.IsCustomer && (AuthState.CurrentUser.IsRoot || AuthState.CurrentUser.Role is TodoXUserRole.Admin or TodoXUserRole.SystemOperator || AuthState.CurrentUser.Can(LandingIndustryPermissions.View));
    private bool CanCreate => AuthState.CurrentUser is not null && (AuthState.CurrentUser.IsRoot || AuthState.CurrentUser.Role is TodoXUserRole.Admin || AuthState.CurrentUser.Can(LandingIndustryPermissions.Create));
    private bool CanUpdate => AuthState.CurrentUser is not null && (AuthState.CurrentUser.IsRoot || AuthState.CurrentUser.Role is TodoXUserRole.Admin or TodoXUserRole.SystemOperator || AuthState.CurrentUser.Can(LandingIndustryPermissions.Update));
    private bool CanDelete => AuthState.CurrentUser is not null && (AuthState.CurrentUser.IsRoot || AuthState.CurrentUser.Role is TodoXUserRole.Admin || AuthState.CurrentUser.Can(LandingIndustryPermissions.Delete));
    private bool CanSave => _edit.Id is null ? CanCreate : CanUpdate;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsInitialized)
        {
            await AuthState.InitializeAsync(id => Accounts.RehydrateSessionAsync(id));
        }

        _ready = true;
        if (!CanView) return;
        _schemaReady = await Repository.IsReadyAsync();
        _videoLibraryReady = await Repository.IsVideoLibraryReadyAsync();
        _mediaReady = MediaPaths.IsConfigured && MediaPaths.CanWrite();
        if (_schemaReady) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!CanView || !_schemaReady) return;
        try
        {
            _loading = true;
            _videoLibraryReady = await Repository.IsVideoLibraryReadyAsync();
            _items = await Repository.ListAsync(includeInactive: true, includeDeleted: true);
            _videoCounts = _videoLibraryReady
                ? await Repository.GetVideoCountsAsync()
                : new Dictionary<Guid, int>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không tải được danh sách: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetVideoCountText(LandingIndustrySolution item)
    {
        if (_videoLibraryReady)
        {
            return $"{(_videoCounts.TryGetValue(item.Id, out var count) ? count : 0)} video";
        }

        return string.IsNullOrWhiteSpace(item.VideoUrl) ? "Đang cập nhật" : "Đã upload";
    }

    private void ResetEditor()
    {
        _edit = NewEdit();
        _thumbnailFile = null;
        _videoFile = null;
    }

    private void NewItem()
    {
        ResetEditor();
        _editOpen = true;
    }

    private void CloseEditor()
    {
        if (_saving) return;
        _editOpen = false;
        ResetEditor();
    }

    private async Task EditAsync(Guid id)
    {
        var item = await Repository.GetAsync(id);
        if (item is null) return;

        _edit = new LandingIndustrySolutionEdit
        {
            Id = item.Id,
            Slug = item.Slug,
            Title = item.Title,
            ShortDescription = item.ShortDescription,
            Description = item.Description,
            ThumbnailUrl = item.ThumbnailUrl,
            VideoUrl = item.VideoUrl,
            AspectRatio = item.AspectRatio,
            FormatNote = item.FormatNote,
            GoalNote = item.GoalNote,
            CapabilityNote = item.CapabilityNote,
            DisplayOrder = item.DisplayOrder,
            IsActive = item.IsActive
        };
        _thumbnailFile = null;
        _videoFile = null;
        _editOpen = true;
    }

    private void ThumbnailSelected(InputFileChangeEventArgs e) => _thumbnailFile = e.File;
    private void VideoSelected(InputFileChangeEventArgs e) => _videoFile = e.File;

    private Task PreviewAsync(LandingIndustrySolution item)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = item.Title,
            ["VideoUrl"] = item.VideoUrl,
            ["AspectRatio"] = item.AspectRatio
        };

        return DialogService.ShowAsync<Components.Dialogs.LandingIndustryVideoPreviewDialog>(
            "Xem thử video",
            parameters,
            new DialogOptions { MaxWidth = item.AspectRatio == "16:9" ? MaxWidth.Large : MaxWidth.Small, FullWidth = true });
    }

    private async Task OpenVideoManagerAsync(LandingIndustrySolution item)
    {
        if (!_videoLibraryReady || !CanUpdate) return;
        _videoIndustry = item;
        _videoManagerOpen = true;
        await LoadIndustryVideosAsync();
    }

    private async Task OpenVideoManagerFromEditorAsync()
    {
        if (_edit.Id is null) return;
        var item = _items.FirstOrDefault(x => x.Id == _edit.Id.Value);
        if (item is null) return;
        _editOpen = false;
        await OpenVideoManagerAsync(item);
    }

    private async Task LoadIndustryVideosAsync()
    {
        if (_videoIndustry is null || !_videoLibraryReady) return;
        try
        {
            _videoLoading = true;
            _industryVideos = await Repository.ListVideosAsync(_videoIndustry.Id, includeInactive: true, includeDeleted: true);
            _videoCounts[_videoIndustry.Id] = _industryVideos.Count(x => !x.IsDeleted);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không tải được danh sách video: {ex.Message}", Severity.Error);
        }
        finally
        {
            _videoLoading = false;
        }
    }

    private void CloseVideoManager()
    {
        if (_videoSaving) return;
        _videoManagerOpen = false;
        _videoEditorOpen = false;
        _videoIndustry = null;
        _industryVideos = Array.Empty<LandingIndustryVideo>();
        ResetVideoEditor();
    }

    private void NewVideo()
    {
        if (_videoIndustry is null) return;
        _videoEdit = NewVideoEdit(_videoIndustry.Id);
        _videoThumbnailFile = null;
        _videoUploadFile = null;
        _videoEditorOpen = true;
    }

    private void EditVideo(LandingIndustryVideo video)
    {
        _videoEdit = new LandingIndustryVideoEdit
        {
            Id = video.Id,
            IndustrySolutionId = video.IndustrySolutionId,
            Title = video.Title,
            ShortDescription = video.ShortDescription,
            Description = video.Description,
            ThumbnailUrl = video.ThumbnailUrl,
            VideoUrl = video.VideoUrl,
            AspectRatio = video.AspectRatio,
            FormatNote = video.FormatNote,
            GoalNote = video.GoalNote,
            CapabilityNote = video.CapabilityNote,
            DisplayOrder = video.DisplayOrder,
            IsPrimary = video.IsPrimary,
            IsActive = video.IsActive
        };
        _videoThumbnailFile = null;
        _videoUploadFile = null;
        _videoEditorOpen = true;
    }

    private void CloseVideoEditor()
    {
        if (_videoSaving) return;
        _videoEditorOpen = false;
        ResetVideoEditor();
    }

    private void ResetVideoEditor()
    {
        _videoEdit = NewVideoEdit(_videoIndustry?.Id ?? Guid.Empty);
        _videoThumbnailFile = null;
        _videoUploadFile = null;
    }

    private void VideoThumbnailSelected(InputFileChangeEventArgs e) => _videoThumbnailFile = e.File;
    private void VideoUploadSelected(InputFileChangeEventArgs e) => _videoUploadFile = e.File;

    private Task PreviewVideoAsync(LandingIndustryVideo video)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = video.Title,
            ["VideoUrl"] = video.VideoUrl,
            ["AspectRatio"] = video.AspectRatio
        };

        return DialogService.ShowAsync<Components.Dialogs.LandingIndustryVideoPreviewDialog>(
            "Xem thử video",
            parameters,
            new DialogOptions { MaxWidth = video.AspectRatio == "16:9" ? MaxWidth.Large : MaxWidth.Small, FullWidth = true });
    }

    private async Task SaveVideoAsync()
    {
        if (AuthState.CurrentUser is null || _videoIndustry is null || !CanUpdate || _videoSaving) return;
        _videoSaving = true;
        var oldThumbnail = _videoEdit.ThumbnailUrl;
        var oldVideo = _videoEdit.VideoUrl;
        try
        {
            if (_videoThumbnailFile is not null)
            {
                _videoEdit.ThumbnailUrl = await Media.SaveThumbnailAsync(_videoThumbnailFile);
            }

            if (_videoUploadFile is not null)
            {
                _videoEdit.VideoUrl = await Media.SaveVideoAsync(_videoUploadFile);
            }

            await Repository.UpsertVideoAsync(_videoEdit, AuthState.CurrentUser.UserId);
            if (_videoThumbnailFile is not null) Media.DeleteIfSharedMedia(oldThumbnail);
            if (_videoUploadFile is not null) Media.DeleteIfSharedMedia(oldVideo);

            Snackbar.Add("Đã lưu video ngành nghề.", Severity.Success);
            _videoEditorOpen = false;
            ResetVideoEditor();
            await ReloadVideoViewsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không lưu được video: {ex.Message}", Severity.Error);
        }
        finally
        {
            _videoSaving = false;
        }
    }

    private async Task SetPrimaryVideoAsync(LandingIndustryVideo video)
    {
        if (AuthState.CurrentUser is null || _videoIndustry is null || !CanUpdate) return;
        await Repository.SetPrimaryVideoAsync(_videoIndustry.Id, video.Id, AuthState.CurrentUser.UserId);
        await ReloadVideoViewsAsync();
    }

    private async Task ToggleVideoActiveAsync(LandingIndustryVideo video)
    {
        if (AuthState.CurrentUser is null || !CanUpdate) return;
        await Repository.SetVideoActiveAsync(video.Id, !video.IsActive, AuthState.CurrentUser.UserId);
        await ReloadVideoViewsAsync();
    }

    private async Task DeleteVideoAsync(LandingIndustryVideo video)
    {
        if (AuthState.CurrentUser is null || !CanDelete) return;
        await Repository.DeleteVideoAsync(video.Id, AuthState.CurrentUser.UserId);
        await ReloadVideoViewsAsync();
    }

    private async Task RestoreVideoAsync(LandingIndustryVideo video)
    {
        if (AuthState.CurrentUser is null || !CanDelete) return;
        await Repository.RestoreVideoAsync(video.Id, AuthState.CurrentUser.UserId);
        await ReloadVideoViewsAsync();
    }

    private async Task ReloadVideoViewsAsync()
    {
        await LoadIndustryVideosAsync();
        _items = await Repository.ListAsync(includeInactive: true, includeDeleted: true);
        _videoCounts = await Repository.GetVideoCountsAsync();
        if (_videoIndustry is not null)
        {
            _videoIndustry = _items.FirstOrDefault(x => x.Id == _videoIndustry.Id) ?? _videoIndustry;
        }
    }

    private async Task SaveAsync()
    {
        if (AuthState.CurrentUser is null || !CanSave || _saving) return;
        _saving = true;
        var oldThumbnail = _edit.ThumbnailUrl;
        var oldVideo = _edit.VideoUrl;
        try
        {
            _edit.Title = _edit.Title.Trim();
            _edit.Slug = string.IsNullOrWhiteSpace(_edit.Slug) ? Slugify(_edit.Title) : Slugify(_edit.Slug);

            if (_thumbnailFile is not null)
            {
                _edit.ThumbnailUrl = await Media.SaveThumbnailAsync(_thumbnailFile);
            }

            if (_videoFile is not null)
            {
                _edit.VideoUrl = await Media.SaveVideoAsync(_videoFile);
            }

            await Repository.UpsertAsync(_edit, AuthState.CurrentUser.UserId);
            if (_thumbnailFile is not null) Media.DeleteIfSharedMedia(oldThumbnail);
            if (_videoFile is not null) Media.DeleteIfSharedMedia(oldVideo);

            Snackbar.Add("Đã lưu giải pháp ngành nghề.", Severity.Success);
            _editOpen = false;
            ResetEditor();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không lưu được dữ liệu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleActiveAsync(LandingIndustrySolution item)
    {
        if (AuthState.CurrentUser is null || !CanUpdate) return;
        await Repository.SetActiveAsync(item.Id, !item.IsActive, AuthState.CurrentUser.UserId);
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        if (AuthState.CurrentUser is null || !CanDelete) return;
        await Repository.DeleteAsync(id, AuthState.CurrentUser.UserId);
        if (_edit.Id == id) CloseEditor();
        await LoadAsync();
    }

    private async Task RestoreAsync(Guid id)
    {
        if (AuthState.CurrentUser is null || !CanDelete) return;
        await Repository.RestoreAsync(id, AuthState.CurrentUser.UserId);
        await LoadAsync();
    }

    private async Task ReorderAsync(LandingIndustrySolution item, int displayOrder)
    {
        if (AuthState.CurrentUser is null || !CanUpdate || displayOrder == item.DisplayOrder) return;
        await Repository.ReorderAsync(item.Id, displayOrder, AuthState.CurrentUser.UserId);
        await LoadAsync();
    }

    private void EnsureSlug()
    {
        if (string.IsNullOrWhiteSpace(_edit.Slug) && !string.IsNullOrWhiteSpace(_edit.Title))
        {
            _edit.Slug = Slugify(_edit.Title);
        }
    }

    private static LandingIndustrySolutionEdit NewEdit() => new()
    {
        AspectRatio = LandingIndustryAspectRatios.Portrait,
        DisplayOrder = 10,
        IsActive = true
    };

    private static LandingIndustryVideoEdit NewVideoEdit(Guid industrySolutionId = default) => new()
    {
        IndustrySolutionId = industrySolutionId,
        AspectRatio = LandingIndustryAspectRatios.Portrait,
        DisplayOrder = 0,
        IsActive = true
    };

    private static string Slugify(string value)
    {
        var normalized = RemoveVietnameseMarks(value.Trim().ToLowerInvariant().Replace("đ", "d").Replace("Đ", "d"));
        normalized = Regex.Replace(normalized, "[^a-z0-9]+", "-");
        return normalized.Trim('-');
    }

    private static string RemoveVietnameseMarks(string value)
    {
        var formD = value.Normalize(System.Text.NormalizationForm.FormD);
        var chars = formD.Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray();
        return new string(chars).Normalize(System.Text.NormalizationForm.FormC);
    }
}
