@page "/landing/video-samples"
@using TodoX.Web.Components.Dialogs
@using TodoX.Web.Models
@using TodoX.Web.Models.Landing
@using TodoX.Web.Services
@using TodoX.Web.Services.Landing
@inject AuthStateService AuthState
@inject AccountService Accounts
@inject LandingVideoSampleRepository Repository
@inject CatalogAdminRepository Catalog
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<LandingVideoSamples> Logger
@inject IJSRuntime JS
@inject IConfiguration Configuration

<PageTitle>Kho mẫu video - Landing</PageTitle>
<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Kho mẫu video</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Trang landing: /mau-video. Mẫu đang ẩn không hiện trong danh sách nhưng vẫn xem được qua "Link xem".</MudText>
        </MudStack>
        @if (_ready && CanView)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(!CanUpdate || _busy)" OnClick="AddAsync">Thêm video mẫu</MudButton>
        }
    </MudStack>
    @if (!_ready) { <MudProgressLinear Indeterminate="true" /> }
    else if (!CanView) { <MudAlert Severity="Severity.Error">Bạn không có quyền xem cấu hình Landing Page.</MudAlert> }
    else
    {
        @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }

        <MudPaper Class="pa-4">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="gap-2">
                    <MudText Typo="Typo.h6">Video trong kho (@_samples.Count)</MudText>
                    @if (_sortSupported && _samples.Count > 1)
                    {
                        @if (_sorting)
                        {
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="CancelSort">Hủy</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(_busy || !_orderChanged)" OnClick="SaveOrderAsync"
                                           StartIcon="@Icons.Material.Filled.Save" data-testid="sample-sort-save">Lưu thứ tự</MudButton>
                            </MudStack>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(!CanUpdate || _busy)" OnClick="StartSort"
                                       StartIcon="@Icons.Material.Filled.SwapVert" data-testid="sample-sort-start">Sắp xếp vị trí</MudButton>
                        }
                    }
                </MudStack>
                @if (_sorting)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Kéo thả để đổi vị trí. Video ở trên cùng hiện đầu tiên ở trang /mau-video và trang chủ. Bấm "Lưu thứ tự" để áp dụng.
                    </MudText>
                    @* Native drag and drop (draggable rows); the arrow buttons do the same for touch screens. *@
                    <div class="d-flex flex-column gap-2" data-testid="sample-sort-list">
                        @foreach (var context in _sortItems)
                        {
                            var item = context;
                            <div draggable="true" @ondragstart="@(() => _dragging = item)" @ondragend="@(() => _dragging = null)"
                                 @ondragover:preventDefault="true" @ondragenter="@(() => _dragOver = item)"
                                 @ondrop="@(() => DropOn(item))" data-testid="sample-sort-item"
                                 style="@SortItemStyle(item)">
                                <MudPaper Outlined="true" Class="pa-2 d-flex align-center gap-3">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2" Style="min-width:28px;font-weight:700">@(_sortItems.IndexOf(item) + 1)</MudText>
                                    <img src="@item.PosterUrl" alt="" draggable="false" style="width:40px;height:40px;object-fit:cover;border-radius:4px" />
                                    <div style="flex:1;min-width:0">
                                        <MudText Typo="Typo.body2" Style="font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@item.Title</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.GroupName · @item.AspectRatio@(item.IsVisible ? "" : " · Đang ẩn")</MudText>
                                    </div>
                                    <MudIconButton Icon="@Icons.Material.Filled.VerticalAlignTop" Size="Size.Small" aria-label="Đưa lên đầu"
                                                   Disabled="@(_sortItems.IndexOf(item) == 0)" OnClick="@(() => MoveTo(item, 0))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" aria-label="Lên một bậc"
                                                   Disabled="@(_sortItems.IndexOf(item) == 0)" OnClick="@(() => MoveTo(item, _sortItems.IndexOf(item) - 1))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" aria-label="Xuống một bậc"
                                                   Disabled="@(_sortItems.IndexOf(item) == _sortItems.Count - 1)" OnClick="@(() => MoveTo(item, _sortItems.IndexOf(item) + 1))" />
                                </MudPaper>
                            </div>
                        }
                    </div>
                }
                else if (_samples.Count == 0)
                {
                    <MudText Typo="Typo.body2">Chưa có video mẫu nào.</MudText>
                }
                else
                {
                    <MudTable T="LandingVideoSample" Items="_samples" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Vị trí</MudTh>
                            <MudTh>Ảnh</MudTh>
                            <MudTh>Tiêu đề</MudTh>
                            <MudTh>Nhóm dịch vụ</MudTh>
                            <MudTh>Kích thước</MudTh>
                            <MudTh>Hiển thị</MudTh>
                            <MudTh>Link xem</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@(_samples.IndexOf(context) + 1)</MudTd>
                            <MudTd><img src="@context.PosterUrl" alt="" style="max-width:64px;max-height:64px;object-fit:cover" /></MudTd>
                            <MudTd>@context.Title</MudTd>
                            <MudTd>
                                @context.GroupName
                                @if (!string.IsNullOrWhiteSpace(context.CustomerName))
                                {
                                    <MudText Typo="Typo.caption" Class="d-block" Color="Color.Warning">Khách: @context.CustomerName</MudText>
                                }
                            </MudTd>
                            <MudTd>@context.AspectRatio</MudTd>
                            <MudTd>
                                <MudSwitch T="bool" Value="@context.IsVisible" ValueChanged="@(value => SetVisibleAsync(context, value))"
                                           Color="Color.Success" Disabled="@(!CanUpdate || _busy)"
                                           Label="@(context.IsVisible ? "Có" : "Ẩn")" />
                            </MudTd>
                            <MudTd>
                                @* Works for hidden samples too: todox.vn plays them from this link without listing them. *@
                                @if (_links.TryGetValue(context.Id, out var link))
                                {
                                    <div class="d-flex align-center gap-1" style="max-width:280px">
                                        <a href="@link" target="_blank" rel="noopener" title="@link"
                                           style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@link.Replace("https://", "")</a>
                                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                       aria-label="Sao chép link xem" OnClick="@(() => CopyLinkAsync(link))" />
                                    </div>
                                    @if (!context.IsVisible)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">Đang ẩn: chỉ ai có link mới xem được</MudText>
                                    }
                                }
                            </MudTd>
                            <MudTd Style="text-align:right;white-space:nowrap">
                                <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(!CanUpdate || _busy)" OnClick="@(() => EditAsync(context))">Sửa</MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" Disabled="@(!CanUpdate || _busy)" OnClick="@(() => DeleteAsync(context))">Xóa</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    private List<LandingVideoSample> _samples = [];
    private Dictionary<Guid, string> _links = new();
    private IReadOnlyList<ServiceDto> _services = [];
    private bool _ready;
    private bool _busy;
    private bool _sortSupported;
    private bool _sorting;
    private bool _orderChanged;
    private List<LandingVideoSample> _sortItems = [];
    private LandingVideoSample? _dragging;
    private LandingVideoSample? _dragOver;
    private string? _error;
    private bool CanView => AuthState.CurrentUser is not null && !AuthState.CurrentUser.IsCustomer && (AuthState.CurrentUser.IsRoot || AuthState.CurrentUser.Role is TodoXUserRole.Admin or TodoXUserRole.SystemOperator || AuthState.CurrentUser.Can(LandingIndustryPermissions.View));
    private bool CanUpdate => CanView && LandingIntroVideoWriteAccess.CanWrite(AuthState.CurrentUser);

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsInitialized) await AuthState.InitializeAsync(id => Accounts.RehydrateSessionAsync(id));
        _ready = true;
        if (!CanView) return;
        try
        {
            _services = await Catalog.GetServicesAsync();
            await ReloadAsync();
            _sortSupported = await Repository.SupportsSortOrderAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Landing video samples load failed.");
            _error = "Không thể tải kho mẫu video. Kiểm tra database và script landing.video_samples.";
        }
    }

    private async Task ReloadAsync()
    {
        _samples = (await Repository.ListAsync()).ToList();
        _links = LandingVideoSampleLinks.ShareUrls(_samples, LandingVideoSampleLinks.BaseUrl(Configuration));
    }

    private void StartSort()
    {
        if (!CanUpdate || _busy) return;
        _error = null;
        _sortItems = _samples.ToList();
        _orderChanged = false;
        _sorting = true;
    }

    private void CancelSort()
    {
        _sorting = false;
        _sortItems = [];
    }

    private string SortItemStyle(LandingVideoSample item)
    {
        var style = "cursor:grab;border-radius:6px;";
        if (_dragging is not null && _dragging != item && _dragOver == item) style += "outline:2px dashed var(--mud-palette-warning);";
        if (_dragging == item) style += "opacity:.5;";
        return style;
    }

    private void DropOn(LandingVideoSample target)
    {
        if (_dragging is { } item) MoveTo(item, _sortItems.IndexOf(target));
        _dragging = null;
        _dragOver = null;
    }

    /// <summary>Moves a sample to a new position in the list being sorted (drag and drop or the arrow buttons).</summary>
    internal static bool Move<T>(List<T> items, T item, int index)
    {
        var from = items.IndexOf(item);
        if (from < 0) return false;
        index = Math.Clamp(index, 0, items.Count - 1);
        if (index == from) return false;
        items.RemoveAt(from);
        items.Insert(index, item);
        return true;
    }

    private void MoveTo(LandingVideoSample item, int index)
    {
        if (!Move(_sortItems, item, index)) return;
        _orderChanged = !_sortItems.Select(x => x.Id).SequenceEqual(_samples.Select(x => x.Id));
    }

    private async Task SaveOrderAsync()
    {
        if (!CanUpdate || _busy || !_sorting) return;
        _busy = true;
        _error = null;
        try
        {
            await Repository.SaveOrderAsync(_sortItems.Select(x => x.Id).ToList());
            await ReloadAsync();
            _sorting = false;
            _sortItems = [];
            Snackbar.Add("Đã lưu thứ tự video mẫu. Trang /mau-video cập nhật trong vài phút.", Severity.Success);
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Landing video sample order save failed.");
            _error = "Không lưu được thứ tự. Vui lòng thử lại.";
        }
        finally { _busy = false; }
    }

    private async Task CopyLinkAsync(string link)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", link);
            Snackbar.Add("Đã sao chép link xem video.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Copy landing sample link failed.");
            Snackbar.Add("Không sao chép được, hãy mở link rồi copy trên thanh địa chỉ.", Severity.Warning);
        }
    }

    private Task AddAsync() => OpenEditorAsync(null);
    private Task EditAsync(LandingVideoSample sample) => OpenEditorAsync(sample);

    private async Task OpenEditorAsync(LandingVideoSample? sample)
    {
        if (!CanUpdate || _busy) return;
        _error = null;
        var parameters = new DialogParameters<LandingVideoSampleDialog>
        {
            { x => x.Source, sample },
            { x => x.Services, _services }
        };
        // An upload runs inside the dialog: only its own buttons may close it.
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false };
        var dialog = await DialogService.ShowAsync<LandingVideoSampleDialog>(sample is null ? "Thêm video mẫu" : "Chỉnh sửa video mẫu", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        try { await ReloadAsync(); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Landing video samples reload failed.");
            _error = "Không thể tải lại kho mẫu video. Vui lòng tải lại trang.";
        }
    }

    private async Task SetVisibleAsync(LandingVideoSample sample, bool visible)
    {
        if (!CanUpdate || _busy) return;
        _busy = true;
        _error = null;
        try
        {
            await Repository.SetVisibleAsync(sample.Id, visible);
            sample.IsVisible = visible;
            Snackbar.Add(visible ? $"Đã hiện \"{sample.Title}\" trên landing." : $"Đã ẩn \"{sample.Title}\" khỏi landing.", Severity.Success);
        }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Landing video sample visibility change failed.");
            _error = "Không thể đổi trạng thái hiển thị. Vui lòng thử lại.";
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(LandingVideoSample sample)
    {
        if (!CanUpdate || _busy) return;
        var confirmed = await DialogService.ShowMessageBoxAsync("Xóa video mẫu", $"Xóa \"{sample.Title}\" khỏi kho mẫu video?", yesText: "Xóa", cancelText: "Hủy");
        if (confirmed != true) return;
        _busy = true;
        _error = null;
        try
        {
            await Repository.DeleteAsync(sample.Id);
            await ReloadAsync();
            Snackbar.Add("Đã xóa video mẫu.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Landing video sample delete failed.");
            _error = "Không thể xóa video mẫu. Vui lòng thử lại.";
        }
        finally { _busy = false; }
    }
}
