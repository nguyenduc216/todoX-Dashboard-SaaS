@page "/admin/editvideo-settings"
@using TodoX.Web.Services.EditVideoTool
@inject EditVideoAiSettingsService Settings
@inject EditVideoConsentSkipService Skips
@inject EditVideoClaudeScriptWriter Claude
@inject AuthStateService AuthState
@inject ISnackbar Snackbar

<PageTitle>Cài đặt EditVideo</PageTitle>

@if (!_initialized)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
}
else if (!_admin)
{
    <MudAlert Severity="Severity.Error">Chỉ quản trị viên mới sửa được cài đặt EditVideo.</MudAlert>
}
else
{
    <MudStack Spacing="3">
        <div>
            <MudText Typo="Typo.h4" Class="todox-page-title">Cài đặt EditVideo</MudText>
            <MudText Class="todox-page-subtitle">
                Model nhạc mặc định và bật/tắt model dự phòng khi TodoX EditVideo tạo video/ảnh AI.
            </MudText>
        </div>

        <MudAlert Severity="Severity.Info">
            Giá ảnh, video, nhạc và giọng đọc của EditVideo nay lấy từ <MudLink Href="/admin/model-prices"><b>Bảng giá model AI</b></MudLink>
            (chung với Dashboard): giá = chi phí 79AI × hệ số. Thứ tự model, model nào bật cho EditVideo và thứ tự dự phòng cũng sửa ở đó.
        </MudAlert>

        <MudPaper Class="todox-card pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Nhạc AI (Suno)</MudText>
            <MudSelect T="string" @bind-Value="_musicModel" Label="Model mặc định" Variant="Variant.Outlined" Style="max-width:260px">
                @foreach (var m in MusicModels)
                {
                    <MudSelectItem Value="@m">@m</MudSelectItem>
                }
            </MudSelect>
        </MudPaper>

        <MudPaper Class="todox-card pa-4">
            <MudText Typo="Typo.h6" Class="mb-1">Xác nhận giá trước khi trừ điểm</MudText>
            <MudText Typo="Typo.body2" Class="todox-page-subtitle mb-3">
                Mỗi lệnh tốn điểm (video, ảnh, nhạc, giọng đọc) đều được TodoX báo giá trước; TodoX EditVideo từ bản 1.1.3 hiện cửa sổ
                "Đồng ý trừ điểm" cho người dùng bấm — trợ lý AI không tự đồng ý được. Mọi lần báo giá và đồng ý được ghi log theo license.
            </MudText>
            <MudAlert Severity="Severity.Info" Dense="true">
                Luôn bắt buộc với mọi bản EditVideo: bản chưa có cửa sổ xác nhận phải cập nhật mới tạo được nội dung tốn điểm.
                Trợ lý AI (Claude) không được xem giá hay số dư — giá chỉ hiện trong cửa sổ xác nhận.
            </MudAlert>
        </MudPaper>

        <MudPaper Class="todox-card pa-4">
            <MudText Typo="Typo.h6" Class="mb-1">Bỏ qua xác nhận giá (chỉ license của TodoX)</MudText>
            <MudText Typo="Typo.body2" Class="todox-page-subtitle mb-3">
                License trong danh sách này tạo ảnh, video, nhạc, giọng đọc mà không hiện cửa sổ "Đồng ý trừ điểm" — chỉ dùng cho license nội bộ
                của TodoX. Mỗi lần dùng vẫn ghi log (ai_price_skip). Khi thêm, bạn phải gõ lại mật khẩu đăng nhập Dashboard của chính bạn.
                Mọi license khác luôn phải bấm xác nhận.
            </MudText>
            @if (_skips.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mb-3">Chưa có license nào được bỏ qua xác nhận.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Class="mb-3">
                    <thead><tr><th>License</th><th>Bật bởi</th><th>Lúc</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in _skips)
                        {
                            <tr>
                                <td>@s.Label</td>
                                <td>@s.EnabledBy</td>
                                <td>@s.EnabledAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td><MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => RemoveSkipAsync(s.LicenseId))">Tắt</MudButton></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudSelect T="Guid?" @bind-Value="_skipLicense" Label="License TodoX" Variant="Variant.Outlined" Dense="true" Style="min-width:320px">
                    @foreach (var l in _licenses.Where(l => _skips.All(s => s.LicenseId != l.Id)))
                    {
                        <MudSelectItem T="Guid?" Value="@l.Id">@($"{l.CustomerName ?? "?"} · {l.KeyPrefix} · {l.Status}")</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" @bind-Value="_skipPassword" Label="Mật khẩu Dashboard của bạn" InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:240px"
                              autocomplete="new-password" />
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(_skipLicense is null || string.IsNullOrEmpty(_skipPassword) || _skipBusy)"
                           OnClick="AddSkipAsync">Bật bỏ qua xác nhận</MudButton>
            </MudStack>
        </MudPaper>

        <MudPaper Class="todox-card pa-4">
            <MudText Typo="Typo.h6" Class="mb-1">Model dự phòng</MudText>
            <MudText Typo="Typo.body2" Class="todox-page-subtitle mb-3">
                Khi 79AI từ chối model khách chọn (lỗi model, hết tài nguyên, thời lượng không hợp lệ), TodoX thử lần lượt các model khác theo thứ tự
                của Bảng giá model AI — chỉ model cùng loại, bật cho EditVideo, có cùng khung/độ phân giải/thời lượng và giá không cao hơn. Khách chỉ bị trừ điểm khi có kết quả.
            </MudText>
            <MudSwitch T="bool" @bind-Value="_fallback" Color="Color.Warning" Label="Bật model dự phòng" />
        </MudPaper>

        <MudPaper Class="todox-card pa-4">
            <MudText Typo="Typo.h6" Class="mb-1">Claude viết kịch bản dự phòng</MudText>
            <MudText Typo="Typo.body2" Class="todox-page-subtitle mb-3">
                "Tạo video từ sản phẩm" nhờ agent 79AI của kiểu video viết kịch bản. Khi agent lỗi, TodoX nhờ Claude (@EditVideoClaudeScriptWriter.Model) viết thay,
                nếu đã lưu khoá API Claude ở đây. Khoá được mã hoá, chỉ hiện 4 ký tự cuối. Chi phí Claude tính vào tài khoản Anthropic của khoá, khách không bị trừ điểm.
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                Trạng thái: @(_claudeHint is null ? "chưa có khoá — dự phòng đang tắt" : $"đã lưu khoá {_claudeHint}")
            </MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudTextField T="string" @bind-Value="_claudeKey" Label="Khoá API Claude (sk-ant-...)" InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:320px" autocomplete="new-password" />
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(string.IsNullOrWhiteSpace(_claudeKey) || _claudeBusy)"
                           OnClick="SaveClaudeKeyAsync">Lưu khoá</MudButton>
                @if (_claudeHint is not null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="_claudeBusy" OnClick="ClearClaudeKeyAsync">Xoá khoá</MudButton>
                }
            </MudStack>
        </MudPaper>

        <div>
            <MudButton Class="todox-primary-btn" StartIcon="@Icons.Material.Filled.Save" Disabled="_saving" OnClick="SaveAsync">Lưu cài đặt</MudButton>
        </div>
    </MudStack>
}

@code {
    private static readonly string[] MusicModels = ["suno-v6.0", "suno-v5.5", "suno-v5.0", "suno-v4.5"];

    private bool _initialized;
    private bool _admin;
    private bool _saving;
    private EditVideoAiSettings _form = new();
    private IReadOnlyDictionary<string, decimal> _rates = new Dictionary<string, decimal>();
    private List<string> _missing = [];

    private string _imageTier = "standard";
    private string _videoTier = "standard";
    private string? _premiumModels;
    private decimal? _musicPoints;
    private decimal? _musicMarkup;
    private decimal _vndPerCredit = 1m;
    private decimal _vndPerPoint = 1000m;
    private decimal? _costFloor = 2m;

    private string MusicPriceText()
    {
        if (_form.MusicMarkup is { } m)
        {
            string P(decimal credits) => $"{Math.Max(0.1m, Math.Ceiling(credits * _vndPerCredit * m / _vndPerPoint * 10) / 10):0.##}";
            return $"×{m:0.##} chi phí 79AI: Suno 4.5–5.5 = {P(3000)} điểm, Suno 6.0 = {P(4000)} điểm";
        }

        return _form.MusicPoints is { } mp ? $"{mp:0.##} điểm cố định" : "chưa đặt";
    }
    private string _musicModel = "suno-v5.5";
    private bool _fallback = true;
    private bool _requireConsent;
    private IReadOnlyList<EditVideoConsentSkip> _skips = [];
    private IReadOnlyList<EditVideoLicenseChoice> _licenses = [];
    private Guid? _skipLicense;
    private string? _skipPassword;
    private bool _skipBusy;

    private string? _claudeHint;
    private string? _claudeKey;
    private bool _claudeBusy;

    private async Task SaveClaudeKeyAsync()
    {
        _claudeBusy = true;
        try
        {
            await Claude.SaveKeyAsync(_claudeKey ?? "");
            _claudeHint = await Claude.HintAsync();
            Snackbar.Add("Đã lưu khoá Claude. Khi agent 79AI lỗi, Claude sẽ viết kịch bản thay.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _claudeKey = null;
            _claudeBusy = false;
        }
    }

    private async Task ClearClaudeKeyAsync()
    {
        _claudeBusy = true;
        try
        {
            await Claude.ClearKeyAsync();
            _claudeHint = null;
            Snackbar.Add("Đã xoá khoá Claude: tắt viết kịch bản dự phòng.", Severity.Info);
        }
        finally
        {
            _claudeBusy = false;
        }
    }

    private async Task LoadSkipsAsync()
    {
        _skips = await Skips.ListAsync();
        _licenses = await Skips.LicensesAsync();
    }

    private async Task AddSkipAsync()
    {
        if (_licenses.FirstOrDefault(l => l.Id == _skipLicense) is not { } license)
        {
            return;
        }

        _skipBusy = true;
        try
        {
            var (ok, message) = await Skips.AddAsync(license, AuthState.CurrentUser, _skipPassword ?? "");
            _skipPassword = null;
            if (ok)
            {
                _skipLicense = null;
                await LoadSkipsAsync();
            }

            Snackbar.Add(message, ok ? Severity.Success : Severity.Error);
        }
        finally
        {
            _skipBusy = false;
        }
    }

    private async Task RemoveSkipAsync(Guid licenseId)
    {
        await Skips.RemoveAsync(licenseId, AuthState.CurrentUser);
        await LoadSkipsAsync();
        Snackbar.Add("Đã tắt: license này phải bấm xác nhận giá như bình thường.", Severity.Info);
    }
    private string? _videoFallback;
    private string? _imageFallback;

    protected override async Task OnInitializedAsync()
    {
        _admin = AdminEndpointAuthorization.IsAdmin(AuthState.CurrentUser);
        if (_admin)
        {
            await LoadAsync();
            _claudeHint = await Claude.HintAsync();
        }

        _initialized = true;
    }

    private async Task LoadAsync()
    {
        var prices = await Settings.PricesAsync();
        _form = prices.Settings;
        _rates = prices.Rates;
        _imageTier = _form.ImageTier;
        _videoTier = _form.VideoTier;
        _premiumModels = _form.PremiumModels;
        _musicPoints = _form.MusicPoints;
        _musicMarkup = _form.MusicMarkup;
        _vndPerCredit = prices.VndPerCredit;
        _vndPerPoint = prices.VndPerPoint;
        _costFloor = _form.CostFloorMarkup;
        _musicModel = _form.MusicModel;
        _fallback = _form.FallbackEnabled;
        _requireConsent = _form.RequireConsent;
        _videoFallback = _form.VideoFallback;
        _imageFallback = _form.ImageFallback;
        await LoadSkipsAsync();
        _missing = new[] { prices.Missing("image", ""), prices.Missing("video", ""), prices.Missing("music", "") }
            .Where(m => m is not null).Select(m => "Chưa có " + m).ToList();
    }

    private string Rate(string key) => _rates.TryGetValue(key, out var r) ? r.ToString("0.##") : "chưa đặt";

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            await Settings.SaveAsync(new EditVideoAiSettings
            {
                ImageTier = _imageTier,
                VideoTier = _videoTier,
                PremiumModels = _premiumModels ?? "",
                MusicPoints = _musicPoints,
                MusicMarkup = _musicMarkup,
                VndPerPoint = _vndPerPoint,
                VndPerCredit = _vndPerCredit,
                CostFloorMarkup = _costFloor,
                MusicModel = _musicModel,
                FallbackEnabled = _fallback,
                RequireConsent = _requireConsent,
                VideoFallback = _videoFallback ?? "",
                ImageFallback = _imageFallback ?? ""
            });
            await LoadAsync();
            Snackbar.Add("Đã lưu cài đặt EditVideo.", Severity.Success);
        }
        finally
        {
            _saving = false;
        }
    }
}
