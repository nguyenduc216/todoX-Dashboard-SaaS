@using TodoX.Web.Models.Catalog
@using TodoX.Web.Models.Timelapse
@inject AuthStateService AuthState
@inject CatalogRepository Catalog
@inject ICustomerDashboardService Dashboard
@inject NavigationManager Navigation
@inject ILogger<CustomerDashboard> Logger

<MudStack Spacing="4">
    <div>
        <MudText Typo="Typo.h4" Class="todox-page-title">Xin chào, @CustomerName 👋</MudText>
        <MudText Typo="Typo.body1" Class="todox-page-subtitle">Hôm nay bạn muốn tạo nội dung gì?</MudText>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var service in _services)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudPaper Class="todox-card pa-4 h-100" rounded="true">
                        <MudStack Spacing="2" Class="h-100">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="gap-3">
                                <MudIcon Icon="@ResolveIcon(service.ServiceType)" Color="Color.Warning" Size="Size.Large" />
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">@service.ServiceType</MudChip>
                            </MudStack>
                            <div>
                                <MudText Typo="Typo.h6">@service.DisplayName</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@service.Description</MudText>
                            </div>
                            <MudSpacer />
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="gap-3 flex-wrap">
                                <MudText Typo="Typo.caption" Class="todox-page-subtitle">@service.StartingPriceSummary</MudText>
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.ArrowForward" OnClick="@(() => OpenService(service))">Tạo ngay</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" sm="6" lg="4">
                <MudPaper Class="todox-card pa-4" rounded="true">
                    <MudText Typo="Typo.subtitle2">Video đang xử lý</MudText>
                    <div class="todox-stat-value">@_processingCount</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" lg="4">
                <MudPaper Class="todox-card pa-4" rounded="true">
                    <MudText Typo="Typo.subtitle2">Hoàn thành tháng này</MudText>
                    <div class="todox-stat-value">@_completedThisMonthCount</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" lg="4">
                <MudPaper Class="todox-card pa-4" rounded="true">
                    <MudText Typo="Typo.subtitle2">Characters</MudText>
                    <div class="todox-stat-value">@_characterCount</div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="todox-card pa-4" rounded="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.h6">Video gần đây</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Warning" Href="/jobs" EndIcon="@Icons.Material.Filled.ArrowForward">Xem tất cả</MudButton>
            </MudStack>

            @if (_recentJobs.Count == 0)
            {
                <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
                    <MudText>Bạn chưa có video nào.</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Hãy bắt đầu tạo video đầu tiên của bạn.</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Href="/create">Tạo video</MudButton>
                </MudStack>
            }
            else
            {
                <MudList T="string" Dense="true">
                    @foreach (var job in _recentJobs)
                    {
                        <MudListItem T="string">
                            <MudStack Spacing="1" Class="w-100">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="gap-3 flex-wrap">
                                    <MudText Typo="Typo.subtitle2">@job.Title</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(job.Status)" Variant="Variant.Filled">@job.StatusLabel</MudChip>
                                </MudStack>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @job.Workflow
                                    @if (job.ProgressPercent is int progress)
                                    {
                                        <span> · @progress%</span>
                                    }
                                </MudText>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.caption" Class="todox-page-subtitle">@job.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                                    <MudButton Variant="Variant.Text" Color="Color.Warning" Href="@job.DetailRoute">Xem chi tiết</MudButton>
                                </MudStack>
                            </MudStack>
                        </MudListItem>
                        <MudDivider />
                    }
                </MudList>
            }
        </MudPaper>
    }
</MudStack>

@code {
    private IReadOnlyList<CatalogServiceView> _services = Array.Empty<CatalogServiceView>();
    private IReadOnlyList<CustomerRecentJobDto> _recentJobs = Array.Empty<CustomerRecentJobDto>();
    private bool _loading = true;
    private string? _error;
    private int _processingCount;
    private int _completedThisMonthCount;
    private int _characterCount;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private string CustomerName => AuthState.CurrentUser?.DisplayName ?? "bạn";

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var user = AuthState.CurrentUser;
            if (user is not { IsCustomer: true })
            {
                _services = Array.Empty<CatalogServiceView>();
                _recentJobs = Array.Empty<CustomerRecentJobDto>();
                _processingCount = 0;
                _completedThisMonthCount = 0;
                _characterCount = 0;
                return;
            }

            var servicesTask = Catalog.GetActiveCatalogServicesAsync();
            var dashboardTask = Dashboard.GetDashboardAsync(user);
            await Task.WhenAll(servicesTask, dashboardTask);

            _services = servicesTask.Result
                .Where(x => CustomerServiceRouting.Resolve(x.ServiceType, x.Id, x.ServiceCode).Destination != CustomerServiceDestination.Unavailable)
                .OrderBy(x => x.SortOrder)
                .ThenBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ToList();
            _recentJobs = dashboardTask.Result.RecentJobs;
            _processingCount = dashboardTask.Result.ProcessingCount;
            _completedThisMonthCount = dashboardTask.Result.CompletedThisMonthCount;
            _characterCount = dashboardTask.Result.CharacterCount;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "CUSTOMER_DASHBOARD_LOAD_FAILED userId={UserId} customerId={CustomerId}", AuthState.CurrentUser?.UserId, AuthState.CurrentUser?.CustomerId);
            _error = "Không thể tải dữ liệu trang chủ. Vui lòng thử lại.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenService(CatalogServiceView service)
    {
        var route = CustomerServiceRouting.Resolve(service.ServiceType, service.Id, service.ServiceCode);
        if (!string.IsNullOrWhiteSpace(route.Route))
        {
            Navigation.NavigateTo(route.Route);
        }
    }

    private static Color GetStatusColor(string status)
        => status switch
        {
            var value when CustomerDashboardStatusRules.IsCompletedStatus(value) => Color.Success,
            var value when CustomerDashboardStatusRules.IsFailedStatus(value) => Color.Error,
            var value when CustomerDashboardStatusRules.IsProcessingStatus(value) => Color.Warning,
            _ => Color.Default
        };

    private static string ResolveIcon(string? serviceType)
        => serviceType switch
        {
            TodoXServiceEngineTypes.Timelapse => Icons.Material.Filled.Construction,
            TodoXServiceEngineTypes.RVideo => Icons.Material.Filled.Movie,
            TodoXServiceEngineTypes.RDance => Icons.Material.Filled.DirectionsRun,
            _ => Icons.Material.Filled.AutoFixHigh
        };
}
