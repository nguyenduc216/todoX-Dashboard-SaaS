@page "/jobs"
@implements IDisposable
@using TodoX.Web.Models.Timelapse
@using TodoX.Web.Services.DanceSell
@using TodoX.Web.Services.Timelapse
@using TodoX.Web.Services.VideoRender
@inject AuthStateService AuthState
@inject ITimelapseJobService TimelapseJobs
@inject IDanceSellPhase2Service DanceJobs
@inject IDanceSellOperationRepository DanceOperations
@inject IRVideoJobService RVideoJobs
@inject TodoX.Web.Services.Platform.ICoreJobApplicationService CoreJobs
@inject TodoX.Web.Services.Platform.ICoreServiceCatalogService ServiceCatalog
@inject NavigationManager Navigation
@inject ILogger<MyJobs> Logger

<PageTitle>Jobs của tôi</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
        <div>
            <MudText Typo="Typo.h4" Class="todox-page-title">Jobs của tôi</MudText>
            <MudText Typo="Typo.body1" Class="todox-page-subtitle">Các job video thuộc tài khoản của bạn.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Navigation.NavigateTo("/create"))">
            Tạo video
        </MudButton>
    </MudStack>

    @if (AuthState.IsInitialized && AuthState.CurrentUser is not { IsCustomer: true })
    {
        <MudAlert Severity="Severity.Warning">Vui lòng đăng nhập bằng tài khoản khách hàng.</MudAlert>
    }
    else if (!_loaded)
    {
        @* First paint is a lightweight skeleton; data loads after the interactive circuit starts (not during prerender). *@
        <MudPaper Class="todox-card pa-3" rounded="true">
            @for (var i = 0; i < 6; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Text" Height="36px" Class="my-1" />
            }
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(_error) && _jobs.Count == 0)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_jobs.Count == 0)
    {
        <MudPaper Class="todox-card pa-6" rounded="true">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" Color="Color.Warning" />
                <MudText>Chưa có job nào.</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => Navigation.NavigateTo("/create"))">Tạo job đầu tiên</MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_error</MudAlert>
        }
        <MudTable Items="_jobs" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="todox-table" Loading="_loading" LoadingProgressColor="Color.Warning">
            <HeaderContent>
                <MudTh>Tiêu đề</MudTh>
                <MudTh>Dịch vụ</MudTh>
                <MudTh>Giai đoạn</MudTh>
                <MudTh>Ngày tạo</MudTh>
                <MudTh>Điểm</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Tiêu đề">@context.Title</MudTd>
                <MudTd DataLabel="Dịch vụ">@context.ServiceLabel</MudTd>
                <MudTd DataLabel="Giai đoạn">@context.StageLabel</MudTd>
                <MudTd DataLabel="Ngày tạo">@context.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Điểm">@context.PointsLabel</MudTd>
                <MudTd DataLabel="Hành động">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" title="Xem" OnClick="@(() => Navigation.NavigateTo(context.Route))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
        @if (_hasMore)
        {
            <MudStack Row="true" Justify="Justify.Center">
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_loading" OnClick="LoadMoreAsync">
                    @(_loading ? "Đang tải..." : "Tải thêm")
                </MudButton>
            </MudStack>
        }
    }
</MudStack>

@code {
    // Jobs load on demand: each source returns only the newest page, and "Tải thêm" widens the window.
    internal const int PageSize = 20;
    private const int CoreMaxPageSize = 100;

    private IReadOnlyList<CustomerJobRow> _jobs = Array.Empty<CustomerJobRow>();
    private IReadOnlyDictionary<string, TodoX.Web.Services.Platform.CoreServiceView>? _catalog;
    private readonly Dictionary<Guid, string> _dancePoints = new();
    private readonly Dictionary<Guid, RVideoJobListSummary?> _rvideoSummaries = new();
    private int _take = PageSize;
    private bool _loaded;
    private bool _loading;
    private bool _hasMore;
    private string? _error;
    private string? _userKey;
    private int _loadVersion;
    private bool _disposed;

    protected override void OnInitialized() => AuthState.OnChange += HandleAuthChange;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await ReloadForCurrentUserAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        AuthState.OnChange -= HandleAuthChange;
    }

    // Profile edits (name, avatar) also raise OnChange; only an identity switch reloads the list.
    private void HandleAuthChange() => _ = InvokeAsync(ReloadForCurrentUserAsync);

    private async Task ReloadForCurrentUserAsync()
    {
        if (!AuthState.IsInitialized) return;
        var user = AuthState.CurrentUser;
        var key = user is { IsCustomer: true } ? $"{user.UserId}:{user.CustomerId}" : null;
        if (_loaded && key == _userKey) return;
        _userKey = key;
        _take = PageSize;
        _dancePoints.Clear();
        _rvideoSummaries.Clear();
        _jobs = Array.Empty<CustomerJobRow>();
        _loaded = false;
        await LoadJobsAsync();
    }

    private Task LoadMoreAsync()
    {
        if (_loading || !_hasMore) return Task.CompletedTask;
        _take += PageSize;
        return LoadJobsAsync();
    }

    private async Task LoadJobsAsync()
    {
        var version = ++_loadVersion;
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            if (AuthState.CurrentUser is { IsCustomer: true } currentUser)
            {
                var timelapseTask = TimelapseJobs.ListOwnedAsync(currentUser);
                // One extra row per source tells whether an older page exists.
                var danceTask = DanceJobs.ListAsync(currentUser, _take + 1);
                var coreTask = ListCoreJobsAsync(currentUser, _take + 1);
                var catalogTask = _catalog is null ? ServiceCatalog.ListAsync() : null;
                await Task.WhenAll(new Task[] { timelapseTask, danceTask, coreTask, catalogTask ?? Task.CompletedTask });
                if (version != _loadVersion || _disposed) return;
                _catalog ??= catalogTask!.Result.ToDictionary(x => x.ServiceCode, StringComparer.OrdinalIgnoreCase);
                var catalog = _catalog;

                var dance = danceTask.Result;
                var core = coreTask.Result;
                // A source that returned a full window may hide older rows; only rows newer than every such
                // source's oldest kept row are certain to be in the right order, so the list is cut there.
                DateTime? frontier = null;
                if (dance.Count > _take) frontier = Max(frontier, dance[_take - 1].CreatedAt);
                if (core.Count > _take) frontier = Max(frontier, core[_take - 1].CreatedAt);

                var rows = timelapseTask.Result.Select(x => new CustomerJobRow(
                        x.Id,
                        x.Snapshot.Title,
                        "Video Timelapse AI",
                        TimelapseStatusText.Parent(x.Workflow.ParentStatus),
                        x.Workflow.CurrentStep,
                        x.CreatedAt,
                        x.Snapshot.SellPrice?.TotalPoints is decimal points ? $"{points:0.##}" : "—",
                        $"/jobs/timelapse/{x.Id}"))
                    .Concat(BuildDanceRows(dance.Take(_take)))
                    .Concat(core.Take(_take)
                        .Where(x => string.Equals(x.OperationType, TodoX.Web.Models.Catalog.TodoXServiceEngineTypes.RVideo, StringComparison.OrdinalIgnoreCase))
                        .Select(x => BuildRVideoRow(new CustomerJobRow(
                            x.JobId,
                            ReadSnapshotString(x.Input, "title") ?? catalog.GetValueOrDefault(x.ServiceCode)?.Name ?? x.ServiceCode,
                            catalog.GetValueOrDefault(x.ServiceCode)?.Name ?? x.ServiceCode,
                            x.Status,
                            RVideoStageLabel(null, x.Status, x.CurrentStep),
                            x.CreatedAt,
                            "…",
                            $"/jobs/rvideo/{x.JobId}",
                            RVideoCore: x))))
                    .Where(x => frontier is null || x.CreatedAt >= frontier)
                    .OrderByDescending(x => x.CreatedAt)
                    .ToList();

                _jobs = rows;
                _hasMore = frontier is not null;
            }
            else
            {
                _jobs = Array.Empty<CustomerJobRow>();
                _hasMore = false;
            }
        }
        catch (Exception ex)
        {
            if (version != _loadVersion || _disposed) return;
            Logger.LogWarning(ex, "My jobs list load failed");
            _error = _jobs.Count == 0 ? "Không tải được danh sách job. Vui lòng thử lại." : "Không tải thêm được job, đang hiển thị danh sách hiện có.";
        }
        finally
        {
            if (version == _loadVersion && !_disposed)
            {
                _loading = false;
                _loaded = true;
                StateHasChanged();
            }
        }

        if (version == _loadVersion && !_disposed) await Task.WhenAll(FillDancePointsAsync(version), FillRVideoSummariesAsync(version));
    }

    private async Task<IReadOnlyList<TodoX.Web.Services.Platform.CoreJobView>> ListCoreJobsAsync(CurrentUserSession user, int count)
    {
        var context = new TodoX.Web.Services.Platform.CoreRequestContext(
            user.CustomerId, user.UserId, TodoX.Web.Services.Platform.CoreChannelCodes.Dashboard);
        var pageSize = Math.Min(count, CoreMaxPageSize);
        var items = new List<TodoX.Web.Services.Platform.CoreJobView>(count);
        for (var page = 1; items.Count < count; page++)
        {
            var result = await CoreJobs.ListAsync(context, new(page, pageSize));
            items.AddRange(result.Items);
            if (result.Items.Count < pageSize) break;
        }

        return items.Count > count ? items.GetRange(0, count) : items;
    }

    private static DateTime Max(DateTime? current, DateTime value) => current is { } c && c > value ? c : value;

    // Dance rows render immediately; their charged points are resolved afterwards and cached per job.
    private IEnumerable<CustomerJobRow> BuildDanceRows(IEnumerable<DanceSellJobDto> jobs)
        => jobs.Select(job => new CustomerJobRow(
            job.Id,
            job.Title ?? "Video nhảy quảng cáo thời trang",
            "Video nhảy quảng cáo thời trang",
            DanceSellCustomerStatusText.JobStatusLabel(job.Status),
            DanceSellCustomerStatusText.StageLabel(job.CurrentStage),
            job.CreatedAt,
            _dancePoints.GetValueOrDefault(job.Id, "…"),
            $"/jobs/rdance/{job.Id}",
            job));

    private async Task FillDancePointsAsync(int version)
    {
        var pending = _jobs.Where(x => x.DanceJob is not null && !_dancePoints.ContainsKey(x.Id)).ToList();
        if (pending.Count == 0) return;
        using var gate = new SemaphoreSlim(4);
        await Task.WhenAll(pending.Select(async row =>
        {
            await gate.WaitAsync();
            try { _dancePoints[row.Id] = await ResolveDancePointsLabelAsync(row.DanceJob!, CancellationToken.None); }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "My jobs dance points lookup failed {JobId}", row.Id);
                _dancePoints[row.Id] = "—";
            }
            finally { gate.Release(); }
        }));
        if (version != _loadVersion || _disposed) return;
        _jobs = _jobs.Select(x => x.DanceJob is not null && _dancePoints.TryGetValue(x.Id, out var label) ? x with { PointsLabel = label } : x).ToList();
        StateHasChanged();
    }

    // RVideo charges per completed scene version, so the core job's own estimate is not the amount used;
    // one batched read resolves project stage and charged points for the visible rows.
    private CustomerJobRow BuildRVideoRow(CustomerJobRow row)
        => _rvideoSummaries.TryGetValue(row.Id, out var summary)
            ? row with
            {
                StageLabel = RVideoStageLabel(summary?.ProjectStatus, row.RVideoCore!.Status, row.RVideoCore.CurrentStep),
                PointsLabel = summary is null ? "—" : $"{summary.ChargedPoints:0.##}"
            }
            : row;

    private async Task FillRVideoSummariesAsync(int version)
    {
        var pending = _jobs.Where(x => x.RVideoCore is not null && !_rvideoSummaries.ContainsKey(x.Id)).Select(x => x.Id).ToList();
        if (pending.Count == 0 || AuthState.CurrentUser is not { IsCustomer: true } user) return;
        try
        {
            var summaries = await RVideoJobs.GetListSummariesAsync(pending, user);
            foreach (var id in pending) _rvideoSummaries[id] = summaries.GetValueOrDefault(id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "My jobs RVideo summary lookup failed");
            foreach (var id in pending) _rvideoSummaries[id] = null;
        }
        if (version != _loadVersion || _disposed) return;
        _jobs = _jobs.Select(x => x.RVideoCore is not null ? BuildRVideoRow(x) : x).ToList();
        StateHasChanged();
    }

    internal static string RVideoStageLabel(string? projectStatus, string? coreStatus, string? currentStep)
        => projectStatus?.Trim().ToLowerInvariant() switch
        {
            VideoProjectStatuses.Draft => "Nháp",
            VideoProjectStatuses.SceneReady => "Đã có kịch bản",
            VideoProjectStatuses.Rendering => "Đang tạo ảnh/video",
            VideoProjectStatuses.ReadyToMerge => "Chờ ghép video",
            VideoProjectStatuses.Merging => "Đang ghép video",
            VideoProjectStatuses.Completed => "Hoàn tất",
            VideoProjectStatuses.Failed => "Thất bại",
            _ => coreStatus?.Trim().ToLowerInvariant() switch
            {
                "completed" => "Hoàn tất",
                "failed" => "Thất bại",
                "cancelled" or "canceled" => "Đã hủy",
                _ => currentStep?.Trim().ToUpperInvariant() switch
                {
                    RVideoStages.Scene => "Viết kịch bản",
                    RVideoStages.Image => "Tạo ảnh",
                    RVideoStages.Video => "Tạo video",
                    RVideoStages.Result => "Ghép video",
                    _ => "Nháp"
                }
            }
        };

    private async Task<string> ResolveDancePointsLabelAsync(DanceSellJobDto job, CancellationToken ct)
    {
        var operation = await DanceOperations.GetLatestOperationAsync(job.Id, DanceSellOperationTypes.MotionVideo, ct);
        var points = DanceSellPointDisplay.ResolveDisplayPoints(job, operation);
        return points.HasValue ? $"{points.Value:0.##}" : "—";
    }

    private static string? ReadSnapshotString(System.Text.Json.JsonElement snapshot, string propertyName)
        => snapshot.ValueKind == System.Text.Json.JsonValueKind.Object
           && snapshot.TryGetProperty(propertyName, out var value)
           && value.ValueKind == System.Text.Json.JsonValueKind.String
            ? value.GetString()
            : null;

    private sealed record CustomerJobRow(
        Guid Id,
        string Title,
        string ServiceLabel,
        string StatusLabel,
        string StageLabel,
        DateTime CreatedAt,
        string PointsLabel,
        string Route,
        DanceSellJobDto? DanceJob = null,
        TodoX.Web.Services.Platform.CoreJobView? RVideoCore = null);
}
