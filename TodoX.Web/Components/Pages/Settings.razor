@page "/settings"
@using TodoX.Web.Models
@inject CatalogRepository Catalog
@inject MrTodoXAvatarService MrTodoXAvatar
@inject SystemImageStorage SystemImageStorage
@inject AuthStateService AuthState
@inject TokenSettingsService TokenSettings
@inject EmailService Email
@using TodoX.Web.Services.Email
@inject ISnackbar Snackbar

<PageTitle>Cài đặt hệ thống</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4" Class="todox-page-title">Cài đặt hệ thống</MudText>
        <MudText Typo="Typo.body1" Class="todox-page-subtitle">Cấu hình SaaS, LLM provider/router, nhận diện TodoX và thông tin triển khai.</MudText>
    </div>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="todox-card pa-5" rounded="true">
                <MudText Typo="Typo.h6">Thông tin hệ thống</MudText>
                <MudDivider Class="my-3" />
                <MudSimpleTable Dense="true" Bordered="false" Class="todox-kv-table">
                    <tbody>
                        <tr><td>Sản phẩm</td><td>TodoX SaaS Dashboard</td></tr>
                        <tr><td>Giao diện</td><td>Dark + Gold (nhận diện TodoX)</td></tr>
                        <tr><td>Database</td><td>PostgreSQL - Foundation V2</td></tr>
                        <tr><td>Automation API</td><td>V9 API-first (/api/v9, /api/llm)</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="todox-card pa-5" rounded="true">
                <MudText Typo="Typo.h6">LLM Router / Provider</MudText>
                <MudDivider Class="my-3" />
                <MudTable Items="@_routers" Dense="true" Hover="true" Class="todox-table" Breakpoint="Breakpoint.None">
                    <HeaderContent>
                        <MudTh>Router</MudTh>
                        <MudTh>Provider</MudTh>
                        <MudTh>Model</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Router"><span class="todox-badge">@context.Router</span></MudTd>
                        <MudTd DataLabel="Provider">@context.Provider</MudTd>
                        <MudTd DataLabel="Model">@context.Model</MudTd>
                    </RowTemplate>
                </MudTable>
                <MudText Typo="Typo.caption" Class="todox-page-subtitle mt-2">
                    Hiển thị theo DatabaseContract. Chỉnh sửa provider nằm trong nhóm cài đặt API.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="todox-card pa-5" rounded="true">
                <MudStack Spacing="3">
                    <div>
                        <MudText Typo="Typo.h6">Hình ảnh đại diện TodoX / Mr. todoX</MudText>
                        <MudText Typo="Typo.body2" Class="todox-page-subtitle">
                            Ảnh này được dùng làm nhân vật đại diện trong các thumbnail dịch vụ render bằng AI.
                        </MudText>
                    </div>

                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3" Class="flex-wrap">
                        <div class="todox-mr-avatar-preview">
                            @if (!string.IsNullOrWhiteSpace(_mrTodoXAvatarUrl))
                            {
                                <img src="@_mrTodoXAvatarUrl" alt="Mr. todoX" />
                            }
                            else
                            {
                                <div class="todox-mr-avatar-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Large" />
                                    <span>Chưa có ảnh Mr. todoX</span>
                                </div>
                            }
                        </div>

                        <MudStack Spacing="2" Class="todox-mr-avatar-form">
                            <MudTextField T="string"
                                          Label="URL ảnh Mr. todoX"
                                          @bind-Value="_mrTodoXAvatarUrl"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField T="string"
                                          Label="Mô tả Mr. todoX dùng khi render"
                                          @bind-Value="_mrTodoXPrompt"
                                          Variant="Variant.Outlined"
                                          Lines="4" />

                            <MudStack Row="true" Spacing="2" Class="flex-wrap">
                                <label class="@($"profile-avatar-upload {(_mrTodoXBusy ? "is-disabled" : string.Empty)}")">
                                    <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Small" />
                                    <span>Upload ảnh Mr. todoX</span>
                                    <InputFile OnChange="UploadMrTodoXAvatar" accept="image/png,image/jpeg,image/webp" disabled="@_mrTodoXBusy" />
                                </label>

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           OnClick="SaveMrTodoXSettings"
                                           Disabled="@_mrTodoXBusy">
                                    Lưu cài đặt
                                </MudButton>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           OnClick="ClearMrTodoXAvatar"
                                           Disabled="@_mrTodoXBusy">
                                    Xóa ảnh
                                </MudButton>
                            </MudStack>

                            @if (_mrTodoXBusy)
                            {
                                <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                            }
                        </MudStack>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="todox-card pa-5" rounded="true">
                <MudText Typo="Typo.h6">Gói dịch vụ &amp; bảng giá điểm</MudText>
                <MudDivider Class="my-3" />
                <MudTable Items="@_packages" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="todox-table">
                    <HeaderContent>
                        <MudTh>Mã gói</MudTh>
                        <MudTh>Tên</MudTh>
                        <MudTh>Loại</MudTh>
                        <MudTh Style="text-align:right">Điểm cơ bản</MudTh>
                        <MudTh Style="text-align:right">Điểm/giây</MudTh>
                        <MudTh Style="text-align:right">Voice</MudTh>
                        <MudTh Style="text-align:right">Caption</MudTh>
                        <MudTh>Trạng thái</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Mã gói"><span class="todox-badge">@context.Code</span></MudTd>
                        <MudTd DataLabel="Tên">@context.Name</MudTd>
                        <MudTd DataLabel="Loại">@context.ServiceType</MudTd>
                        <MudTd DataLabel="Điểm cơ bản" Style="text-align:right">@context.BaseTokens.ToString("#,0.##")</MudTd>
                        <MudTd DataLabel="Điểm/giây" Style="text-align:right">@context.TokenPerSecond.ToString("#,0.##")</MudTd>
                        <MudTd DataLabel="Voice" Style="text-align:right">@context.VoiceTokens.ToString("#,0.##")</MudTd>
                        <MudTd DataLabel="Caption" Style="text-align:right">@context.CaptionTokens.ToString("#,0.##")</MudTd>
                        <MudTd DataLabel="Trạng thái">
                            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Bật" : "Tắt")</MudChip>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-4 todox-page-subtitle">Chưa có gói dịch vụ nào.</MudText>
                    </NoRecordsContent>
                </MudTable>
                <MudText Typo="Typo.caption" Class="todox-page-subtitle mt-2">
                    Dữ liệu đọc trực tiếp từ public.service_packages.
                </MudText>
            </MudPaper>
        </MudItem>
            @if (IsAdmin)
        {
            <MudItem xs="12">
                <MudPaper Class="todox-card pa-5" rounded="true">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">Trừ điểm ảnh tĩnh</MudText>
                        <MudText Typo="Typo.body2" Class="todox-page-subtitle">
                            Khi bật, RDance và Timelapse tính điểm cho toàn bộ ảnh tĩnh đầu vào. Khi tắt, phần ảnh tĩnh không bị tính điểm.
                        </MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap gap-3">
                            <MudSwitch T="bool"
                                       Color="Color.Warning"
                                       Value="@_chargeStaticImagePoints"
                                       ValueChanged="OnChargeStaticImagePointsChanged"
                                       Disabled="@_settingsBusy">
                                Trừ điểm ảnh tĩnh
                            </MudSwitch>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Disabled="@(_settingsBusy || !_settingsLoaded)"
                                       OnClick="SaveStaticImageBillingAsync">
                                Lưu cài đặt
                            </MudButton>
                        </MudStack>
                        @if (_settingsBusy)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12">
                <MudPaper Class="todox-card pa-5" rounded="true">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6">Email gửi đi (SMTP)</MudText>
                            @if (_smtpLoaded)
                            {
                                <MudChip T="string" Size="Size.Small" Color="@(_smtpConfigured ? Color.Success : Color.Default)">
                                    @(_smtpConfigured ? "Đã cấu hình" : "Chưa cấu hình")
                                </MudChip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.body2" Class="todox-page-subtitle">
                            Dùng để gửi email chào mừng khi khách đăng ký và báo cho TodoX có khách mới.
                            Gmail: máy chủ smtp.gmail.com, cổng 587, STARTTLS, mật khẩu là App Password.
                        </MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" @bind-Value="_smtpHost" Label="Máy chủ SMTP" Placeholder="smtp.gmail.com" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudNumericField T="int" @bind-Value="_smtpPort" Label="Cổng" Min="1" Max="65535" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="6" sm="3">
                                <MudSelect T="string" @bind-Value="_smtpSecurity" Label="Bảo mật" Variant="Variant.Outlined">
                                    <MudSelectItem Value="@("auto")">Tự chọn</MudSelectItem>
                                    <MudSelectItem Value="@("starttls")">STARTTLS (587)</MudSelectItem>
                                    <MudSelectItem Value="@("ssl")">SSL (465)</MudSelectItem>
                                    <MudSelectItem Value="@("none")">Không mã hoá</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" @bind-Value="_smtpUsername" Label="Tài khoản đăng nhập" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" @bind-Value="_smtpPassword" Label="Mật khẩu" InputType="InputType.Password" Variant="Variant.Outlined"
                                              Placeholder="@(_smtpHasPassword ? "Đã lưu – để trống để giữ nguyên" : "")" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" @bind-Value="_smtpFromEmail" Label="Email người gửi" Placeholder="no-reply@todox.vn" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" @bind-Value="_smtpFromName" Label="Tên người gửi" Placeholder="TodoX" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" @bind-Value="_smtpNotifyEmail" Label="Email nhận thông báo khách mới (không bắt buộc)" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6" Class="d-flex align-center">
                                <MudSwitch T="bool" @bind-Value="_smtpWelcome" Color="Color.Warning">Gửi email chào mừng khi khách đăng ký</MudSwitch>
                            </MudItem>
                        </MudGrid>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap gap-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Save"
                                       Disabled="@(_smtpBusy || !_smtpLoaded)" OnClick="SaveSmtpAsync">Lưu cấu hình email</MudButton>
                            <MudTextField T="string" @bind-Value="_smtpTestTo" Label="Gửi thử tới" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:260px" />
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Send"
                                       Disabled="@(_smtpBusy || !_smtpLoaded)" OnClick="TestSmtpAsync">Gửi thử</MudButton>
                        </MudStack>
                        @if (_smtpBusy)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</MudStack>

@code {
    private IReadOnlyList<ServicePackageView> _packages = new List<ServicePackageView>();
    private string? _mrTodoXAvatarUrl;
    private string _mrTodoXPrompt = string.Empty;
    private bool _mrTodoXBusy;
    private bool _chargeStaticImagePoints = true;
    private bool _settingsLoaded;
    private bool _settingsBusy;

    private bool IsAdmin => AuthState.CurrentUser?.IsRoot == true
        || AuthState.CurrentUser?.Role is TodoXUserRole.Admin or TodoXUserRole.SystemOperator;

    protected override async Task OnInitializedAsync()
    {
        _packages = await Catalog.GetServicePackagesAsync();
        var mrTodoX = await MrTodoXAvatar.GetAsync();
        _mrTodoXAvatarUrl = mrTodoX.AvatarUrl;
        _mrTodoXPrompt = mrTodoX.PromptDescription;
        if (IsAdmin)
        {
            _chargeStaticImagePoints = await TokenSettings.GetChargeStaticImagePointsAsync();
            _settingsLoaded = true;
            LoadSmtp(await Email.GetAsync());
            _smtpTestTo = AuthState.CurrentUser?.Email;
        }
    }

    private string? _smtpHost, _smtpUsername, _smtpPassword, _smtpFromEmail, _smtpFromName, _smtpNotifyEmail, _smtpTestTo;
    private string _smtpSecurity = "auto";
    private int _smtpPort = 587;
    private bool _smtpWelcome = true, _smtpHasPassword, _smtpConfigured, _smtpLoaded, _smtpBusy;

    private void LoadSmtp(SmtpSettings s)
    {
        (_smtpHost, _smtpPort, _smtpSecurity, _smtpUsername) = (s.Host, s.Port, s.Security, s.Username);
        (_smtpFromEmail, _smtpFromName, _smtpNotifyEmail, _smtpWelcome) = (s.FromEmail, s.FromName, s.NotifyEmail, s.WelcomeOnRegister);
        _smtpPassword = null;
        _smtpHasPassword = !string.IsNullOrEmpty(s.Password);
        _smtpConfigured = s.IsConfigured;
        _smtpLoaded = true;
    }

    private SmtpSettings SmtpForm() => new(_smtpHost?.Trim() ?? "", _smtpPort, _smtpSecurity, _smtpUsername?.Trim(), _smtpPassword,
        _smtpFromEmail?.Trim() ?? "", _smtpFromName?.Trim(), _smtpNotifyEmail?.Trim(), _smtpWelcome);

    private async Task SaveSmtpAsync()
    {
        if (!IsAdmin) return;
        _smtpBusy = true;
        try
        {
            var result = await Email.SaveAsync(SmtpForm());
            Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
            if (result.Success)
            {
                LoadSmtp(await Email.GetAsync());
            }
        }
        finally { _smtpBusy = false; }
    }

    /// <summary>Sends a test with what is in the form (a blank password uses the stored one), without saving.</summary>
    private async Task TestSmtpAsync()
    {
        if (!IsAdmin) return;
        var form = SmtpForm();
        var error = EmailService.Validate(form);
        if (error is not null)
        {
            Snackbar.Add(error, Severity.Error);
            return;
        }

        _smtpBusy = true;
        try
        {
            if (string.IsNullOrEmpty(form.Password))
            {
                form = form with { Password = (await Email.GetAsync()).Password };
            }

            var result = await Email.SendAsync(form, _smtpTestTo ?? "", "TodoX – email thử",
                SignupEmails.Welcome(AuthState.CurrentUser?.DisplayName ?? "bạn", _smtpTestTo ?? ""));
            Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Error);
        }
        finally { _smtpBusy = false; }
    }

    private async Task UploadMrTodoXAvatar(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _mrTodoXBusy = true;
        try
        {
            var url = await SystemImageStorage.SaveMrTodoXAvatarAsync(file);
            _mrTodoXAvatarUrl = url;
            await MrTodoXAvatar.SaveAvatarUrlAsync(url);
            Snackbar.Add("Đã upload ảnh Mr. todoX.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload ảnh Mr. todoX lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _mrTodoXBusy = false;
        }
    }

    private async Task SaveMrTodoXSettings()
    {
        _mrTodoXBusy = true;
        try
        {
            await MrTodoXAvatar.SaveAvatarUrlAsync(_mrTodoXAvatarUrl);
            await MrTodoXAvatar.SavePromptAsync(_mrTodoXPrompt);
            Snackbar.Add("Đã lưu cài đặt Mr. todoX.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lưu cài đặt Mr. todoX lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _mrTodoXBusy = false;
        }
    }

    private async Task ClearMrTodoXAvatar()
    {
        _mrTodoXBusy = true;
        try
        {
            _mrTodoXAvatarUrl = null;
            await MrTodoXAvatar.SaveAvatarUrlAsync(null);
            Snackbar.Add("Đã xóa URL ảnh Mr. todoX.", Severity.Success);
        }
        finally
        {
            _mrTodoXBusy = false;
        }
    }

    private Task OnChargeStaticImagePointsChanged(bool value)
    {
        _chargeStaticImagePoints = value;
        return Task.CompletedTask;
    }

    private async Task SaveStaticImageBillingAsync()
    {
        if (!IsAdmin)
        {
            return;
        }

        _settingsBusy = true;
        try
        {
            await TokenSettings.SetBoolAsync(
                TokenSettingsService.KeyChargeStaticImagePoints,
                _chargeStaticImagePoints,
                "billing",
                "Trừ điểm ảnh tĩnh cho RDance và Timelapse");
            _settingsLoaded = true;
            Snackbar.Add("Đã lưu cài đặt trừ điểm ảnh tĩnh.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lưu cài đặt trừ điểm ảnh tĩnh lỗi: {ex.Message}", Severity.Error);
        }
        finally
        {
            _settingsBusy = false;
        }
    }

    private readonly List<RouterRow> _routers = new()
    {
        new("CloudGemini", "Google Cloud", "gemini-2.5-pro"),
        new("GPT", "WokuGPT", "gpt-4o"),
        new("Claude", "WokuClaude", "claude-sonnet-4-6"),
        new("DeepSeek", "WokuDeepSeek", "deepseek-chat"),
        new("WokuGemini", "WokuGemini", "gemini-2.0-flash")
    };

    private sealed record RouterRow(string Router, string Provider, string Model);
}
