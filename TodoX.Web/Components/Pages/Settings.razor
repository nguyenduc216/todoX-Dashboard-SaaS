@code {
    private IReadOnlyList<ServicePackageView> _packages = new List<ServicePackageView>();
    private string? _mrTodoXAvatarUrl;
    private string _mrTodoXPrompt = string.Empty;
    private bool _mrTodoXBusy;
    private bool _chargeStaticImagePoints = true;
    private bool _settingsLoaded;
    private bool _settingsBusy;

    private bool IsAdmin => AuthState.CurrentUser?.IsRoot == true
        || AuthState.CurrentUser?.Role is TodoXUserRole.Admin or TodoXUserRole.SystemOperator;

    protected override async Task OnInitializedAsync()
    {
        _packages = await Catalog.GetServicePackagesAsync();
        var mrTodoX = await MrTodoXAvatar.GetAsync();
        _mrTodoXAvatarUrl = mrTodoX.AvatarUrl;
        _mrTodoXPrompt = mrTodoX.PromptDescription;
        if (IsAdmin)
        {
            _chargeStaticImagePoints = await TokenSettings.GetChargeStaticImagePointsAsync();
            _settingsLoaded = true;
        }
    }

    private async Task UploadMrTodoXAvatar(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _mrTodoXBusy = true;
        try
        {
            var url = await SystemImageStorage.SaveMrTodoXAvatarAsync(file);
            _mrTodoXAvatarUrl = url;
            await MrTodoXAvatar.SaveAvatarUrlAsync(url);
            Snackbar.Add("ÄÃ£ upload áº£nh Mr. todoX.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload áº£nh Mr. todoX lá»—i: {ex.Message}", Severity.Error);
        }
        finally
        {
            _mrTodoXBusy = false;
        }
    }

    private async Task SaveMrTodoXSettings()
    {
        _mrTodoXBusy = true;
        try
        {
            await MrTodoXAvatar.SaveAvatarUrlAsync(_mrTodoXAvatarUrl);
            await MrTodoXAvatar.SavePromptAsync(_mrTodoXPrompt);
            Snackbar.Add("ÄÃ£ lÆ°u cÃ i Ä‘áº·t Mr. todoX.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"LÆ°u cÃ i Ä‘áº·t Mr. todoX lá»—i: {ex.Message}", Severity.Error);
        }
        finally
        {
            _mrTodoXBusy = false;
        }
    }

    private async Task ClearMrTodoXAvatar()
    {
        _mrTodoXBusy = true;
        try
        {
            _mrTodoXAvatarUrl = null;
            await MrTodoXAvatar.SaveAvatarUrlAsync(null);
            Snackbar.Add("ÄÃ£ xÃ³a URL áº£nh Mr. todoX.", Severity.Success);
        }
        finally
        {
            _mrTodoXBusy = false;
        }
    }

    private Task OnChargeStaticImagePointsChanged(bool value)
    {
        _chargeStaticImagePoints = value;
        return Task.CompletedTask;
    }

    private async Task SaveStaticImageBillingAsync()
    {
        if (!IsAdmin)
        {
            return;
        }

        _settingsBusy = true;
        try
        {
            await TokenSettings.SetBoolAsync(
                TokenSettingsService.KeyChargeStaticImagePoints,
                _chargeStaticImagePoints,
                "billing",
                "Trá»« Ä‘iá»ƒm áº£nh tÄ©nh cho RDance vÃ  Timelapse");
            _settingsLoaded = true;
            Snackbar.Add("ÄÃ£ lÆ°u cÃ i Ä‘áº·t trá»« Ä‘iá»ƒm áº£nh tÄ©nh.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"LÆ°u cÃ i Ä‘áº·t trá»« Ä‘iá»ƒm áº£nh tÄ©nh lá»—i: {ex.Message}", Severity.Error);
        }
        finally
        {
            _settingsBusy = false;
        }
    }

    private readonly List<RouterRow> _routers = new()
    {
        new("CloudGemini", "Google Cloud", "gemini-2.5-pro"),
        new("GPT", "WokuGPT", "gpt-4o"),
        new("Claude", "WokuClaude", "claude-sonnet-4-6"),
        new("DeepSeek", "WokuDeepSeek", "deepseek-chat"),
        new("WokuGemini", "WokuGemini", "gemini-2.0-flash")
    };

    private sealed record RouterRow(string Router, string Provider, string Model);
}
