@page "/render-job"
@using System.Text
@using System.Text.Json
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components.Forms
@using TodoX.Web.Components.Dialogs
@using TodoX.Web.Services.AiProviders
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject TodoX.Web.Services.VideoRender.VideoRenderRepository VideoRepo
@inject TodoX.Web.Services.Render.IRenderJobService RenderJobs
@inject TodoX.Web.Services.Render.ISceneImageRenderService SceneImages
@inject TodoX.Web.Services.AiCharacters.IAiCharacterService Characters
@inject TodoX.Web.Services.IAiStudioCatalogService Catalog
@inject TodoX.Web.Services.VideoRender.ITodoXVideoPromptParser PromptParser
@inject TodoX.Web.Services.AiProviders.IAiImageRenderRouter ImageRenderRouter
@inject TodoX.Web.Services.AiProviders.IAiProviderService AiProviders
@inject TodoX.Web.Services.Media.IMediaFileService MediaFiles
@inject TenantContext Tenant
@inject TodoX.Web.Services.VideoRender.ISceneMediaVersioningService SceneVersions
@inject TodoX.Web.Services.VideoRender.RVideoJobSettingsRepository RVideoSettings
@inject TodoX.Web.Services.VideoRender.IRVideoJobService RVideoJobs
@inject TodoX.Web.Services.Platform.ICoreServiceCatalogService CoreCatalog
@inject IOptionsMonitor<TodoX.Web.Services.VideoRender.VideoRenderOptions> VideoOptions
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<RenderVideoJobs> Logger
@inject IJSRuntime JS

<PageTitle>@ResolveServiceLabel()</PageTitle>

@if (!Embedded)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
}
else
{
<MudStack Spacing="0">
    @if (!AuthState.IsInitialized)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (AuthState.CurrentUser is null)
    {
        <MudAlert Severity="Severity.Warning">Vui lòng đăng nhập.</MudAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_loadWarning))
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_loadWarning</MudAlert>
        }
        @if (_projectDialogOpen)
        {
            <div class="render-project-dialog" role="dialog" aria-modal="true">
                <div class="render-project-dialog-surface">
                    <header class="render-project-dialog-header">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">@ResolveServiceLabel()</MudText>
                            <MudText Typo="Typo.caption">@ProjectHeaderMeta</MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="1" Class="flex-wrap gap-1">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="CloseProjectDialogAsync" />
                        </MudStack>
                    </MudStack>
                    </header>
                    <main class="render-project-dialog-body">
                    <MudTabs Class="render-project-tabs" rounded="true" ApplyEffectsToContainer="true" panelClass="render-tab-panel" @bind-ActivePanelIndex="_tabIndex">
            <MudTabPanel Text="Thông tin">
                <div class="render-tab-scroll render-info-scroll">
                <MudPaper Class="todox-card pa-4" rounded="true">
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudPaper Class="pa-4 d-flex flex-column h-100" Outlined="true" rounded="true">
                                <MudStack Spacing="2" Class="h-100">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                                        <MudText Typo="Typo.h6">Nhân vật tham chiếu</MudText>
                                    </MudStack>
                                    <MudCheckBox T="bool" Value="@_skipCharacter" ValueChanged="OnSkipCharacterChanged" Label="Không sử dụng nhân vật" />
                                    @if (_skipCharacter)
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true">Đã tắt nhân vật tham chiếu. Video sẽ được tạo không dùng nhân vật cố định.</MudAlert>
                                    }
                                    else
                                    {
                                        <MudRadioGroup T="string" @bind-Value="_characterMode">
                                            <MudRadio T="string" Value="@RVideoCharacterModes.Upload">Upload hình ảnh</MudRadio>
                                            <MudRadio T="string" Value="@RVideoCharacterModes.Library">Chọn từ Character Library</MudRadio>
                                        </MudRadioGroup>
                                        @if (_characterMode == RVideoCharacterModes.Upload)
                                        {
                                            <InputFile OnChange="UploadReferenceCharacterAsync" accept="image/png,image/jpeg,image/webp" />
                                            @if (_uploadedCharacter is not null)
                                            {
                                                <MudPaper Class="pa-3" Outlined="true" rounded="true">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                        <MudText>@_uploadedCharacter.FileName</MudText>
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="RemoveUploadedCharacterAsync" />
                                                    </MudStack>
                                                    <img src="@_uploadedCharacter.FileUrl" style="max-width:100%;max-height:160px;object-fit:contain" />
                                                </MudPaper>
                                            }
                                        }
                                        else
                                        {
                                            <MudSelect T="long?" Label="Chọn nhân vật" Value="@_selectedCharacterId" ValueChanged="OnCharacterChangedAsync" Variant="Variant.Outlined" Dense="true">
                                                @foreach (var character in _characters)
                                                {
                                                    <MudSelectItem T="long?" Value="@character.Id">@character.CharacterName</MudSelectItem>
                                                }
                                            </MudSelect>
                                            @if (ResolveCurrentCharacter() is { } previewCharacter)
                                            {
                                                <MudPaper Class="pa-3 selected-character-preview" Outlined="true" rounded="true">
                                                    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start">
                                                        <div class="character-thumb-wrap">
                                                            @if (!string.IsNullOrWhiteSpace(previewCharacter.MasterImageUrl))
                                                            {
                                                                <img src="@previewCharacter.MasterImageUrl" style="width:100%;height:100%;object-fit:cover;border-radius:10px;cursor:pointer" @onclick="@(() => OpenCharacterPreview(previewCharacter))" />
                                                            }
                                                        </div>
                                                        <MudText Typo="Typo.subtitle1">@previewCharacter.CharacterName</MudText>
                                                    </MudStack>
                                                </MudPaper>
                                            }
                                        }
                                    }
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="8">
                            <MudPaper Class="pa-4 h-100" Outlined="true" rounded="true">
                                <MudStack Spacing="2" Class="h-100">
                                    <MudText Typo="Typo.subtitle1">Dịch vụ đã chọn: @ResolveServiceLabel()</MudText>
                                    <MudTextField T="string" Label="Prompt JSON đã nạp" Value="@PromptFileSummary" ReadOnly="true" Variant="Variant.Outlined" Lines="2" />
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <InputFile OnChange="ImportPromptJsonAsync" accept=".json,application/json,text/json" />
                                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Code" OnClick="OpenRawPromptAsync" Disabled="@string.IsNullOrWhiteSpace(_prompt)">Xem JSON</MudButton>
                                    </MudStack>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CheckPromptAsync">Kiểm tra cấu trúc</MudButton>
                                    <MudSelect T="string" Label="Tỷ lệ video của project" Value="@_aspectRatio" ValueChanged="OnAspectRatioChangedAsync" Variant="Variant.Outlined" Dense="true" Required="true">
                                        <MudSelectItem T="string" Value="@string.Empty">Chọn tỷ lệ trước khi tạo scene</MudSelectItem>
                                        <MudSelectItem T="string" Value="@AspectRatioLandscape">16:9 — video ngang</MudSelectItem>
                                        <MudSelectItem T="string" Value="@AspectRatioPortrait">9:16 — video dọc</MudSelectItem>
                                    </MudSelect>
                                    <MudSelect T="string" Label="Độ phân giải video" Value="@_resolution" ValueChanged="OnResolutionChangedAsync" Variant="Variant.Outlined" Dense="true" Required="true">
                                        <MudSelectItem T="string" Value="@string.Empty">Chọn độ phân giải trước khi render video</MudSelectItem>
                                        @foreach (var resolution in SupportedVideoResolutions)
                                        {
                                            <MudSelectItem T="string" Value="@resolution">@resolution</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudAlert Severity="@PromptValidationSeverity" Dense="true">
                                        @PromptValidationMessage
                                    </MudAlert>
                                    @if (!string.IsNullOrWhiteSpace(_promptParseResult.ErrorMessage))
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true">@_promptParseResult.ErrorMessage</MudAlert>
                                    }
                                    @if (_promptParseResult.Model is not null)
                                    {
                                        <MudGrid>
                                            <MudItem xs="12" md="6"><MudText><b>Tiêu đề video:</b> @_promptParseResult.Summary.VideoTitle</MudText></MudItem>
                                            <MudItem xs="12" md="6"><MudText><b>Mục tiêu video:</b> @_promptParseResult.Summary.VideoObjective</MudText></MudItem>
                                            <MudItem xs="12" md="6"><MudText><b>Phong cách:</b> @_promptParseResult.Summary.Style</MudText></MudItem>
                                            <MudItem xs="12" md="6"><MudText><b>CTA:</b> @_promptParseResult.Summary.Cta</MudText></MudItem>
                                            <MudItem xs="12" md="6"><MudText><b>DeclaredDuration:</b> @_promptParseResult.Summary.DeclaredDurationSeconds</MudText></MudItem>
                                            <MudItem xs="12" md="6"><MudText><b>SceneCount:</b> @_promptParseResult.Summary.SceneCount</MudText></MudItem>
                                            <MudItem xs="12" md="6"><MudText><b>Tổng thời lượng scene:</b> @_promptParseResult.Summary.SceneDurationTotal giây</MudText></MudItem>
                                        <MudItem xs="12" md="6"><MudText><b>Dịch vụ:</b> @ResolveServiceLabel()</MudText></MudItem>
                                        <MudItem xs="12" md="6"><MudText><b>Tỷ lệ video:</b> @(ProjectAspectRatio)</MudText></MudItem>
                                            <MudItem xs="12" md="6"><MudText><b>Độ phân giải:</b> @(ProjectResolution)</MudText></MudItem>
                                        </MudGrid>
                                        @if (!string.IsNullOrWhiteSpace(_promptParseResult.Summary.SceneDurationValidationMessage))
                                        {
                                            <MudText Color="Color.Success">@_promptParseResult.Summary.SceneDurationValidationMessage</MudText>
                                        }
                                        @if (_promptParseResult.Summary.HasDurationMismatch)
                                        {
                                            <MudAlert Severity="Severity.Warning" Dense="true">@_promptParseResult.Summary.DurationMismatchMessage</MudAlert>
                                        }
                                    }
                                    @foreach (var warning in _promptParseResult.Warnings.Distinct())
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true">@warning</MudAlert>
                                    }
                                    <MudPaper Class="pa-3" Outlined="true" rounded="true">
                                        <MudText Typo="Typo.subtitle1">Giọng nói</MudText>
                                        <MudRadioGroup T="string" @bind-Value="_voiceMode">
                                            <MudRadio T="string" Value="@RVideoVoiceModes.None">Không sử dụng giọng</MudRadio>
                                            <MudRadio T="string" Value="@RVideoVoiceModes.Native">AI Native Voice + Lip-sync</MudRadio>
                                            <MudRadio T="string" Value="@RVideoVoiceModes.Library">Giọng đọc từ Voice Library</MudRadio>
                                        </MudRadioGroup>
                                        @if (_voiceMode == RVideoVoiceModes.Library)
                                        {
                                            <MudSelect T="string" Label="Voice" @bind-Value="_voiceCatalogCode" Dense="true" Variant="Variant.Outlined">
                                                @foreach (var voice in _voices)
                                                {
                                                    <MudSelectItem Value="@voice.Code">@voice.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                            @if (_voices.FirstOrDefault(x => x.Code == _voiceCatalogCode) is { PreviewFileUrl: not null } voicePreview)
                                            {
                                                <audio controls src="@voicePreview.PreviewFileUrl" style="width:100%"></audio>
                                            }
                                        }
                                    </MudPaper>
                                    <MudPaper Class="pa-3" Outlined="true" rounded="true">
                                        <MudText Typo="Typo.subtitle1">Nhạc nền</MudText>
                                        <MudRadioGroup T="string" Value="@_musicMode" ValueChanged="OnMusicModeChanged">
                                            <MudRadio T="string" Value="@RVideoMusicModes.None">Không dùng</MudRadio>
                                            <MudRadio T="string" Value="@RVideoMusicModes.Library">Chọn từ Music Library</MudRadio>
                                        </MudRadioGroup>
                                        @if (_musicMode == RVideoMusicModes.Library)
                                        {
                                            <MudSelect T="string" Label="Music" @bind-Value="_musicCatalogCode" Dense="true" Variant="Variant.Outlined">
                                                @foreach (var music in _music)
                                                {
                                                    <MudSelectItem Value="@music.Code">@music.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                            @if (_music.FirstOrDefault(x => x.Code == _musicCatalogCode) is { FileUrl: not null } musicPreview)
                                            {
                                                <audio controls src="@musicPreview.FileUrl" style="width:100%"></audio>
                                            }
                                        }
                                    </MudPaper>
                                    <MudExpansionPanels Elevation="0" Dense="true">
                                        <MudExpansionPanel Text="Cài đặt nâng cao">
                                            <MudGrid Class="pt-2">
                                                <MudItem xs="12" sm="4"><MudNumericField T="int" Label="Tổng số giây" @bind-Value="_totalSeconds" Min="1" Variant="Variant.Outlined" /></MudItem>
                                                <MudItem xs="12" sm="4"><MudNumericField T="int" Label="Giây mỗi scene" @bind-Value="_sceneSeconds" Min="1" Variant="Variant.Outlined" /></MudItem>
                                                <MudItem xs="12" sm="4"><MudNumericField T="decimal" Label="Tốc độ nói mặc định" @bind-Value="_defaultTtsRate" Min="0.1m" Max="4m" Step="0.05m" Variant="Variant.Outlined" /></MudItem>
                                                <MudItem xs="12" sm="6"><MudNumericField T="decimal" Label="Âm lượng nhạc" @bind-Value="_musicVolume" Min="0m" Max="1m" Step="0.05m" Variant="Variant.Outlined" /></MudItem>
                                                <MudItem xs="12" sm="6"><MudCheckBox @bind-Value="_thinkScenes" Label="Suy nghĩ kịch bản" /></MudItem>
                                            </MudGrid>
                                            <MudDivider Class="my-3" />
                                            <MudText Typo="Typo.subtitle2">Chế độ xử lý</MudText>
                                            <MudRadioGroup T="string" @bind-Value="_executionMode">
                                                <MudRadio T="string" Value="@RVideoExecutionModes.Manual" Color="Color.Warning">Duyệt từng bước</MudRadio>
                                                <MudRadio T="string" Value="@RVideoExecutionModes.Auto" Color="Color.Warning">Tự động thực hiện</MudRadio>
                                            </MudRadioGroup>
                                            @if (_executionMode == RVideoExecutionModes.Auto)
                                            {
                                                <MudAlert Severity="Severity.Info" Dense="true">Server sẽ tiếp tục ảnh → video → hoàn thiện mà không cần xác nhận giữa các giai đoạn.</MudAlert>
                                            }
                                            <MudDivider Class="my-3" />
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                                                <MudText Typo="Typo.subtitle2">Log kỹ thuật phân tách scene</MudText>
                                                <MudStack Row="true" Spacing="1">
                                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearDebugLogAsync" aria-label="Xóa log kỹ thuật" />
                                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ContentCopy" OnClick="CopyDebugLogAsync" aria-label="Sao chép log kỹ thuật" />
                                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Download" OnClick="DownloadDebugLogAsync" aria-label="Tải log kỹ thuật" />
                                                </MudStack>
                                            </MudStack>
                                            <div id="render-job-debug-log" style="max-height:260px;overflow:auto;display:flex;flex-direction:column-reverse;gap:8px;">
                                                @if (_debugEntries.Count == 0)
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Chưa có log.</MudText>
                                                }
                                                else
                                                {
                                                    @foreach (var entry in _debugEntries.OrderByDescending(x => x.StepNumber).ThenByDescending(x => x.Timestamp))
                                                    {
                                                        <MudPaper Class="pa-2" Outlined="true">
                                                            <MudText Typo="Typo.caption">@entry.Status · @entry.StepCode · @entry.Message</MudText>
                                                        </MudPaper>
                                                    }
                                                }
                                            </div>
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                    <MudStack Row="true" Spacing="2" Class="flex-wrap gap-2">
                                        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="CreateProjectAsync" Disabled="@(_busy || _projectId is null)">Tạo / phân tách scene</MudButton>
                                        <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="ReloadAsync" Disabled="@(_projectId is null || _busy)">Refresh</MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12">
                        </MudItem>
                    </MudGrid>
                </MudPaper>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Xem trước">
                <div class="scene-image-tab">
                    @if (_project is null)
                    {
                        <MudAlert Severity="Severity.Info">Hãy tạo project ở tab Thông tin trước.</MudAlert>
                    }
                    else
                    {
                        <div class="scene-image-toolbar" role="toolbar" aria-label="Thao tác Scene / Hình ảnh">
                            @if (_batchActive)
                            {
                                <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.HourglassBottom">Đang tạo ảnh</MudChip>
                            }
                            <MudTooltip Text="Tạo ảnh tĩnh cho các scene còn thiếu hoặc lỗi">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.AddPhotoAlternate" OnClick="RenderMissingSceneImagesAsync" Disabled="@_batchActive">Tạo ảnh còn thiếu</MudButton>
                            </MudTooltip>
                            <MudTooltip Text="Thêm scene thủ công">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddSceneAsync" Disabled="@_busy">Thêm scene</MudButton>
                            </MudTooltip>
                            <MudTooltip Text="Tạo video cho các scene đã có ảnh">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Movie" OnClick="EnqueueRenderAllScenesAsync" Disabled="@(!CanEnqueueSceneVideos())">Tạo video</MudButton>
                            </MudTooltip>
                            <MudTooltip Text="Tải lại scene">
                                <MudIconButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Icon="@Icons.Material.Filled.Refresh" OnClick="ReloadAsync" Disabled="@_busy" aria-label="Refresh scene" />
                            </MudTooltip>
                        </div>

                        <div class="scene-list-scroll" tabindex="0">
                        <MudStack Spacing="3">
                        @foreach (var scene in _project.Scenes.OrderBy(x => x.SceneIndex))
                        {
                            var draft = GetSceneDraft(scene);
                            var sceneState = ResolveSceneImageState(scene);
                            <MudPaper Class="scene-card scene-card-compact pa-3" Outlined="true">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="scene-card-header flex-wrap gap-1">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1" Class="scene-card-title">Scene @scene.SceneIndex.ToString("00") - @scene.Title</MudText>
                                            <MudText Typo="Typo.caption">@scene.DurationSeconds giây</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="scene-card-meta flex-wrap gap-1">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@ProjectAspectRatio</MudChip>
                                            @RenderSceneStatusBadge(scene, "image")
                                            <MudMenu Dense="true" Icon="@Icons.Material.Filled.MoreVert">
                                                <MudMenuItem Icon="@Icons.Material.Filled.Save" Disabled="@_busy" OnClick="@(async () => await SaveSceneAsync(scene))">Lưu scene</MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.AddPhotoAlternate" Disabled="@IsSceneRendering(scene)" OnClick="@(() => RerenderSceneImageAsync(scene))">@(string.IsNullOrWhiteSpace(ResolveDraftImageUrl(scene, draft)) ? "Tạo ảnh" : "Render lại ảnh")</MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => EditScenePromptsAsync(scene))">Chỉnh sửa prompt ảnh</MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.History" OnClick="@(() => ToggleImageHistoryAsync(scene))">Lịch sử ảnh</MudMenuItem>
                                                <MudDivider />
                                                <MudMenuItem Icon="@Icons.Material.Filled.KeyboardArrowUp" Disabled="@(_busy || scene.SceneIndex <= 1)" OnClick="@(() => MoveSceneUpAsync(scene))">Lên</MudMenuItem>
                                                <MudMenuItem Icon="@Icons.Material.Filled.KeyboardArrowDown" Disabled="@(_busy || _project is null || scene.SceneIndex >= _project.Scenes.Count)" OnClick="@(() => MoveSceneDownAsync(scene))">Xuống</MudMenuItem>
                                                <MudDivider />
                                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" Disabled="@_busy" OnClick="@(() => DeleteSceneAsync(scene))">Xóa</MudMenuItem>
                                            </MudMenu>
                                        </MudStack>
                                    </MudStack>

                                    <MudGrid Class="scene-surface-grid">
                                        <MudItem xs="12" md="6">
                                            <MudStack Spacing="1">
                                                <RenderMediaFrame IsVideo="false"
                                                                  MediaUrl="@ResolveDraftImageUrl(scene, draft)"
                                                                  ThumbnailUrl="@ResolveDraftImageUrl(scene, draft)"
                                                                  AspectRatio="@ProjectAspectRatio"
                                                                  State="@ResolveImageMediaState(sceneState)"
                                                                  EmptyText="Chưa render ảnh"
                                                                  FailedText="Lỗi render ảnh"
                                                                  RetryDisabled="@_sceneRerendering.Contains(scene.Id)"
                                                                  OnRetry="@(() => RerenderSceneImageAsync(scene))"
                                                                  OnClick="@(() => OpenScenePreview(scene))" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@ProjectAspectRatio · @ProjectResolution</MudText>
                                                <div class="scene-media-actions">
                                                <MudStack Row="true" Spacing="1" Class="flex-wrap gap-1">
                                                    <MudTooltip Text="Xem prompt ảnh"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Image" OnClick="@(() => OpenScenePrompt(scene, ScenePromptKind.Image))" aria-label="Xem prompt ảnh" /></MudTooltip>
                                                    <MudTooltip Text="Xem prompt video"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Movie" OnClick="@(() => OpenScenePrompt(scene, ScenePromptKind.Motion))" aria-label="Xem prompt video" /></MudTooltip>
                                                    <MudTooltip Text="Xem lời thoại"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.RecordVoiceOver" OnClick="@(() => OpenScenePrompt(scene, ScenePromptKind.Voice))" aria-label="Xem lời thoại" /></MudTooltip>
                                                    <MudTooltip Text="Lịch sử ảnh"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.History" OnClick="@(() => ToggleImageHistoryAsync(scene))" aria-label="Lịch sử ảnh" /></MudTooltip>
                                                    <MudTooltip Text="Hướng dẫn giọng đọc"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Audiotrack" OnClick="@(() => OpenSceneVoiceInstruction(scene))" aria-label="Xem hướng dẫn giọng đọc" /></MudTooltip>
                                                </MudStack>
                                                </div>
                                            </MudStack>
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudStack Spacing="1">
                                                <RenderMediaFrame IsVideo="true"
                                                                  MediaUrl="@ResolveDraftVideoUrl(scene, draft)"
                                                                  ThumbnailUrl="@ResolveDraftImageUrl(scene, draft)"
                                                                  AspectRatio="@ProjectAspectRatio"
                                                                  State="@ResolveVideoMediaState(scene)"
