    private static bool ReadAutoFinish(string? prompt)
    {
        if (!TryExtractJsonRange(prompt ?? string.Empty, out var start, out var end))
        {
            return false;
        }

        try
        {
            var obj = JsonNode.Parse((prompt ?? string.Empty)[start..(end + 1)]) as JsonObject;
            return obj?["auto_finish"]?.GetValue<bool>() == true;
        }
        catch (Exception)
        {
            return false;
        }
    }

    private static bool TryExtractJsonRange(string input, out int start, out int end)
    {
        start = input.IndexOf('{');
        end = input.LastIndexOf('}');
        return start >= 0 && end > start;
    }

    private async Task ReloadJobsAsync()
    {
        if (_projectId is null) return;
        var logCode = BuildLogCode();
        if (string.IsNullOrWhiteSpace(logCode)) return;

        try
        {
            _jobs = (await RenderJobs.ListByLogCodeAsync(logCode)).ToList();
            // Recover batch-active state after a refresh/navigation: the server job keeps running even
            // if this circuit was recreated, so re-derive the shimmer state from the live job list.
            _batchActive = _jobs.Any(j =>
                string.Equals(j.JobType, TodoX.Web.Services.Render.SceneImageBatchRenderHandler.JobTypeName, StringComparison.OrdinalIgnoreCase)
                && j.Status is RenderJobStatuses.Queued or RenderJobStatuses.Preparing or RenderJobStatuses.Rendering or RenderJobStatuses.PostProcessing);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "VIDEO_RENDER_LOAD_JOBS_FAILED logCode={LogCode}", logCode);
            await AddDebugAsync("jobs_failed", "Tải job thất bại", "FAILED", ex.Message, ex.ToString());
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task StartPolling()
    {
        if (_projectId is null)
        {
            StopPolling();
            return;
        }
        _pollCts?.Cancel();
        _pollCts = new CancellationTokenSource();
        _pollTimer?.Dispose();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(VideoOptions.CurrentValue.PollIntervalSeconds));
        _ = PollLoopAsync(_pollCts.Token);
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;
        _pollTimer?.Dispose();
        _pollTimer = null;
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        if (_projectId is null) return;
        while (!ct.IsCancellationRequested && _pollTimer is not null)
        {
            try
            {
                if (!await _pollTimer.WaitForNextTickAsync(ct)) break;
                if (_project is null) continue;

                // Keep polling while a configured image-provider batch is active, scenes are actively rendering/retrying,
                // scenes are still pending an image, or the video pipeline is mid-flight. Stop once everything
                // has settled to avoid churn.
                var hasPendingSceneImages = HasPendingSceneImages();
                var scenesPending = _batchActive || HasActiveSceneRenders();
                var videoActive = _project.Status is VideoProjectStatuses.Rendering or VideoProjectStatuses.Merging
                                  || _project.Scenes.Any(IsVideoSceneActive);
                if (scenesPending || videoActive)
                {
                    await InvokeAsync(ReloadAsync);
                    // Batch is done when no scene is still waiting for its first image.
                    if (_batchActive && !hasPendingSceneImages)
                    {
                        _batchActive = false;
                    }
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    await ContinueAutoFinishAsync();
                }
            }
            catch (OperationCanceledException) when (ct.IsCancellationRequested)
            {
                break;
            }
        }
    }

    private async Task ContinueAutoFinishAsync()
    {
        // Pipeline transitions are server-driven by RVideoLifecycleWorker. This method remains as
        // a no-op compatibility hook for the existing UI polling loop.
        await Task.CompletedTask;
    }

    private async Task<bool> SaveSceneAsync(VideoProjectSceneDto scene)
    {
        if (_projectId is null || AuthState.CurrentUser is null) return false;
        var draft = GetSceneDraft(scene);
        var metadata = BuildMetadata(draft);
        if (!ScenePromptMetadata.IsUsableImagePrompt(metadata.EffectiveImagePrompt))
        {
            Snackbar.Add("SCENE_IMAGE_SOURCE_UNRESOLVED: prompt ảnh là placeholder và không có fallback dùng được.", Severity.Error);
            return false;
        }
        scene.ImagePrompt = metadata.ImagePrompt;
        scene.VideoPrompt = metadata.MotionPrompt;
        scene.ScenePrompt = metadata.Serialize();

        await VideoRepo.SaveSceneDraftAsync(new VideoProjectSaveSceneDraftRequest
        {
            SceneId = scene.Id,
            Status = scene.Status,
            Title = scene.Title,
            SceneIndex = scene.SceneIndex,
            ScenePrompt = scene.ScenePrompt,
            ImagePrompt = scene.ImagePrompt,
            VideoPrompt = scene.VideoPrompt,
            ImageUrl = ResolveDraftImageUrl(scene, draft),
            ImagePath = ResolveDraftImagePath(scene, draft),
            VideoUrl = ResolveDraftVideoUrl(scene, draft),
            VideoPath = ResolveDraftVideoPath(scene, draft),
            ErrorMessage = scene.ErrorMessage,
            SelectedImageVersionId = draft.SelectedImageVersionId,
            SelectedVideoVersionId = draft.SelectedVideoVersionId,
            AspectRatio = draft.AspectRatio
        }, AuthState.CurrentUser.UserId);

        draft.IsDirty = false;
        Snackbar.Add("Đã lưu scene.", Severity.Success);
        await LogProjectEvent("SCENE_SAVED", "info", $"Đã lưu scene {scene.SceneIndex}.", new { scene.Id, scene.SceneIndex, scene.Status, draft.SelectedImageVersionId, draft.SelectedVideoVersionId, AspectRatio = draft.AspectRatio });
        await ReloadAsync();
        await ProjectSaved.InvokeAsync();
        return true;
    }

    private async Task EditScenePromptsAsync(VideoProjectSceneDto scene)
    {
        var parameters = new DialogParameters
        {
            [nameof(Components.Dialogs.ScenePromptEditorDialog.Metadata)] = ScenePromptMetadata.FromScene(scene),
            [nameof(Components.Dialogs.ScenePromptEditorDialog.IsRendering)] = IsSceneRendering(scene) || RenderSceneImageUiState.IsActive(ResolveSceneImageState(scene))
        };
        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Medium };
        var dialog = await DialogService.ShowAsync<Components.Dialogs.ScenePromptEditorDialog>($"Chỉnh prompt scene {scene.SceneIndex}", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not ScenePromptMetadata metadata)
        {
            return;
        }

        var draft = GetSceneDraft(scene);
        draft.Purpose = metadata.ScenePurpose;
        draft.ImagePrompt = metadata.ImagePrompt;
        draft.MotionPrompt = metadata.MotionPrompt;
        draft.Voice = metadata.Voice;
        draft.VoiceInstruction = metadata.VoiceInstruction;
        draft.TtsRate = metadata.TtsRate;
        draft.IsDirty = true;
        await SaveSceneAsync(scene);
    }

    private static void NormalizeScenePrompts(VideoProjectSceneDto scene)
    {
        var metadata = ScenePromptMetadata.FromScene(scene);
        scene.ImagePrompt = metadata.ImagePrompt;
        scene.VideoPrompt = metadata.MotionPrompt;
        scene.ScenePrompt = metadata.Serialize();
    }

    private async Task SaveJobAsync()
    {
        if (AuthState.CurrentUser is null) return;
        if (!EnsureAspectRatioSelected())
        {
            return;
        }

        _busy = true;
        try
        {
            if (_project is null && _jobId is null)
            {
                if (ServiceId is not Guid serviceId || string.IsNullOrWhiteSpace(ServiceCode))
                {
                    throw new InvalidOperationException("Thiếu thông tin dịch vụ RVIDEO.");
                }

                if (!_promptParseResult.IsJsonValid)
                {
                    _promptParseResult = PromptParser.Parse(_prompt);
                }
                _prompt = PersistPromptVideoSettings(_prompt, _aspectRatio, _resolution, _autoFinish);
                var created = await RVideoJobs.CreateDraftAsync(new RVideoJobCreateRequest
                {
                    ServiceId = serviceId,
                    ServiceCode = ServiceCode,
                    Title = _promptParseResult.Model.VideoTitle ?? "RVIDEO",
                    Prompt = _prompt,
                    AspectRatio = _aspectRatio,
                    Resolution = _resolution,
                    TotalSeconds = _totalSeconds,
                    SceneSeconds = Math.Max(1, _sceneSeconds),
                    ThinkScenes = _thinkScenes,
                    Settings = BuildRVideoSettingsRequest()
                }, AuthState.CurrentUser, VideoOptions.CurrentValue.StorageRoot, VideoOptions.CurrentValue.PublicBase, DateTime.UtcNow.ToString("yyyyMMdd-HHmmss"));
                _jobId = created.JobId;
                _projectId = created.ProjectId;
                Snackbar.Add("Đã lưu RVIDEO job.", Severity.Success);
                Navigation.NavigateTo(created.Route, replace: true);
                return;
            }
            if (_project is null) return;

            foreach (var scene in _project.Scenes)
            {
                NormalizeScenePrompts(scene);
            }

            _prompt = PersistPromptVideoSettings(_prompt, _aspectRatio, _resolution);
            var snapshot = BuildJobSnapshot();
            await VideoRepo.UpdateProjectDraftAsync(_project.Id, new VideoProjectUpdateRequest
            {
                Title = _project.Title,
                OriginalPrompt = _prompt,
                CharacterId = _selectedCharacter?.Id ?? _selectedCharacterId,
                TotalSeconds = _totalSeconds,
                SceneSeconds = Math.Max(1, _sceneSeconds),
                ThinkScenes = _thinkScenes,
                Scenes = _project.Scenes.OrderBy(x => x.SceneIndex).ToList()
            }, AuthState.CurrentUser);
            var settingsRequest = BuildRVideoSettingsRequest();
            await RVideoSettings.SaveAsync(_project.Id, settingsRequest);
            if (_jobId is Guid jobId)
            {
                await RVideoJobs.UpdateAsync(jobId, new RVideoJobUpdateRequest
                {
                    Title = _project.Title,
                    Prompt = _prompt,
                    AspectRatio = _aspectRatio,
                    Resolution = _resolution,
                    TotalSeconds = _totalSeconds,
                    SceneSeconds = Math.Max(1, _sceneSeconds),
                    ThinkScenes = _thinkScenes,
                    Settings = settingsRequest
                }, AuthState.CurrentUser);
            }
            await LogProjectEvent("JOB_SAVED", "info", "Lưu video project render-job.", snapshot);
            Snackbar.Add("Đã lưu job.", Severity.Success);
            await ReloadAsync();
            await ProjectSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "VIDEO_RENDER_SAVE_JOB_FAILED projectId={ProjectId}", _project.Id);
            Snackbar.Add(ex.Message, Severity.Error);
            await AddDebugAsync("job_save_failed", "Lưu job thất bại", "FAILED", ex.Message, ex.ToString());
        }
        finally
        {
            _busy = false;
        }
    }

    private RVideoJobSettingsRequest BuildRVideoSettingsRequest()
        => new()
        {
            ExecutionMode = _executionMode,
            SkipCharacter = _skipCharacter,
            CharacterMode = _skipCharacter ? RVideoCharacterModes.None : _characterMode,
            SelectedCharacterId = _skipCharacter ? null : _selectedCharacterId,
            CharacterSnapshot = _skipCharacter
                ? null
                : _characterMode == RVideoCharacterModes.Upload
                    ? _uploadedCharacter
                    : _selectedCharacter is null ? null : new
                    {
                        source = "LIBRARY",
                        id = _selectedCharacter.Id,
                        name = _selectedCharacter.CharacterName,
                        masterImageUrl = _selectedCharacter.MasterImageUrl,
                        storageKey = _selectedCharacter.MasterImageObjectKey
                    },
            VoiceMode = _voiceMode,
            VoiceCatalogCode = _voiceMode == RVideoVoiceModes.Library ? _voiceCatalogCode : null,
            VoiceSnapshot = _voiceMode == RVideoVoiceModes.Library
                ? _voices.FirstOrDefault(x => string.Equals(x.Code, _voiceCatalogCode, StringComparison.OrdinalIgnoreCase))
                : null,
            DefaultTtsRate = _defaultTtsRate,
            MusicCatalogCode = _musicMode == RVideoMusicModes.Library ? _musicCatalogCode : null,
            MusicSnapshot = _musicMode == RVideoMusicModes.Library
                ? _music.FirstOrDefault(x => string.Equals(x.Code, _musicCatalogCode, StringComparison.OrdinalIgnoreCase))
                : null,
            MusicVolume = _musicVolume
        };

    private async Task LoadRVideoSettingsAsync(long projectId)
    {
        try
        {
            var settings = await RVideoSettings.GetAsync(projectId);
            _executionMode = RVideoRules.NormalizeExecutionMode(settings?.ExecutionMode);
            _skipCharacter = settings?.SkipCharacter ?? true;
            _characterMode = _skipCharacter ? RVideoCharacterModes.None : RVideoRules.NormalizeCharacterMode(settings?.CharacterMode);
            _selectedCharacterId = _skipCharacter ? null : settings?.SelectedCharacterId;
            _uploadedCharacter = null;
            if (!string.IsNullOrWhiteSpace(settings?.CharacterSnapshotJson) && _characterMode == RVideoCharacterModes.Upload)
            {
                _uploadedCharacter = JsonSerializer.Deserialize<UploadedCharacterSnapshot>(settings.CharacterSnapshotJson, RVideoJsonOptions);
            }
            _voiceMode = RVideoRules.NormalizeVoiceMode(settings?.VoiceMode);
            _voiceCatalogCode = _voiceMode == RVideoVoiceModes.Library ? settings?.VoiceCatalogCode : null;
            _defaultTtsRate = settings?.DefaultTtsRate > 0 ? settings.DefaultTtsRate : 1.0m;
            _musicCatalogCode = settings?.MusicCatalogCode;
            _musicMode = string.IsNullOrWhiteSpace(_musicCatalogCode) ? RVideoMusicModes.None : RVideoMusicModes.Library;
            _musicVolume = settings?.MusicVolume is >= 0 and <= 1 ? settings.MusicVolume : 0.8m;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "RVVIDEO_SETTINGS_LOAD_FAILED projectId={ProjectId}", projectId);
            _executionMode = RVideoExecutionModes.Manual;
        }
    }

    private object BuildJobSnapshot()
    {
        var scenes = _project?.Scenes
            .OrderBy(x => x.SceneIndex)
            .Select(scene => new
            {
                scene.Id,
                scene.SceneIndex,
                scene.Title,
                scene.DurationSeconds,
                scene.ScenePrompt,
                scene.ImagePrompt,
                scene.VideoPrompt,
                Voice = ExtractValue(scene.ScenePrompt, "voice"),
                VoiceInstruction = ExtractValue(scene.ScenePrompt, "voice_instruction"),
                scene.StaticImageUrl,
                scene.StaticImagePath,
                scene.SceneVideoUrl,
                scene.SceneVideoPath,
                scene.Status,
                scene.ErrorMessage,
                scene.UpdatedAt
            })
            .ToList();

        return new
        {
            ProjectId = _project!.Id,
            _project.Title,
            _project.OriginalPrompt,
            AspectRatio = _aspectRatio,
            Resolution = _resolution,
            _project.CharacterId,
            CharacterName = _selectedCharacter?.CharacterName ?? ResolveCurrentCharacter()?.CharacterName,
            CharacterPrompt = _selectedCharacter?.NormalizedPrompt ?? ResolveCurrentCharacter()?.NormalizedPrompt,
            _project.TotalSeconds,
            _project.SceneSeconds,
            _project.ThinkScenes,
            _project.Status,
            _project.UpdatedAt,
            _project.StorageRoot,
            _project.PublicBase,
            _project.JobFolder,
            Scenes = scenes
        };
    }

    // ------------------------------------------------------------------
    // Bulk scene image render — configured image provider router, background job.
    // ------------------------------------------------------------------
    private async Task EnqueueBulkSceneImageRenderAsync(bool onlyMissingOrFailed)
    {
        if (_project is null || AuthState.CurrentUser is null) return;
        var reference = await PersistAndResolveRVideoImageReferenceAsync();
        var input = TodoX.Web.Services.Render.RVideoSceneImageReferenceSelection.BuildBatchInput(reference);
        input.CapabilityCode = TodoX.Web.Services.Render.SceneImageRenderContext.RVideoCapabilityCode;
        input.ProjectId = _project.Id;
        input.AspectRatio = _aspectRatio;
        input.UserId = AuthState.CurrentUser.UserId;
        input.CustomerId = AuthState.CurrentUser.CustomerId;
        input.TrustedPayerContext = TodoX.Web.Services.AiProviders.AiBillingPayerResolver.CreateTrustedBackgroundContext(AuthState.CurrentUser);
        input.OnlyMissingOrFailed = onlyMissingOrFailed;

        var (job, alreadyActive) = await RenderJobs.EnqueueForProjectIfNoneActiveAsync(new RenderJobCreateModel
        {
            JobType = TodoX.Web.Services.Render.SceneImageBatchRenderHandler.JobTypeName,
            UserId = AuthState.CurrentUser.UserId,
            CustomerId = AuthState.CurrentUser.CustomerId,
            Input = input,
            Prompt = new { projectId = _project.Id },
            LogCode = BuildLogCode(),
            ProviderCode = TodoX.Web.Services.Render.SceneImageBatchRenderHandler.RoutingProviderCode,
            ModelCode = TodoX.Web.Services.Render.SceneImageBatchRenderHandler.RoutingModelCode,
            MaxAttempts = 1,
            PointCostEstimate = 0,
            PointStatus = RenderPointStatuses.NotRequired
        }, _project.Id);

        if (alreadyActive)
        {
            Logger.LogInformation("VIDEO_RENDER_SCENE_IMAGE_BATCH_ALREADY_ACTIVE projectId={ProjectId} jobId={JobId}", _project.Id, job.Id);
            Snackbar.Add("Project này đang có batch tạo ảnh tĩnh.", Severity.Info);
            await StartPolling();
            return;
        }

        Logger.LogInformation("VIDEO_RENDER_SCENE_IMAGE_BATCH_ENQUEUED projectId={ProjectId} jobId={JobId} onlyMissing={OnlyMissing} characterId={CharacterId}",
            _project.Id, job.Id, onlyMissingOrFailed, input.CharacterId);
        await LogProjectEvent("SCENE_IMAGE_BATCH_ENQUEUED", "info", "Đã enqueue batch render ảnh tĩnh qua AI provider đã cấu hình.",
            new { job.Id, onlyMissingOrFailed, input.CharacterId });
        await StartPolling();
    }

    private async Task RenderMissingSceneImagesAsync()
    {
        if (_project is null || AuthState.CurrentUser is null) return;
        if (!EnsureAspectRatioSelected())
        {
            return;
        }

        _batchActive = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await EnqueueBulkSceneImageRenderAsync(onlyMissingOrFailed: true);
            Snackbar.Add("Đã enqueue render ảnh cho các scene còn thiếu/lỗi.", Severity.Info);
        }
        catch (Exception ex)
        {
            _batchActive = false;
            Logger.LogError(ex, "VIDEO_RENDER_SCENE_IMAGE_BATCH_ENQUEUE_FAILED projectId={ProjectId}", _project.Id);
            Snackbar.Add(ex.Message, Severity.Error);
            await InvokeAsync(StateHasChanged);
        }
    }

    // ------------------------------------------------------------------
    // Per-scene re-render - persisted scene image work item.
    // ------------------------------------------------------------------
    private async Task RerenderSceneImageAsync(VideoProjectSceneDto scene)
    {
        if (_project is null || AuthState.CurrentUser is null) return;
        if (!EnsureAspectRatioSelected())
        {
            return;
        }
        var draft = GetSceneDraft(scene);
        if (string.IsNullOrWhiteSpace(draft.ImagePrompt))
        {
            Snackbar.Add("Cần nhập prompt ảnh trước khi render.", Severity.Warning);
            return;
        }
        if (!_sceneRerendering.Add(scene.Id)) return; // already running for this scene

        _sceneRerenderErrors.Remove(scene.Id);
        if (draft.IsDirty)
        {
            if (!await SaveSceneAsync(scene))
            {
                _sceneRerendering.Remove(scene.Id);
                return;
            }
            if (_project is null)
            {
                _sceneRerendering.Remove(scene.Id);
                return;
            }
            scene = _project.Scenes.FirstOrDefault(x => x.Id == scene.Id) ?? scene;
            draft = GetSceneDraft(scene);
        }

        if (await SceneVersions.HasActiveImageVersionAsync(scene.Id))
        {
            Snackbar.Add($"Scene {scene.SceneIndex} đang có phiên bản ảnh được xử lý.", Severity.Info);
            _sceneRerendering.Remove(scene.Id);
            return;
        }

        await InvokeAsync(StateHasChanged);

        try
        {
            var reference = await PersistAndResolveRVideoImageReferenceAsync();
            var model = TodoX.Web.Services.Render.RVideoImageModelPolicy.GetInitial();
            var promptScene = new VideoProjectSceneDto
            {
                Id = scene.Id,
                ProjectId = scene.ProjectId,
                SceneIndex = scene.SceneIndex,
                Title = scene.Title,
                DurationSeconds = scene.DurationSeconds,
                ScenePrompt = BuildMetadata(draft).Serialize(),
                ImagePrompt = draft.ImagePrompt,
                VideoPrompt = draft.MotionPrompt
            };
            var prompt = TodoX.Web.Services.Render.SceneImagePromptBuilder.Build(promptScene, reference.CharacterPrompt);
            var referenceMediaId = await SceneImages.ResolveCharacterReferenceMediaIdAsync(
                _project.Id, reference.Url, reference.ObjectKey,
                AuthState.CurrentUser.UserId, AuthState.CurrentUser.CustomerId,
                requireReference: reference.ReferenceRequested);
            if (reference.ReferenceRequested && referenceMediaId is null)
            {
                throw new InvalidOperationException("RVIDEO_REFERENCE_IMAGE_UNAVAILABLE");
            }

            var logicalRequestId = TodoX.Web.Services.Render.SceneImageRenderService.BuildLogicalRequestId(
                "render_job_scene_image_rerender", scene.Id, null);
            var operationId = Guid.NewGuid();
            var version = await SceneVersions.CreateQueuedImageVersionAsync(new TodoX.Web.Services.VideoRender.SceneImageVersionCreateRequest(
                _project.Id, scene.Id, AuthState.CurrentUser.UserId, AuthState.CurrentUser.CustomerId,
                operationId, logicalRequestId, draft.ImagePrompt, prompt, draft.MotionPrompt, null,
                new { scene.Id, scene.ProjectId, scene.SceneIndex, scene.Title, scene.DurationSeconds,
                    scene.ScenePrompt, imagePrompt = draft.ImagePrompt, videoPrompt = draft.MotionPrompt },
                new { characterId = reference.CharacterId, referenceMediaId, referenceUrl = reference.Url,
                    referenceObjectKey = reference.ObjectKey, referenceSource = reference.Source,
                    characterPrompt = reference.CharacterPrompt },
                new { capability = TodoX.Web.Services.Render.SceneImageRenderContext.RVideoCapabilityCode,
                    aspectRatio = TodoX.Web.Services.Render.SceneImageRenderService.NormalizeAspectRatio(_aspectRatio),
                    outputFormat = "png", source = "scene_image_user_rerender", model = model.Model,
                    model.Mode, model.Resolution, modelAttemptIndex = model.AttemptIndex }));

            await VideoRepo.UpdateSceneAsync(scene.Id, VideoSceneStatuses.Draft, errorMessage: null,
                title: scene.Title, scenePrompt: scene.ScenePrompt, imagePrompt: scene.ImagePrompt,
                videoPrompt: scene.VideoPrompt);

            var job = await RenderJobs.EnqueueAsync(new RenderJobCreateModel
            {
                JobType = TodoX.Web.Services.Render.SceneImageRenderWorkItemHandler.JobTypeName,
                UserId = AuthState.CurrentUser.UserId,
                CustomerId = AuthState.CurrentUser.CustomerId,
                Input = new TodoX.Web.Services.Render.SceneImageRenderWorkItemInput
                {
                    ParentJobId = operationId,
                    ImageVersionId = version.Id,
                    ProjectId = _project.Id,
                    SceneId = scene.Id,
                    SceneIndex = scene.SceneIndex,
                    UserId = AuthState.CurrentUser.UserId,
                    CustomerId = AuthState.CurrentUser.CustomerId,
                    CreatedBy = AuthState.CurrentUser.Email ?? AuthState.CurrentUser.UserId.ToString(),
                    TrustedPayerContext = TodoX.Web.Services.AiProviders.AiBillingPayerResolver.CreateTrustedBackgroundContext(AuthState.CurrentUser),
                    Prompt = version.CompiledImagePromptSnapshot ?? prompt,
                    AspectRatio = TodoX.Web.Services.Render.SceneImageRenderService.NormalizeAspectRatio(_aspectRatio),
                    CharacterId = reference.CharacterId,
                    ReferenceMediaId = referenceMediaId,
                    ReferenceObjectKey = reference.ObjectKey,
                    ReferenceUrl = reference.Url,
                    CapabilityCode = TodoX.Web.Services.Render.SceneImageRenderContext.RVideoCapabilityCode,
                    LogicalRequestId = logicalRequestId,
                    RequestedModel = model.Model,
                    ModelAttemptIndex = model.AttemptIndex
                },
                Prompt = new { projectId = _project.Id, sceneId = scene.Id, imageVersionId = version.Id },
                References = Array.Empty<object>(),
                LogCode = BuildLogCode(),
                ProviderCode = TodoX.Web.Services.Render.SceneImageBatchRenderHandler.RoutingProviderCode,
                ModelCode = TodoX.Web.Services.Render.SceneImageBatchRenderHandler.RoutingModelCode,
                MaxAttempts = 100,
                PointCostEstimate = 0,
                PointStatus = RenderPointStatuses.NotRequired
            });

            _sceneEventState[scene.Id] = RenderSceneImageVisualState.Queued;
            await LogProjectEvent("SCENE_IMAGE_RERENDER_ENQUEUED", "info", $"Đã enqueue render lại ảnh scene {scene.SceneIndex}.",
                new { job.Id, projectId = _project.Id, sceneId = scene.Id, sceneIndex = scene.SceneIndex,
                    imageVersionId = version.Id, characterId = reference.CharacterId, referenceSource = reference.Source,
                    model = model.Model,
                    modelAttemptIndex = model.AttemptIndex });
            Snackbar.Add($"Đã enqueue render lại ảnh scene {scene.SceneIndex}.", Severity.Success);
            await StartPolling();
        }
        catch (Exception ex)
        {
            _sceneRerenderErrors[scene.Id] = ex.Message;
            Logger.LogError(ex, "VIDEO_RENDER_SCENE_RERENDER_FAILED projectId={ProjectId} sceneId={SceneId}", _project.Id, scene.Id);
            await LogProjectEvent("SCENE_IMAGE_RERENDER_ENQUEUE_FAILED", "error", $"Enqueue render lại ảnh scene {scene.SceneIndex} lỗi.",
                new { projectId = _project.Id, sceneId = scene.Id, sceneIndex = scene.SceneIndex, error = ex.Message });
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _sceneRerendering.Remove(scene.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<TodoX.Web.Services.Render.RVideoSceneImageReferenceSelection>
        PersistAndResolveRVideoImageReferenceAsync()
    {
        if (_project is null)
        {
            throw new InvalidOperationException("RVVIDEO_PROJECT_NOT_FOUND");
        }

        var persistedSettings = await RVideoSettings.GetAsync(_project.Id)
            ?? throw new InvalidOperationException("RVVIDEO_SETTINGS_NOT_FOUND");
        var request = BuildRVideoSettingsRequest();
        TodoX.Web.Models.RVideoRules.PreserveValidUploadedCharacterSnapshot(request, persistedSettings);
        await RVideoSettings.SaveAsync(_project.Id, request);
        var settings = await RVideoSettings.GetAsync(_project.Id)
            ?? throw new InvalidOperationException("RVVIDEO_SETTINGS_NOT_FOUND");
        return TodoX.Web.Services.Render.RVideoSceneImageReferenceSelection.Resolve(settings);
    }


