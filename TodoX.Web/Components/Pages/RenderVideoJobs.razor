    private string PromptValidationMessage
        => !_promptParseResult.IsJsonValid
            ? (_promptParseResult.ErrorMessage ?? "Chưa có JSON để kiểm tra.")
            : !_promptParseResult.IsTodoXPrompt
                ? "JSON hợp lệ nhưng chưa nhận diện schema TodoX."
                : !_promptParseResult.IsTodoXSchemaValid
                    ? "JSON hợp lệ. Schema TodoX chưa đầy đủ; các cảnh báo bên dưới cần được kiểm tra."
                    : $"JSON hợp lệ. TodoX schema hợp lệ. Có {_promptParseResult.Summary.SceneCount} scene, tổng thời lượng {_promptParseResult.Summary.SceneDurationTotal} giây.";

    private async Task ImportPromptJsonAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(8 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
            _prompt = await reader.ReadToEndAsync();
            _promptParseResult = PromptParser.Parse(_prompt);
            ApplyVideoSettingsFromPrompt();
            Snackbar.Add(
                _promptParseResult.IsJsonValid
                    ? $"Đã nạp JSON {file.Name}."
                    : "File đã nạp nhưng JSON syntax không hợp lệ.",
                _promptParseResult.IsJsonValid ? Severity.Success : Severity.Warning);
        }
        catch (DecoderFallbackException)
        {
            _prompt = string.Empty;
            _promptParseResult = new TodoXVideoPromptParseResult
            {
                ErrorMessage = "File không phải UTF-8 hợp lệ hoặc không đọc được BOM UTF-8."
            };
            Snackbar.Add(_promptParseResult.ErrorMessage, Severity.Warning);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "RVIDEO_PROMPT_JSON_IMPORT_FAILED fileName={FileName}", file.Name);
            _promptParseResult = new TodoXVideoPromptParseResult
            {
                ErrorMessage = $"Không thể đọc file JSON: {ex.Message}"
            };
            Snackbar.Add(_promptParseResult.ErrorMessage, Severity.Warning);
        }

        await InvokeAsync(StateHasChanged);
    }

