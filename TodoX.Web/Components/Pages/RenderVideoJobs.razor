    private SceneEditorState GetSceneDraft(VideoProjectSceneDto scene)
    {
        if (_sceneDrafts.TryGetValue(scene.Id, out var draft))
        {
            return draft;
        }

        draft = CreateSceneDraft(scene);
        _sceneDrafts[scene.Id] = draft;
        return draft;
    }

    private SceneEditorState CreateSceneDraft(VideoProjectSceneDto scene)
    {
        var metadata = ScenePromptMetadata.FromScene(scene);
        var state = new SceneEditorState
        {
            SceneId = scene.Id,
            Purpose = metadata.ScenePurpose,
            ImagePrompt = metadata.ImagePrompt,
            MotionPrompt = metadata.MotionPrompt,
            Voice = metadata.Voice,
            VoiceInstruction = metadata.VoiceInstruction,
            TtsRate = metadata.TtsRate,
            RawSceneJson = metadata.RawSceneJson,
            EffectiveImagePrompt = metadata.EffectiveImagePrompt,
            AspectRatio = HasProjectAspectRatio ? _aspectRatio : AspectRatioPortrait
        };
        return WithExtra(state, metadata.Extra);
    }

    private static SceneEditorState WithExtra(SceneEditorState state, IReadOnlyDictionary<string, string> extra)
    {
        foreach (var item in extra)
        {
            state.Extra[item.Key] = item.Value;
        }

        return state;
    }

    private static ScenePromptMetadata BuildMetadata(SceneEditorState draft)
    {
        var parsed = ScenePromptMetadata.Parse(draft.RawSceneJson);
        var imagePrompt = TrimOrNull(draft.ImagePrompt) ?? parsed.ImagePrompt;
        var effectiveImagePrompt = ScenePromptMetadata.NormalizeEditedEffectiveImagePrompt(
            imagePrompt,
            parsed.ImagePrompt,
            TrimOrNull(draft.EffectiveImagePrompt) ?? parsed.EffectiveImagePrompt);
        var metadata = new ScenePromptMetadata
        {
            ScenePurpose = TrimOrNull(draft.Purpose) ?? parsed.ScenePurpose,
            ImagePrompt = imagePrompt,
            EffectiveImagePrompt = effectiveImagePrompt,
            MotionPrompt = TrimOrNull(draft.MotionPrompt) ?? parsed.MotionPrompt,
            Voice = TrimOrNull(draft.Voice) ?? parsed.Voice,
            VoiceInstruction = TrimOrNull(draft.VoiceInstruction) ?? parsed.VoiceInstruction,
            TtsRate = draft.TtsRate ?? parsed.TtsRate,
            RawSceneJson = draft.RawSceneJson ?? parsed.RawSceneJson
        };
        foreach (var item in parsed.Extra)
        {
            metadata.Extra[item.Key] = item.Value;
        }
        foreach (var item in draft.Extra)
        {
            metadata.Extra[item.Key] = item.Value;
        }

        return metadata;
    }

    private void ReconcileSceneDrafts()
    {
        if (_project is null) return;
        var sceneIds = _project.Scenes.Select(x => x.Id).ToHashSet();
        foreach (var staleId in _sceneDrafts.Keys.Where(id => !sceneIds.Contains(id)).ToList())
        {
            _sceneDrafts.Remove(staleId);
        }

        foreach (var scene in _project.Scenes)
        {
            if (!_sceneDrafts.TryGetValue(scene.Id, out var draft) || !draft.IsDirty)
            {
                _sceneDrafts[scene.Id] = CreateSceneDraft(scene);
            }
        }
    }

    private void UpdateDraft(long sceneId, Action<SceneEditorState> update)
    {
        if (_project?.Scenes.FirstOrDefault(x => x.Id == sceneId) is not { } scene) return;
        var draft = GetSceneDraft(scene);
        update(draft);
        draft.IsDirty = true;
    }


