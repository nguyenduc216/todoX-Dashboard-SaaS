    private ValueTask CopyTextAsync(string text)
        => string.IsNullOrWhiteSpace(text)
            ? ValueTask.CompletedTask
            : JS.InvokeVoidAsync("navigator.clipboard.writeText", text);

    private ValueTask CopyJobIdAsync()
        => _jobId is Guid jobId
            ? JS.InvokeVoidAsync("navigator.clipboard.writeText", jobId.ToString())
            : ValueTask.CompletedTask;

    private static Color VersionStatusColor(string status) => status switch
    {
        "completed" => Color.Success,
        "queued" or "submitted" or "processing" => Color.Warning,
        "failed" or "cancelled" => Color.Error,
        _ => Color.Default
    };

    private RenderFragment RenderImageHistoryPanel(VideoProjectSceneDto scene) => @<MudPaper Class="pa-3 mt-2" Outlined="true">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle2">Lịch sử ảnh scene @scene.SceneIndex</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => LoadImageHistoryAsync(scene))">Refresh</MudButton>
            </MudStack>
            @if (!_imageVersions.TryGetValue(scene.Id, out var versions) || versions.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">Chưa có phiên bản ảnh.</MudAlert>
            }
            else
            {
                @foreach (var version in versions)
                {
                    <MudPaper Class="pa-2" Outlined="true">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap gap-1">
                                <MudChip T="string" Size="Size.Small" Color="@VersionStatusColor(version.Status)">v@version.VersionNumber - @version.Status</MudChip>
                                @if (version.IsSelected)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Đang được chọn</MudChip>
                                }
                                <MudText Typo="Typo.caption">@version.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                            </MudStack>
                            @if (!string.IsNullOrWhiteSpace(version.PublicUrl))
                            {
                                <img src="@version.PublicUrl" style="max-width:160px;max-height:96px;object-fit:cover;border-radius:6px" />
                            }
                            <MudText Typo="Typo.caption">Provider: @version.ProviderCode | Model: @version.ModelName | Task: @version.ProviderTaskId</MudText>
                            <MudText Typo="Typo.caption">Điểm trừ: @version.ChargedPoints.ToString("0.####") | USD dự kiến: @FormatMoney(version.EstimatedUsd) | USD thực tế: @FormatMoney(version.ActualUsd)</MudText>
                            <MudText Typo="Typo.caption">Prompt gốc: @ShortText(version.ImagePromptSnapshot)</MudText>
                            <MudText Typo="Typo.caption">Prompt gửi provider: @ShortText(version.CompiledImagePromptSnapshot)</MudText>
                            <MudText Typo="Typo.caption">Prompt video: @ShortText(version.VideoPromptSnapshot)</MudText>
                            @if (!string.IsNullOrWhiteSpace(version.ErrorMessage))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">Lỗi: @version.ErrorMessage</MudText>
                            }
                            <MudStack Row="true" Spacing="1" Class="flex-wrap gap-1">
                                @if (!string.IsNullOrWhiteSpace(version.PublicUrl))
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OpenUrl(version.PublicUrl!))">Xem ảnh</MudButton>
                                }
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => CopyTextAsync(version.CompiledImagePromptSnapshot ?? version.ImagePromptSnapshot ?? string.Empty))">Sao chép prompt</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" Disabled="@(!CanSelectVersion(version.Status, version.IsSelected))" OnClick="@(() => SelectImageVersionAsync(scene, version))">Chọn vào bản nháp</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            }
        </MudStack>
    </MudPaper>;

