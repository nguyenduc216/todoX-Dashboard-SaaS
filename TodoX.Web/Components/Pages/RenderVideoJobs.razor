    private async Task ReloadAsync()
    {
        if (_projectId is null) return;
        if (AuthState.CurrentUser is null) return;

        // Guard against overlapping ReloadAsync calls from concurrent polling/UI refresh. Non-blocking: if
        // already reloading, skip this call instead of queueing (the next poll will catch the new state).
        if (!await _reloadLock.WaitAsync(0))
        {
            return;
        }
        try
        {
            try
            {
                _project = await VideoRepo.GetProjectAsync(_projectId.Value, AuthState.CurrentUser);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "VIDEO_RENDER_RELOAD_PROJECT_FAILED projectId={ProjectId}", _projectId);
                throw;
            }
            if (_project is not null)
            {
                _thinkScenes = _project.ThinkScenes;
                _prompt = _project.OriginalPrompt;
                _autoFinish = ReadAutoFinish(_prompt);
                try
                {
                    await LoadRVideoSettingsAsync(_project.Id);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "RVIDEO_RELOAD_SETTINGS_FAILED projectId={ProjectId}", _project.Id);
                    _loadWarning = "Không thể tải cài đặt RVIDEO. Trang đang dùng dữ liệu project hiện có.";
                }
                try
                {
                    _promptParseResult = PromptParser.Parse(_prompt);
                    ApplyVideoSettingsFromPrompt();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "RVIDEO_RELOAD_PROMPT_PARSE_FAILED projectId={ProjectId}", _project.Id);
                    _promptParseResult = new();
                    _loadWarning = "Không thể phân tích prompt gốc. Scene preview vẫn được hiển thị.";
                }
                _totalSeconds = _project.TotalSeconds;
                _sceneSeconds = _project.SceneSeconds;
                if (!_skipCharacter && _characterMode == RVideoCharacterModes.Library && _selectedCharacterId is not null)
                {
                    await OnCharacterChangedAsync(_selectedCharacterId);
                }
                else if (_skipCharacter)
                {
                    await ClearSelectedCharacterAsync();
                }
                ReconcileSceneDrafts();
                RebuildSceneEventState();
                await LoadSceneVideoVersionsForStateAsync(_project.Scenes);
                try
                {
                    _defaultImageToVideoProvider = await AiProviders.GetDefaultProviderAsync(TodoX.Web.Services.VideoRender.RVideoVideoModelPolicy.CapabilityCode);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "RVIDEO_RELOAD_VIDEO_PROVIDER_FAILED projectId={ProjectId}", _project.Id);
                    _defaultImageToVideoProvider = null;
                    _loadWarning = "Không thể tải cấu hình tạo video. Có thể xem preview hiện có và thử lại sau.";
                }
                await ReloadJobsAsync();
            }
        }
        finally
        {
            _reloadLock.Release();
        }
    }

