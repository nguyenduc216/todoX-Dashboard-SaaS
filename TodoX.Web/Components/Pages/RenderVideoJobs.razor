    private UploadedCharacterSnapshot? _uploadedCharacter;
    private string _voiceMode = RVideoVoiceModes.None;
    private string? _voiceCatalogCode;
    private decimal _defaultTtsRate = 1.0m;
    private string _musicMode = RVideoMusicModes.None;
    private string? _musicCatalogCode;
    private decimal _musicVolume = 0.8m;
    private string _prompt = string.Empty;
    private string _characterPrompt = string.Empty;
    private TodoXVideoPromptParseResult _promptParseResult = new();
    private string _aspectRatio = string.Empty;
    private string _resolution = string.Empty;
    private int _totalSeconds = 16;
    private int _sceneSeconds = 8;
    private bool _thinkScenes = false;
    private bool _autoFinish = true;
    private string _executionMode = RVideoExecutionModes.Manual;
    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCts;
    private readonly List<DebugEntry> _debugEntries = new();
    private int _debugStep;

    // Scenes currently being re-rendered individually through persisted provider work. Keyed by scene id.
    private readonly HashSet<long> _sceneRerendering = new();
    private readonly HashSet<long> _sceneVideoRetrying = new();
    // Per-scene re-render error messages (kept so a failed rerender does not wipe the old image).
    private readonly Dictionary<long, string> _sceneRerenderErrors = new();
    // Transient per-scene render state derived from project events (survives page refresh).
    private readonly Dictionary<long, RenderSceneImageVisualState> _sceneEventState = new();
    private readonly Dictionary<long, IReadOnlyList<TodoX.Web.Services.VideoRender.SceneImageVersionDto>> _imageVersions = new();
    private readonly Dictionary<long, IReadOnlyList<TodoX.Web.Services.VideoRender.SceneVideoVersionDto>> _videoVersions = new();
    private readonly Dictionary<long, SceneEditorState> _sceneDrafts = new();
    private IReadOnlyList<TodoX.Web.Services.VideoRender.FinalVideoVersionDto> _finalVersions = Array.Empty<TodoX.Web.Services.VideoRender.FinalVideoVersionDto>();
    private readonly Dictionary<Guid, IReadOnlyList<TodoX.Web.Services.VideoRender.FinalVideoVersionItemDto>> _finalVersionItems = new();
    private ProviderOptionDto? _defaultImageToVideoProvider;
    private long? _imageHistorySceneId;
    private long? _videoHistorySceneId;
    private bool _showFinalHistory;
    // Polling guard: prevents overlapping ReloadAsync calls.
    private readonly SemaphoreSlim _reloadLock = new(1, 1);
    // True while a background scene image batch job for this project is queued/rendering.
    private bool _batchActive;
    private IReadOnlyList<TodoX.Web.Services.Platform.CoreServiceView> _coreServices = Array.Empty<TodoX.Web.Services.Platform.CoreServiceView>();

    private sealed class SceneEditorState
    {
        public long SceneId { get; init; }
        public string? Purpose { get; set; }
        public string? ImagePrompt { get; set; }
        public string? MotionPrompt { get; set; }
