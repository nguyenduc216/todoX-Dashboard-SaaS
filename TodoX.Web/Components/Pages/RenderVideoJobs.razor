        public Guid? SelectedImageVersionId { get; set; }
        public Guid? SelectedVideoVersionId { get; set; }
        public string AspectRatio { get; set; } = AspectRatioPortrait;
        public bool IsDirty { get; set; }
    }

    private const string AspectRatioLandscape = "16:9";
    private const string AspectRatioPortrait = "9:16";
    private const string Resolution720p = "720p";
    private const string Resolution1080p = "1080p";
    private const string Resolution4K = "4K";

    private bool CanMerge => _project is not null && _project.Scenes.Count > 0 && _project.Scenes.All(x => ResolveVideoSceneStatus(x) == VideoSceneStatuses.VideoReady);

    private string BuildLogCode() => _projectId is null ? string.Empty : $"video-{_projectId.Value}";

    private string ProjectAspectRatio => HasProjectAspectRatio ? _aspectRatio : "Chưa chọn";

    private bool HasProjectAspectRatio => IsSupportedAspectRatio(_aspectRatio);

    private string ProjectResolution => HasProjectResolution ? _resolution : "Chưa chọn";

    private bool HasProjectResolution => IsSupportedResolution(_resolution);

    private string PromptFileSummary
        => string.IsNullOrWhiteSpace(_prompt)
            ? "Chưa nạp file JSON"
            : $"{_promptParseResult.Summary.SceneCount} scene · {_prompt.Length:n0} ký tự";

    private IReadOnlyList<string> SupportedVideoResolutions
        => (VideoOptions.CurrentValue.SupportedResolutions is { Length: > 0 } values ? values : new[] { Resolution720p, Resolution1080p })
            .Select(NormalizeResolution)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Cast<string>()
            .ToList();

    private string ProjectHeaderMeta
        => _jobId is Guid jobId
            ? $"Job ID: {jobId} · Service: {ResolveServiceLabel()} · Stage: {ResolveProjectStage()} · Aspect ratio: {ProjectAspectRatio}"
            : $"Job mới · Service: {ResolveServiceLabel()} · Stage: {ResolveProjectStage()} · Aspect ratio: {ProjectAspectRatio}";

    private string ResolveServiceLabel()
    {
        var serviceCode = ServiceCode
            ?? (ServiceId.HasValue ? _coreServices.FirstOrDefault(x => x.Id == ServiceId.Value)?.ServiceCode : null);
        var catalogService = _coreServices.FirstOrDefault(x =>
            (ServiceId.HasValue && x.Id == ServiceId.Value)
            || string.Equals(x.ServiceCode, serviceCode, StringComparison.OrdinalIgnoreCase));
        return !string.IsNullOrWhiteSpace(catalogService?.Name)
            ? catalogService.Name
            : string.IsNullOrWhiteSpace(serviceCode) ? "RVIDEO" : serviceCode;
    }

    private string ResolveProjectStage()
    {
        if (_project is null) return "Thông tin";
        var states = _project.Scenes.Select(ResolveSceneImageState).ToList();
        if (states.Any(x => x == RenderSceneImageVisualState.Failed)) return "Có lỗi";
        if (_project.Scenes.Count > 0 && _project.Scenes.All(x => !string.IsNullOrWhiteSpace(x.StaticImageUrl)))
        {
            if (_project.Scenes.All(x => !string.IsNullOrWhiteSpace(ResolveDraftVideoUrl(x, GetSceneDraft(x)))))
                return "Hoàn thành";
            return "Ảnh đã sẵn sàng";
        }
        if (states.Any(x => x == RenderSceneImageVisualState.Downloading)) return "Đang tải kết quả";
        if (states.Any(x => x == RenderSceneImageVisualState.ProviderProcessing)) return "Đang xử lý";
        if (states.Any(x => x == RenderSceneImageVisualState.ProviderSubmitted)) return "Đã gửi yêu cầu";
        if (states.Any(RenderSceneImageUiState.IsActive)) return "Đang tạo ảnh";
        return _project.Scenes.Count > 0 ? "Chuẩn bị scene" : "Thông tin";
    }

    private sealed record DebugEntry(DateTimeOffset Timestamp, int StepNumber, string StepCode, string StepName, string Status, long DurationMs, string Message, string? Details = null);

    protected override async Task OnInitializedAsync()
    {
        if (!Embedded)
        {
            var target = QueryProjectId is long projectId ? $"/render-jobs?projectId={projectId}" : "/render-jobs";
            Navigation.NavigateTo(target, replace: true);
            return;
        }

        try
        {
            _loadWarning = null;
            _jobId = JobId;
            _projectId = ProjectId ?? QueryProjectId;
            if (AuthState.CurrentUser is not null)
            {
                try
                {
                    _coreServices = await CoreCatalog.ListAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "RVIDEO_BOOTSTRAP_CORE_SERVICES_FAILED");
                    _loadWarning = "Một phần dữ liệu khởi tạo chưa tải được. Trang vẫn sẵn sàng để tiếp tục.";
                }
                await LoadCharactersAsync();
                await LoadAudioCatalogsAsync();
            }
            if (AuthState.CurrentUser is not null)
            {
                _projectDialogOpen = true;
                if (_projectId is null && _jobId is not null && AuthState.CurrentUser is { IsCustomer: true } user)
                {
                    try
                    {
                        var view = await RVideoJobs.GetByJobIdAsync(_jobId.Value, user);
                        _projectId = view?.Project.Id ?? _projectId;
                        if (view is not null)
                        {
                            ServiceId = view.CoreJob.ServiceId;
                            ServiceCode = view.CoreJob.ServiceCode;
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "RVIDEO_BOOTSTRAP_JOB_RESOLVE_FAILED jobId={JobId}", _jobId);
                        _loadWarning = "Không thể tải đủ metadata job. Đang hiển thị phần project đã có.";
                    }
                }
                if (_projectId is not null)
                {
                    await ReloadAsync();
                }
            }
            if (_projectId is not null)
            {
                await StartPolling();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "RVIDEO_BOOTSTRAP_FAILED jobId={JobId} projectId={ProjectId}", _jobId, _projectId);
            _loadWarning = "Không thể hoàn tất khởi tạo RVIDEO. Vui lòng thử tải lại.";
            _projectDialogOpen = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Embedded)
        {
            var target = QueryProjectId is long projectId ? $"/render-jobs?projectId={projectId}" : "/render-jobs";
            Navigation.NavigateTo(target, replace: true);
            return;
        }

        var incomingProjectId = ProjectId ?? QueryProjectId;
        if (incomingProjectId != _projectId || JobId != _jobId)
        {
            try
            {
                _loadWarning = null;
                _jobId = JobId;
                _projectId = incomingProjectId;
                _sceneDrafts.Clear();
                _imageVersions.Clear();
                _videoVersions.Clear();
                if (AuthState.CurrentUser is not null)
                {
                    _projectDialogOpen = true;
                    if (_projectId is null && _jobId is not null && AuthState.CurrentUser is { IsCustomer: true } user)
                    {
                        try
                        {
                            var view = await RVideoJobs.GetByJobIdAsync(_jobId.Value, user);
                            _projectId = view?.Project.Id ?? _projectId;
                            if (view is not null)
                            {
                                ServiceId = view.CoreJob.ServiceId;
                                ServiceCode = view.CoreJob.ServiceCode;
                            }
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning(ex, "RVIDEO_PARAMETER_JOB_RESOLVE_FAILED jobId={JobId}", _jobId);
                            _loadWarning = "Không thể tải đủ metadata job. Đang hiển thị phần project đã có.";
                        }
                    }
                    if (_projectId is null)
                    {
                        _project = null;
                        _prompt = string.Empty;
                        _aspectRatio = string.Empty;
                        _resolution = string.Empty;
                        StopPolling();
                    }
                    else
                    {
                        await ReloadAsync();
                        await StartPolling();
                    }
                    _tabIndex = 0;
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "RVIDEO_PARAMETERS_BOOTSTRAP_FAILED jobId={JobId} projectId={ProjectId}", JobId, incomingProjectId);
                _loadWarning = "Không thể hoàn tất tải lại dữ liệu RVIDEO. Vui lòng thử refresh.";
                _projectDialogOpen = true;
            }
        }
    }

    public void Dispose()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollTimer?.Dispose();
        _reloadLock.Dispose();
    }

    private async Task CreateProjectAsync()
    {
        if (AuthState.CurrentUser is null) return;
        if (_projectId is not null)
        {
            if (!EnsureAspectRatioSelected())
            {
                return;
            }

            _busy = true;
            try
            {
                if (!_promptParseResult.IsJsonValid)
                {
                    _promptParseResult = PromptParser.Parse(_prompt);
                }

                _prompt = PersistPromptVideoSettings(_prompt, _aspectRatio, _resolution, _autoFinish);
                var scenes = BuildSceneRequests().Select(x => new VideoProjectSceneDto
                {
                    SceneIndex = x.SceneIndex,
                    Title = x.Title,
                    DurationSeconds = x.DurationSeconds,
                    ScenePrompt = x.ScenePrompt,
                    ImagePrompt = x.ImagePrompt,
                    VideoPrompt = x.VideoPrompt,
                    Status = VideoSceneStatuses.Draft
                }).ToList();
                await VideoRepo.ReplaceScenesAsync(_projectId.Value, scenes);
                await VideoRepo.AddProjectEventAsync(_projectId.Value, "SCENES_CREATED", "info", "RVIDEO scenes created from the saved Core Job.", new { jobId = _jobId, projectId = _projectId });
                await ReloadAsync();
                _tabIndex = 1;
                Snackbar.Add("Đã tạo và phân tách scene.", Severity.Success);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "VIDEO_RENDER_CREATE_SCENES_FAILED jobId={JobId} projectId={ProjectId}", _jobId, _projectId);
                Snackbar.Add(ex.Message, Severity.Error);
            }
            finally
            {
                _busy = false;
            }
            return;
        }

        if (!EnsureAspectRatioSelected())
        {
            return;
        }
        _busy = true;
        try
        {
            if (!_promptParseResult.IsJsonValid)
            {
                _promptParseResult = PromptParser.Parse(_prompt);
            }
            await AddDebugAsync("ui_started", "Bắt đầu xử lý", "STARTED", "Người dùng bấm nút Tạo / phân tách scene.");
            await AddDebugAsync("ui_auth", "Kiểm tra đăng nhập", "INFO", $"User={MaskGuid(AuthState.CurrentUser.UserId)}, Customer={MaskGuid(AuthState.CurrentUser.CustomerId)}");
            var inputDebug = BuildInputDebugMessage();
            await AddDebugAsync("ui_input", "Kiểm tra prompt", "INFO", inputDebug);
            _prompt = PersistPromptVideoSettings(_prompt, _aspectRatio, _resolution, _autoFinish);

            var storageRoot = VideoOptions.CurrentValue.StorageRoot;
            var publicBase = VideoOptions.CurrentValue.PublicBase;
            var jobFolder = DateTime.UtcNow.ToString("yyyyMMdd-HHmmss");
            await AddDebugAsync("repo_call", "Gọi repository", "INFO", $"storageRoot={storageRoot}, publicBase={publicBase}, jobFolder={jobFolder}");
            var result = await VideoRepo.CreateProjectAsync(new VideoProjectCreateRequest
            {
                Prompt = _prompt,
                AspectRatio = _aspectRatio,
                CharacterId = _selectedCharacter?.Id,
                TotalSeconds = _totalSeconds,
                SceneSeconds = Math.Max(1, _sceneSeconds),
                ThinkScenes = _thinkScenes,
                Title = _promptParseResult.Model.VideoTitle ?? "Render video job",
                CreateEmptyProject = false,
                Scenes = BuildSceneRequests()
            }, AuthState.CurrentUser.UserId, AuthState.CurrentUser.CustomerId, storageRoot, publicBase, jobFolder);
            _projectId = result.Id;
            await RVideoSettings.SaveAsync(result.Id, BuildRVideoSettingsRequest());
            await ProjectCreated.InvokeAsync(result.Id);
            Logger.LogInformation("VIDEO_RENDER_CREATE_PROJECT_OK projectId={ProjectId} sceneCount={SceneCount} status={Status}", result.Id, result.SceneCount, result.Status);
            await ReloadAsync();
            if (_executionMode == RVideoExecutionModes.Auto)
            {
                await EnqueueBulkSceneImageRenderAsync(onlyMissingOrFailed: true);
            }
            Snackbar.Add("Đã tạo project và chuyển sang tab Scene / Hình ảnh.", Severity.Success);
            _tabIndex = 1;
            await LogProjectEvent("PROJECT_CREATED", "info", "Đã tạo project và sinh scene plan mock.", new { result.Id, result.SceneCount, result.Status });
            await AddDebugAsync("ui_done", "Hoàn tất", "SUCCESS", $"Tạo project thành công: {result.Id}", $"SceneCount={result.SceneCount}, Status={result.Status}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "VIDEO_RENDER_CREATE_PROJECT_FAILED");
            Snackbar.Add(ex.Message, Severity.Error);
            await AddDebugAsync("ui_failed", "Thất bại", "FAILED", ex.Message, ex.ToString());
        }
        finally { _busy = false; }
    }

    private async Task CreateEmptyProjectAsync()
    {
        if (AuthState.CurrentUser is null) return;
        if (!EnsureAspectRatioSelected())
        {
            return;
        }
        _promptParseResult = PromptParser.Parse(_prompt);
        _busy = true;
        try
        {
            var storageRoot = VideoOptions.CurrentValue.StorageRoot;
            var publicBase = VideoOptions.CurrentValue.PublicBase;
            var jobFolder = DateTime.UtcNow.ToString("yyyyMMdd-HHmmss");
            var result = await VideoRepo.CreateProjectAsync(new VideoProjectCreateRequest
            {
                Prompt = PersistPromptVideoSettings(_prompt, _aspectRatio, _resolution, _autoFinish),
                AspectRatio = _aspectRatio,
                CharacterId = _selectedCharacter?.Id,
                TotalSeconds = _totalSeconds,
                SceneSeconds = Math.Max(1, _sceneSeconds),
                ThinkScenes = false,
                Title = _promptParseResult.Model.VideoTitle ?? "Video project rỗng",
                CreateEmptyProject = true
            }, AuthState.CurrentUser.UserId, AuthState.CurrentUser.CustomerId, storageRoot, publicBase, jobFolder);
            _projectId = result.Id;
            await RVideoSettings.SaveAsync(result.Id, BuildRVideoSettingsRequest());
            await ProjectCreated.InvokeAsync(result.Id);
            await ReloadAsync();
            _tabIndex = 1;
            Snackbar.Add("Đã tạo project rỗng.", Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private List<VideoProjectSceneCreateRequest> BuildSceneRequests()
    {
        if (_promptParseResult.HasScenes)
        {
            return _promptParseResult.Model.Scenes
                .OrderBy(x => x.Scene ?? int.MaxValue)
                .Select((scene, index) => new VideoProjectSceneCreateRequest
                {
                    SceneIndex = scene.Scene ?? index + 1,
                    Title = $"Scene {scene.Scene ?? index + 1}",
                    DurationSeconds = scene.DurationSeconds ?? _sceneSeconds,
                    ScenePrompt = BuildSceneMetadata(scene),
                    ImagePrompt = scene.EffectiveImagePrompt,
                    VideoPrompt = scene.MotionPrompt
                })
                .ToList();
        }

        var fallbackCount = Math.Max(1, (int)Math.Ceiling(Math.Max(1, _totalSeconds) / (double)Math.Max(1, _sceneSeconds)));
        return Enumerable.Range(1, fallbackCount)
            .Select(index => new VideoProjectSceneCreateRequest
            {
                SceneIndex = index,
                Title = $"Scene {index}",
                DurationSeconds = index == fallbackCount ? Math.Max(1, _totalSeconds - _sceneSeconds * (fallbackCount - 1)) : _sceneSeconds,
                ScenePrompt = $"scene_purpose: main_content | image_prompt: Scene {index} image prompt | motion_prompt: Scene {index} motion prompt | voice: Scene {index} voice | voice_instruction: Scene {index} voice instruction",
                ImagePrompt = $"Scene {index} image prompt",
                VideoPrompt = $"Scene {index} motion prompt"
            })
            .ToList();
    }

