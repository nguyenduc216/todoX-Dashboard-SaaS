    private async Task OpenSceneErrorDetailAsync(VideoProjectSceneDto scene, string taskType)
    {
        if (AuthState.CurrentUser is null)
        {
            Snackbar.Add("Vui lòng đăng nhập để xem log lỗi.", Severity.Warning);
            return;
        }

        SceneRenderErrorDetailDto detail;
        try
        {
            detail = await SceneVersions.GetSceneRenderErrorDetailAsync(scene.Id, taskType, AuthState.CurrentUser)
                ?? BuildFallbackSceneErrorDetail(scene, taskType, "Không tìm thấy nội dung lỗi chi tiết");
        }
        catch (Exception ex)
        {
            detail = BuildFallbackSceneErrorDetail(scene, taskType, $"Không thể tải log lỗi: {ex.Message}");
        }

        var parameters = new DialogParameters<SceneRenderErrorDetailDialog>
        {
            { x => x.Detail, detail }
        };
        var options = new DialogOptions { CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Large, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<SceneRenderErrorDetailDialog>($"Chi tiết lỗi Scene {scene.SceneIndex:00}", parameters, options);
    }

    private SceneRenderErrorDetailDto BuildFallbackSceneErrorDetail(VideoProjectSceneDto scene, string taskType, string message)
        => new()
        {
            ProjectId = _project?.Id ?? scene.ProjectId,
            JobTitle = _project?.Title ?? "Render Video Job",
            SceneId = scene.Id,
            SceneIndex = scene.SceneIndex,
            SceneTitle = scene.Title,
            TaskType = string.Equals(taskType, "video", StringComparison.OrdinalIgnoreCase) ? "video" : "image",
            Status = string.Equals(taskType, "video", StringComparison.OrdinalIgnoreCase) ? ResolveVideoSceneStatus(scene) : scene.Status,
            ErrorStage = "UNKNOWN",
            ErrorCode = "log_detail_unavailable",
            ErrorMessage = string.IsNullOrWhiteSpace(scene.ErrorMessage) ? message : scene.ErrorMessage,
            UpdatedAt = new DateTimeOffset(DateTime.SpecifyKind(scene.UpdatedAt, DateTimeKind.Utc))
        };

    private bool CanCreateSceneVideo(VideoProjectSceneDto scene, SceneEditorState draft)
        => !string.IsNullOrWhiteSpace(ResolveDraftImageUrl(scene, draft))
           && !string.IsNullOrWhiteSpace(draft.MotionPrompt)
           && HasProjectAspectRatio
           && HasProjectResolution
           && _defaultImageToVideoProvider is not null
           && !HasCompletedVideoVersion(scene)
           && !string.Equals(ResolveVideoSceneStatus(scene), VideoSceneStatuses.VideoRendering, StringComparison.OrdinalIgnoreCase)
           && IsSceneVideoPromptValid(scene, draft);

    private string SceneVideoDisabledReason(VideoProjectSceneDto scene, SceneEditorState draft)
        => string.IsNullOrWhiteSpace(ResolveDraftImageUrl(scene, draft))
            ? "Cần chọn/render ảnh trước"
            : string.IsNullOrWhiteSpace(draft.MotionPrompt)
                ? "Cần nhập prompt video"
            : !HasProjectAspectRatio
                ? "Cần chọn tỷ lệ video"
            : !HasProjectResolution
                ? "Cần chọn độ phân giải video"
            : _defaultImageToVideoProvider is null
                ? "Chưa cấu hình tạo video"
            : !IsSceneVideoPromptValid(scene, draft)
                ? ResolveVideoPromptState(scene, draft).Text
            : string.Empty;

    private bool CanEnqueueSceneVideos()
        => _project is not null
           && _project.Scenes.Any(scene => CanCreateSceneVideo(scene, GetSceneDraft(scene)));

    private string BulkSceneVideoDisabledReason()
        => _project is null
            ? "Chưa có project"
            : !HasProjectAspectRatio
                ? "Cần chọn tỷ lệ video"
            : !HasProjectResolution
                ? "Cần chọn độ phân giải video"
            : _defaultImageToVideoProvider is null
                ? "Chưa cấu hình tạo video"
                : !_project.Scenes.Any(scene => CanCreateSceneVideo(scene, GetSceneDraft(scene)))
                    ? "Không có scene nào đủ điều kiện render video"
                    : string.Empty;

    private bool IsOmniFlashVideoModel()
        => string.Equals(_defaultImageToVideoProvider?.ModelName, "omni-flash", StringComparison.OrdinalIgnoreCase);

    private bool IsSceneVideoPromptValid(VideoProjectSceneDto scene, SceneEditorState draft)
    {
        if (!IsOmniFlashVideoModel())
        {
            return !string.IsNullOrWhiteSpace(draft.MotionPrompt);
        }

        var state = ResolveVideoPromptState(scene, draft);
        return state.IsValid;
    }

    private VideoPromptState ResolveVideoPromptState(VideoProjectSceneDto scene, SceneEditorState draft)
    {
        var prompt = draft.MotionPrompt ?? string.Empty;
        var modelName = _defaultImageToVideoProvider?.ModelName ?? string.Empty;
        var maxCharacters = TodoX.Web.Services.VideoRender.VideoPromptValidator.ResolveMaxPromptCharacters(modelName, null);
        var actualCharacters = TodoX.Web.Services.VideoRender.VideoPromptValidator.CountUnicodeScalars(prompt.Trim());

        if (string.IsNullOrWhiteSpace(prompt))
        {
            return new VideoPromptState(false, Color.Error, $"Scene {scene.SceneIndex:00}: prompt video không được để trống.");
        }

        if (maxCharacters is int max && actualCharacters > max)
        {
            return new VideoPromptState(false, Color.Error, $"Scene {scene.SceneIndex:00}: {actualCharacters:n0} / {max:n0} ký tự, vượt giới hạn của Omni Flash.");
        }

        if (maxCharacters is int warningMax && actualCharacters > TodoX.Web.Services.VideoRender.VideoPromptValidator.OmniFlashWarningPromptCharacters)
        {
            return new VideoPromptState(true, Color.Warning, $"Scene {scene.SceneIndex:00}: {actualCharacters:n0} / {warningMax:n0} ký tự.");
        }

        return new VideoPromptState(true, Color.Success, $"Scene {scene.SceneIndex:00}: {actualCharacters:n0} / {maxCharacters?.ToString("n0") ?? "?"} ký tự.");
    }

