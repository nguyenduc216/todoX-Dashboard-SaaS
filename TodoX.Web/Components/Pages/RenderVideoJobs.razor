    private static MediaRenderState ResolveImageMediaState(RenderSceneImageVisualState state)
        => state switch
        {
            RenderSceneImageVisualState.Queued
                => MediaRenderState.Queued,
            RenderSceneImageVisualState.ProviderSubmitted
                or RenderSceneImageVisualState.ProviderProcessing
                or RenderSceneImageVisualState.Rendering
                or RenderSceneImageVisualState.Retrying => MediaRenderState.Rendering,
            RenderSceneImageVisualState.Downloading => MediaRenderState.Downloading,
            RenderSceneImageVisualState.Ready => MediaRenderState.Ready,
            RenderSceneImageVisualState.Failed => MediaRenderState.Failed,
            _ => MediaRenderState.Empty
        };

    private MediaRenderState ResolveVideoMediaState(VideoProjectSceneDto scene)
    {
        var versions = _videoVersions.TryGetValue(scene.Id, out var loadedVersions)
            ? loadedVersions
            : Array.Empty<TodoX.Web.Services.VideoRender.SceneVideoVersionDto>();
        var latest = versions.OrderByDescending(x => x.VersionNumber).FirstOrDefault();
        var selectedCompleted = versions.FirstOrDefault(x =>
            x.IsSelected
            && string.Equals(x.Status, "completed", StringComparison.OrdinalIgnoreCase)
            && HasUsableVideoMedia(x));

        if (selectedCompleted is not null
            || (!string.IsNullOrWhiteSpace(scene.SceneVideoUrl) && HasCompletedVideoVersion(scene)))
        {
            return MediaRenderState.Ready;
        }

        if (latest is not null)
        {
            var latestStatus = latest.Status.Trim().ToLowerInvariant();
            if (latestStatus is "downloading" or "importing" or "reconciling")
            {
                return MediaRenderState.Downloading;
            }

            if (latestStatus is "submitted" or "processing" or "pending_reconciliation" or "rendering")
            {
                return MediaRenderState.Rendering;
            }

            if (latestStatus == "queued")
            {
                return MediaRenderState.Queued;
            }

            if (latestStatus == "failed")
            {
                return MediaRenderState.Failed;
            }
        }

        var status = scene.Status.Trim().ToLowerInvariant();
        return status switch
        {
            VideoSceneStatuses.VideoQueued => MediaRenderState.Queued,
            VideoSceneStatuses.VideoRendering or "submitted" or "processing" or "pending_reconciliation" => MediaRenderState.Rendering,
            "downloading" or "importing" or "reconciling" => MediaRenderState.Downloading,
            VideoSceneStatuses.VideoReady => MediaRenderState.Ready,
            VideoSceneStatuses.Failed => MediaRenderState.Failed,
            _ => MediaRenderState.Empty
        };
    }

    private static bool HasUsableVideoMedia(TodoX.Web.Services.VideoRender.SceneVideoVersionDto version)
        => !string.IsNullOrWhiteSpace(version.PublicUrl)
           || !string.IsNullOrWhiteSpace(version.SourceFilePath)
           || !string.IsNullOrWhiteSpace(version.StorageKey);

    private async Task LoadSceneVideoVersionsForStateAsync(IEnumerable<VideoProjectSceneDto> scenes)
    {
        if (AuthState.CurrentUser is null) return;

        var loads = scenes.Select(async scene =>
        {
            try
            {
                _videoVersions[scene.Id] = await SceneVersions.ListSceneVideoVersionsAsync(scene.Id, AuthState.CurrentUser, 0, 20);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "RVIDEO_LOAD_VIDEO_STATE_FAILED sceneId={SceneId}", scene.Id);
            }
        });
        await Task.WhenAll(loads);
    }

