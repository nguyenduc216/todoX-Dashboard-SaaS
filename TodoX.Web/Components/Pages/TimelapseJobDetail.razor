@page "/jobs/timelapse/{JobId:guid}"
@implements IDisposable
@using TodoX.Web.Models.Timelapse
@using TodoX.Web.Services.Timelapse
@using TodoX.Web.Components.Dialogs
@inject AuthStateService AuthState
@inject ITimelapseJobService Jobs
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(_job?.Snapshot.Title ?? "Công việc Timelapse")</PageTitle>

<MudStack Spacing="3" Class="timelapse-job-detail">
    @if (!AuthState.IsInitialized)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (AuthState.CurrentUser is not { IsCustomer: true })
    {
        <MudAlert Severity="Severity.Warning">Vui lòng đăng nhập bằng tài khoản khách hàng.</MudAlert>
    }
    else if (_initialLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (_job is null)
    {
        <MudAlert Severity="Severity.Error">@(_loadError ?? "Không tìm thấy job.")</MudAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_refreshError))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="timelapse-refresh-warning">
                @_refreshError
            </MudAlert>
        }
        @if (_busy)
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Warning"
                               Class="timelapse-action-progress"
                               aria-label="Đang lưu thay đổi Timelapse" />
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/jobs"))" />
            <div>
                <MudText Typo="Typo.h4" Class="todox-page-title">@_job.Snapshot.Title</MudText>
                <MudText Typo="Typo.body1" Class="todox-page-subtitle">@_job.Snapshot.ServiceCode · @_job.Workflow.CurrentStep</MudText>
            </div>
            <MudSpacer />
            <MudChip T="string" Color="@StatusColor(_job.Workflow.ParentStatus)">@TimelapseStatusText.Parent(_job.Workflow.ParentStatus)</MudChip>
        </MudStack>

        <MudPaper Class="todox-card pa-4" rounded="true">
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Ảnh AI</MudText>
                    <MudText Typo="Typo.h6">@ImageProgress.Completed / @ImageProgress.Total hoàn thành</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Tiến độ ảnh</MudText>
                    <MudText Typo="Typo.h6">@ImageProgress.Percent%</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Video</MudText>
                    <MudText Typo="Typo.h6">@CompletedVideos / @TotalVideos hoàn thành</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudText Typo="Typo.overline">Trạng thái</MudText>
                    <MudText Typo="Typo.h6">@TimelapseStatusText.Parent(_job.Workflow.ParentStatus)</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudTabs Rounded="true" KeepPanelsAlive="true" @bind-ActivePanelIndex="_activeTabIndex">
            <MudTabPanel Text="YÊU CẦU">
                <MudGrid Class="mt-3">
                    <MudItem xs="12" lg="8">
                        <MudPaper Class="todox-card pa-4" rounded="true">
                            <MudStack Spacing="3">
                                <MudTextField T="string" Label="Tên job" Value="@_job.Snapshot.Title" Variant="Variant.Outlined" Disabled="true" />

                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2">Ảnh thành phẩm / ảnh tham chiếu</MudText>
                                    <div class="timelapse-detail-image">
                                        @if (!string.IsNullOrWhiteSpace(_job.Snapshot.OriginalImage.PublicUrl))
                                        {
                                            <img src="@_job.Snapshot.OriginalImage.PublicUrl" alt="Ảnh tham chiếu Timelapse" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
                                        }
                                    </div>
                                </MudStack>

                                <MudGrid>
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle2">Loại công trình</MudText>
                                        <MudText>@_job.Snapshot.ProfileName</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle2">Số scene</MudText>
                                        <MudText>@_job.Snapshot.SceneCount scene</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle2">Chất lượng</MudText>
                                        <MudText>@TimelapseSellPricing.CustomerQualityLabel(_job.Snapshot.VideoMode)</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle2">Tỷ lệ</MudText>
                                        <MudText>@FormatRatio(_job.Snapshot.Ratio)</MudText>
                                    </MudItem>
                                </MudGrid>

                                @if (!_job.Workflow.CanEditRequest)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        Yêu cầu đang được khóa vì có tác vụ ảnh, video hoặc hoàn thiện video đang chạy.
                                    </MudAlert>
                                }
                            </MudStack>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" lg="4">
                        <MudPaper Class="todox-card pa-4" rounded="true">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.overline">CHI PHÍ DỰ KIẾN</MudText>
                                <div class="price-row"><span>Chất lượng</span><strong>@TimelapseSellPricing.CustomerQualityLabel(_job.Snapshot.VideoMode)</strong></div>
                                <div class="price-row"><span>Số scene</span><strong>@_job.Snapshot.SceneCount</strong></div>
                                <div class="price-row"><span>Ảnh khách tải lên</span><strong>Miễn phí</strong></div>
                                @if (_job.Snapshot.SellPrice is not null)
                                {
                                    <div class="price-row"><span>Đơn giá video</span><strong>@FormatPoints(_job.Snapshot.SellPrice.VideoSceneSellPoints) / scene</strong></div>
                                    <div class="price-row"><span>Video</span><strong>@($"{_job.Snapshot.SellPrice.SceneCount} x {FormatPoints(_job.Snapshot.SellPrice.VideoSceneSellPoints)} = {FormatPoints(_job.Snapshot.SellPrice.VideoSubtotal)}")</strong></div>
                                    <MudDivider />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Ảnh AI trung gian chưa tính trong giai đoạn này. Số ảnh AI dự kiến: @_job.Workflow.GeneratedImageCount.</MudText>
                                    <div class="timelapse-total">
                                        <span>TỔNG DỰ KIẾN</span>
                                        <strong>@FormatPoints(_job.Snapshot.SellPrice.TotalPoints) todoX</strong>
                                    </div>
                                }
                                <MudButton Class="todox-primary-btn"
                                           Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.MovieCreation"
                                           Disabled="@(!_job.Workflow.CanStartRender || _busy)"
                                           OnClick="StartOrResumeAsync">
                                    @StartButtonLabel
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="SCENE">
                <MudStack Spacing="3" Class="mt-3">
                    <MudPaper Class="todox-card pa-4" rounded="true">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Warning" />
                                <MudText Typo="Typo.h6">HÌNH ẢNH</MudText>
                            </MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Tạo theo thứ tự ngược từ ảnh thành phẩm.</MudText>
                            @if (ImageFailureCount > 0 || VideoFailureCount > 0)
                            {
                                <MudAlert Severity="Severity.Error" Dense="true">
                                    Có @ImageFailureCount ảnh lỗi và @VideoFailureCount video lỗi. Bạn có thể render lại tại scene tương ứng.
                                </MudAlert>
                            }
                            <div class="timelapse-stage-grid">
                                @foreach (var image in ImageCards)
                                {
                                    <div class="@($"timelapse-stage-card image-stage-card {OperationStateClass(image.Status)}")">
                                        <div class="stage-card-header">
                                            <strong>@image.ProgressPercent%</strong>
                                            <MudChip T="string" Size="Size.Small" Color="@OperationColor(image.Status)" Class="@($"tl-status-badge {OperationStateClass(image.Status)}")">
                                                @if (IsRenderingOperation(image.Status))
                                                {
                                                    <span class="tl-status-dot" aria-hidden="true"></span>
                                                }
                                                @FormatOperationStatus(image.Status)
                                            </MudChip>
                                        </div>
                                        <div class="@PreviewClass("image-preview", image.Status)">
                                            @if (!string.IsNullOrWhiteSpace(image.PublicUrl))
                                            {
                                                <img src="@image.PublicUrl" alt="@($"{image.ProgressPercent}%")" />
                                            }
                                            else if (image.IsOriginal)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
                                                <span>Ảnh thành phẩm chưa sẵn sàng</span>
                                            }
                                            else if (IsPendingOperation(image.Status))
                                            {
                                                <div class="tl-loading-content" role="status" aria-live="polite">
                                                    <span class="tl-loading-icon">
                                                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
                                                    </span>
                                                    <strong>@ImageLoadingTitle(image)</strong>
                                                    <span>@ImagePlaceholderText(image)</span>
                                                    @if (IsRenderingOperation(image.Status))
                                                    {
                                                        <span class="tl-image-scan" aria-hidden="true"></span>
                                                    }
                                                </div>
                                                @if (IsRenderingOperation(image.Status))
                                                {
                                                    <span class="tl-active-scanline tl-image-scanline" aria-hidden="true"></span>
                                                }
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
                                                <span>@ImagePlaceholderText(image)</span>
                                            }
                                        </div>
                                        <div class="tl-image-card-footer">
                                            <div class="tl-image-meta-row">
                                                @if (!image.IsOriginal)
                                                {
                                                    <MudTooltip Text="Xem / chỉnh sửa prompt">
                                                        <MudIconButton Icon="@Icons.Material.Filled.EditNote"
                                                                       Size="Size.Small"
                                                                       Color="Color.Warning"
                                                                       Disabled="@(!CanOpenPrompt(image) || _busy)"
                                                                       OnClick="@(() => OpenImagePromptAsync(image))"
                                                                       aria-label="@($"Xem hoặc chỉnh sửa prompt ảnh {image.ProgressPercent}%")" />
                                                    </MudTooltip>
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" Color="Color.Warning" />
                                                }
                                                <div class="tl-image-meta-copy">
                                                    <MudText Typo="Typo.body2">@(image.IsOriginal ? "Ảnh gốc / thành phẩm" : $"Ảnh AI {image.ProgressPercent}%")</MudText>
                                                    @if (image.IsOriginal)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Ảnh nguồn do khách hàng tải lên</MudText>
                                                    }
                                                    else
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatStartedAt(image)</MudText>
                                                        @if (image.CompletedAt.HasValue)
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatCompletedAt(image.CompletedAt.Value)</MudText>
                                                        }
                                                        @if (image.Attempt > 0)
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Lần render @image.Attempt</MudText>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        @if (!image.IsOriginal && image.DependsOnProgressPercent.HasValue && image.Status == TimelapseOperationStatuses.Waiting)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Đang chờ ảnh @image.DependsOnProgressPercent% hoàn thành</MudText>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(image.ErrorMessage))
                                        {
                                            <MudAlert Severity="Severity.Error" Dense="true">@FriendlyOperationError(image.ErrorMessage, "ảnh")</MudAlert>
                                        }
                                        @if (!image.IsOriginal && CanRetryImage(image.Status))
                                        {
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Outlined"
                                                       StartIcon="@Icons.Material.Filled.Refresh"
                                                       Disabled="@_busy"
                                                       OnClick="@(() => RetryImageAsync(image))">
                                                Render lại
                                            </MudButton>
                                        }
                                    </div>
                                }
                            </div>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Class="todox-card pa-4" rounded="true">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Movie" Color="Color.Warning" />
                                <MudText Typo="Typo.h6">VIDEO</MudText>
                            </MudStack>
                            @if (_job.Workflow.CanConfirmVideoRender)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    @_job.Workflow.ReadyVideoCount phân cảnh đã đủ ảnh đầu-cuối và đang chờ bạn xác nhận.
                                </MudAlert>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.MovieCreation"
                                           Disabled="@_busy"
                                           OnClick="ConfirmVideoRenderAsync">
                                    Bắt đầu tạo video
                                </MudButton>
                            }
                            else if (_job.Workflow.RequiresVideoConfirmation && !_job.Snapshot.VideoRenderConfirmed)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Video sẽ chờ xác nhận khi có phân cảnh đủ ảnh đầu-cuối.
                                </MudText>
                            }
                            <div class="timelapse-stage-grid">
                                @foreach (var clip in VideoCards)
                                {
                                    <div class="@($"timelapse-stage-card video-stage-card {OperationStateClass(clip.Status)}")">
                                        <div class="stage-card-header">
                                            <strong>@clip.StartProgressPercent% -> @clip.EndProgressPercent%</strong>
                                            <MudChip T="string" Size="Size.Small" Color="@OperationColor(clip.Status)" Class="@($"tl-status-badge {OperationStateClass(clip.Status)}")">
                                                @if (IsRenderingOperation(clip.Status))
                                                {
                                                    <span class="tl-status-dot" aria-hidden="true"></span>
                                                }
                                                @FormatOperationStatus(clip.Status)
                                            </MudChip>
                                        </div>
                                        <div class="clip-thumbs">
                                            @RenderImageThumb(clip.StartProgressPercent)
                                            @RenderImageThumb(clip.EndProgressPercent)
                                        </div>
                                        <div class="@PreviewClass("video-preview", clip.Status)">
                                            @if (TimelapseVideoOrchestration.HasCompletedPreview(clip))
                                            {
                                                <video src="@clip.PublicUrl" controls playsinline preload="metadata"></video>
                                            }
                                            else if (IsPendingOperation(clip.Status))
                                            {
                                                <div class="tl-loading-content" role="status" aria-live="polite">
                                                    <span class="tl-loading-icon">
                                                        <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" />
                                                    </span>
                                                    <strong>@VideoLoadingTitle(clip)</strong>
                                                    <span>@VideoPlaceholderText(clip)</span>
                                                    @if (IsRenderingOperation(clip.Status))
                                                    {
                                                        <span class="tl-video-wave" aria-hidden="true">
                                                            <i></i><i></i><i></i><i></i><i></i>
                                                        </span>
                                                    }
                                                </div>
                                                @if (IsRenderingOperation(clip.Status))
                                                {
                                                    <span class="tl-active-scanline tl-video-scanline" aria-hidden="true"></span>
                                                }
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" />
                                                <span>@VideoPlaceholderText(clip)</span>
                                            }
                                        </div>
                                        <div class="tl-video-card-footer">
                                            <div class="tl-video-dependency-row">
                                                <span>Ảnh đầu @clip.StartProgressPercent%</span>
                                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                                <span>Ảnh cuối @clip.EndProgressPercent%</span>
                                            </div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatClipStartedAt(clip)</MudText>
                                            @if (clip.CompletedAt.HasValue)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatCompletedAt(clip.CompletedAt.Value)</MudText>
                                            }
                                            @if (clip.Attempt > 0)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Lần render @clip.Attempt</MudText>
                                            }
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@TimelapseRequestRules.RuntimeClipDurationSeconds giây · @TimelapseSellPricing.CustomerQualityLabel(_job.Snapshot.VideoMode) · @FormatRatio(_job.Snapshot.Ratio)</MudText>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(clip.ErrorMessage))
                                        {
                                            <MudAlert Severity="Severity.Error" Dense="true">@FriendlyOperationError(clip.ErrorMessage, "video")</MudAlert>
                                        }
                                        @if (CanRetry(clip.Status))
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_busy" OnClick="@(() => RetryVideoAsync(clip.ClipIndex))">
                                                Render lại
                                            </MudButton>
                                        }
                                    </div>
                                }
                            </div>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.MovieFilter"
                                       Disabled="@(!_job.Workflow.CanFinalize || _busy)"
                                       OnClick="StartFinalizerAsync">
                                Hoàn thành video
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="KẾT QUẢ">
                <MudPaper Class="todox-card pa-4 mt-3" rounded="true">
                    @if (IsFinalOutputLoading)
                    {
                        <div class="tl-final-loading tl-loading-skeleton tl-loading-shimmer tl-pulse tl-flash-soft" role="status" aria-live="polite">
                            <span class="tl-loading-icon tl-final-icon">
                                <MudIcon Icon="@Icons.Material.Filled.MovieFilter" Size="Size.Large" />
                            </span>
                            <MudText Typo="Typo.h6">@FinalLoadingTitle</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Hệ thống tiếp tục xử lý kể cả khi bạn rời trang.</MudText>
                            <span class="tl-final-progress" aria-hidden="true"></span>
                        </div>
                    }
                    else if (_job.Workflow.FinalOutput?.Status == TimelapseOperationStatuses.Completed && !string.IsNullOrWhiteSpace(_job.Workflow.FinalOutput.PublicUrl))
                    {
                        <MudStack Spacing="2">
                            <video src="@_job.Workflow.FinalOutput.PublicUrl" controls playsinline class="final-video"></video>
                            <MudText Typo="Typo.h6">@_job.Snapshot.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Phiên bản @_job.Workflow.FinalOutput.Version · @_job.Workflow.FinalOutput.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Href="@_job.Workflow.FinalOutput.PublicUrl" Target="_blank">
                                Tải video
                            </MudButton>
                        </MudStack>
                    }
                    else if (_job.Workflow.FinalOutput?.Status == TimelapseOperationStatuses.Failed)
                    {
                        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="tl-final-failed">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
                            <MudText Typo="Typo.h6">Không thể hoàn thiện video.</MudText>
                            @if (!string.IsNullOrWhiteSpace(_job.Workflow.FinalOutput.ErrorMessage))
                            {
                                <MudAlert Severity="Severity.Error" Dense="true">@_job.Workflow.FinalOutput.ErrorMessage</MudAlert>
                            }
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Disabled="@(!_job.Workflow.CanFinalize || _busy)"
                                       OnClick="StartFinalizerAsync">
                                Hoàn thiện lại
                            </MudButton>
                        </MudStack>
                    }
                    else
                    {
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" Color="Color.Warning" />
                            <MudText Typo="Typo.h6">Video hoàn chỉnh chưa được tạo.</MudText>
                        </MudStack>
                    }
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    }
</MudStack>

@code {
    [Parameter] public Guid JobId { get; set; }

    private TimelapseJobView? _job;
    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCts;
    private bool _initialLoading = true;
    private bool _busy;
    private bool _refreshing;
    private string? _refreshError;
    private string? _loadError;
    private int _activeTabIndex;

    private TimelapseImageProgressSummary ImageProgress => TimelapseProgress.CalculateImageProgress(ImageCards);
    private int CompletedVideos => VideoCards.Count(x => x.Status == TimelapseOperationStatuses.Completed);
    private int TotalVideos => VideoCards.Count();
    private IEnumerable<TimelapseStageImage> ImageCards
        => EnsureImageCards().OrderBy(x => x.ProgressPercent);
    private IEnumerable<TimelapseVideoClip> VideoCards
        => EnsureVideoCards();
    private int ImageFailureCount => ImageCards.Count(x => x.Status == TimelapseOperationStatuses.Failed);
    private int VideoFailureCount => VideoCards.Count(x => x.Status == TimelapseOperationStatuses.Failed);
    private bool IsFinalOutputLoading
        => _job?.Workflow.FinalOutput?.Status is TimelapseOperationStatuses.Waiting or TimelapseOperationStatuses.Rendering
           || string.Equals(_job?.Workflow.FinalOutput?.Status, TimelapseParentStatuses.Finalizing, StringComparison.OrdinalIgnoreCase)
           || _job?.Workflow.ParentStatus == TimelapseParentStatuses.Finalizing;
    private string FinalLoadingTitle
        => _job?.Workflow.ParentStatus == TimelapseParentStatuses.Finalizing
            ? "Đang ghép video cuối cùng..."
            : "Đang chờ hoàn thiện kết quả...";
    private string StartButtonLabel => _job?.Workflow.HasActiveOperations == true
        ? "Đang xử lý..."
        : _job?.Workflow.ParentStatus is TimelapseParentStatuses.Paused or TimelapseParentStatuses.Failed
            ? "Tiếp tục tạo video"
            : "Bắt đầu tạo video";

    protected override void OnInitialized()
    {
        AuthState.OnChange += HandleAuthChange;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadInitialAsync();
        RestartPollingIfNeeded();
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthChange;
        _pollCts?.Cancel();
        _pollTimer?.Dispose();
        _pollCts?.Dispose();
    }

    private void HandleAuthChange() => _ = InvokeAsync(async () =>
    {
        if (_job is null)
        {
            await LoadInitialAsync();
        }
        RestartPollingIfNeeded();
        StateHasChanged();
    });

    private async Task LoadInitialAsync()
    {
        _initialLoading = true;
        _refreshError = null;
        _loadError = null;
        try
        {
            if (AuthState.CurrentUser is { IsCustomer: true } customer)
            {
                _job = await Jobs.GetOwnedAsync(JobId, customer);
                if (_job is null)
                {
                    _loadError = "Không tìm thấy job.";
                }
            }
        }
        catch (UnauthorizedAccessException)
        {
            _job = null;
            _loadError = "Bạn không có quyền xem job này.";
        }
        catch (Exception)
        {
            _job = null;
            _loadError = "Không thể tải thông tin job. Vui lòng thử lại.";
        }
        finally
        {
            _initialLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshJobStateAsync()
    {
        if (_refreshing || AuthState.CurrentUser is not { IsCustomer: true } customer)
        {
            return;
        }

        _refreshing = true;
        try
        {
            var latest = await Jobs.GetOwnedAsync(JobId, customer);
            if (latest is not null)
            {
                _job = latest;
                _refreshError = null;
            }
        }
        catch (Exception ex)
        {
            _refreshError = SafeRefreshError(ex);
        }
        finally
        {
            _refreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartOrResumeAsync()
    {
        if (AuthState.CurrentUser is null)
        {
            return;
        }

        await RunActionAsync(async () =>
        {
            _job = await Jobs.StartOrResumeAsync(JobId, AuthState.CurrentUser);
            _activeTabIndex = 1;
        });
    }

    private async Task OpenImagePromptAsync(TimelapseStageImage image)
    {
        if (!CanOpenPrompt(image) || AuthState.CurrentUser is null)
        {
            return;
        }

        var parameters = new DialogParameters<TimelapseImagePromptDialog>
        {
            { x => x.Image, image }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        var dialog = await DialogService.ShowAsync<TimelapseImagePromptDialog>(
            $"Prompt ảnh {image.ProgressPercent}%",
            parameters,
            options);
        var response = await dialog.Result;
        if (response is null || response.Canceled || response.Data is not TimelapseImagePromptDialogResult edit)
        {
            return;
        }

        if (edit.Rerender && !await ConfirmImageRerenderAsync(image.ProgressPercent))
        {
            return;
        }

        await RunActionAsync(async () =>
        {
            _job = await Jobs.UpdateImagePromptAsync(
                JobId,
                image.Id,
                edit.Prompt,
                edit.Rerender,
                AuthState.CurrentUser);
            _activeTabIndex = 1;
            Snackbar.Add(
                edit.Rerender
                    ? "Đã lưu prompt và bắt đầu render lại chuỗi ảnh phụ thuộc."
                    : image.Status == TimelapseOperationStatuses.Completed
                        ? "Đã lưu prompt. Ảnh hiện tại chưa thay đổi. Bấm Render lại để áp dụng prompt mới."
                        : "Đã lưu prompt cho ảnh Timelapse.",
                Severity.Success);
        });
    }

    private async Task RetryImageAsync(TimelapseStageImage image)
    {
        if (AuthState.CurrentUser is null || !await ConfirmImageRerenderAsync(image.ProgressPercent))
        {
            return;
        }

        await RunActionAsync(async () =>
        {
            _job = await Jobs.RetryImageAsync(JobId, image.ProgressPercent, AuthState.CurrentUser);
            _activeTabIndex = 1;
            Snackbar.Add("Đã bắt đầu render lại chuỗi ảnh và video phụ thuộc.", Severity.Success);
        });
    }

    private async Task<bool> ConfirmImageRerenderAsync(int progressPercent)
    {
        if (_job is null)
        {
            return false;
        }

        var impact = TimelapseRerenderImpactPlanner.Plan(_job.Snapshot.SceneCount, progressPercent);
        var parameters = new DialogParameters<TimelapseRerenderConfirmDialog>
        {
            { x => x.Impact, impact }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };
        var dialog = await DialogService.ShowAsync<TimelapseRerenderConfirmDialog>(
            $"Xác nhận render lại ảnh {progressPercent}%",
            parameters,
            options);
        var response = await dialog.Result;
        return response is { Canceled: false, Data: true };
    }

