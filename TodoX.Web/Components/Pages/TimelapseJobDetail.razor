@page "/jobs/timelapse/{JobId:guid}"
@implements IDisposable
@using TodoX.Web.Models.Timelapse
@using TodoX.Web.Services.Timelapse
@inject AuthStateService AuthState
@inject ITimelapseJobService Jobs
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(_job?.Snapshot.Title ?? "Timelapse Job")</PageTitle>

<MudStack Spacing="3" Class="timelapse-job-detail">
    @if (!AuthState.IsInitialized)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (AuthState.CurrentUser is not { IsCustomer: true })
    {
        <MudAlert Severity="Severity.Warning">Vui lòng đăng nhập bằng tài khoản khách hàng.</MudAlert>
    }
    else if (_initialLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (_job is null)
    {
        <MudAlert Severity="Severity.Error">@(_loadError ?? "Không tìm thấy job.")</MudAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_refreshError))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="timelapse-refresh-warning">
                @_refreshError
            </MudAlert>
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/jobs"))" />
            <div>
                <MudText Typo="Typo.h4" Class="todox-page-title">@_job.Snapshot.Title</MudText>
                <MudText Typo="Typo.body1" Class="todox-page-subtitle">@_job.Snapshot.ServiceCode · @_job.Workflow.CurrentStep</MudText>
            </div>
            <MudSpacer />
            <MudChip T="string" Color="@StatusColor(_job.Workflow.ParentStatus)">@_job.Workflow.ParentStatus</MudChip>
        </MudStack>

        <MudPaper Class="todox-card pa-4" rounded="true">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.overline">Ảnh</MudText>
                    <MudText Typo="Typo.h6">@CompletedImages / @TotalImages hoàn thành</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.overline">Video</MudText>
                    <MudText Typo="Typo.h6">@CompletedVideos / @TotalVideos hoàn thành</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.overline">Trạng thái</MudText>
                    <MudText Typo="Typo.h6">@(_job.Workflow.HasActiveOperations ? "Đang xử lý" : "Sẵn sàng")</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudTabs Rounded="true" KeepPanelsAlive="true" @bind-ActivePanelIndex="_activeTabIndex">
            <MudTabPanel Text="YÊU CẦU">
                <MudGrid Class="mt-3">
                    <MudItem xs="12" lg="8">
                        <MudPaper Class="todox-card pa-4" rounded="true">
                            <MudStack Spacing="3">
                                <MudTextField T="string" Label="Tên job" Value="@_job.Snapshot.Title" Variant="Variant.Outlined" Disabled="true" />

                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2">Ảnh thành phẩm / ảnh tham chiếu</MudText>
                                    <div class="timelapse-detail-image">
                                        @if (!string.IsNullOrWhiteSpace(_job.Snapshot.OriginalImage.PublicUrl))
                                        {
                                            <img src="@_job.Snapshot.OriginalImage.PublicUrl" alt="Ảnh tham chiếu Timelapse" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
                                        }
                                    </div>
                                </MudStack>

                                <MudGrid>
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle2">Loại công trình</MudText>
                                        <MudText>@_job.Snapshot.ProfileName</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle2">Số scene</MudText>
                                        <MudText>@_job.Snapshot.SceneCount scene</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle2">Chất lượng</MudText>
                                        <MudText>@TimelapseSellPricing.CustomerQualityLabel(_job.Snapshot.VideoMode)</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle2">Tỷ lệ</MudText>
                                        <MudText>@FormatRatio(_job.Snapshot.Ratio)</MudText>
                                    </MudItem>
                                </MudGrid>

                                @if (!_job.Workflow.CanEditRequest)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        Yêu cầu đang được khóa vì có tác vụ ảnh, video hoặc hoàn thiện video đang chạy.
                                    </MudAlert>
                                }
                            </MudStack>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" lg="4">
                        <MudPaper Class="todox-card pa-4" rounded="true">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.overline">CHI PHÍ DỰ KIẾN</MudText>
                                <div class="price-row"><span>Chất lượng</span><strong>@TimelapseSellPricing.CustomerQualityLabel(_job.Snapshot.VideoMode)</strong></div>
                                <div class="price-row"><span>Số scene</span><strong>@_job.Snapshot.SceneCount</strong></div>
                                <div class="price-row"><span>Ảnh khách tải lên</span><strong>Miễn phí</strong></div>
                                @if (_job.Snapshot.SellPrice is not null)
                                {
                                    <div class="price-row"><span>Đơn giá video</span><strong>@FormatPoints(_job.Snapshot.SellPrice.VideoSceneSellPoints) / scene</strong></div>
                                    <div class="price-row"><span>Video</span><strong>@($"{_job.Snapshot.SellPrice.SceneCount} x {FormatPoints(_job.Snapshot.SellPrice.VideoSceneSellPoints)} = {FormatPoints(_job.Snapshot.SellPrice.VideoSubtotal)}")</strong></div>
                                    <MudDivider />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Ảnh AI trung gian chưa tính trong giai đoạn này. Số ảnh AI dự kiến: @_job.Workflow.GeneratedImageCount.</MudText>
                                    <div class="timelapse-total">
                                        <span>TỔNG DỰ KIẾN</span>
                                        <strong>@FormatPoints(_job.Snapshot.SellPrice.TotalPoints) todoX</strong>
                                    </div>
                                }
                                <MudButton Class="todox-primary-btn"
                                           Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.MovieCreation"
                                           Disabled="@(!_job.Workflow.CanStartRender || _busy)"
                                           OnClick="StartOrResumeAsync">
                                    @StartButtonLabel
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="SCENE">
                <MudStack Spacing="3" Class="mt-3">
                    <MudPaper Class="todox-card pa-4" rounded="true">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Warning" />
                                <MudText Typo="Typo.h6">HÌNH ẢNH</MudText>
                            </MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Tạo theo thứ tự ngược từ ảnh thành phẩm.</MudText>
                            @if (ImageFailureCount > 0 || VideoFailureCount > 0)
                            {
                                <MudAlert Severity="Severity.Error" Dense="true">
                                    Có @ImageFailureCount ảnh lỗi và @VideoFailureCount video lỗi. Bạn có thể render lại tại scene tương ứng.
                                </MudAlert>
                            }
                            <div class="timelapse-stage-grid">
                                @foreach (var image in ImageCards)
                                {
                                    <div class="timelapse-stage-card">
                                        <div class="stage-card-header">
                                            <strong>@image.ProgressPercent%</strong>
                                            <MudChip T="string" Size="Size.Small" Color="@OperationColor(image.Status)">@FormatOperationStatus(image.Status)</MudChip>
                                        </div>
                                        <div class="stage-preview image-preview">
                                            @if (!string.IsNullOrWhiteSpace(image.PublicUrl))
                                            {
                                                <img src="@image.PublicUrl" alt="@($"{image.ProgressPercent}%")" />
                                            }
                                            else if (image.IsOriginal)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
                                                <span>Ảnh thành phẩm chưa sẵn sàng</span>
                                            }
                                            else if (TimelapseOperationStatuses.IsActive(image.Status))
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
                                                <span>Đang tạo ảnh...</span>
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
                                                <span>@ImagePlaceholderText(image)</span>
                                            }
                                        </div>
                                        <MudText Typo="Typo.body2">@(image.IsOriginal ? "Ảnh thành phẩm" : $"Stage {image.ProgressPercent}%")</MudText>
                                        @if (!image.IsOriginal && image.DependsOnProgressPercent.HasValue && image.Status == TimelapseOperationStatuses.Waiting)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Đang chờ ảnh @image.DependsOnProgressPercent% hoàn thành</MudText>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(image.ErrorMessage))
                                        {
                                            <MudAlert Severity="Severity.Error" Dense="true">@image.ErrorMessage</MudAlert>
                                        }
                                        @if (!image.IsOriginal && CanRetry(image.Status))
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_busy" OnClick="@(() => RetryImageAsync(image.ProgressPercent))">
                                                Render lại
                                            </MudButton>
                                        }
                                    </div>
                                }
                            </div>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Class="todox-card pa-4" rounded="true">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Movie" Color="Color.Warning" />
                                <MudText Typo="Typo.h6">VIDEO</MudText>
                            </MudStack>
                            <div class="timelapse-stage-grid">
                                @foreach (var clip in _job.Workflow.Videos)
                                {
                                    <div class="timelapse-stage-card">
                                        <div class="stage-card-header">
                                            <strong>@clip.StartProgressPercent% -> @clip.EndProgressPercent%</strong>
                                            <MudChip T="string" Size="Size.Small" Color="@OperationColor(clip.Status)">@FormatOperationStatus(clip.Status)</MudChip>
                                        </div>
                                        <div class="clip-thumbs">
                                            @RenderImageThumb(clip.StartProgressPercent)
                                            @RenderImageThumb(clip.EndProgressPercent)
                                        </div>
                                        <div class="stage-preview video-preview">
                                            @if (!string.IsNullOrWhiteSpace(clip.PublicUrl))
                                            {
                                                <video src="@clip.PublicUrl" controls playsinline></video>
                                            }
                                            else if (TimelapseOperationStatuses.IsActive(clip.Status))
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" />
                                                <span>Đang tạo video...</span>
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" />
                                                <span>@VideoPlaceholderText(clip)</span>
                                            }
                                        </div>
                                        <MudText Typo="Typo.caption">@TimelapseRequestRules.RuntimeClipDurationSeconds giây · @TimelapseSellPricing.CustomerQualityLabel(_job.Snapshot.VideoMode) · @FormatRatio(_job.Snapshot.Ratio)</MudText>
                                        @if (!string.IsNullOrWhiteSpace(clip.ErrorMessage))
                                        {
                                            <MudAlert Severity="Severity.Error" Dense="true">@clip.ErrorMessage</MudAlert>
                                        }
                                        @if (CanRetry(clip.Status))
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_busy" OnClick="@(() => RetryVideoAsync(clip.ClipIndex))">
                                                Render lại
                                            </MudButton>
                                        }
                                    </div>
                                }
                            </div>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.MovieFilter"
                                       Disabled="@(!_job.Workflow.CanFinalize || _busy)"
                                       OnClick="StartFinalizerAsync">
                                Hoàn thành video
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="KẾT QUẢ">
                <MudPaper Class="todox-card pa-4 mt-3" rounded="true">
                    @if (TimelapseOperationStatuses.IsActive(_job.Workflow.FinalOutput?.Status))
                    {
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.MovieFilter" Size="Size.Large" Color="Color.Warning" />
                            <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                            <MudText>Đang hoàn thiện video...</MudText>
                        </MudStack>
                    }
                    else if (_job.Workflow.FinalOutput?.Status == TimelapseOperationStatuses.Completed && !string.IsNullOrWhiteSpace(_job.Workflow.FinalOutput.PublicUrl))
                    {
                        <MudStack Spacing="2">
                            <video src="@_job.Workflow.FinalOutput.PublicUrl" controls playsinline class="final-video"></video>
                            <MudText Typo="Typo.h6">@_job.Snapshot.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Phiên bản @_job.Workflow.FinalOutput.Version · @_job.Workflow.FinalOutput.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Href="@_job.Workflow.FinalOutput.PublicUrl" Target="_blank">
                                Tải video
                            </MudButton>
                        </MudStack>
                    }
                    else
                    {
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" Color="Color.Warning" />
                            <MudText Typo="Typo.h6">Video hoàn chỉnh chưa được tạo.</MudText>
                        </MudStack>
                    }
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    }
</MudStack>

@code {
    [Parameter] public Guid JobId { get; set; }

    private TimelapseJobView? _job;
    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCts;
    private bool _initialLoading = true;
    private bool _busy;
    private bool _refreshing;
    private string? _refreshError;
    private string? _loadError;
    private int _activeTabIndex;

    private int CompletedImages => ImageCards.Count(x => x.Status == TimelapseOperationStatuses.Completed);
    private int TotalImages => ImageCards.Count();
    private int CompletedVideos => VideoCards.Count(x => x.Status == TimelapseOperationStatuses.Completed);
    private int TotalVideos => VideoCards.Count();
    private IEnumerable<TimelapseStageImage> ImageCards
        => EnsureImageCards().OrderBy(x => x.ProgressPercent);
    private IEnumerable<TimelapseVideoClip> VideoCards
        => EnsureVideoCards();
    private int ImageFailureCount => ImageCards.Count(x => x.Status == TimelapseOperationStatuses.Failed);
    private int VideoFailureCount => VideoCards.Count(x => x.Status == TimelapseOperationStatuses.Failed);
    private string StartButtonLabel => _job?.Workflow.HasActiveOperations == true
        ? "Đang xử lý..."
        : _job?.Workflow.ParentStatus is TimelapseParentStatuses.Paused or TimelapseParentStatuses.Failed
            ? "Tiếp tục tạo video"
            : "Bắt đầu tạo video";

    protected override void OnInitialized()
    {
        AuthState.OnChange += HandleAuthChange;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadInitialAsync();
        RestartPollingIfNeeded();
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthChange;
        _pollCts?.Cancel();
        _pollTimer?.Dispose();
        _pollCts?.Dispose();
    }

    private void HandleAuthChange() => _ = InvokeAsync(async () =>
    {
        if (_job is null)
        {
            await LoadInitialAsync();
        }
        RestartPollingIfNeeded();
        StateHasChanged();
    });

    private async Task LoadInitialAsync()
    {
        _initialLoading = true;
        _refreshError = null;
        _loadError = null;
        try
        {
            if (AuthState.CurrentUser is { IsCustomer: true } customer)
            {
                _job = await Jobs.GetOwnedAsync(JobId, customer);
                if (_job is null)
                {
                    _loadError = "Không tìm thấy job.";
                }
            }
        }
        catch (UnauthorizedAccessException)
        {
            _job = null;
            _loadError = "Bạn không có quyền xem job này.";
        }
        catch (Exception)
        {
            _job = null;
            _loadError = "Không thể tải thông tin job. Vui lòng thử lại.";
        }
        finally
        {
            _initialLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshJobStateAsync()
    {
        if (_refreshing || AuthState.CurrentUser is not { IsCustomer: true } customer)
        {
            return;
        }

        _refreshing = true;
        try
        {
            var latest = await Jobs.GetOwnedAsync(JobId, customer);
            if (latest is not null)
            {
                _job = latest;
                _refreshError = null;
            }
        }
        catch (Exception ex)
        {
            _refreshError = SafeRefreshError(ex);
        }
        finally
        {
            _refreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartOrResumeAsync()
    {
        if (AuthState.CurrentUser is null)
        {
            return;
        }

        await RunActionAsync(async () =>
        {
            _job = await Jobs.StartOrResumeAsync(JobId, AuthState.CurrentUser);
            _activeTabIndex = 1;
        });
    }

    private async Task RetryImageAsync(int progressPercent)
    {
        if (AuthState.CurrentUser is null)
        {
            return;
        }

        await RunActionAsync(async () =>
        {
            _job = await Jobs.RetryImageAsync(JobId, progressPercent, AuthState.CurrentUser);
            _activeTabIndex = 1;
        });
    }

    private async Task RetryVideoAsync(int clipIndex)
    {
        if (AuthState.CurrentUser is null)
        {
            return;
        }

        await RunActionAsync(async () =>
        {
            _job = await Jobs.RetryVideoAsync(JobId, clipIndex, AuthState.CurrentUser);
            _activeTabIndex = 1;
        });
    }

    private async Task StartFinalizerAsync()
    {
        if (AuthState.CurrentUser is null)
        {
            return;
        }

        await RunActionAsync(async () =>
        {
            _job = await Jobs.StartFinalizerAsync(JobId, AuthState.CurrentUser);
            _activeTabIndex = 2;
        });
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
            RestartPollingIfNeeded();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void RestartPollingIfNeeded()
    {
        _pollCts?.Cancel();
        _pollTimer?.Dispose();
        _pollCts?.Dispose();
        _pollCts = null;
        _pollTimer = null;

        if (_job?.Workflow.HasActiveOperations != true)
        {
            return;
        }

        _pollCts = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(4));
        _ = PollAsync(_pollCts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        if (_pollTimer is null)
        {
            return;
        }

        try
        {
            while (await _pollTimer.WaitForNextTickAsync(ct))
            {
                await RefreshJobStateAsync();
                if (_job?.Workflow.HasActiveOperations != true)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private RenderFragment RenderImageThumb(int progress) => builder =>
    {
        var image = ImageCards.FirstOrDefault(x => x.ProgressPercent == progress);
        if (!string.IsNullOrWhiteSpace(image?.PublicUrl))
        {
            builder.OpenElement(0, "img");
            builder.AddAttribute(1, "src", image.PublicUrl);
            builder.AddAttribute(2, "alt", $"{progress}%");
            builder.CloseElement();
            return;
        }

        builder.OpenElement(3, "span");
        builder.AddContent(4, $"{progress}%");
        builder.CloseElement();
    };

    private IReadOnlyList<TimelapseStageImage> EnsureImageCards()
    {
        if (_job is null)
        {
            return Array.Empty<TimelapseStageImage>();
        }

        var current = _job.Workflow.Images.ToDictionary(x => x.ProgressPercent);
        return _job.Snapshot.ProgressMapping
            .Select((progress, index) =>
            {
                if (current.TryGetValue(progress, out var image))
                {
                    return image;
                }

                var isOriginal = progress == 100;
                var dependency = isOriginal
                    ? (int?)null
                    : _job.Snapshot.ProgressMapping.Where(x => x > progress).OrderBy(x => x).FirstOrDefault();
                return new TimelapseStageImage
                {
                    StageIndex = index + 1,
                    ProgressPercent = progress,
                    IsOriginal = isOriginal,
                    DependsOnProgressPercent = dependency,
                    Status = isOriginal ? TimelapseOperationStatuses.Completed : TimelapseOperationStatuses.Waiting,
                    PublicUrl = isOriginal ? _job.Snapshot.OriginalImage.PublicUrl : null,
                    MediaId = isOriginal ? _job.Snapshot.OriginalImage.MediaId : null
                };
            })
            .ToList();
    }

    private IReadOnlyList<TimelapseVideoClip> EnsureVideoCards()
    {
        if (_job is null)
        {
            return Array.Empty<TimelapseVideoClip>();
        }

        var current = _job.Workflow.Videos.ToDictionary(x => x.ClipIndex);
        var graph = TimelapseStageGraphBuilder.Build(_job.Snapshot.SceneCount);
        return graph.VideoClips
            .Select(edge => current.TryGetValue(edge.ClipIndex, out var clip)
                ? clip
                : new TimelapseVideoClip
                {
                    ClipIndex = edge.ClipIndex,
                    StartProgressPercent = edge.StartProgressPercent,
                    EndProgressPercent = edge.EndProgressPercent,
                    Status = TimelapseOperationStatuses.Waiting
                })
            .ToList();
    }

    private static string ImagePlaceholderText(TimelapseStageImage image)
        => image.Status == TimelapseOperationStatuses.Failed
            ? "Lỗi render ảnh"
            : image.DependsOnProgressPercent.HasValue
                ? $"Đang chờ ảnh {image.DependsOnProgressPercent}% hoàn thành"
                : "Đang chờ render...";

    private static string VideoPlaceholderText(TimelapseVideoClip clip)
        => clip.Status == TimelapseOperationStatuses.Failed
            ? "Lỗi render video"
            : "Đang chờ ảnh đầu vào...";

    private static string SafeRefreshError(Exception ex)
        => ex is UnauthorizedAccessException
            ? "Không thể cập nhật trạng thái mới nhất. Hệ thống sẽ thử lại."
            : "Không thể cập nhật trạng thái mới nhất. Hệ thống sẽ thử lại.";

    private static bool CanRetry(string status)
        => status is TimelapseOperationStatuses.Failed or TimelapseOperationStatuses.Completed or TimelapseOperationStatuses.Invalidated;

    private static Color StatusColor(string status)
        => status switch
        {
            TimelapseParentStatuses.Completed => Color.Success,
            TimelapseParentStatuses.Failed => Color.Error,
            TimelapseParentStatuses.GeneratingImages or TimelapseParentStatuses.GeneratingVideos or TimelapseParentStatuses.Finalizing => Color.Warning,
            _ => Color.Default
        };

    private static Color OperationColor(string status)
        => status switch
        {
            TimelapseOperationStatuses.Completed => Color.Success,
            TimelapseOperationStatuses.Failed => Color.Error,
            TimelapseOperationStatuses.Rendering => Color.Warning,
            TimelapseOperationStatuses.Invalidated => Color.Info,
            _ => Color.Default
        };

    private static string FormatOperationStatus(string status)
        => status switch
        {
            TimelapseOperationStatuses.Waiting => "Đang chờ",
            TimelapseOperationStatuses.Rendering => "Đang xử lý",
            TimelapseOperationStatuses.Completed => "Hoàn thành",
            TimelapseOperationStatuses.Failed => "Thất bại",
            TimelapseOperationStatuses.Invalidated => "Cần tạo lại",
            _ => status
        };

    private static string FormatRatio(string ratio)
        => string.Equals(ratio, TimelapseRequestRules.PortraitRatio, StringComparison.OrdinalIgnoreCase)
            ? "9:16"
            : "16:9";

    private static string FormatPoints(decimal value) => $"{value:0.##} điểm";
}
