@page "/services"
@using TodoX.Web.Components.Dialogs
@using TodoX.Web.Models.Catalog
@inject CatalogAdminRepository Catalog
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Quản lý dịch vụ</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-3">
        <div>
            <MudText Typo="Typo.h4" Class="todox-page-title">Quản lý dịch vụ</MudText>
            <MudText Typo="Typo.body1" Class="todox-page-subtitle">Dịch vụ thương mại, ảnh minh họa, engine và giá bán.</MudText>
        </div>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (_services.Count == 0)
    {
        <MudPaper Class="todox-card pa-8" rounded="true">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Large" Class="todox-gold" />
                <MudText Class="todox-page-subtitle">Chưa có dịch vụ nào.</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudGrid Class="todox-service-grid">
            @foreach (var svc in _services)
            {
                <MudItem xs="12" sm="6" md="4" lg="3" xl="3">
                    <MudPaper Class="todox-card todox-service-card" rounded="true">
                        <div class="todox-service-media">
                            @if (!string.IsNullOrWhiteSpace(ImageUrl(svc)))
                            {
                                <img src="@ImageUrl(svc)" alt="@svc.ServiceName" />
                            }
                            else
                            {
                                <div class="todox-service-media-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" Class="todox-gold" />
                                </div>
                            }

                            <MudChip T="string" Size="Size.Small" Class="todox-service-status"
                                     Color="@(TodoXServiceStatuses.IsActive(svc.Status) ? Color.Success : Color.Default)">
                                @TodoXServiceStatuses.LabelFor(svc.Status)
                            </MudChip>
                        </div>

                        <div class="todox-service-body">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h6" Class="todox-service-title">@svc.ServiceName</MudText>
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="gap-2">
                                    <span class="todox-badge">@TodoXServiceEngineTypes.LabelFor(svc.ServiceType)</span>
                                    <span class="todox-badge">#@svc.SortOrder</span>
                                </MudStack>
                                <MudText Typo="Typo.body2" Class="todox-page-subtitle todox-service-desc">
                                    @(svc.ShortDescription ?? svc.Description ?? "")
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @PriceSummary(svc)
                                </MudText>
                            </MudStack>

                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-4">
                                <div class="todox-service-actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Sell" Size="Size.Small" title="Giá bán" OnClick="@(() => OpenSellPrices(svc))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Tune" Size="Size.Small" title="Point rates" OnClick="@(() => OpenPointRates(svc))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Sửa" OnClick="@(() => OpenEdit(svc))" />
                                </div>
                            </MudStack>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudStack>

@code {
    private bool _loading = true;
    private IReadOnlyList<ServiceDto> _services = new List<ServiceDto>();
    private IReadOnlyList<ServiceCategoryDto> _categories = new List<ServiceCategoryDto>();

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _loading = true;
        _categories = await Catalog.GetCategoriesAsync();
        _services = SortServices(await Catalog.GetServicesAsync());
        _loading = false;
    }

    private static IReadOnlyList<ServiceDto> SortServices(IEnumerable<ServiceDto> services)
        => services
            .OrderBy(x => x.SortOrder)
            .ThenBy(x => x.ServiceName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.ServiceCode, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private static string? ImageUrl(ServiceDto s)
        => !string.IsNullOrWhiteSpace(s.ThumbnailUrl) ? s.ThumbnailUrl : s.CoverImageUrl;

    private static string PriceSummary(ServiceDto svc)
    {
        if (svc.MinSellPoints is null)
        {
            return "Chưa có giá bán";
        }

        return $"Từ {svc.MinSellPoints:0} điểm";
    }

    private async Task OpenEdit(ServiceDto svc)
    {
        var parameters = new DialogParameters<ServiceDialog>
        {
            { x => x.Source, svc },
            { x => x.Categories, _categories }
        };
        var dialog = await DialogService.ShowAsync<ServiceDialog>("Chỉnh sửa dịch vụ", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is ServiceDto model)
        {
            await Catalog.UpdateServiceAsync(model);
            Snackbar.Add("Đã cập nhật dịch vụ.", Severity.Success);
            await Reload();
        }
    }

    private async Task OpenSellPrices(ServiceDto svc)
    {
        var parameters = new DialogParameters<ServiceSellPricesDialog>
        {
            { x => x.Service, svc }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<ServiceSellPricesDialog>($"Giá bán · {svc.ServiceName}", parameters, options);
        await Reload();
    }

    private async Task OpenPointRates(ServiceDto svc)
    {
        var parameters = new DialogParameters<ServicePointRatesDialog>
        {
            { x => x.Service, svc }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<ServicePointRatesDialog>($"Point rates · {svc.ServiceName}", parameters, options);
        await Reload();
    }
}
