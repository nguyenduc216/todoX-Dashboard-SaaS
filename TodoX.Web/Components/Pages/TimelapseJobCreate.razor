@page "/jobs/timelapse/new"
@implements IDisposable
@using Microsoft.AspNetCore.Components.Forms
@using TodoX.Web.Models.Catalog
@using TodoX.Web.Models.Timelapse
@using TodoX.Web.Services.Timelapse
@using Microsoft.AspNetCore.WebUtilities
@inject AuthStateService AuthState
@inject CatalogRepository Catalog
@inject IServiceSellPriceResolver SellPrices
@inject ITimelapseProfileRepository Profiles
@inject ITimelapseJobService Jobs
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@PageHeading</PageTitle>

<MudStack Spacing="3" Class="timelapse-create-page">
    @if (!AuthState.IsInitialized)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (AuthState.CurrentUser is not { IsCustomer: true })
    {
        <MudAlert Severity="Severity.Warning">Vui lòng đăng nhập bằng tài khoản khách hàng.</MudAlert>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="@(() => Navigation.NavigateTo("/create"))" />
            <div>
                <MudText Typo="Typo.h4" Class="todox-page-title">@PageHeading</MudText>
                <MudText Typo="Typo.body1" Class="todox-page-subtitle">@PageSubtitle</MudText>
            </div>
        </MudStack>

        @if (_loadingService)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
        }
        else if (!string.IsNullOrWhiteSpace(_serviceWarning))
        {
            <MudAlert Severity="Severity.Warning">
                <MudStack Spacing="2">
                    <MudText>@_serviceWarning</MudText>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Navigation.NavigateTo("/create"))">
                        Quay lại danh sách dịch vụ
                    </MudButton>
                </MudStack>
            </MudAlert>
        }
        else
        {
            <MudGrid Class="timelapse-create-grid">
                <MudItem xs="12" lg="8">
                    <MudPaper Class="todox-card timelapse-form-card pa-4" rounded="true">
                        <MudStack Spacing="3">
                            <MudTextField T="string" Label="Tên job" @bind-Value="_request.Title" @bind-Value:after="ScheduleAutoSave" Variant="Variant.Outlined" />

                            @if (_serviceDefinition is not null)
                            {
                                <MudGrid>
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle2">Dịch vụ</MudText>
                                        <MudText>@_serviceDefinition.DisplayName</MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle2">Loại công trình</MudText>
                                        <MudText>@_serviceDefinition.CategoryLabel</MudText>
                                    </MudItem>
                                </MudGrid>
                            }

                            <MudGrid>
                                <MudItem xs="12" md="6">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2">Ảnh ban đầu / 0% - Không bắt buộc</MudText>
                                <label class="timelapse-upload-card @(_selectedStartFile is not null ? "has-file" : string.Empty)">
                                    <InputFile OnChange="OnStartImageSelected" accept="image/png,image/jpeg,image/webp" disabled="@_busy" />
                                    @if (!string.IsNullOrWhiteSpace(_startPreviewDataUrl))
                                    {
                                        <img src="@_startPreviewDataUrl" alt="Ảnh ban đầu đã chọn" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" />
                                    }
                                    <span class="upload-primary">Chọn ảnh ban đầu</span>
                                    <span class="upload-secondary">Không bắt buộc</span>
                                    <span class="upload-helper">Nếu có ảnh ban đầu, todoX sẽ giữ trạng thái này làm mốc khởi đầu và tạo quá trình tiến triển tới ảnh thành phẩm.</span>
                                </label>
                                @if (_selectedStartFile is not null)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                                        <MudText Typo="Typo.caption" Color="Color.Success">@_selectedStartFile.Name</MudText>
                                        <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="RemoveStartImage">
                                            Xóa ảnh
                                        </MudButton>
                                    </MudStack>
                                }
                            </MudStack>
                                </MudItem>
                                <MudItem xs="12" md="6">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2">Ảnh thành phẩm / 100% - Bắt buộc</MudText>
                                <label class="timelapse-upload-card @(_selectedFile is not null ? "has-file" : string.Empty)">
                                    <InputFile OnChange="OnFinalImageSelected" accept="image/png,image/jpeg,image/webp" disabled="@_busy" />
                                    @if (!string.IsNullOrWhiteSpace(_previewDataUrl))
                                    {
                                        <img src="@_previewDataUrl" alt="Ảnh đã chọn" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" />
                                    }
                                    <span class="upload-primary">Chọn ảnh thành phẩm</span>
                                    <span class="upload-secondary">Bấm để tải ảnh lên</span>
                                    <span class="upload-helper">JPG, PNG hoặc WebP · tối đa 10MB. Ảnh thành phẩm là mốc kết thúc bắt buộc của video Timelapse.</span>
                                </label>
                                @if (_selectedFile is not null)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-2">
                                        <MudText Typo="Typo.caption" Color="Color.Success">@_selectedFile.Name</MudText>
                                        <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="RemoveImage">
                                            Xóa ảnh
                                        </MudButton>
                                    </MudStack>
                                }
                            </MudStack>
                                </MudItem>
                            </MudGrid>

                            @if (_profiles.Count == 1)
                            {
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2">Cấu hình dựng</MudText>
                                    <MudText>@_profiles[0].ProfileName</MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudSelect T="string" Label="Cấu hình dựng" @bind-Value="_request.ProfileCode" @bind-Value:after="ScheduleAutoSave" Variant="Variant.Outlined" Required="true">
                                    @foreach (var profile in _profiles)
                                    {
                                        <MudSelectItem T="string" Value="@profile.ProfileCode">@profile.ProfileName</MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2">Số scene</MudText>
                                <div class="timelapse-option-grid scene-options">
                                    @foreach (var count in TimelapseRequestRules.AllowedSceneCounts)
                                    {
                                        <button type="button" class="timelapse-option @(IsSceneSelected(count) ? "selected" : string.Empty)" @onclick="() => SelectSceneCount(count)">
                                            <strong>@count scene</strong>
                                        </button>
                                    }
                                </div>
                            </MudStack>

                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2">Chất lượng</MudText>
                                <div class="timelapse-option-grid quality-options">
                                    <button type="button" class="timelapse-option @(IsModeSelected(TimelapseRequestRules.FastMode) ? "selected" : string.Empty)" @onclick="() => SelectMode(TimelapseRequestRules.FastMode)">
                                        <strong>TIÊU CHUẨN</strong>
                                        <span>Tối ưu chi phí, tốc độ xử lý nhanh</span>
                                    </button>
                                    <button type="button" class="timelapse-option @(IsModeSelected(TimelapseRequestRules.ProfessionalMode) ? "selected" : string.Empty)" @onclick="() => SelectMode(TimelapseRequestRules.ProfessionalMode)">
                                        <strong>CAO CẤP</strong>
                                        <span>Chất lượng xử lý cao hơn</span>
                                    </button>
                                </div>
                            </MudStack>

                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2">Tỷ lệ</MudText>
                                <div class="timelapse-option-grid ratio-options">
                                    <button type="button" class="timelapse-option @(IsRatioSelected(TimelapseRequestRules.LandscapeRatio) ? "selected" : string.Empty)" @onclick="() => SelectRatio(TimelapseRequestRules.LandscapeRatio)">
                                        <strong>16:9</strong>
                                        <span>Ngang</span>
                                    </button>
                                    <button type="button" class="timelapse-option @(IsRatioSelected(TimelapseRequestRules.PortraitRatio) ? "selected" : string.Empty)" @onclick="() => SelectRatio(TimelapseRequestRules.PortraitRatio)">
                                        <strong>9:16</strong>
                                        <span>Dọc</span>
                                    </button>
                                </div>
                            </MudStack>
                            <MudSwitch T="bool" Color="Color.Warning" @bind-Value="_request.AutoFinish" @bind-Value:after="ScheduleAutoSave">
                                Tự động hoàn thành
                            </MudSwitch>
                            <MudText Typo="Typo.caption" Class="timelapse-auto-finish-help">
                                Hệ thống sẽ tự động tạo ảnh trung gian, tạo các video scene và ghép video hoàn chỉnh khi dữ liệu sẵn sàng.
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(_saveStatus))
                            {
                                <MudText Typo="Typo.caption" Color="@(_saveError is null ? Color.Secondary : Color.Error)">@_saveStatus</MudText>
                            }

                            @if (_profiles.Count == 0)
                            {
                                <MudAlert Severity="Severity.Warning">Không tải được profile Timelapse từ hệ thống workflow.</MudAlert>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" lg="4">
                    <MudPaper Class="todox-card timelapse-price-card pa-4" rounded="true">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.overline">CHI PHÍ DỰ KIẾN</MudText>
                            <div class="price-row"><span>Chất lượng</span><strong>@TimelapseSellPricing.CustomerQualityLabel(_request.VideoMode)</strong></div>
                            <div class="price-row"><span>Số scene</span><strong>@_request.SceneCount</strong></div>
                            <div class="price-row"><span>Ảnh khách tải lên</span><strong>Miễn phí</strong></div>

                            @if (_priceLoading)
                            {
                                <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                            }
                            else if (_priceEstimate?.Success == true && _priceEstimate.VideoScenePrice is not null)
                            {
                                <div class="price-row"><span>Đơn giá video</span><strong>@FormatPoints(_priceEstimate.VideoScenePrice.SellPoints) / scene</strong></div>
                                <div class="price-row"><span>Video</span><strong>@($"{_request.SceneCount} x {FormatPoints(_priceEstimate.VideoScenePrice.SellPoints)} = {FormatPoints(_priceEstimate.VideoSubtotal)}")</strong></div>
                                <MudDivider />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Ảnh AI trung gian chưa tính trong phase UI này.</MudText>
                                <div class="timelapse-total">
                                    <span>TỔNG DỰ KIẾN</span>
                                    <strong>@FormatPoints(_priceEstimate.TotalPoints) todoX</strong>
                                </div>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">@PriceMessage</MudAlert>
                            }

                            <MudButton Class="todox-primary-btn"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.MovieCreation"
                                       Disabled="@SubmitDisabled"
                                       OnClick="CreateDraftAsync">
                                Bắt đầu tạo video
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    }
</MudStack>

@code {
    private const long MaxImageBytes = 10 * 1024 * 1024;
    private static readonly HashSet<string> AllowedImageContentTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/jpeg",
        "image/png",
        "image/webp"
    };

    private TimelapseCreateRequest _request = new();
    private IReadOnlyList<TimelapseProfileDto> _profiles = Array.Empty<TimelapseProfileDto>();
    private CatalogServiceView? _selectedService;
    private TimelapseServiceDefinition? _serviceDefinition;
    private ServiceSellPriceEstimate? _priceEstimate;
    private IBrowserFile? _selectedFile;
    private IBrowserFile? _selectedStartFile;
    private string? _previewDataUrl;
    private string? _startPreviewDataUrl;
    private bool _removeStartImage;
    private string? _serviceWarning;
    private string? _priceError;
    private bool _busy;
    private bool _loadingService = true;
    private bool _priceLoading;
    private int _priceLoadVersion;
    private Guid? _draftJobId;
    private CancellationTokenSource? _autoSaveCts;
    private readonly SemaphoreSlim _autoSaveGate = new(1, 1);
    private string? _saveStatus;
    private string? _saveError;

    private string PageHeading => _selectedService?.DisplayName ?? "Tạo video Timelapse AI";
    private string PageSubtitle => _selectedService is null
        ? "Tạo video Timelapse AI từ ảnh thành phẩm."
        : "Tạo video Timelapse AI từ ảnh thành phẩm.";
    private string PriceMessage => _priceError ?? _priceEstimate?.Message ?? "Chưa cấu hình giá cho lựa chọn này.";
    private bool HasValidImage => _selectedFile is not null && ValidateSelectedImage(showSnackbar: false);
    private bool HasValidPrice => _priceEstimate is { Success: true, VideoScenePrice: not null };
    private bool ServiceReady => _selectedService is { Enabled: true } && string.Equals(_selectedService.ServiceType, TodoXServiceEngineTypes.Timelapse, StringComparison.OrdinalIgnoreCase);
    private bool CanStartWorkflow
        => AuthState.CurrentUser is { IsCustomer: true }
           && !_priceLoading
           && ServiceReady
           && HasValidPrice
           && TimelapseRequestRules.Validate(_request, HasValidImage).Count == 0;
    private bool SubmitDisabled => _busy || !CanStartWorkflow;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthChange;
        ApplySelectedServiceFromQuery();
        await LoadPageAsync();
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthChange;
        _autoSaveCts?.Cancel();
        _autoSaveCts?.Dispose();
        _autoSaveGate.Dispose();
    }

    private void HandleAuthChange() => _ = InvokeAsync(async () =>
    {
        await LoadPageAsync();
        StateHasChanged();
    });

    private async Task LoadPageAsync()
    {
        _serviceWarning = null;
        _selectedService = null;
        _serviceDefinition = null;
        _priceEstimate = null;
        _priceError = null;
        _loadingService = true;

        if (AuthState.CurrentUser is not { IsCustomer: true })
        {
            _loadingService = false;
            return;
        }

        try
        {
            await LoadSelectedServiceAsync();
            ApplyServiceDefaults();
            await LoadProfilesAsync();
            await RefreshPriceEstimateAsync();
        }
        finally
        {
            _loadingService = false;
            ScheduleAutoSave();
        }
    }

    private async Task LoadSelectedServiceAsync()
    {
        if (!_request.ServiceId.HasValue || _request.ServiceId.Value == Guid.Empty)
        {
            _serviceWarning = "Vui lòng chọn dịch vụ từ danh sách trước khi tạo video.";
            return;
        }

        var service = await Catalog.GetServiceByIdAsync(_request.ServiceId.Value);
        if (service is null)
        {
            _serviceWarning = "Không tìm thấy dịch vụ đã chọn.";
            return;
        }

        _request.ServiceCode = service.ServiceCode;
        _selectedService = service;
        if (!TimelapseServiceCatalog.TryGet(service.ServiceCode, out var definition))
        {
            _serviceWarning = "Dịch vụ Timelapse đã chọn chưa được cấu hình loại công trình.";
            return;
        }

        _serviceDefinition = definition;
        _request.ServiceCategory = definition.Category;

        if (!service.Enabled)
        {
            _serviceWarning = "Dịch vụ này đang tạm ngưng, vui lòng chọn dịch vụ khác.";
            return;
        }

        if (!string.Equals(service.ServiceType, TodoXServiceEngineTypes.Timelapse, StringComparison.OrdinalIgnoreCase))
        {
            _serviceWarning = "Dịch vụ đã chọn không thuộc nhóm Timelapse.";
        }
    }

    private async Task LoadProfilesAsync()
    {
        _profiles = Array.Empty<TimelapseProfileDto>();
        if (AuthState.CurrentUser is not { IsCustomer: true })
        {
            return;
        }

        try
        {
            if (_serviceDefinition is null)
            {
                return;
            }

            _profiles = await Profiles.GetEnabledProfilesByCategoryAsync(_serviceDefinition.Category);
            if (string.IsNullOrWhiteSpace(_request.ProfileCode))
            {
                _request.ProfileCode = _profiles.FirstOrDefault()?.ProfileCode ?? string.Empty;
            }
            else if (!_profiles.Any(x => string.Equals(x.ProfileCode, _request.ProfileCode, StringComparison.OrdinalIgnoreCase)))
            {
                _request.ProfileCode = _profiles.FirstOrDefault()?.ProfileCode ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không tải được profile Timelapse: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnFinalImageSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
        _previewDataUrl = null;

        if (!ValidateSelectedImage(showSnackbar: true))
        {
            _selectedFile = null;
            return;
        }

        await using var stream = _selectedFile!.OpenReadStream(MaxImageBytes);
        await using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        _previewDataUrl = $"data:{_selectedFile.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
        ScheduleAutoSave();
    }

    private async Task OnStartImageSelected(InputFileChangeEventArgs args)
    {
        _selectedStartFile = args.File;
        _startPreviewDataUrl = null;
        _removeStartImage = false;

        if (!ValidateSelectedStartImage(showSnackbar: true))
        {
            _selectedStartFile = null;
            return;
        }

        await using var stream = _selectedStartFile!.OpenReadStream(MaxImageBytes);
        await using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        _startPreviewDataUrl = $"data:{_selectedStartFile.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
        ScheduleAutoSave();
    }

    private bool ValidateSelectedImage(bool showSnackbar)
    {
        if (_selectedFile is null)
        {
            return false;
        }

        if (_selectedFile.Size <= 0 || _selectedFile.Size > MaxImageBytes)
        {
            if (showSnackbar)
            {
                Snackbar.Add("Ảnh phải có dung lượng tối đa 10MB.", Severity.Warning);
            }
            return false;
        }

        if (!AllowedImageContentTypes.Contains(_selectedFile.ContentType))
        {
            if (showSnackbar)
            {
                Snackbar.Add("Chỉ hỗ trợ JPG, PNG hoặc WebP.", Severity.Warning);
            }
            return false;
        }

        return true;
    }

    private bool ValidateSelectedStartImage(bool showSnackbar)
    {
        if (_selectedStartFile is null)
        {
            return true;
        }

        if (_selectedStartFile.Size <= 0 || _selectedStartFile.Size > MaxImageBytes)
        {
            if (showSnackbar)
            {
                Snackbar.Add("Ảnh phải có dung lượng tối đa 10MB.", Severity.Warning);
            }
            return false;
        }

        if (!AllowedImageContentTypes.Contains(_selectedStartFile.ContentType))
        {
            if (showSnackbar)
            {
                Snackbar.Add("Chỉ hỗ trợ JPG, PNG hoặc WebP.", Severity.Warning);
            }
            return false;
        }

        return true;
    }

    private void RemoveImage()
    {
        _selectedFile = null;
        _previewDataUrl = null;
        ScheduleAutoSave();
    }

    private void RemoveStartImage()
    {
        _selectedStartFile = null;
        _startPreviewDataUrl = null;
        _removeStartImage = true;
        ScheduleAutoSave();
    }

    private void ApplySelectedServiceFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("serviceId", out var serviceIdValues)
            && Guid.TryParse(serviceIdValues.FirstOrDefault(), out var serviceId))
        {
            _request.ServiceId = serviceId;
        }

        if (query.TryGetValue("serviceCode", out var serviceCodeValues))
        {
            _request.ServiceCode = serviceCodeValues.FirstOrDefault();
        }
    }

    private async Task SelectSceneCount(int sceneCount)
    {
        _request.SceneCount = sceneCount;
        await RefreshPriceEstimateAsync();
        ScheduleAutoSave();
    }

    private async Task SelectMode(string mode)
    {
        _request.VideoMode = mode;
        await RefreshPriceEstimateAsync();
        ScheduleAutoSave();
    }

    private void SelectRatio(string ratio)
    {
        _request.Ratio = ratio;
        ScheduleAutoSave();
    }

    private bool IsSceneSelected(int sceneCount) => _request.SceneCount == sceneCount;

    private bool IsModeSelected(string mode) => string.Equals(_request.VideoMode, mode, StringComparison.OrdinalIgnoreCase);

    private bool IsRatioSelected(string ratio) => string.Equals(_request.Ratio, ratio, StringComparison.OrdinalIgnoreCase);

    private void ApplyServiceDefaults()
    {
        if (_selectedService is null)
        {
            return;
        }

        var defaults = ServiceJobDefaultsCodec.FromJson(_selectedService.JobDefaultsJson);
        if (!string.IsNullOrWhiteSpace(defaults.ProfileCode))
        {
            _request.ProfileCode = defaults.ProfileCode.Trim();
        }
        if (defaults.SceneCount is > 0)
        {
            _request.SceneCount = defaults.SceneCount.Value;
        }
        if (TimelapseRequestRules.IsSupportedMode(defaults.VideoMode))
        {
            _request.VideoMode = defaults.VideoMode!;
        }
        if (TimelapseRequestRules.IsSupportedRatio(defaults.Ratio))
        {
            _request.Ratio = defaults.Ratio!;
        }
        if (defaults.AutoFinish.HasValue)
        {
            _request.AutoFinish = defaults.AutoFinish.Value;
        }
    }

    private async Task RefreshPriceEstimateAsync()
    {
        var version = ++_priceLoadVersion;
        _priceError = null;
        _priceEstimate = null;

        if (_selectedService is null || !ServiceReady)
        {
            return;
        }

        _priceLoading = true;
        try
        {
            var estimate = await SellPrices.EstimateAsync(new ServiceSellPriceEstimateRequest(
                _selectedService.Id,
                TimelapseSellPricing.QualityTierForMode(_request.VideoMode),
                TimelapseRequestRules.RuntimeClipDurationSeconds,
                _request.SceneCount,
                ImageCount: 0));

            if (version == _priceLoadVersion)
            {
                _priceEstimate = estimate;
            }
        }
        catch (Exception ex)
        {
            if (version == _priceLoadVersion)
            {
                _priceError = "Không tải được giá cho lựa chọn này.";
                Snackbar.Add($"Không tải được giá Timelapse: {ex.Message}", Severity.Error);
            }
        }
        finally
        {
            if (version == _priceLoadVersion)
            {
                _priceLoading = false;
            }
        }
    }

    private async Task CreateDraftAsync()
    {
        if (!CanStartWorkflow)
        {
            Snackbar.Add(FirstWorkflowReadinessError(), Severity.Warning);
            return;
        }

        if (AuthState.CurrentUser is not { IsCustomer: true } user)
        {
            Snackbar.Add("Vui lòng đăng nhập bằng tài khoản khách hàng.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var job = await EnsureDraftSavedAsync(CancellationToken.None);

            if (_request.AutoFinish)
            {
                job = await Jobs.StartOrResumeAsync(job.Id, user);
            }
            Navigation.NavigateTo($"/jobs/timelapse/{job.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ScheduleAutoSave()
    {
        if (!CanAutoSave)
        {
            return;
        }

        _autoSaveCts?.Cancel();
        _autoSaveCts?.Dispose();
        _autoSaveCts = new CancellationTokenSource();
        var token = _autoSaveCts.Token;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(700, token);
                await EnsureDraftSavedAsync(token);
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested)
            {
            }
            catch (Exception ex)
            {
                _saveError = ex.Message;
                _saveStatus = "Không thể tự lưu bản nháp. Vui lòng thử lại.";
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private bool CanAutoSave
        => AuthState.CurrentUser is { IsCustomer: true }
           && CanStartWorkflow;

    private async Task<TimelapseJobView> EnsureDraftSavedAsync(CancellationToken ct)
    {
        if (!CanAutoSave || AuthState.CurrentUser is not { IsCustomer: true } user || _selectedFile is null)
        {
            throw new InvalidOperationException("Vui lòng hoàn tất các thông tin bắt buộc trước khi lưu.");
        }

        await _autoSaveGate.WaitAsync(ct);
        try
        {
            _saveError = null;
            _saveStatus = "Đang lưu...";
            await InvokeAsync(StateHasChanged);

            await using var stream = _selectedFile.OpenReadStream(MaxImageBytes);
            await using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer, ct);
            byte[]? startBytes = null;
            if (_selectedStartFile is not null)
            {
                await using var startStream = _selectedStartFile.OpenReadStream(MaxImageBytes);
                await using var startBuffer = new MemoryStream();
                await startStream.CopyToAsync(startBuffer, ct);
                startBytes = startBuffer.ToArray();
            }

            TimelapseJobView job;
            if (_draftJobId is Guid draftId)
            {
                job = await Jobs.UpdateDraftAsync(
                    draftId,
                    _request,
                    buffer.ToArray(),
                    _selectedFile.Name,
                    _selectedFile.ContentType,
                    user,
                    startBytes,
                    _selectedStartFile?.Name,
                    _selectedStartFile?.ContentType,
                    removeStartImage: _removeStartImage,
                    ct);
            }
            else
            {
                job = await Jobs.CreateDraftAsync(
                    _request,
                    buffer.ToArray(),
                    _selectedFile.Name,
                    _selectedFile.ContentType,
                    user,
                    startBytes,
                    _selectedStartFile?.Name,
                    _selectedStartFile?.ContentType,
                    ct);
                _draftJobId = job.Id;
            }

            _saveStatus = "Đã lưu bản nháp";
            await InvokeAsync(StateHasChanged);
            return job;
        }
        catch (Exception ex)
        {
            _saveError = ex.Message;
            _saveStatus = "Không thể tự lưu bản nháp. Vui lòng thử lại.";
            await InvokeAsync(StateHasChanged);
            throw;
        }
        finally
        {
            _autoSaveGate.Release();
        }
    }

    private static string FormatPoints(decimal value) => $"{value:0.##} điểm";

    private string FirstWorkflowReadinessError()
    {
        if (!ServiceReady)
        {
            return _serviceWarning ?? "Dịch vụ Timelapse hiện chưa khả dụng.";
        }

        if (!HasValidPrice)
        {
            return PriceMessage;
        }

        return TimelapseRequestRules.Validate(_request, ValidateSelectedImage(showSnackbar: true)).FirstOrDefault()
            ?? "Vui lòng hoàn tất các thông tin bắt buộc trước khi tạo video.";
    }
}
