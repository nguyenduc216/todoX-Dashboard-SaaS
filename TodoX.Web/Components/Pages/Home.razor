@page "/"
@inject AuthStateService AuthState

<PageTitle>TodoX SaaS Dashboard</PageTitle>

@switch (ShellMode)
{
    case HomeShellMode.Loading:
        <MudPaper Class="todox-card pa-6 d-flex flex-column align-items-center" Elevation="1">
            <MudProgressCircular Indeterminate="true" Color="Color.Warning" />
            <MudText Class="mt-3">Đang tải trang chủ...</MudText>
        </MudPaper>
        break;
    case HomeShellMode.SignIn:
        <MudAlert Severity="Severity.Info">
            Vui lòng đăng nhập để xem dashboard.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Href="/login" StartIcon="@Icons.Material.Filled.Login">
            Đăng nhập
        </MudButton>
        break;
    case HomeShellMode.Customer:
        <CustomerDashboard />
        break;
    default:
        <AdminDashboard />
        break;
}

@code {
    private HomeShellMode ShellMode => HomePageState.Resolve(AuthState.CurrentUser, AuthState.IsInitialized);
}
