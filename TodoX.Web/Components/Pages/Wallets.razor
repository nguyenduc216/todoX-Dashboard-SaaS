@page "/wallets"
@inject AuthStateService AuthState
@inject BillingRepository Billing
@inject WalletService WalletService
@inject ISnackbar Snackbar

<PageTitle>Quản lý điểm</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4" Class="todox-page-title">Points & Wallets</MudText>
        <MudText Typo="Typo.body1" Class="todox-page-subtitle">Điểm khả dụng, cấu hình giá và voucher.</MudText>
    </div>

    <MudTabs Rounded="true" Class="pt-4">
        @if (!IsCustomer)
        {
        <MudTabPanel Text="POINT CONFIGURATION">
            <MudPaper Class="pa-4 mb-4">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="3">
                        <MudSelect T="string" @bind-Value="_rateResource" Label="Resource">
                            <MudSelectItem Value="@("image")">Image</MudSelectItem>
                            <MudSelectItem Value="@("video")">Video</MudSelectItem>
                            <MudSelectItem Value="@("voice")">Voice</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudSelect T="string" @bind-Value="_rateQuality" Label="Quality">
                            <MudSelectItem Value="@("standard")">Standard</MudSelectItem>
                            <MudSelectItem Value="@("premium")">Premium</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="decimal" @bind-Value="_rateValue" Label="Rate" Min="0" />
                    </MudItem>
                    <MudItem xs="12" sm="3" Class="d-flex align-end">
                        <MudButton StartIcon="@Icons.Material.Filled.Save" OnClick="SaveRateAsync">Save rate</MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
            <MudTable Items="_rates" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Resource</MudTh>
                    <MudTh>Quality</MudTh>
                    <MudTh>Rate</MudTh>
                    <MudTh>Unit</MudTh>
                    <MudTh>Source</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ResourceType</MudTd>
                    <MudTd>@context.QualityTier</MudTd>
                    <MudTd>@context.Rate.ToString("#,0.##")</MudTd>
                    <MudTd>@context.Unit</MudTd>
                    <MudTd>@(context.IsActive ? "active" : "inactive")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
        }

        <MudTabPanel Text="CUSTOMER WALLETS">
            @if (!IsCustomer)
            {
                <MudPaper Class="pa-4 mb-4">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="4">
                            <MudSelect T="Guid?" @bind-Value="_selectedCustomerId" Label="Customer">
                                @foreach (var wallet in _wallets)
                                {
                                    <MudSelectItem T="Guid?" Value="@wallet.CustomerId">@wallet.CustomerName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal" @bind-Value="_mutationAmount" Label="Points" Min="1" />
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudTextField @bind-Value="_mutationNote" Label="Note" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudStack Row="true" Spacing="2" Class="flex-wrap">
                                <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="TopUpAsync">Top-up</MudButton>
                                <MudButton StartIcon="@Icons.Material.Filled.AddCircle" OnClick="AdjustPlusAsync">Adjust plus</MudButton>
                                <MudButton StartIcon="@Icons.Material.Filled.RemoveCircle" OnClick="AdjustMinusAsync">Adjust minus</MudButton>
                                <MudButton StartIcon="@Icons.Material.Filled.Replay" OnClick="RefundAsync">Refund</MudButton>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h6">Redeem voucher</MudText>
                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    <MudTextField @bind-Value="_redeemCode" Label="Voucher code" />
                    <MudButton StartIcon="@Icons.Material.Filled.Redeem" OnClick="RedeemVoucherAsync">Redeem</MudButton>
                </MudStack>
            </MudPaper>
            <MudTable Items="_wallets" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Customer</MudTh>
                    <MudTh Style="text-align:right">Usable</MudTh>
                    <MudTh Style="text-align:right">Locked</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.CustomerName</MudTd>
                    <MudTd Style="text-align:right">@context.Balance.ToString("#,0")</MudTd>
                    <MudTd Style="text-align:right">@context.LockedBalance.ToString("#,0")</MudTd>
                    <MudTd>@context.Status</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="POINT HISTORY">
            <MudTable Items="_transactions" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Time</MudTh>
                    <MudTh>Customer</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh Style="text-align:right">Amount</MudTh>
                    <MudTh Style="text-align:right">After</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.CreatedAt.ToString("dd/MM HH:mm")</MudTd>
                    <MudTd>@context.CustomerName</MudTd>
                    <MudTd>@context.TransactionType</MudTd>
                    <MudTd Style="text-align:right">@context.Amount.ToString("#,0")</MudTd>
                    <MudTd Style="text-align:right">@context.BalanceAfter.ToString("#,0")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        @if (!IsCustomer)
        {
        <MudTabPanel Text="VOUCHERS">
            <MudGrid>
                <MudItem xs="12" md="5">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Create voucher</MudText>
                        <MudTextField @bind-Value="_voucherCode" Label="Code" />
                        <MudNumericField T="decimal" @bind-Value="_voucherPoints" Label="Points" Min="1" />
                        <MudNumericField T="int?" @bind-Value="_voucherMaxRedemptions" Label="Max redemptions" />
                        <MudButton Class="mt-3" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateVoucherAsync">Create</MudButton>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="7">
                    <MudTable Items="_vouchers" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Code</MudTh>
                            <MudTh>Points</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Redeemed</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.VoucherCode</MudTd>
                            <MudTd>@context.PointAmount.ToString("#,0")</MudTd>
                            <MudTd>@context.Status</MudTd>
                            <MudTd>@($"{context.RedeemedCount}/{context.MaxRedemptions?.ToString() ?? "∞"}")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        }
    </MudTabs>
</MudStack>

@code {
    private IReadOnlyList<PointRateConfigView> _rates = Array.Empty<PointRateConfigView>();
    private IReadOnlyList<WalletView> _wallets = Array.Empty<WalletView>();
    private IReadOnlyList<TransactionView> _transactions = Array.Empty<TransactionView>();
    private IReadOnlyList<PointVoucherView> _vouchers = Array.Empty<PointVoucherView>();
    private string _voucherCode = string.Empty;
    private string _redeemCode = string.Empty;
    private string _rateResource = "image";
    private string _rateQuality = "standard";
    private decimal _rateValue = 3000;
    private Guid? _selectedCustomerId;
    private decimal _mutationAmount = 1000;
    private string _mutationNote = string.Empty;
    private decimal _voucherPoints = 1000;
    private int? _voucherMaxRedemptions = 1;

    private bool IsCustomer => AuthState.CurrentUser?.IsCustomer == true;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        var cid = AuthState.CurrentUser?.IsCustomer == true ? AuthState.CurrentUser.CustomerId : null;
        _rates = IsCustomer ? Array.Empty<PointRateConfigView>() : await Billing.GetPointRatesAsync();
        _wallets = await Billing.GetWalletsAsync(cid);
        _transactions = await Billing.GetRecentTransactionsAsync(cid);
        _vouchers = IsCustomer ? Array.Empty<PointVoucherView>() : await Billing.GetPointVouchersAsync();
        _selectedCustomerId ??= _wallets.FirstOrDefault()?.CustomerId;
    }

    private async Task SaveRateAsync()
    {
        try
        {
            await Billing.UpsertPointRateAsync(_rateResource, _rateQuality, _rateValue, AuthState.CurrentUser?.UserId);
            Snackbar.Add("Point rate saved.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task MutateAsync(string kind)
    {
        if (_selectedCustomerId is not Guid customerId)
        {
            Snackbar.Add("Select a customer wallet.", Severity.Warning);
            return;
        }

        var actor = AuthState.CurrentUser?.UserId;
        var result = kind switch
        {
            "topup" => await WalletService.TopUpAsync(customerId, _mutationAmount, "TOPUP", _mutationNote, actor),
            "adjust_plus" => await WalletService.AdjustPlusAsync(customerId, _mutationAmount, "ADJUST_PLUS", _mutationNote, actor),
            "adjust_minus" => await WalletService.AdjustMinusAsync(customerId, _mutationAmount, "ADJUST_MINUS", _mutationNote, actor),
            "refund" => await WalletService.RefundAsync(customerId, _mutationAmount, "REFUND", _mutationNote, actor),
            _ => new WalletMutationResult(false, null, 0, 0, "Unsupported mutation.")
        };

        Snackbar.Add(result.Error ?? $"Balance updated: {result.BalanceBefore:#,0} -> {result.BalanceAfter:#,0}", result.Ok ? Severity.Success : Severity.Error);
        if (result.Ok)
        {
            await ReloadAsync();
        }
    }

    private Task TopUpAsync() => MutateAsync("topup");
    private Task AdjustPlusAsync() => MutateAsync("adjust_plus");
    private Task AdjustMinusAsync() => MutateAsync("adjust_minus");
    private Task RefundAsync() => MutateAsync("refund");

    private async Task CreateVoucherAsync()
    {
        var result = await WalletService.CreateVoucherAsync(
            _voucherCode,
            _voucherPoints,
            _voucherMaxRedemptions,
            null,
            null,
            "Created from wallet admin page",
            AuthState.CurrentUser?.UserId);

        Snackbar.Add(result.Error ?? $"Voucher {result.VoucherCode} created.", result.Ok ? Severity.Success : Severity.Error);
        if (result.Ok)
        {
            await ReloadAsync();
        }
    }

    private async Task RedeemVoucherAsync()
    {
        if (AuthState.CurrentUser?.CustomerId is not Guid customerId)
        {
            Snackbar.Add("Customer account is required.", Severity.Warning);
            return;
        }

        var result = await WalletService.RedeemVoucherAsync(customerId, _redeemCode, AuthState.CurrentUser?.UserId);
        Snackbar.Add(result.Error ?? $"Voucher redeemed. New balance: {result.BalanceAfter:#,0}", result.Ok ? Severity.Success : Severity.Error);
        if (result.Ok)
        {
            await ReloadAsync();
        }
    }
}
