@page "/my-commissions"
@using TodoX.Web.Services.Affiliate
@inject AffiliateRepository AffiliateRepo
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<MyCommissions> Logger

<PageTitle>Hoa hồng của tôi</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4" Class="todox-page-title">Hoa hồng của tôi</MudText>
        <MudText Typo="Typo.body1" Class="todox-page-subtitle">Lịch sử nạp tiền của khách hàng gắn mã đại lý của bạn, hoa hồng được nhận và các lần TodoX đã thanh toán.</MudText>
    </div>

    @if (!_loaded)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
    }
    else if (AuthState.CurrentUser?.CustomerId is null)
    {
        <MudAlert Severity="Severity.Info">Trang này dành cho tài khoản khách hàng là đại lý. Quản trị viên xem hoa hồng tại <MudLink Href="/affiliates">Đại lý & hoa hồng</MudLink>.</MudAlert>
    }
    else if (_agent is null || !_agent.IsActive)
    {
        <MudAlert Severity="Severity.Info">Tài khoản của bạn chưa là đại lý (hoặc đã ngưng). Vui lòng liên hệ TodoX để đăng ký làm đại lý.</MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="todox-card pa-4">
                    <MudText Typo="Typo.subtitle2">Mã đại lý của bạn</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <div class="todox-stat-value">@_agent.AgentCode</div>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => CopyAsync(_agent.AgentCode))" />
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="todox-page-subtitle">Link đăng ký giới thiệu:</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body2" Style="word-break:break-all">@ReferralLink</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => CopyAsync(ReferralLink))" />
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4" md="2">
                <MudPaper Class="todox-card pa-4">
                    <MudText Typo="Typo.subtitle2">Khách hàng giới thiệu</MudText>
                    <div class="todox-stat-value">@_agent.ReferredCount</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4" md="2">
                <MudPaper Class="todox-card pa-4">
                    <MudText Typo="Typo.subtitle2">Chưa thanh toán</MudText>
                    <div class="todox-stat-value">@Money(_agent.PendingAmount)</div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4" md="2">
                <MudPaper Class="todox-card pa-4">
                    <MudText Typo="Typo.subtitle2">Đã nhận</MudText>
                    <div class="todox-stat-value">@Money(_agent.PaidAmount)</div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudAlert Severity="@(HasBank ? Severity.Normal : Severity.Warning)" Dense="true">
            Tài khoản nhận hoa hồng:
            <b>@(HasBank ? string.Join(" · ", new[] { _agent.BankName, _agent.BankAccountNo, _agent.BankAccountName }.Where(x => !string.IsNullOrWhiteSpace(x))) : "chưa có")</b>
            — cập nhật tại <MudLink Href="/profile">Thông tin tài khoản</MudLink>.
        </MudAlert>

        <MudPaper Class="todox-table-card pa-4" rounded="true">
            <MudText Typo="Typo.h6" Class="mb-2">Lịch sử nạp tiền của khách hàng</MudText>
            <MudTable Items="@_topups" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="todox-table">
                <HeaderContent>
                    <MudTh>Ngày nạp</MudTh>
                    <MudTh>Khách hàng</MudTh>
                    <MudTh Style="text-align:right">Số điểm</MudTh>
                    <MudTh Style="text-align:right">Giá trị nạp</MudTh>
                    <MudTh Style="text-align:right">Tỷ lệ</MudTh>
                    <MudTh Style="text-align:right">Hoa hồng</MudTh>
                    <MudTh>Trạng thái</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Ngày nạp">@context.TopupAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd DataLabel="Khách hàng">@context.CustomerCode — @context.CustomerName</MudTd>
                    <MudTd DataLabel="Số điểm" Style="text-align:right">@context.Points.ToString("N0")</MudTd>
                    <MudTd DataLabel="Giá trị nạp" Style="text-align:right">@Money(context.BaseAmount, context.Currency)</MudTd>
                    <MudTd DataLabel="Tỷ lệ" Style="text-align:right">@context.CommissionPercent.ToString("0.##")%</MudTd>
                    <MudTd DataLabel="Hoa hồng" Style="text-align:right"><b>@Money(context.CommissionAmount, context.Currency)</b></MudTd>
                    <MudTd DataLabel="Trạng thái">
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@AffiliateCommissionStatuses.Label(context.Status)</MudChip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Class="pa-4 todox-page-subtitle">Khách hàng của bạn chưa có lần nạp nào.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>

        @if (_commissions.Count > 0)
        {
            <MudPaper Class="todox-table-card pa-4" rounded="true">
                <MudText Typo="Typo.h6" Class="mb-2">Hoa hồng mua gói</MudText>
                <MudTable Items="@_commissions" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="todox-table">
                    <HeaderContent>
                        <MudTh>Ngày phát sinh</MudTh>
                        <MudTh>Khách hàng</MudTh>
                        <MudTh>Gói</MudTh>
                        <MudTh Style="text-align:right">Giá trị gói</MudTh>
                        <MudTh Style="text-align:right">Tỷ lệ</MudTh>
                        <MudTh Style="text-align:right">Hoa hồng</MudTh>
                        <MudTh>Trạng thái</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Ngày phát sinh">@context.PurchasedAt.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Khách hàng">@context.CustomerName</MudTd>
                        <MudTd DataLabel="Gói">@context.PackageCode — @context.PackageName</MudTd>
                        <MudTd DataLabel="Giá trị gói" Style="text-align:right">@Money(context.BaseAmount, context.Currency)</MudTd>
                        <MudTd DataLabel="Tỷ lệ" Style="text-align:right">@context.CommissionPercent.ToString("0.##")%</MudTd>
                        <MudTd DataLabel="Hoa hồng" Style="text-align:right"><b>@Money(context.CommissionAmount, context.Currency)</b></MudTd>
                        <MudTd DataLabel="Trạng thái">
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@AffiliateCommissionStatuses.Label(context.Status)</MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }

        <MudPaper Class="todox-table-card pa-4" rounded="true">
            <MudText Typo="Typo.h6" Class="mb-2">Lịch sử nhận thanh toán từ TodoX</MudText>
            <MudTable Items="@_payouts" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="todox-table">
                <HeaderContent>
                    <MudTh>Ngày chuyển khoản</MudTh>
                    <MudTh Style="text-align:right">Số tiền</MudTh>
                    <MudTh Style="text-align:right">Số khoản</MudTh>
                    <MudTh>Tài khoản nhận</MudTh>
                    <MudTh>Mã giao dịch</MudTh>
                    <MudTh>Ghi chú</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Ngày chuyển khoản">@context.PaidAt.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Số tiền" Style="text-align:right"><b>@Money(context.Amount, context.Currency)</b></MudTd>
                    <MudTd DataLabel="Số khoản" Style="text-align:right">@context.ItemCount</MudTd>
                    <MudTd DataLabel="Tài khoản nhận">@string.Join(" · ", new[] { context.BankName, context.BankAccountNo, context.BankAccountName }.Where(x => !string.IsNullOrWhiteSpace(x)))</MudTd>
                    <MudTd DataLabel="Mã giao dịch">@context.BankReference</MudTd>
                    <MudTd DataLabel="Ghi chú">@context.Note</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Class="pa-4 todox-page-subtitle">Chưa có lần thanh toán nào.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>

        <MudPaper Class="todox-table-card pa-4" rounded="true">
            <MudText Typo="Typo.h6" Class="mb-2">Khách hàng bạn giới thiệu</MudText>
            <MudTable Items="@_referred" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="todox-table">
                <HeaderContent>
                    <MudTh>Mã KH</MudTh>
                    <MudTh>Khách hàng</MudTh>
                    <MudTh>Ngày giới thiệu</MudTh>
                    <MudTh Style="text-align:right">Số lần mua gói</MudTh>
                    <MudTh>Gói gần nhất</MudTh>
                    <MudTh>Hạn gói</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Mã KH">@context.CustomerCode</MudTd>
                    <MudTd DataLabel="Khách hàng">@context.CustomerName</MudTd>
                    <MudTd DataLabel="Ngày giới thiệu">@context.ReferredAt.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Số lần mua gói" Style="text-align:right">@context.PurchaseCount</MudTd>
                    <MudTd DataLabel="Gói gần nhất">@context.LatestPackageCode</MudTd>
                    <MudTd DataLabel="Hạn gói">@context.CurrentCycleEnd?.ToString("dd/MM/yyyy")</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Class="pa-4 todox-page-subtitle">Chưa có khách hàng nào dùng mã của bạn.</MudText></NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
</MudStack>

@code {
    private bool _loaded;
    private AffiliateAgentView? _agent;
    private IReadOnlyList<AffiliateCommissionView> _commissions = Array.Empty<AffiliateCommissionView>();
    private IReadOnlyList<AffiliateTopupCommissionView> _topups = Array.Empty<AffiliateTopupCommissionView>();
    private IReadOnlyList<AffiliatePayoutView> _payouts = Array.Empty<AffiliatePayoutView>();
    private IReadOnlyList<AffiliateReferredCustomer> _referred = Array.Empty<AffiliateReferredCustomer>();

    private string ReferralLink => $"{Navigation.BaseUri.TrimEnd('/')}/register?ref={Uri.EscapeDataString(_agent?.AgentCode ?? string.Empty)}";
    private bool HasBank => !string.IsNullOrWhiteSpace(_agent?.BankAccountNo);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthState.CurrentUser?.CustomerId is Guid customerId)
            {
                _agent = await AffiliateRepo.GetAgentByCustomerAsync(customerId);
                if (_agent is { IsActive: true })
                {
                    // New top-ups of referred customers become commissions before the agent reads the list.
                    await AffiliateRepo.SyncTopupCommissionsAsync();
                    _agent = await AffiliateRepo.GetAgentByCustomerAsync(customerId);
                    _topups = await AffiliateRepo.GetTopupCommissionsAsync(_agent!.Id);
                    _commissions = await AffiliateRepo.GetCommissionsAsync(_agent.Id);
                    _payouts = (await AffiliateRepo.GetPayoutsAsync(_agent.Id)).Where(x => x.Status == "paid").ToList();
                    _referred = await AffiliateRepo.GetReferredCustomersAsync(_agent.Id);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "My commissions load failed.");
            Snackbar.Add("Không tải được dữ liệu hoa hồng.", Severity.Error);
        }

        _loaded = true;
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add("Đã sao chép.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Trình duyệt không cho phép sao chép, hãy copy thủ công.", Severity.Warning);
        }
    }

    private static string Money(decimal amount, string currency = "VND") => $"{amount:N0} {currency}";

    private static Color StatusColor(string status) => status switch
    {
        AffiliateCommissionStatuses.Paid => Color.Success,
        AffiliateCommissionStatuses.Pending => Color.Warning,
        _ => Color.Default
    };
}
