<div class="tl-processing-mask @(IsVideo ? "is-video" : "is-image")"
     role="status"
     aria-label="@(IsVideo ? "Video processing" : "Image processing")"
     aria-live="polite">
    <span class="tl-processing-flash" aria-hidden="true"></span>
    <span class="tl-processing-beam" aria-hidden="true"></span>
    <span class="tl-processing-scan" aria-hidden="true"></span>

    <span class="tl-processing-center">
        <span class="tl-processing-spinner" aria-hidden="true"></span>
        <span class="tl-processing-dots" aria-hidden="true">
            <i></i><i></i><i></i>
        </span>
        @if (IsVideo)
        {
            <span class="tl-processing-wave" aria-hidden="true">
                <i></i><i></i><i></i><i></i><i></i>
            </span>
        }
    </span>
</div>

@code {
    [Parameter] public bool IsVideo { get; set; }
}
